<page-meta page-style="{{ fontScaleStyle }}"></page-meta>
<view class="talent-v2 {{isMerchantViewer ? 'theme-merchant' : 'theme-dark'}}">
  <cy-toast id="cy-toast" />
  <cy-loading-mask id="cy-loading" />
  <cy-modal-host id="cy-modal-host" />

  <!-- ===== 顶栏(自绘·避开胶囊) ===== -->
  <view class="nav-wrap {{isSticky ? 'sticky' : ''}}">
    <view class="nav-status" style="height: {{statusBarHeight}}px;"></view>
    <view class="nav-bar" style="height: {{navBarHeight}}px;">
      <!-- 2026-09-18 UI-19:一级 tab 页也要有页标题(与商家「模板」tab 同一形态:导航栏居中一行) -->
      <text class="nav-title">俱乐部</text>
      <view class="nav-right" style="right: {{rightGap}}px;">
        <view class="nav-icon nav-msg" bindtap="onMsgTap" aria-role="button" aria-label="站内消息" hover-class="cy-pressed" hover-stay-time="80">
          <image lazy-load="true" src="/images/nav_msg.svg" mode="aspectFit" />
          <view class="im-dot" wx:if="{{imUnread > 0}}">{{imUnread > 99 ? '99+' : imUnread}}</view>
        </view>
      </view>
    </view>
  </view>

  <view style="height: {{headerH}}px;"></view>

  <!-- ===== 帖文 / 俱乐部 一级 tab(2026-08-05)=====
       帖文原来只活在单个俱乐部详情页里,没有跨俱乐部的流。范围不是全站公开流:
       玩家看我加入的、商家看我谈成过的(后端 /api/club/post/feed 判死)。 -->
  <cy-tabs class="top-tabs" variant="fill" wide="{{true}}" tabs="{{topTabs}}" active="{{activeTopTab}}" bind:change="onTopTabChange" />

  <!-- ===== 帖文 ===== -->
  <view class="tab-body tab-body--feed" wx:if="{{activeTopTab === 'feed'}}">
    <cy-skeleton class="feed-state" wx:if="{{feedState === 'loading'}}" type="card" count="{{3}}" />
    <cy-error class="feed-state cy-fade-in" wx:elif="{{feedState === 'error'}}" title="动态加载失败" sub="{{feedError}}" retry="重试" bind:retry="loadFeed" />
    <block wx:else>
      <cy-progress-status class="talent-state" wx:if="{{feedState === 'refreshing'}}" title="正在更新帖文" sub="现有内容仍可查看" />
      <block wx:if="{{feed.length}}">
        <cy-post-card class="cy-fade-in" wx:for="{{feed}}" wx:key="id" post="{{item}}" index="{{index}}" light="{{isMerchantViewer}}" interactive-user interactive-club show-share
          accessibility-label="查看{{item.memberNickname || '城瘾玩家'}}的动态"
          bind:detail="onPostTap" bind:user="onPostUser" bind:club="onPostClub"
          bind:playdetail="onPostReference" bind:play="onPostReferencePlay" />
      </block>
      <cy-empty class="feed-state" wx:else title="{{feedEmptyTitle}}" sub="{{feedEmptySub}}" />
    </block>
    <view class="safe-bottom"></view>
  </view>

  <!-- ===== 俱乐部：单页上「我的」、下「附近」===== -->
  <view class="tab-body" wx:elif="{{activeTopTab === 'club'}}">
      <!-- 创建俱乐部常驻顶部；商户账户互斥，继续隐藏 -->
      <view class="club-create" wx:if="{{!isMerchantViewer}}">
        <view class="club-create-txt">创建你自己的俱乐部</view>
        <view class="club-create-btn" bindtap="onClubApply" aria-role="button" aria-label="创建俱乐部" hover-class="cy-pressed" hover-stay-time="80">创建俱乐部</view>
      </view>

      <!-- 2026-09-18 UI-19:商家那条合作邀约入口行已删 —— 用户:邀约情况不在这里看
           (在合作中心 / 消息与动态里处理),这里就是完整的俱乐部列表。 -->

      <cy-skeleton wx:if="{{!clubsLoaded && !clubsError}}" type="card" count="{{3}}" />
      <cy-error wx:elif="{{clubsError && clubsState !== 'stale-error'}}" fill title="俱乐部列表加载失败" sub="{{clubsErrorText || '网络恢复后可重试'}}" retry="重试" bind:retry="retryClubs" />
      <block wx:else>
        <cy-progress-status class="talent-state" wx:if="{{clubsState === 'refreshing'}}" title="正在更新俱乐部" sub="现有列表仍可查看" />
        <cy-progress-status class="talent-state" wx:if="{{isMerchantViewer && merchantCityState === 'loading' && clubsLoaded && clubsState !== 'refreshing'}}" title="正在确认同城范围" sub="俱乐部列表仍可查看" />
        <cy-inline-error class="talent-state" wx:elif="{{isMerchantViewer && merchantCityState === 'error'}}" kind="{{merchantCityErrorKind}}" title="同城范围暂未确认" sub="{{merchantCityError}}" action="重试" bind:action="detectMerchant" />

      <!-- 2026-09-18 UI-19:不再分「我的 / 附近」两段 —— 这里就是一张完整的俱乐部列表。
           顺序:我创建的 → 我加入的 → 同城其他俱乐部(商家视角只有最后一组,仍按店铺城市过滤)。
           2026-08-20 重设计:三份内联拷贝收敛为 cy-club-card;外层保留 club-card 类名给截图矩阵选择器。 -->
      <view class="club-section" wx:if="{{clubsLoaded}}">
        <view class="club-grid" wx:if="{{myClubs.length || joinedClubs.length || nearbyClubs.length}}">
          <block wx:if="{{!isMerchantViewer}}">
            <cy-club-card class="club-card" wx:for="{{myClubs}}" wx:key="id" club="{{item}}" interactive="{{true}}"
              data-id="{{item.id}}" bind:tap="goClubDetail" bind:action="onClubCardAction" aria-role="button" aria-label="打开俱乐部主页"  hover-class="cy-pressed" hover-stay-time="80"/>
            <cy-club-card class="club-card" wx:for="{{joinedClubs}}" wx:key="id" club="{{item}}" interactive="{{true}}"
              data-id="{{item.id}}" bind:tap="goClubDetail" bind:action="onClubCardAction" aria-role="button" aria-label="打开俱乐部主页"  hover-class="cy-pressed" hover-stay-time="80"/>
          </block>
          <cy-club-card class="club-card" wx:for="{{nearbyClubs}}" wx:key="id" club="{{item}}" interactive="{{true}}"
            data-id="{{item.id}}" bind:tap="goClubDetail" bind:action="onClubCardAction" aria-role="button" aria-label="打开俱乐部主页"  hover-class="cy-pressed" hover-stay-time="80"/>
        </view>
        <cy-empty wx:elif="{{!isMerchantViewer}}" title="还没有俱乐部" sub="本城暂无正在组织探索的同好，创建你自己的俱乐部，成为第一个" cta="创建俱乐部" bindcta="onClubApply" />
        <cy-empty wx:else title="本城还没有俱乐部" sub="本城暂无正在组织探索的同好" />
      </view>
      </block>

  <cy-sheet show="{{clubManageShow}}" title="{{managingClub.name || '成员管理'}}" bind:close="closeClubManage">
    <view class="club-manage-sub">成员管理</view>
    <scroll-view class="club-member-list" scroll-y>
      <cy-skeleton wx:if="{{clubMembersState === 'loading'}}" type="list" count="{{3}}" />
      <cy-error wx:elif="{{clubMembersState === 'error'}}" title="成员没有加载出来" sub="{{clubMembersError}}" retry="重试" bind:retry="retryClubMembers" />
      <block wx:else>
        <cy-progress-status class="talent-state" wx:if="{{clubMembersState === 'refreshing'}}" title="正在更新成员" sub="现有名单仍可查看" />
        <view wx:for="{{clubMembers}}" wx:key="memberId" class="club-member" aria-label="{{item.nickname || '城瘾玩家'}}{{item.isOwner ? '，主理人' : ''}}">
          <cy-avatar size="72" src="{{item.avatar || '/images/d_profile.png'}}" />
          <view class="club-member-info">
            <view class="club-member-name">{{item.nickname || '城瘾玩家'}}</view>
            <view class="club-member-meta" wx:if="{{item.isOwner}}">主理人</view>
            <view class="club-member-meta" wx:else>加入时间 {{item.joinTime || '待确认'}}</view>
          </view>
          <view wx:if="{{!item.isOwner}}" class="club-member-remove" catchtap="removeClubMember" data-member-id="{{item.memberId}}" data-member-name="{{item.nickname || '这位成员'}}" hover-class="cy-pressed" hover-stay-time="80" aria-role="button" aria-label="移除{{item.nickname || '该成员'}}">移除</view>
        </view>
        <cy-empty wx:if="{{clubMembersLoaded && clubMembersState === 'empty'}}" title="暂无成员" sub="该俱乐部还没有成员加入，分享俱乐部让同好加入" />
      </block>
    </scroll-view>
  </cy-sheet>

  <view class="safe-bottom"></view>
  </view><!-- .tab-body -->
</view>

<tabBar dark="{{!isMerchantViewer}}" monochrome="{{!isMerchantViewer}}"/>

<!-- 危险动作三段式确认:文案来自 utils/danger-actions.js,页面只给 key -->
<cy-danger-confirm id="dc" bind:confirm="onConfirmRemoveClubMember" />

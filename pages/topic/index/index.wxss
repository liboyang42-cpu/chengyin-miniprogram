}

.topic .det1 .cont .row2 .col2 {
  width: 200rpx;
  margin-left: 110rpx; /* ds-ok: 量表外遗留值,复核保留(既有布局/图文对齐值) */
}

.topic .det1 .cont .row2 .col2 .user image {

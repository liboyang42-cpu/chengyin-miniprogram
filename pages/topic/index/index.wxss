.topic .det5 .lis1t .li .item {
  width: 176rpx;
  height: 216rpx;
  background: rgba(79, 79, 79, 0.1);
  border-radius: var(--cy-radius-lg);
  padding: var(--cy-space-1) var(--cy-space-3-5);

/* 页面基础样式 */
page{ background: var(--cy-bg-page);}
.topic .slide1 {
  height: 100vh;
  overflow: hidden; position: relative;
}

.topic .slide1 image {
  width: 100%;
  height: 100%;
}

.topic .slide1 .slide-txt {
  width: 100%;
  position: absolute;
  bottom: 0;
  left: 0;
  padding: var(--cy-space-5) var(--cy-space-6) var(--cy-space-6) var(--cy-space-6);
  box-sizing: border-box;
  color: var(--cy-text-inverse);
  text-align: center;
}

.topic .slide1 .slide-txt .txt1 {
  font-size: var(--cy-font-display);
  font-weight: bold;
}

.topic .slide1 .slide-txt .txt2 {
  font-size: 72rpx; /* ds-ok: hero封面大字,刻意大于data-xl(64)做沉浸式展示 */
  margin: var(--cy-space-2-5) 0;
}

.topic .slide1 .slide-txt .txt3 {
  font-size: var(--cy-font-body);
}

/* CU-M-191 无封面时首屏的信息锚点。卡片自带不透明底,不去赌那张占位图的明暗:
   icon_line.jpg 是固定白底的黑线画,压深渐变在它上面每一点对比都不一样。
   底与字取同主题的成对档(--cy-bg-card / --cy-text-*),深色页就是深卡白字。 */
.topic .slide1 .cover-brief {
  max-width: 560rpx; /* ds-ok: 与商家版 slide1 锚点同宽(merchantinfo.wxss:59) */
  margin: 0 auto var(--cy-space-4);
  padding: var(--cy-space-4);
  box-sizing: border-box;
  border-radius: var(--cy-radius-lg);
  background: var(--cy-bg-card);
  text-align: left;
}
.topic .slide1 .cover-brief-type {
  font-size: var(--cy-font-caption);
  color: var(--cy-text-secondary);
}
.topic .slide1 .cover-brief-title {
  margin-top: var(--cy-space-1);
  font-size: var(--cy-font-title);
  font-weight: 700;
  color: var(--cy-text-title);
}
.topic .slide1 .cover-brief-value {
  margin-top: var(--cy-space-1);
  font-size: var(--cy-font-body);
  line-height: var(--cy-leading-normal);
  color: var(--cy-text-body);
}
/* 白色下滑箭头压在那张白底占位图上等于隐形(走查原话「很淡的向下箭头」),
   给它一枚深色承载底;有真封面时不加,保持稿上封面不压东西。 */
.topic .slide1 .jt--nocover {
  display: inline-flex;
  padding: var(--cy-space-1-5);
  border-radius: var(--cy-radius-pill);
  background: var(--cy-color-overlay);
}

.topic .slide1 .slide-txt .jt {
  margin-top: var(--cy-space-8);
}

.topic .slide1 .slide-txt .jt image {
  width: 43rpx;
  height: 41rpx;
  -webkit-animation: bounceDown 4s linear infinite;
  -moz-animation: bounceDown 4s linear infinite;
  -o-animation: bounceDown 4s linear infinite;
  animation: bounceDown 4s linear infinite;
}

/* ==================== 顶部导航栏样式 ==================== */
.topbar {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 100;
  background: transparent;
  transition: background-color var(--cy-dur) var(--cy-ease);
}

.topbar.solid {
  background: var(--cy-bg-card);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.topbar .statusBar.trans {
  background: transparent;
  transition: background-color var(--cy-dur) var(--cy-ease);
}

.topbar.solid .statusBar.trans {
  background: var(--cy-bg-card);
}

.topbar .titBar.trans {
  background: transparent;
  transition: background-color var(--cy-dur) var(--cy-ease);
}

.topbar.solid .titBar.trans {
  background: var(--cy-bg-card);
}

.topbar .titBar {
  padding: 0 var(--cy-page-x);
  box-sizing: border-box;
}

.topbar .titBar .back button {
  width: 66rpx;
  height: 66rpx;
  background: rgba(255, 255, 255, 0.5);
  border-radius: 50%;
  transition: background-color var(--cy-dur) var(--cy-ease);
  position: relative;
}

/* 返回箭头绝对定位居中,不依赖 flex(原生 button 的内置内边距会把 flex 子项挤偏) */
.topbar .titBar .back button cy-icon {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

.topbar.solid .titBar .back button {
  background: var(--cy-bg-page);
}


/* ==================== 吸顶标签栏样式 ==================== */
.sticky-tab-wrapper {
  position: relative;
  background: var(--cy-bg-card);
  /* .sticky 改的 position/top/z-index 都不可动画,真正过渡的只有 opacity */
  transition: opacity var(--cy-dur) var(--cy-ease);
  z-index: 98;
  /* 默认隐藏，滚动到位置时显示 */
  opacity: 0;
  visibility: hidden;
  height: 0;
  overflow: hidden;
}

.sticky-tab-wrapper.sticky {
  /* 吸顶时的样式 */
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  /* 2026-09-02:原 999 —— 页内吸顶条却比 sheet(800)/modal(900)/toast(950) 还高,
     任何弹窗弹出来都会被这条 tab 压住一截,零报错。吸顶条属于 sticky 档,
     且必须低于 nav(90),否则会盖住 cy-nav-bar(见 tokens.wxss 那段说明)。 */
  z-index: var(--cy-z-sticky);
  opacity: 1;
  visibility: visible;
  height: auto;
  /*box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);*/
  animation: tabSlideDown 0.3s ease-out;
}

/* 吸顶状态栏样式 */
.sticky-status-bar {
  background: var(--cy-bg-card);
  width: 100%;
}

/* 吸顶导航栏样式 */
.sticky-nav-bar {
  background: var(--cy-bg-card);
  padding: 0 var(--cy-page-x);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.sticky-nav-bar .sticky-back button {
  width: 66rpx;
  height: 66rpx;
  background: var(--cy-bg-page);
  border-radius: 50%;
  border: none;
  padding: 0;
  margin: 0;
  position: relative;
}

.sticky-nav-bar .sticky-back button::after {
  border: none;
}

.sticky-nav-bar .sticky-back button cy-icon {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}


/* 吸顶动画 */
@keyframes tabSlideDown {
  from {
    transform: translateY(-100%);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

/* 调整吸顶标签栏的样式 */
.sticky-tab-wrapper .tab2 {
  margin: 0;
  height: 90rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: var(--cy-bg-card);
  
}

/* .sticky-tab-wrapper .tab2 .li 已归一至 .cy-tabs__item(吸顶态容器样式 .sticky-tab-wrapper .tab2 保留) */

/* 页面内的标签栏样式 */
.det4 .page-tab {
  /* .hidden 只改 opacity/visibility/height */
  transition: opacity var(--cy-dur) var(--cy-ease), visibility var(--cy-dur) var(--cy-ease), height var(--cy-dur) var(--cy-ease);
  opacity: 1;
  visibility: visible;
  height: auto;
  overflow: visible;
}

.det4 .page-tab.hidden {
  /* 当吸顶标签显示时，页面内的标签隐藏 */
  opacity: 0;
  visibility: hidden;
  height: 0;
  overflow: hidden;
  margin-bottom: 0;
}

/* 确保页面内容在吸顶时有正确的间距 */
.topic {
  position: relative;
  min-height: 100vh;
}

/* 骨架屏/错误态/缺参空态独占整屏(与主内容 block 互斥渲染),做成 flex column
 * 让 cy-empty/cy-error 的 fill 变体能用 flex:1 吃满"顶栏下方到屏幕底部"的剩余空间
 * 真正居中(2026-07-31:用户明确的"居中"定义,不是紧贴顶部也不是整屏居中)。 */
.topic-state {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  box-sizing: border-box;
}

/* fill 链的最后一环(2026-07-31 补):.topic-state 已是 flex 列 + 100vh,
   但 cy-empty/cy-error 的 .cy-empty--fill{flex:1} 只作用在组件内部根节点,
   够不到宿主 <cy-empty> 标签 —— 宿主还是 display:block / flex:0 1 auto,
   于是"剩余空间"从来没被撑开,size="lg" 只放大了图文、位置仍贴顶。
   补上宿主这一环后 240rpx 大图 + 放大文案才真的落在剩余空间正中。 */
.fill-slot { display: flex !important; flex-direction: column !important; flex: 1 !important; min-height: 0 !important; }

/* 修复吸顶后内容被遮挡的问题 */
.sticky-tab-wrapper.sticky ~ .slide1 {
  margin-top: calc(90rpx + var(--statusBarHeight, 0px) + var(--navBarHeight, 44px)); /* ds-ok: 90rpx=吸顶tab高,尺寸值非留白间距 */
}

/* 事实卡是第二屏首项；tab 吸顶后要为它留出真实占位，否则第一排章节/用时会被吸顶层盖住。 */
.sticky-tab-wrapper.sticky ~ .slide2 .statbar {
  margin-top: calc(90rpx + var(--statusBarHeight, 0px) + var(--navBarHeight, 44px)); /* ds-ok: 与既有吸顶层高度同源 */
}

/* 原有的主题内容样式 */
/* 方案一优化版 - 增加更多兼容性处理 */
.topic .det1 {
  display: flex;
  height: auto;
  width: 100%;
  position: relative;
  overflow: hidden;
  /* 优先使用 aspect-ratio */
  aspect-ratio: 5/3;
}

/* 对于不支持 aspect-ratio 的容器 */
.topic .det1:not([style*="aspect-ratio"]) {
  height: 0;
  padding-bottom: 60%; /* 5:3比例，3/5=0.6=60% */
}

/* 横版封面多图轮播:swiper 不自适应高度,故绝对定位铺满 .det1(它 position:relative,
   高度由下面的 padding-bottom:60% 兜底撑出 5:3)。swiper-item 里的 .bgt 由后面那条
   :not([style*="aspect-ratio"]) 规则铺满,这里不用再写。
   .cont 同为 absolute 且在 DOM 里排在 swiper 之后,自然压在上层,无需 z-index。 */
.topic .det1 .bgt-swiper {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.topic .det1 .bgt {
  width: 100%;
  height: auto;
  /* 移除 !important 以避免冲突 */
  object-fit: cover;
  display: block;
}

/* 确保在容器有padding-bottom时图片能正确显示 */
.topic .det1[style*="padding-bottom"] .bgt,
.topic .det1:not([style*="aspect-ratio"]) .bgt {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

/* Figma 2233:11364-11370:透明覆盖行贴图底边,左分类标签、右发起人,图从后面透出来 */
.topic .det1 .cont {
  position: absolute;
  width: 100%;
  left: 0;
  bottom: 0;
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: space-between;
  align-items: flex-end;
  gap: var(--cy-space-1-5);
  padding: var(--cy-space-2-5) var(--cy-page-x);
  box-sizing: border-box;
  color: var(--cy-color-text-primary);
}

/* Beta 试玩期条:info 语义(既非告警也非成就,是「还在试玩」的状态说明)。
   CU-C-111:原来挂在 .cont 那条贴在头图底边的覆盖行里,横穿封面里的路线图定位标记 ——
   信息压装饰、装饰遮信息。挪到图下自成一行,左右内缩距改由自己付(覆盖行原来代付)。 */
.topic-beta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: var(--cy-space-2);
  margin: var(--cy-space-2) var(--cy-page-x);
  padding: var(--cy-space-2);
  border-radius: var(--cy-radius-md);
  background: var(--cy-color-status-info-soft);
}

.topic-beta__head {
  flex: 1;
  gap: var(--cy-space-1-5);
  min-width: 0;
}

.topic-beta__badge {
  flex: none;
  min-height: 40rpx;
  padding: 0 var(--cy-space-2);
  border-radius: var(--cy-radius-pill);
  background: var(--cy-color-status-info);
  color: var(--cy-color-text-primary);
  font-size: var(--cy-type-label);
  font-weight: 700;
  line-height: 40rpx;
}

.topic-beta__note {
  flex: 1;
  min-width: 0;
  color: var(--cy-color-text-secondary);
  font-size: var(--cy-type-caption);
}

.topic-beta__action {
  flex: none;
}

.topic-category-list {
  display: flex;
  flex-wrap: wrap;
  gap: var(--cy-space-1);
  min-width: 0;
}

.topic-category-chip {
  max-width: 220rpx;
  min-height: 40rpx;
  padding: 0 var(--cy-space-2);
  box-sizing: border-box;
  border-radius: var(--cy-radius-pill);
  color: var(--cy-color-text-primary);
  background: var(--cy-color-bg-glass);
  font-size: var(--cy-type-label);
  line-height: 40rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.topic-attribution {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: flex-end;
  gap: var(--cy-space-1-5);
  min-width: 0;
  /* 无分类 chip 时覆盖行只剩这一个孩子,space-between 会把它推去左边;稿要求发起人恒靠右 */
  margin-left: auto;
}

.topic-attribution__item {
  display: flex;
  flex: 0 1 auto;
  align-items: center;
  gap: var(--cy-space-1);
  min-width: 0;
  max-width: 100%;
  padding: var(--cy-space-1) var(--cy-space-1-5);
  box-sizing: border-box;
  border-radius: var(--cy-radius-pill);
  background: var(--cy-color-bg-glass);
}

/* 2026-09-05:人物那半随「合作者」一起删了(见 index.wxml 的说明),
   __avatar 的两条规则跟着清掉,只留承接俱乐部那半用的 __icon。 */
.topic-attribution__icon {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
}

.topic-attribution__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--cy-color-text-primary);
}

/* 移交按钮(仅 isOwner)独占一行,不挤进覆盖行 */
.topic-transfer-entry {
  flex-basis: 100%;
}

.topic-attribution__label {
  flex-shrink: 0;
  /* 覆盖行改浮在头图上后，这个 caption 的底是 82% 玻璃 + 身后照片。
     照片全白是最坏情况：tertiary(#919191) 只剩 3.04:1，caption 字号要 4.5:1 不够；
     secondary(#B7B7B7) 是 4.77:1。契约测试按合成底把这条锁死了。 */
  color: var(--cy-color-text-secondary);
  font-size: var(--cy-type-caption);
  line-height: var(--cy-leading-normal);
}

.topic-attribution__value {
  min-width: 0;
  /* 长昵称截断上限:约 15 个 16rpx 字,保证 pill 不吃满整行、左侧分类 chip 仍有位置 */
  max-width: 240rpx;
  color: var(--cy-color-text-primary);
  font-size: var(--cy-type-label);
  line-height: var(--cy-leading-normal);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.topic .det1 .cont .row2 {
  color: var(--cy-text-inverse);
  padding: var(--cy-space-4) var(--cy-page-x) var(--cy-space-2-5) var(--cy-page-x);

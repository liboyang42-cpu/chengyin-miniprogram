@import '../../../style/merchant-light.wxss';

.merchant-info-page { min-height: 100vh; background: var(--cy-bg-page); color: var(--cy-text-title); }

page {
  background: var(--cy-bg-page);
}

/* ===== 顶栏 ===== */
.topbar {
  position: sticky;
  top: 0;
  z-index: 100;
  background: var(--cy-bg-page);
}
.topbar .navBar {
  position: relative;
}
.topbar .nav-content {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  padding: 0 var(--cy-space-3-5);
  display: flex;
  align-items: center;
}
.back-btn image {
  width: var(--cy-space-2-5);
  height: 25rpx;
}
.btn-signup::after { border: none; }
/* 页面基础样式 */
.topic .slide1 {
  height: 100vh;
  overflow: hidden; position: relative;
}

.topic .slide1 image {
  width: 100%;
  height: 100%;
}

.topic .slide1 .slide-txt {
  width: 100%;
  position: absolute;
  bottom: 0;
  left: 0;
  padding: var(--cy-space-5) var(--cy-space-6) var(--cy-space-6) var(--cy-space-6);
  box-sizing: border-box;
  color: var(--cy-text-inverse);
  text-align: center;
}

/* P0-UI-1:不让封面承担信息；四态共用这块文字锚点。 */
.topic .slide1 .cover-brief {
  margin: 0 auto var(--cy-space-3);
  max-width: 560rpx;
}
.topic .slide1 .cover-brief-type {
  display: inline-block;
  padding: var(--cy-space-1) var(--cy-space-2);
  border-radius: var(--cy-radius-pill);
  background: var(--cy-color-overlay);
  color: var(--cy-text-inverse);
  font-size: var(--cy-font-caption);
}
.topic .slide1 .cover-brief-title {
  margin-top: var(--cy-space-2);
  color: var(--cy-text-inverse);
  font-size: var(--cy-font-title);
  font-weight: 700;
}
.topic .slide1 .cover-brief-value {
  display: block;
  margin-top: var(--cy-space-1);
  color: var(--cy-text-inverse);
  font-size: var(--cy-font-body);
  line-height: 1.5;
}

/* 浅色封面兜底沿用商家页正文层级，不能让图片态的白字落在浅底上。 */
.topic .slide1 .slide-txt--cover-fallback {
  color: var(--cy-text-title);
}
.topic .slide1 .slide-txt--cover-fallback .cover-brief-title {
  color: var(--cy-text-title);
}
.topic .slide1 .slide-txt--cover-fallback .cover-brief-value {
  color: var(--cy-text-body);
}
.topic .slide1 .slide-txt--cover-fallback .jt {
  display: inline-flex;
  padding: var(--cy-space-1-5);
  border-radius: var(--cy-radius-pill);
  background: var(--cy-color-overlay);
}

.topic .slide1 .slide-txt .txt1 {
  font-size: var(--cy-font-display);
  font-weight: bold;
}

.topic .slide1 .slide-txt .txt2 {
  font-size: 72rpx; /* ds-ok: hero封面大字,刻意大于data-xl(64)做沉浸式展示 */
  margin: var(--cy-space-2-5) 0;
}

.topic .slide1 .slide-txt .txt3 {
  font-size: var(--cy-font-body);
}

.topic .slide1 .slide-txt .jt {
  margin-top: var(--cy-space-8);
}

/* P1-2:封面加载失败兜底 —— 原来图挂了就是一整屏纯空白,看不出页面有没有内容 */
.topic .slide1 .slide-cover-fallback {
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  padding: 0 var(--cy-space-6);
  background: var(--cy-bg-card-2);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.topic .slide1 .cover-fb-skeleton {
  width: 100%;
  padding: var(--cy-space-5);
  box-sizing: border-box;
  border-radius: var(--cy-radius-lg);
  background: var(--cy-bg-card);
}
.topic .slide1 .cover-fb-block {
  width: 58%;
  height: var(--cy-space-3);
  margin-top: var(--cy-space-2);
  border-radius: var(--cy-radius-pill);
  background: var(--cy-color-bg-surface-subtle);
}
.topic .slide1 .cover-fb-block:first-child { margin-top: 0; }
.topic .slide1 .cover-fb-block--wide { width: 82%; height: var(--cy-space-8); border-radius: var(--cy-radius-lg); }
.topic .slide1 .cover-fb-block--short { width: 36%; }
.topic .slide1 .cover-fb-title {
  font-size: var(--cy-font-title);
  font-weight: 700;
  color: var(--cy-text-title);
  text-align: center;
}
.topic .slide1 .cover-fb-tip {
  margin-top: var(--cy-space-2);
  font-size: var(--cy-font-body);
  color: var(--cy-text-secondary);
  text-align: center;
}

/* 底部压深,保证「下滑」提示在任何封面(含浅色兜底底)上都读得清 */
.topic .slide1 .slide-scrim {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 320rpx;
  background: linear-gradient(to top, var(--cy-color-overlay), transparent);
  pointer-events: none;
}
.topic .slide1 .slide-scrim--cover-fallback {
  background: linear-gradient(to top, var(--cy-bg-card-2), transparent);
}

.topic .slide1 .slide-txt .jt image {
  width: 43rpx;
  height: 41rpx;
  -webkit-animation: bounceDown 4s linear infinite;
  -moz-animation: bounceDown 4s linear infinite;
  -o-animation: bounceDown 4s linear infinite;
  animation: bounceDown 4s linear infinite;
}

/* ==================== 顶部导航栏样式 ==================== */
.topic .topbar {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 100;
  background: transparent;
  transition: background-color var(--cy-dur) var(--cy-ease);
}

.topic .topbar.solid {
  background: var(--cy-bg-card);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.topic .topbar .statusBar.trans {
  background: transparent;
  transition: background-color var(--cy-dur) var(--cy-ease);
}

.topic .topbar.solid .statusBar.trans {
  background: var(--cy-bg-card);
}

.topic .topbar .titBar.trans {
  background: transparent;
  transition: background-color var(--cy-dur) var(--cy-ease);
}

.topic .topbar.solid .titBar.trans {
  background: var(--cy-bg-card);
}

.topic .topbar .titBar {
  padding: 0 var(--cy-space-3-5);
  box-sizing: border-box;
}

.topic .topbar .titBar .back button {
  width: 66rpx;
  height: 66rpx;
  background: rgba(255, 255, 255, 0.5);
  border-radius: 50%;
  transition: background-color var(--cy-dur) var(--cy-ease);
}

.topic .topbar.solid .titBar .back button {
  background: var(--cy-bg-page);
}

.topic .topbar .titBar .back button image {
  width: var(--cy-space-2-5);
  height: 25rpx;
}


.sticky-tab-wrapper.sticky {
  /* 吸顶时的样式 */
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  /* 2026-09-02:同 topic/index —— 原 999 比所有弹窗档都高,吸顶条会压住弹窗。 */
  z-index: var(--cy-z-sticky);
  opacity: 1;
  visibility: visible;
  height: auto;
  /*box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);*/
  animation: tabSlideDown 0.3s ease-out;
}



.sticky-nav-bar .sticky-back button {
  width: 66rpx;
  height: 66rpx;
  background: var(--cy-bg-page);
  border-radius: 50%;
  border: none;
  padding: 0;
  margin: 0;
}

.sticky-nav-bar .sticky-back button::after {
  border: none;
}

.sticky-nav-bar .sticky-back button image {
  width: var(--cy-space-2-5);
  height: 25rpx;
}

/* 吸顶动画 */
@keyframes tabSlideDown {
  from {
    transform: translateY(-100%);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

/* 调整吸顶标签栏的样式 */
.sticky-tab-wrapper .tab2 {
  margin: 0;
  height: 90rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: var(--cy-bg-card);
  
}

/* .sticky-tab-wrapper .tab2 .li 已归一至 .cy-tabs__item(吸顶容器样式保留) */

/* 页面内的标签栏样式 */
.det4 .page-tab {
  /* .hidden 只改 opacity/visibility/height */
  transition: opacity var(--cy-dur) var(--cy-ease), visibility var(--cy-dur) var(--cy-ease), height var(--cy-dur) var(--cy-ease);
  opacity: 1;
  visibility: visible;
  height: auto;
  overflow: visible;
}

.det4 .page-tab.hidden {
  /* 当吸顶标签显示时，页面内的标签隐藏 */
  opacity: 0;
  visibility: hidden;
  height: 0;
  overflow: hidden;
  margin-bottom: 0;
}

/* 确保页面内容在吸顶时有正确的间距 */
.topic {
  position: relative;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--cy-bg-page);
}

.browse-error {
  display: flex !important;
  flex-direction: column !important;
  flex: 1 !important;
  min-height: 0 !important;
}

.topic .slide2 { padding-bottom: var(--cy-space-6); background: var(--cy-bg-page); }

/* 修复吸顶后内容被遮挡的问题 */
.sticky-tab-wrapper.sticky ~ .slide1 {
  margin-top: calc(90rpx + var(--statusBarHeight, 0px) + var(--navBarHeight, 44px)); /* ds-ok: 90rpx=吸顶tab高,尺寸值非留白间距 */
}

/* 原有的主题内容样式 */
/* 方案一优化版 - 增加更多兼容性处理 */
.topic .det1 {
  display: flex;
  height: auto;
  width: 100%;
  position: relative;
  overflow: hidden;
  /* 优先使用 aspect-ratio */
  aspect-ratio: 5/3;
}

/* 对于不支持 aspect-ratio 的容器 */
.topic .det1:not([style*="aspect-ratio"]) {
  height: 0;
  padding-bottom: 60%; /* 5:3比例，3/5=0.6=60% */
}

.topic .det1 .bgt {
  width: 100%;
  height: auto;
  /* 移除 !important 以避免冲突 */
  object-fit: cover;
  display: block;
}

.topic .det1 .detail-cover-fallback {
  width: 100%;
  height: 100%;
  padding: var(--cy-space-5) var(--cy-page-x);
  box-sizing: border-box;
  background: var(--cy-bg-card-2);
}
/* CU-M-156 加载结束后无封面的缺图档:图标 + 短文案,与 pages/template 列表、
   templatedetail 头图同一口径。排布写在占位块自己身上,不写进 fallback ——
   那块还要给加载中的骨架用,骨架是左上角的横条,不是居中。 */
.topic .det1 .detail-cover-ph {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: var(--cy-space-1-5);
  color: var(--cy-text-secondary);
}
/* no_data.svg 原图 4:3,按此比例给宽,不拉扁 */
.topic .det1 .detail-cover-ph-icon { width: 160rpx; height: 120rpx; flex: 0 0 auto; }
.topic .det1 .detail-cover-ph-txt { font-size: var(--cy-font-caption); line-height: var(--cy-leading-normal); }

.topic .det1 .detail-cover-shape {
  width: 56%;
  height: var(--cy-space-3);
  margin-top: var(--cy-space-2);
  border-radius: var(--cy-radius-pill);
  background: var(--cy-bg-card);
}
.topic .det1 .detail-cover-shape--large {
  width: 100%;
  height: calc(var(--cy-space-8) * 2);
  margin-top: 0;
  border-radius: var(--cy-radius-lg);
}

/* 确保在容器有padding-bottom时图片能正确显示 */
.topic .det1[style*="padding-bottom"] .bgt,
.topic .det1:not([style*="aspect-ratio"]) .bgt {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.topic .det1 .cont {
  position: absolute;
  width: 100%;
  left: 0;
  bottom: 0;
  display: flex;
  justify-content: space-between; 
}

.topic .det1 .cont .row1 {
  box-sizing: border-box;
}

/* CU-M-156:这里原来还写了 background: rgba(255,255,255,.5) —— 与上面的规则同特异性,
   @import 在前、本页在后,于是本页赢下 background 却没人赢下 color,color 仍从
   style/merchant-light.wxss:217 拿到 #ffffff ⇒ 白字压在近白底上,"运动健身"读不见。
   merchant-light 那条「暗底白字」是一对(深底必配白字),只改走一半就是这次的根因。
   所以撤掉本页的 background,让共享规则把底和字一起定死,不是再补一条 color 盖回去。 */
.topic .det1 .cont .row1 text {
  padding: 0 var(--cy-space-1);
  height: 40rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: var(--cy-font-label);
  backdrop-filter: blur(var(--cy-space-1))
}

.topic .det1 .cont .row2 {
  color: var(--cy-text-inverse);
  padding: var(--cy-space-4) var(--cy-page-x) var(--cy-space-2-5) var(--cy-page-x);
  box-sizing: border-box;
  align-items: flex-end;
}

.topic .det1 .cont .row2 .col1 .tit {
  font-size: var(--cy-font-title);
  font-weight: bold;
}

.topic .det1 .cont .row2 .col1 .desc {
  color: var(--cy-text-secondary);
  font-size: var(--cy-font-caption);
  margin-top: var(--cy-space-2);
  line-height: var(--cy-leading-normal);
}

.topic .det1 .cont .row2 .col2 {
  width: 200rpx;
  margin-left: 110rpx; /* ds-ok: 量表外遗留值,复核保留(既有布局/图文对齐值) */
}

.topic .det1 .cont .row2 .col2 .user image {
  width: 55rpx;
  height: 55rpx;
  border-radius: 50%;
  margin-right: calc(var(--cy-space-3-5) * -1);
}

.topic .det1 .cont .row2 .col2 .user .num {
  width: 55rpx;
  height: 55rpx;
  background: var(--cy-bg-card);
  color: var(--cy-accent);
  font-weight: 400;
  font-size: var(--cy-font-caption);
  border-radius: 50%;
  border: 2rpx solid var(--cy-text-title);
}

.topic .det1 .cont .row2 .col2 .user .txt {
  margin-left: var(--cy-space-2-5);
}








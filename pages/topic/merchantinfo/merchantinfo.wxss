.davidbmtk_box_ly_txt {
  font-size: var(--cy-font-label);
  color: var(--cy-text-body);
  line-height: var(--cy-leading-normal);
}


.cense .davidbmtk_box_top_left {
  background: linear-gradient(135deg, #00A63E 0%, #00FF5F 100%);
  box-shadow: 0px 10rpx 20rpx -6rpx rgba(1, 209, 78, 0.9);
}

.cense .davidbmtk_box_top_right_con {
  color: #00A63E;
  background: rgba(218, 255, 229, 1);
}

.cense .davidbmtk_box_ly_2h_li::before {
  background: #038C36;
}

.cense .davidbmtk_box_ly_tit {
  color: #00752C;
  border-top: 2rpx solid rgba(1, 183, 68, 0.18)
}

/* 底部按钮 */
.bm-btndavid {
  padding: var(--cy-space-4) var(--cy-page-x) var(--cy-space-6) var(--cy-page-x);
  box-sizing: border-box;
}

.bm-btndavid button {
  width: 100%;
  height: var(--cy-space-8);
  background: var(--cy-btn-solid-bg);
  color: var(--cy-text-inverse);
  font-size: var(--cy-font-body);
  border-radius: var(--cy-radius-lg);
  font-weight: bold;
}

.bm-btndavid button:hover {
  opacity: 0.88;
}

/* 相对定位辅助类 */
.david_pr {
  position: relative;
}

.merchant-chapter-option {
  min-width: 46%;
  max-width: 100%;
  line-height: 1.45;
}

.merchant-chapter-meta {
  margin-top: var(--cy-space-1);
  font-size: var(--cy-font-caption);
  color: var(--cy-text-secondary);
}

.merchant-chapter-option.check .merchant-chapter-meta {
  color: inherit;
}

/* 减少动态效果:吸顶标签栏滑入直接到位。 */
.mi--reduced .sticky-tab-wrapper.sticky { animation: none; }

/* 站点卡(稿 181:715):宽图 + 图底深色带写玩法名,图下写「商家名（地点名）」与导航按钮。 */
.node-card {
  margin-top: var(--cy-space-3);
  border-radius: var(--cy-radius-lg);
  background: var(--cy-bg-card);
  overflow: hidden;
}
.node-card-cover { position: relative; }
.node-card-img {
  display: block;
  width: 100%;
  height: 320rpx;
  background: var(--cy-bg-card-2);
}
/* 玩法名压在图的底部:稿上是一条通栏深色带,不是图外单独一行 */
.node-card-tag {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: var(--cy-space-2) var(--cy-space-4);
  background: var(--cy-comp-scrim);
  font-size: var(--cy-font-label);
  color: var(--cy-text-inverse);
}
.node-card-foot {
  display: flex;
  align-items: center;
  gap: var(--cy-space-3);
  padding: var(--cy-space-3) var(--cy-space-4);
}
.node-card-who {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
}
.node-card-name {
  font-size: var(--cy-font-subtitle);
  color: var(--cy-text-title);
}
.node-card-place {
  font-size: var(--cy-font-caption);
  color: var(--cy-text-secondary);
}
.node-card-more {
  margin-left: var(--cy-space-2);
  font-size: var(--cy-font-caption);
  color: var(--cy-text-secondary);
}
/* 命中区不得小于 44px(X12 门禁):圆钮本身照稿是 56rpx 的小胶囊,
   靠 min-width/min-height 把可点范围撑到 88rpx = 44px。 */
.node-card-go {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  min-width: 88rpx;
  min-height: 88rpx;
  border-radius: var(--cy-radius-pill);
  background: var(--cy-btn-solid-bg);
  color: var(--cy-btn-solid-fg);
}

/* 稿 181:575「阵容/商家」:横滑人物卡(与玩家版 214:384 同构,浅色域) */
.lineup { padding: var(--cy-space-5) 0 var(--cy-space-2); }
.lineup .det-type { margin: 0 var(--cy-page-x) var(--cy-space-3-5) var(--cy-page-x); }
.lineup-row { white-space: nowrap; padding: 0 var(--cy-page-x); }
.lineup-card {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  width: 200rpx;
  padding: var(--cy-space-4) var(--cy-space-2-5);
  margin-right: var(--cy-space-2-5);
  border-radius: var(--cy-radius-lg);
  background: var(--cy-bg-card);
  vertical-align: top;
}
.lineup-name {
  margin-top: var(--cy-space-2-5);
  max-width: 100%;
  font-size: var(--cy-font-body);
  font-weight: 600;
  color: var(--cy-text-title);
}
.lineup-role {
  margin-top: var(--cy-space-1);
  font-size: var(--cy-font-caption);
  color: var(--cy-text-muted);
}

/* 「我在这条路线上的承接」:从选标的弹层搬进正文后,要按正文的卡片语言排,
   不能沿用弹层里那套贴边列表 —— 它现在跟「节点介绍 / 主题介绍」并排。 */
.topic .my-apply .dt {
  margin-top: var(--cy-space-3);
  margin-bottom: var(--cy-space-1-5);
  font-size: var(--cy-font-label);
  font-weight: 600;
  color: var(--cy-text-title);
}
.topic .my-apply .dd {
  padding: var(--cy-space-3);
  margin-bottom: var(--cy-space-2);
  background: var(--cy-bg-card);
  border: 1rpx solid var(--cy-border-card);
  border-radius: var(--cy-radius-md);
}
/* 一行里可能同时有「撤回申请」和「填写实际供给」,让它们并排、按内容宽 */
.topic .my-apply .merchant-chapter-actions {
  display: flex;
  flex-wrap: wrap;
  gap: var(--cy-space-2);
  margin-top: var(--cy-space-2);
}

/* 稿 181:687 / 181:696「评价」：大分数 + 星 + 「基于 N 条评论」，下面一排横滑评价卡。
   与玩家版 214:542/551 同一块，这里是浅色域的镜像。 */
.topic .det6-light { padding: var(--cy-space-4) 0 0 0; }
.topic .det6-light__head {
  display: flex;
  align-items: center;
  gap: var(--cy-space-3);
  padding: 0 var(--cy-page-x);
}
.topic .det6-light__score {
  font-size: 72rpx; /* ds-ok: 与玩家版 .det6 .row1 .col1 同一个刻意放大的评分数字,两边必须一样大 */
  font-weight: bold;
  color: var(--cy-text-title);
  line-height: 1;
}
.topic .det6-light__stars { display: flex; align-items: center; gap: var(--cy-space-1); }
.topic .det6-light__sub {
  display: block;
  margin-top: var(--cy-space-1);
  font-size: var(--cy-font-caption);
  color: var(--cy-text-secondary);
}
.topic .det6-light__row { margin-top: var(--cy-space-3); white-space: nowrap; }
.topic .det6-light__card {
  display: inline-block;
  width: 516rpx;
  white-space: normal;
  vertical-align: top;
  margin-left: var(--cy-page-x);
  padding: var(--cy-space-3);
  background: var(--cy-bg-card);
  border: 1rpx solid var(--cy-border-card);
  border-radius: var(--cy-radius-md);
}
.topic .det6-light__card:last-child { margin-right: var(--cy-page-x); }
.topic .det6-light__card-top { display: flex; align-items: center; justify-content: space-between; }
.topic .det6-light__card-stars { display: flex; align-items: center; gap: 2rpx; }
.topic .det6-light__who { font-size: var(--cy-font-label); font-weight: 600; color: var(--cy-text-title); }
.topic .det6-light__when {
  display: block;
  margin-top: var(--cy-space-1);
  font-size: var(--cy-font-caption);
  color: var(--cy-text-muted);
}
.topic .det6-light__text {
  display: block;
  margin-top: var(--cy-space-2);
  font-size: var(--cy-font-label);
  line-height: var(--cy-leading-normal);
  color: var(--cy-text-body);
}

/* 稿 181:644 / 214:499「活动内容」：主题介绍下面的一串「这趟里都有什么」，
   一行一条、行首一个点。内容全部来自后端真字段，缺就少一条、都缺整块不出。 */
.topic-includes { margin-top: var(--cy-space-3); }
.topic-includes__t {
  margin-bottom: var(--cy-space-2);
  font-size: var(--cy-font-label);
  font-weight: 600;
  color: var(--cy-text-title);
}
.topic-includes__li {
  position: relative;
  padding-left: var(--cy-space-4);
  margin-bottom: var(--cy-space-1-5);
  font-size: var(--cy-font-label);
  line-height: var(--cy-leading-normal);
  color: var(--cy-text-body);
}
.topic-includes__li::before {
  content: '·';
  position: absolute;
  left: var(--cy-space-2);
}


/* ===== 稿 181:575 数据条(商家浅色;玩家深色版 214:384 是同一块) =====
   稿上的死数:格宽 104、格内 gap 4、小标题 11、大数字 19、格间一条 1×32 竖线。 */
.statbar {
  margin: var(--cy-space-3) var(--cy-page-x) 0;
  padding: 20rpx 16rpx;
  border-radius: var(--cy-radius-lg);
  background: var(--cy-bg-card);
  white-space: nowrap;
}
.statbar__row { display: flex; align-items: center; }
.statbar__cell {
  flex: none;
  width: 208rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}
.statbar__sep {
  flex: none;
  width: 1rpx;
  height: 64rpx;
  background: var(--cy-color-border-subtle);
}
.statbar__label { font-size: var(--cy-type-caption); color: var(--cy-text-secondary); }
.statbar__value {
  font-size: 38rpx;            /* ds-ok:稿 19px,card-title(16)与 sheet-title(22)之间没有这一档;为一个元素加全局 token 要同步六处,不值 */
  font-weight: 600;
  line-height: 1.1;
  color: var(--cy-text-title);
}
.statbar__sub { font-size: var(--cy-type-caption); color: var(--cy-text-secondary); }
.statbar__stars { display: flex; gap: 4rpx; color: var(--cy-color-status-warning); }

/* CU-M-89:「节点介绍」缺图时的占位块。尺寸仍由全局 .temp-list ... .pic 钉住
   (height 266rpx !important),这里只补底色与居中 —— 不写尺寸,免得与全局那一条打架。 */
.temp-list .li .item .pic--empty {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--cy-bg-subtle);
}

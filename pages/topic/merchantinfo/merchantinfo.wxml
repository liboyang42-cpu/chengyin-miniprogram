            <view class="davidbmtk_box_top_right_tit">自由探索模式</view>
            <view class="davidbmtk_box_top_right_con"><image lazy-load="true" src="/pages/topic/images/d_bmtk3.png" mode="widthFix" />灵活安排时间</view>

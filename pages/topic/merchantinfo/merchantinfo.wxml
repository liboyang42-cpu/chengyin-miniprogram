      </view>
      <view class="davidbmtk_box">
        <view class="davidbmtk_box_top">
          <view class="davidbmtk_box_top_left"><image lazy-load="true" src="/pages/topic/images/d_bmtk2.png" mode="widthFix" /></view>
          <view class="davidbmtk_box_top_right">
            <view class="davidbmtk_box_top_right_tit">城市定向模式</view>
            <view class="davidbmtk_box_top_right_con"><image lazy-load="true" src="/pages/topic/images/d_bmtk5.png" mode="widthFix" />固定时间出发</view>

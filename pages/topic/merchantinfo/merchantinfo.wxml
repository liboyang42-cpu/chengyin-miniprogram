  <!-- F3 选承接标的(稿 159:346):章节横滑 + 玩法模板横滑 + 「下一步 · 填报名」。
       选完直接把章节与玩法带进 chapter-node-form —— 稿上「下一步」就是那一屏。
       原来这一步是 topicShow 那个旧 pop,它把「选标的」和「我的申请管理」挤在一起,
       申请管理已经搬到主题正文,这里只剩选标的。 -->
  <cy-chapter-target-picker
    show="{{topicShow && selectedMode === 2}}"
    chapters="{{allChaptersList}}"
    chapters-state="{{chapterRecruitmentState}}"
    chapters-error="{{chapterRecruitmentError}}"
    application-open="{{chapterApplicationOpen}}"
    submitting="{{chapterNodeSubmitting}}"
    bind:close="topicClose"
    bind:confirm="onChapterTargetConfirm"
    bind:retrychapters="loadMerchantRecruitmentChapters"
    bind:gocategory="goMerchantCategory"
    bind:createtemplate="goCreateTemplate" />

  <node-npc-form
    show="{{nodeNpcFormVisible}}"
    node-id="{{nodeNpcNodeId}}"
    node-name="{{nodeNpcNodeName}}"
    bind:close="onNodeNpcFormClose" />

  <chapter-node-form
    show="{{chapterNodeFormVisible}}"
    chapterId="{{selectedChapterId}}"
    chapterName="{{selectedChapterText}}"
    presetNode="{{presetChapterNode}}"
    presetTemplateId="{{selectedTemplateId}}"
    presetTemplateName="{{selectedTemplateName}}"
    termsMode="{{selectedChapterTermsMode}}"
    circleMode="{{selectedChapterCircleMode}}"
    formMode="{{chapterNodeFormMode}}"
    submitting="{{chapterNodeSubmitting}}"
    bind:close="closeChapterNodeForm"
    bind:submit="onChapterNodeFormSubmit" />

  <!-- 一个主题开了多个场次时,「本站」入口先选一个。原来是系统 ActionSheet,
       2026-09-10 合流 master 后统一走 cy-option-sheet。
       ⚠️ 必须挂在 .theme-merchant 容器**里**——挂到外面商家浅色页会弹出玩家的黑弹窗。 -->
  <cy-option-sheet show="{{stationSheetShow}}" title="选择场次" items="{{stationSheetItems}}"
                   bind:select="onStationSheetSelect" bind:cancel="onStationSheetCancel" />
</view>
</view>

<cy-qr-voucher wx:if="{{checkinVisible}}"
  show="{{true}}"
  state="{{checkinQrState}}"
  qr="{{checkinQrUrl}}"
  title="本站打卡码"
  desc="请让玩家扫这一张。可下载到相册，贴在店里长期使用。"
  countdown=""
  error-text="{{checkinErr || '打卡码暂时没能生成'}}"
  secondary-text="{{checkinQrState === 'ready' ? '保存到相册' : ''}}"
  mask-closable="{{true}}"
  bind:close="closeLiveCheckin"
  bind:retry="issueStationPoster"
  bind:secondary="downloadCheckinQr" />
<cy-privacy-gate show="{{privacyGateShow}}" bind:settled="onPrivacyGateSettled" />

<!-- 危险动作三段式确认:文案来自 utils/danger-actions.js,页面只给 key -->
<!-- 同一个 #dc 现在承两条不可逆写(撤回申请 / 结束本章),按 e.detail.key 分流 -->
<cy-danger-confirm id="dc" bind:confirm="onDangerConfirm" bind:alt="onDangerAlt" />

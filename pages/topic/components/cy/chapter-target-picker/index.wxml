<!-- F3 选承接标的(Figma 159:346)。两组都横滑,底部一个「下一步 · 填报名」。
     T1 = cy-sheet 默认 bottom 半屏(full 只留给多步向导,见 sheet-halfscreen-glass-contract)。 -->
<cy-sheet show="{{show}}" title="申请承接章节" footer="{{true}}"
          closable="{{!submitting}}" bind:close="onClose">
  <view class="ctp">
    <view class="ctp-h">选择章节</view>
    <!-- 章节这一侧的四种取数结局分开说:拉取中 / 拉失败 / 没填品类 / 拉到了。
         合成一句「暂时没有开放的章节」会把「我还没读到」说成「主办方没开」。 -->
    <cy-skeleton wx:if="{{chaptersState === 'loading'}}" type="card" count="{{1}}" />
    <cy-error wx:elif="{{chaptersState === 'error'}}" title="可承接章节暂时没能加载"
              sub="{{chaptersError}}" retry="重试" bind:retry="onRetryChapters" />
    <cy-empty wx:elif="{{chaptersState === 'category-missing'}}" kind="no-permission" size="lg"
              title="请先完善商家品类" sub="平台按品类为你匹配可承接章节"
              cta="去完善品类" bind:cta="onGoCategory" />
    <scroll-view wx:else class="ctp-scroll" scroll-x enable-flex>
      <view class="ctp-card {{pickedChapterId === item.id ? 'is-on' : ''}}"
            wx:for="{{rows}}" wx:key="id" data-id="{{item.id}}" bindtap="onPickChapter"
            aria-role="button" aria-label="选择 {{item.name}}"
            hover-class="cy-pressed" hover-stay-time="80">
        <text class="ctp-card-t">{{item.name}}</text>
        <!-- 副信息只说后端真给了的事实(还缺几家 / 名额已满);拿不到就整行不出 -->
        <text class="ctp-card-s" wx:if="{{item.sub}}">{{item.sub}}</text>
      </view>
    </scroll-view>
    <cy-empty wx:if="{{chaptersState === 'ready' && !rows.length}}" kind="empty" size="lg"
              title="这条路线暂时没有开放的章节" sub="主办方开放章节招商后，这里会列出可申请的章节" />
    <!-- 选中章节的招募事实:品类 / 必选 / 条款 / 边界 / 名额 / 权益门槛。
         卡上放不下,但这是决定要不要接的依据,选中后必须看得到。 -->
    <view class="ctp-facts" wx:if="{{pickedFacts.length}}">
      <text class="ctp-fact" wx:for="{{pickedFacts}}" wx:key="*this">{{item}}</text>
    </view>

    <view class="ctp-h">选择玩法模板</view>
    <cy-skeleton wx:if="{{templatesState === 'loading'}}" type="card" count="{{1}}" />
    <!-- 读不到 ≠ 一个都没有:分开说,否则商家会去重新建一个自己已经有的玩法 -->
    <cy-error wx:elif="{{templatesState === 'error'}}" title="玩法模板没读出来"
              sub="{{templatesError}}" retry="重试" bind:retry="loadTemplates" />
    <cy-empty wx:elif="{{templatesState === 'empty'}}" kind="empty" size="lg"
              title="还没有可用的玩法" sub="先建一个玩法，回来就能选上"
              cta="去创建玩法" bind:cta="goCreateTemplate" />
    <scroll-view wx:else class="ctp-scroll" scroll-x enable-flex>
      <!-- 稿 159:346:封面方图是主体,名称与描述在图下方(不套卡) -->
      <view class="ctp-tpl {{pickedTemplateId === item.id ? 'is-on' : ''}}"
            wx:for="{{templates}}" wx:key="id" data-id="{{item.id}}" bindtap="onPickTemplate"
            aria-role="button" aria-label="选择玩法 {{item.title}}"
            hover-class="cy-pressed" hover-stay-time="80">
        <image class="ctp-tpl-img" wx:if="{{item.cover}}" src="{{item.cover}}" mode="aspectFill" />
        <view class="ctp-tpl-img ctp-tpl-img--fallback" wx:else><text>{{item.initial}}</text></view>
        <text class="ctp-tpl-t">{{item.title}}</text>
        <text class="ctp-tpl-s" wx:if="{{item.sub}}">{{item.sub}}</text>
      </view>
    </scroll-view>
  </view>

  <view slot="footer" class="ctp-foot">
    <!-- 玩法可以留到下一页再选(那一页也有同一个选择器),所以只有章节是必选的 -->
    <cy-btn variant="primary" style="width:100%" disabled="{{!pickedChapterId || submitting || !applicationOpen}}"
            bindtap="onNext">下一步 · 填报名</cy-btn>
    <!-- 章节错误/缺品类/全关已有各自的权威反馈,不能再把它们误说成主题招商窗口关闭。 -->
    <view class="ctp-foot-note" wx:if="{{!applicationOpen && chaptersState === 'ready' && rows.length}}">本条路线的招商窗口已关闭，暂时不能提交申请</view>
  </view>
</cy-sheet>

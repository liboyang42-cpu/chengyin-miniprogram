<!-- ===================== 结算页(Figma 3992:18005)=====================
     原 arrive「已收队」+ finish 拱形卡两屏合成这一张:时间行 + 标题/✕ + 巨号公里数 +
     六格数据 + 真轨迹图 + 主 CTA 分享。结算/上报的错误行保留在数据格下方 —— 屏换了错误不许跟着消失。 -->
<view class="settle" wx:if="{{screen=='arrive'}}">
  <scroll-view scroll-y class="settle__scroll">
    <view class="settle__meta" style="padding-top:{{chrome.actionTop}}px">{{finish.dateLine}}</view>
    <view class="settle__headrow">
      <text class="settle__title">{{finish.zone}} · 自由漫游</text>
      <view class="settle__x" bindtap="backToSquare" aria-role="button" aria-label="关闭结算页" hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="close" size="44" /></view>
    </view>
    <view class="settle__hr"></view>
    <!-- 大数字与格子按城瘾口径:探店/探索度/邮票/探索值/勋章 —— 时间与距离是跑步 App 的,不上(用户裁决) -->
    <text class="settle__big">{{finish.shops}}</text>
    <text class="settle__unit">家探店</text>
    <view class="settle__grid">
      <view class="sgc"><text class="sgc__v">{{finish.explorePct}}%</text><text class="sgc__l">探索度</text></view>
      <view class="sgc"><text class="sgc__v">{{finish.photos.length}}</text><text class="sgc__l">邮票</text></view>
      <view class="sgc"><text class="sgc__v">{{finish.xpAwarded > 0 ? '+' + finish.xpAwarded : 0}}</text><text class="sgc__l">探索值</text></view>
      <view class="sgc"><text class="sgc__v">{{(finish.medal ? 1 : 0) + (finish.shopMedal ? 1 : 0) || 0}}</text><text class="sgc__l">勋章 (枚)</text></view>
    </view>
    <!-- 结算提示:key 是 finish,不依赖角色名或头像(roam-ai 基座渲染位)。 -->
    <view class="roam-prompt-finish" wx:if="{{finish.routeStory}}">
      <text class="roam-prompt-label">这段足迹</text>
      <text class="roam-prompt-line">{{finish.routeStory}}</text>
    </view>
    <view class="roam-prompt-finish" wx:if="{{finish.roamPrompt && !finish.routeStory}}">
      <text class="roam-prompt-label">漫游提示</text>
      <text class="roam-prompt-line">{{finish.roamPrompt}}</text>
    </view>
    <scroll-view class="finish-stamps" wx:if="{{finish.photos.length}}" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="finish-stamp" wx:for="{{finish.photos}}" wx:key="path">
        <image src="{{item.path}}" mode="aspectFill"></image>
        <view class="finish-stamp__caption">{{item.name || '漫游打卡'}}</view>
      </view>
    </scroll-view>
    <view class="settle__err" wx:if="{{finish.settleErr}}">
      <cy-error title="{{finish.settleErr === 'reveal' ? '探索记录尚未确认，暂未结算' : '漫游结算需要核对'}}"
                sub="{{recoveryError || (finish.settleErr === 'reveal' ? '待确认的格子已保留，重试确认成功后继续结算' : '漫游记录已保留，确认活动进度后继续原结算')}}"
                retry="{{finish.settleErr === 'unknown' || finish.settleErr === 'bootstrap' || finish.settleErr === 'recovery' ? '核对结算结果' : '重新结算'}}" bind:retry="retrySettle" />
    </view>
    <view wx:if="{{recoveryCanContinue}}" class="settle__minor-act" bindtap="continueUnstartedRoam" aria-role="button" aria-label="继续本次探索" hover-class="cy-pressed" hover-stay-time="80">继续本次探索</view>
    <view class="settle__err" wx:if="{{finish.resultIncomplete}}">已确认本次探索值；历史结算缺少完整快照，无法核对当次勋章与回顾。</view>
    <view class="settle__err" wx:if="{{finish.eventErr}}">
      <cy-error title="{{finish.eventErr === 'unknown' ? '活动进度响应异常，请先核对' : '这次没能计入活动进度'}}"
                sub="{{finish.eventErr === 'unknown' ? '本次活动进度可能已经记入，请稍后重新进入查看，暂不要重复上报' : '漫游记录本身已保存,只是没上报到活动的集体进度'}}"
                retry="{{finish.eventErr === 'unknown' ? '' : '重新上报'}}" bind:retry="retryEventReport" />
    </view>
    <view class="settle__map">
      <free-map class="settle__map-native" scene="explore" center="{{center}}" scale="14"
                map-markers="{{markers}}" map-polyline="{{polyline}}"
                subkey="{{fmSubkey}}" layer-style="{{fmLayerStyle}}"
                show-controls="{{false}}" interactive="{{false}}" />
      <view class="settle__track-empty" wx:if="{{!polyline.length}}" aria-role="status" aria-label="{{trackTip}}">
        <cy-icon name="route" size="32" />
        <text>{{trackTip}}</text>
      </view>
      <view class="settle__chip">{{currentAddress}}</view>
    </view>
    <view class="settle__ctaw">
      <view class="settle__cta" bindtap="openShare" aria-role="button" aria-label="分享足迹卡" hover-class="cy-pressed" hover-stay-time="80">分享</view>
      <view class="settle__minor">
        <text class="settle__minor-act" bindtap="openPassport" aria-role="button" aria-label="查看漫游数据" hover-class="cy-pressed" hover-stay-time="80">查看漫游数据</text>
        <text class="settle__minor-sep">·</text>
        <text class="settle__minor-act" bindtap="backToSquare" aria-role="button" aria-label="返回广场" hover-class="cy-pressed" hover-stay-time="80">返回广场</text>
      </view>
    </view>
  </scroll-view>
</view>


<!-- ===================== C2 分享 sheet ===================== -->
<view class="roam-scene-host" wx:if="{{sceneCurrent && sceneCurrent.id === 'roam-share'}}" catchtouchmove="blockSceneTouch">
<view class="pdim {{sceneIn ? 'is-in' : ''}} {{reducedMotion ? 'is-reduced' : ''}}" bindtap="onProtoSheetClose" aria-role="button" aria-label="关闭{{sceneCurrent.title}}" hover-class="cy-pressed" hover-stay-time="80"></view>
<view class="psheet psheet--{{sceneCurrent.variant}} {{sceneIn ? 'is-in' : ''}} {{reducedMotion ? 'is-reduced' : ''}}" catchtap="noop">
  <view class="psheet__grab"></view>
  <view class="psheet__x" catchtap="onProtoSheetClose" aria-role="button" aria-label="关闭{{sceneCurrent.title}}" hover-class="cy-pressed" hover-stay-time="80"><view class="psheet__x-i"></view></view>
  <text class="ph1">{{sceneCurrent.title}}</text>
  <!-- 预览卡已删(用户裁决):结算页本身就是预览,sheet 只承载去哪儿分享 -->
  <view class="sharesheet">
  <!-- 发布可见性(Strava「Visibility / Who can view」同构):三档都是**真闸**,
       不放后端不认识的选项 —— 选中即决定下面哪几条渠道还能点。 -->
  <view class="sh-vis">
    <text class="sh-vis__label">谁能看到</text>
    <view class="sh-vis__segs">
      <view class="sh-vis__seg {{share.visibility === 'public' ? 'is-on' : ''}}" bindtap="onShareVisibility" data-v="public"
            aria-role="radio" aria-checked="{{share.visibility === 'public'}}" hover-class="cy-pressed" hover-stay-time="80">公开</view>
      <view class="sh-vis__seg {{share.visibility === 'friends' ? 'is-on' : ''}}" bindtap="onShareVisibility" data-v="friends"
            aria-role="radio" aria-checked="{{share.visibility === 'friends'}}" hover-class="cy-pressed" hover-stay-time="80">仅好友</view>
      <view class="sh-vis__seg {{share.visibility === 'private' ? 'is-on' : ''}}" bindtap="onShareVisibility" data-v="private"
            aria-role="radio" aria-checked="{{share.visibility === 'private'}}" hover-class="cy-pressed" hover-stay-time="80">仅自己</view>
    </view>
    <text class="sh-vis__hint">{{share.visibility === 'public' ? '发到广场，全站可见。' : (share.visibility === 'friends' ? '不进广场，存图后自己发朋友圈，只有好友看得到。' : '只存到相册，不发布到任何地方。')}}</text>
    <text class="sh-vis__hint">本次漫游记录始终保留在「我的漫游历史」，不受这里影响。</text>
  </view>
  <view class="sh-channels">
    <view class="sh-ch {{share.can.square ? '' : 'is-off'}}" bindtap="shareTo" data-ch="广场" hover-class="cy-pressed" hover-stay-time="80"><view class="sh-ci"><cy-icon name="tab-feed" size="36" /></view><text>{{share.squarePostUnknown?'广场 · 待核对':'广场'}}</text></view>
    <view class="sh-ch {{share.can.moments ? '' : 'is-off'}}" bindtap="shareTo" data-ch="朋友圈" hover-class="cy-pressed" hover-stay-time="80"><view class="sh-ci"><cy-icon name="share" size="36" /></view><text>朋友圈</text></view>
    <view class="sh-ch {{share.can.xhs ? '' : 'is-off'}}" bindtap="shareTo" data-ch="小红书" hover-class="cy-pressed" hover-stay-time="80"><view class="sh-ci"><cy-icon name="image" size="36" /></view><text>小红书</text></view>
    <view class="sh-ch {{share.can.save ? '' : 'is-off'}}" bindtap="shareTo" data-ch="保存" hover-class="cy-pressed" hover-stay-time="80"><view class="sh-ci"><cy-icon name="check" size="36" /></view><text>保存</text></view>
  </view>
  </view>
</view>
</view>


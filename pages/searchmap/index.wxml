<wxs src="../../utils/wxs/money.wxs" module="money" />
<!-- L2 Browse · Map + List(迁移矩阵 §5.1 / 模板库 §4.4)
     §4.4 三条:①地图与列表是同一数据集的两种表达 ②标记选中后底部 Sheet 展示对应对象
     ③地图不可用时必须能切换列表,不以地图作为唯一信息渠道 → 胶囊入口对 loading/empty/error 全态可达 -->

<!-- 活动卡片:全部结果 Sheet 与 选中对象 Sheet 共用一份标记(§4.3 禁止同类对象在不同列表重画) -->
<template name="actItem">
  <view class="item">
    <view class="item-pic">
      <view class="item-cat"><cy-tag variant="mono">{{item.mapPointLabel || '活动点位'}}</cy-tag></view>
      <image wx:if="{{item.imgUrl}}" lazy-load="true" bindtap="goActivity" aria-role="button" aria-label="打开活动详情" data-id="{{item.id}}" src="{{item.imgUrl}}" mode="aspectFill"  hover-class="cy-pressed" hover-stay-time="80"/>
      <view wx:else class="item-pic-ph"><cy-icon name="image" size="48" /></view>
      <view class="tags flex-ac">
        <cy-tag wx:for="{{item.sysCategoryList}}" wx:for-item="tag" wx:key="categoryName" variant="mono">{{tag.categoryName}}</cy-tag>
      </view>
    </view>
    <view class="item-txt" bindtap="goActivity" data-id="{{item.id}}" hover-class="cy-pressed" hover-stay-time="80">
      <view class="item-tit ep1">{{item.name}}</view>
      <view class="item-association" wx:if="{{item.topicId}}">关联主题路线</view>
      <view class="item-meta">
        <view class="item-meta-row">
          <cy-icon name="poi-landmark" size="24" />
          <text class="item-meta-txt ep1">{{item.address || '位置暂未提供'}}</text>
        </view>
        <view class="item-meta-row">
          <cy-icon name="clock" size="24" />
          <text class="item-meta-txt">{{item.startDate}} - {{item.endDate}}</text>
        </view>
      </view>
    </view>
  </view>
</template>

<view class="theme-dark">
  <cy-toast id="cy-toast" />
  <cy-loading-mask id="cy-loading" />
  <cy-modal-host id="cy-modal-host" />
<view class="smap">
  <map
    id="myMap"
    style="width: 100%; height: 100%;"
    latitude="{{latitude}}"
    longitude="{{longitude}}"
    scale="{{scale}}"
    markers="{{markers}}"
    bindtap="onMapTap"
    bindmarkertap="onMarkerTap"
    bindregionchange="onRegionChange"
    show-location
   hover-class="cy-pressed" hover-stay-time="80">
    <cover-view class="location-btn" bindtap="requestLocation" aria-role="button" aria-label="定位到当前位置" hover-class="cy-pressed" hover-stay-time="80" hover-stop-propagation="true">
      <cover-view class="location-btn__label">定位</cover-view>
    </cover-view>
    <cover-view wx:if="{{locationError}}" class="smap-location-error">
      <cover-view class="smap-location-error__message">{{locationMessage}}</cover-view>
      <cover-view class="smap-location-error__action" bindtap="recoverLocation" aria-role="button" aria-label="{{locationAction === 'open-setting' ? '打开设置开启定位权限' : '重新定位'}}" hover-class="cy-pressed" hover-stay-time="80" hover-stop-propagation="true">{{locationAction === 'open-setting' ? '去设置' : '重试定位'}}</cover-view>
    </cover-view>
  </map>
</view>

<!-- UI-14 返修(2026-09-18):返回/搜索/筛选在同一行,由 JS 按胶囊实测几何排版 ——
     行中心 = 胶囊中心(navTop),行右边界 = 胶囊左缘 - 页面边距(navRight),
     左内边距的 12rpx 补偿见 .smapso(88rpx 命中盒里的 64rpx 视觉圆仍锚在页面边距上)。
     行内三件按 flex 垂直居中,不再各自用绝对定位 + 光学补偿对表。 -->
<view class="smapso" style="padding-top:{{navTop}}px; padding-right:{{navRight}}px;">
  <view class="smapso_bar">
    <view class="smap-back" bindtap="goBack" aria-role="button" aria-label="返回" hover-class="cy-pressed" hover-stay-time="80">
      <view class="smap-back-visual">
        <cy-icon name="back" size="32" />
      </view>
    </view>
    <cy-search class="smapso_search" value="{{searchKeyword}}" placeholder="搜索路线、地点等" loading="{{listState === 'loading'}}" bind:input="onKeywordInput" bind:confirm="onSearchConfirm" />
    <cy-btn variant="ghost" size="xs" class="smapso_filter cy-btn-inline" accessibility-label="筛选地图结果" aria-role="button" aria-label="筛选地图结果" bindtap="popShow"><cy-icon name="filter" size="36" /></cy-btn>
  </view>
  <!-- UI-14:删掉「活动 / 开启定位后显示附近据点」两枚图例胶囊 —— 用户明确要求地图上不要提示词。
       无定位的商家据点闸仍照旧不发请求(merchantNodeNeedLocation 只做状态,不再渲染提示)。 -->
</view>

<view class="smap-offline" style="top:{{statusBarHeight + 64}}px;">
  <cy-offline-banner wx:if="{{offline}}" message="{{offlineMessage}}"
                     cacheTime="{{lastListUpdatedText}}" action="重试连接"
                     bind:action="retryNetwork" />
</view>

<!-- 结果入口胶囊:四态可达(§4.4③ 地图不是唯一信息渠道;错误/空态在此可见且可恢复) -->
<view class="smap-listbtn smap-listbtn--{{listState}}" wx:if="{{!locationError && !bmShow && !selShow && !popVisible}}"
      bindtap="openList" aria-role="button" aria-label="{{capsuleText}}，打开地图结果列表" hover-class="cy-pressed" hover-stay-time="80">
  <cy-icon wx:if="{{listState === 'error'}}" name="warning" size="24" />
  <view wx:if="{{listState === 'loading'}}" class="smap-listbtn__spinner"></view>
  <text>{{capsuleText}}</text>
  <text wx:if="{{listState === 'ready' && noCoordCount > 0}}" class="smap-listbtn-sub"> · {{ noCoordCount || 0 }} 个活动只在列表显示</text>
</view>

<!-- 全部结果 -->
<cy-sheet show="{{bmShow}}" title="{{listState === 'ready' ? '全部 ' + list.length + ' 个结果' : '搜索结果'}}" bind:close="bmClose">
  <text class="smap-sync" wx:if="{{merchantNodesRefreshing && merchantNodes.length}}"
        aria-role="status" aria-live="polite">正在更新商家点位…</text>
  <cy-error wx:if="{{listState === 'error'}}" title="活动没能加载出来" sub="{{errorMsg}}" bind:retry="onRetry" />
  <cy-empty wx:elif="{{listState === 'empty'}}" title="这一带还没有活动" sub="换个关键词，或拖动地图看看别处" />
  <cy-skeleton wx:elif="{{listState === 'loading'}}" type="map-card" count="3" />
  <block wx:else>
    <text class="smap-sync" wx:if="{{listRefreshing && list.length}}"
          aria-role="status" aria-live="polite">正在更新地图结果…</text>
    <cy-inline-error wx:if="{{pageError && list.length}}" kind="network"
                     title="{{pageErrorIsRefresh ? '这次刷新没有成功' : '更多活动没加载出来'}}"
                     sub="{{pageErrorIsRefresh ? '屏幕上还是上一次的结果，点重试再拉一次' : '已加载的活动和地图点位仍可查看'}}"
                     action="{{pageErrorIsRefresh ? '重试刷新' : '重试这一页'}}" bind:action="retryListPage" />
    <view class="smap-listtip" wx:if="{{noCoordCount > 0}}">其中 {{ noCoordCount || 0 }} 个活动暂未提供位置，只在列表中显示</view>
    <swiper indicator-dots="{{true}}" autoplay="{{false}}">
      <swiper-item wx:for="{{list}}" wx:key="id">
        <template is="actItem" data="{{item}}" />
      </swiper-item>
    </swiper>
    <!-- A-RPT-7:刷新失败(pageErrorIsRefresh)只说明屏上还是上次结果,翻页并没失败 ——
         那一条 pageError 不许把「加载更多」也一起藏掉。 -->
    <view class="smap-more" wx:if="{{hasMore && (!pageError || pageErrorIsRefresh)}}">
      <cy-btn wx:if="{{hasMore}}" variant="ghost" bindtap="loadMoreResults"
              loading="{{loadingMore}}" disabled="{{loadingMore}}">{{loadingMore ? '正在加载' : '加载更多'}}</cy-btn>
    </view>
  </block>
</cy-sheet>

<!-- 选中标记对应的对象(§4.4②) -->
<cy-sheet show="{{selShow}}" title="{{selected.name || '活动'}}" bind:close="selClose">
  <template is="actItem" data="{{item: selected}}" />
  <view class="smap-sel-cta">
    <cy-btn variant="primary" bindtap="goActivity" data-id="{{selected.id}}">查看活动详情</cy-btn>
    <cy-btn wx:if="{{selected.topicId}}" variant="ghost" bindtap="goTopic" data-id="{{selected.topicId}}">查看关联主题</cy-btn>
  </view>
</cy-sheet>

<!-- 筛选(§11:Modal 走共享组件,原 .screen/.pop-cont 私有弹层已删) -->
<cy-sheet show="{{popVisible}}" title="筛选" bind:close="popClose">
  <view class="form-main">
    <view class="dl">
      <view class="dt">商家发现</view>
      <view class="smap-merchant-fields">
        <view class="smap-merchant-picker" bindtap="openMerchantCategorySheet" hover-class="cy-pressed" hover-stay-time="80">{{merchantCategoryLabel || '全部品类'}}</view>
        <input value="{{filterConditions.tag}}" placeholder="探索标签" bindinput="onMerchantTagInput" />
        <input value="{{filterConditions.cityRole}}" placeholder="城市角色" bindinput="onMerchantRoleInput" />
      </view>
    </view>
    <!-- 日期筛选 -->
    <view class="dl">
      <view class="dt">日期</view>
      <view class="cont">
        <view class="dd {{activeDate === '1' ? 'active' : ''}}" bindtap="selectDate" data-value="1" hover-class="cy-pressed" hover-stay-time="80">
          <view class="tit">今天</view>
          <cy-icon wx:if="{{activeDate === '1'}}" class="ck" name="check" size="40" />
        </view>
        <view class="dd {{activeDate === '2' ? 'active' : ''}}" bindtap="selectDate" data-value="2" hover-class="cy-pressed" hover-stay-time="80">
          <view class="tit">明天</view>
          <cy-icon wx:if="{{activeDate === '2'}}" class="ck" name="check" size="40" />
        </view>
        <view class="dd {{activeDate === '3' ? 'active' : ''}}" bindtap="selectDate" data-value="3" hover-class="cy-pressed" hover-stay-time="80">
          <view class="tit">选择日期</view>
          <cy-icon wx:if="{{activeDate === '3'}}" class="ck" name="check" size="40" />
        </view>

        <view class="riqi flex-ac" wx:if="{{activeDate === '3'}}">
          <cy-icon name="calendar" size="32" />
          <view class="picker_group flex-ac">
            <view class="picker" data-field="startdate" bindtap="openDatePicker" hover-class="cy-pressed" hover-stay-time="80">
              <text class="{{startdate=='开始日期'?'text-style1':'text-style2'}}">{{startdate}}</text>
            </view>
            <text class="text-style1">-</text>
            <view class="picker" data-field="enddate" bindtap="openDatePicker" hover-class="cy-pressed" hover-stay-time="80">
              <text class="{{enddate=='结束日期'?'text-style1':'text-style2'}}">{{enddate}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 价格筛选 -->
    <view class="dl dl2">
      <view class="dt">价格</view>
      <view class="price flex-b">
        <view class="li">
          <view class="tit">最低区间</view>
          <view class="cont">
            <input type="text" value="{{jg1}}" bindinput="onMinPriceInput" />
          </view>
        </view>
        <view class="li">
          <view class="tit">最高区间</view>
          <view class="cont">
            <input type="text" value="{{jg2}}" bindinput="onMaxPriceInput" />
          </view>
        </view>
      </view>

      <!-- 双向滑动价格滑块 -->
      <view class="slider-container">
        <view class="slider-track"></view>
        <view class="slider-range" style="{{sliderRangeStyle}}"></view>
        <view class="slider-handle min-handle" style="{{minHandleStyle}}" bindtouchmove="onMinSliderMove" data-type="min"></view>
        <view class="slider-handle max-handle" style="{{maxHandleStyle}}" bindtouchmove="onMaxSliderMove" data-type="max"></view>
      </view>

      <view class="price-range-tip">
        价格区间：{{money.amount(priceRange.min)}} - {{money.amount(priceRange.max)}}
      </view>
    </view>

    <!-- 排序 -->
    <view class="dl">
      <view class="dt">排序</view>
      <view class="cont">
        <view class="dd {{activeSort === '1' ? 'active' : ''}}" bindtap="selectSort" data-value="1" hover-class="cy-pressed" hover-stay-time="80">
          <view class="tit">最近</view>
          <cy-icon wx:if="{{activeSort === '1'}}" class="ck" name="check" size="40" />
        </view>
        <view class="dd {{activeSort === '2' ? 'active' : ''}}" bindtap="selectSort" data-value="2" hover-class="cy-pressed" hover-stay-time="80">
          <view class="tit">最热</view>
          <cy-icon wx:if="{{activeSort === '2'}}" class="ck" name="check" size="40" />
        </view>
      </view>
    </view>
  </view>

  <view class="form-btn">
    <cy-btn class="form-btn__item" variant="ghost" bindtap="resetFilter">重置</cy-btn>
    <cy-btn class="form-btn__item" variant="primary" bindtap="searchFilter">搜索</cy-btn>
  </view>
</cy-sheet>

<cy-category-sheet show="{{merchantCategorySheetVisible}}" type="{{1}}" num="{{1}}"
  ids="{{filterConditions.categoryId || ''}}" bind:select="onMerchantCategoryChange" bind:close="closeMerchantCategorySheet" />

<cy-date-sheet show="{{dateSheetVisible}}" title="{{datePickerTitle}}" dark="{{true}}"
  bind:cancel="cancelDatePicker" bind:confirm="confirmDatePicker">
    <picker-view class="date-picker-view pw-wheel" value="{{datePickerValue}}" indicator-style="height:88rpx; border-top:1rpx solid rgba(128,128,128,0.45); border-bottom:1rpx solid rgba(128,128,128,0.45);" mask-style="background: transparent;" bindchange="onDatePickerChange">
      <picker-view-column>
        <view class="date-picker-item" wx:for="{{datePickerYears}}" wx:key="*this">{{ item || 0 }}年</view>
      </picker-view-column>
      <picker-view-column>
        <view class="date-picker-item" wx:for="{{datePickerMonths}}" wx:key="*this">{{ item || 0 }}月</view>
      </picker-view-column>
      <picker-view-column>
        <view class="date-picker-item" wx:for="{{datePickerDays}}" wx:key="*this">{{ item || 0 }}日</view>
      </picker-view-column>
    </picker-view>
</cy-date-sheet>
</view>
<cy-privacy-gate show="{{privacyGateShow}}" bind:settled="onPrivacyGateSettled" />

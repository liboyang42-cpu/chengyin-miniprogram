/* 2026-07-31:根链改 flex column + min-height:100vh,交给 cy-empty/cy-error 的 fill 变体
   在"标题下方到屏幕底部"这段剩余空间里居中,替换掉原来 .detail-state 自己猜的 min-height:48vh。 */
page{
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}
.detail{ width: 100%; overflow: hidden; display: flex; flex-direction: column; flex: 1; }
/* cy-empty/cy-error 是 styleIsolation:isolated 组件,宿主标签默认 display:block,
   组件内部的 flex:1 要宿主自己也是 flex 容器才生效,从页面外部补一层。 */
.fill-slot{ display: flex !important; flex-direction: column !important; flex: 1 !important; min-height: 0 !important; }

.detail-nav-spacer { flex: none; }

/* 详情数据尚不可用时仍保留层级与可返回路径，避免无 id 直开落成头像/动作空壳。
   自身不再猜 min-height,交给内部 fill 变体的 cy-empty/cy-error 吃满剩余空间并居中。 */
.detail-state {
  padding: 0 var(--cy-page-x);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  flex: 1;
  gap: var(--cy-space-4);
}

/* 评论输入占位色:原先由 WXML 的 placeholder-style 写死一个字面灰(C01 文档 P0-G) */
.comment-ph { color: var(--cy-text-placeholder); }

.comment-load-more-status {
  padding: var(--cy-space-3) var(--cy-page-x);
  color: var(--cy-text-secondary);
  font-size: var(--cy-font-caption);
  text-align: center;
}
/* 评论提交态。稿(379:2564)的评论条没有发送键,所以在途反馈长在输入框上:
   发送中 → 输入框禁用 + placeholder 改「正在发送…」+ 右侧一个转圈;
   空输入 → 输入框整体收敛(is-idle),替代原来发送键的 disabled 视觉。 */
.david_npl_right { position: relative; }
.david_npl_right.is-idle { opacity: .82; }
.david_npl_right.is-sending .comment-ph { color: var(--cy-color-text-tertiary); }
/* 不做转圈:motion-property-ratchet 是「只减不增」,为一个 loading 点自增一组 @keyframes
   不划算;而 placeholder 已经改成「正在发送…」,这里补一个静态文字标即可,
   它同时是 aria-live 的宿主(读屏要念的那句原来挂在已删的发送按钮上)。 */
.comment-sending {
  position: absolute;
  right: var(--cy-space-3);
  top: 50%;
  transform: translateY(-50%);
  pointer-events: none;
  font-size: var(--cy-font-caption);
  color: var(--cy-color-text-tertiary);
}

.comment-submit-feedback {
  position: fixed;
  left: var(--cy-page-x);
  right: var(--cy-page-x);
  bottom: calc(120rpx + env(safe-area-inset-bottom));
  z-index: 12;
}

/* 图片横向滚动区域 */
.detail .row3-scroll-wrapper {
  margin-bottom: var(--cy-space-2-5);
  width: 100%;
}

.detail .row3-scroll {
  width: 100%;
  white-space: nowrap;
  height: 600rpx; /* 调整为600rpx，与JS中的imageHeight保持一致 */
}

.detail .row3-scroll .row3-images {
  display: flex;
  height: 100%;
  align-items: center;
  padding-right: var(--cy-space-3-5);
}

.detail .row3-scroll .row3-images .scroll-image {
  display: inline-block;
  vertical-align: middle;
  flex-shrink: 0;
  object-fit: contain;
  margin-right: var(--cy-legacy-10); /* 图片间距 */
  border-radius: 10px; /* 5px圆角 */
  background-color: var(--cy-bg-page);
  /* 确保图片高度占满容器 */
  max-height: 100%;
}

/* 确保最后一个图片没有右边距 */
.detail .row3-scroll .row3-images .scroll-image:last-child {
  margin-right: 0;
}

/* 移除旧的row3样式 */
.detail .row3.scroll {
  overflow-x: auto;
  margin-right: calc(var(--cy-space-3-5) * -1);
  height: auto; /* 改为自动高度 */
  padding-bottom: var(--cy-space-2);
  display: flex;
  align-items: center;
}

/* 移除旧的图片样式 */
/* .detail .row3 image {
  width: 96%; 
  margin-right: 2%;  
  height: 100%;
  flex-shrink:0;
} */

/* 以下是原有样式保持不变 */
.detail .row1 .fl .user {
  position: relative;
  margin-right: var(--cy-space-3);
  width: 69rpx;
  height: 69rpx;
}

.detail .row1 .fl .user image {
  width: 69rpx;
  height: 69rpx;
  border-radius: 50%;
}

.detail .row1 .fl .user .jia {
  width: 31rpx;
  height: 31rpx;
  border-radius: 50%;
  position: absolute;
  bottom: -5rpx;
  right: -5rpx;
  background: var(--cy-btn-solid-bg);
  color: var(--cy-text-inverse);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid var(--cy-border-card);
}

.detail .row1 .fl .user .jia image {
  /* icon_jia.png 本身是纯白像素(实测 RGB=255,255,255)。这颗徽标底色是白实心
     (--cy-btn-solid-bg,或玩家域去紫后的 --cy-brand),白图标压白底会整个看不见——
     base 规则其实早就这样了(既有缺陷),玩家域 brand 去紫后波及面变大,一并按黑图标修。 */
  filter: brightness(0);
  width: 13rpx;
  height: 13rpx;
}

.detail .row1 .fl .uname {
  font-size: var(--cy-font-label);
  font-weight: bold;
}

.detail .row1 .fl .uname image {
  width: 23rpx;
  height: 23rpx;
  margin-left: var(--cy-legacy-10);
}

.detail .row1 .fl .time {
  font-size: var(--cy-font-caption);
  color: var(--cy-text-secondary);
  margin-left: var(--cy-space-1-5);
}

.detail .row1 .gz {
  width: 131rpx;
  height: 46rpx;
  font-size: var(--cy-font-label);
  border: 2rpx solid var(--cy-border-line);
  border-radius: var(--cy-radius-sm);
  font-weight: bold;
}

.detail .row2 {

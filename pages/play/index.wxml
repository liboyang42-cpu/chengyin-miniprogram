<view class="psheet psheet--{{sceneCurrent.variant}} {{sceneIn ? 'is-in' : ''}} {{reducedMotion ? 'is-reduced' : ''}}" catchtap="noop">
  <view class="psheet__grab"></view>
  <view class="psheet__x" catchtap="onProtoSheetClose" aria-role="button" aria-label="关闭{{sceneCurrent.title}}" hover-class="cy-pressed" hover-stay-time="80"><view class="psheet__x-i"></view></view>
  <text class="ph1">{{sceneCurrent.title}}</text>
    <cy-scene-qr-group-code activity-id="{{sceneCurrent.params.activityId}}" topic-id="{{sceneCurrent.params.topicId}}" name="{{sceneCurrent.params.name}}" bind:close="backScene" />
</view>
</view>
<view class="play-scene-host" wx:if="{{sceneCurrent && sceneCurrent.id === 'qr-citynode'}}" catchtouchmove="blockSceneTouch">
<view class="pdim {{sceneIn ? 'is-in' : ''}} {{reducedMotion ? 'is-reduced' : ''}}" bindtap="onProtoSheetClose" aria-role="button" aria-label="关闭{{sceneCurrent.title}}" hover-class="cy-pressed" hover-stay-time="80"></view>
<view class="psheet psheet--{{sceneCurrent.variant}} {{sceneIn ? 'is-in' : ''}} {{reducedMotion ? 'is-reduced' : ''}}" catchtap="noop">
  <view class="psheet__grab"></view>
  <view class="psheet__x" catchtap="onProtoSheetClose" aria-role="button" aria-label="关闭{{sceneCurrent.title}}" hover-class="cy-pressed" hover-stay-time="80"><view class="psheet__x-i"></view></view>
  <text class="ph1">{{sceneCurrent.title}}</text>
    <cy-scene-qr-citynode poi-id="{{sceneCurrent.params.poiId}}" name="{{sceneCurrent.params.name}}" bind:close="backScene" />
</view>
</view>

<view class="play-scene-host" wx:if="{{sceneCurrent && sceneCurrent.id === 'qr-ticket'}}" catchtouchmove="blockSceneTouch">
<view class="pdim {{sceneIn ? 'is-in' : ''}} {{reducedMotion ? 'is-reduced' : ''}}" bindtap="onProtoSheetClose" aria-role="button" aria-label="关闭{{sceneCurrent.title}}" hover-class="cy-pressed" hover-stay-time="80"></view>
<view class="psheet psheet--{{sceneCurrent.variant}} {{sceneIn ? 'is-in' : ''}} {{reducedMotion ? 'is-reduced' : ''}}" catchtap="noop">
  <view class="psheet__grab"></view>
  <view class="psheet__x" catchtap="onProtoSheetClose" aria-role="button" aria-label="关闭{{sceneCurrent.title}}" hover-class="cy-pressed" hover-stay-time="80"><view class="psheet__x-i"></view></view>
  <text class="ph1">{{sceneCurrent.title}}</text>
    <cy-scene-qr-ticket registration-id="{{sceneCurrent.params.registrationId}}" bind:close="backScene" />
</view>
</view>
<view class="play-scene-host" wx:if="{{sceneCurrent && sceneCurrent.id === 'roam-stamp-album'}}" catchtouchmove="blockSceneTouch">
<view class="pdim {{sceneIn ? 'is-in' : ''}} {{reducedMotion ? 'is-reduced' : ''}}" bindtap="onProtoSheetClose" aria-role="button" aria-label="关闭{{sceneCurrent.title}}" hover-class="cy-pressed" hover-stay-time="80"></view>
<view class="psheet psheet--{{sceneCurrent.variant}} {{sceneIn ? 'is-in' : ''}} {{reducedMotion ? 'is-reduced' : ''}}" catchtap="noop">
  <view class="psheet__grab"></view>
  <view class="psheet__x" catchtap="onProtoSheetClose" aria-role="button" aria-label="关闭{{sceneCurrent.title}}" hover-class="cy-pressed" hover-stay-time="80"><view class="psheet__x-i"></view></view>
  <text class="ph1">{{sceneCurrent.title}}</text>
    <cy-scene-roam-stamp-album bind:camera="openStampCameraFromScene" bind:close="closeScene" />
</view>
</view>
<cy-modal show="{{sceneConfirm.show}}" title="放弃未保存修改？" content="关闭后，本次修改不会保留。" confirm-text="放弃修改" cancel-text="继续编辑" danger bind:confirm="confirmSceneDiscard" bind:cancel="cancelSceneDiscard" />

<!-- 剧情全屏叙事页(两段式第二段)。
     刻意放在 .play 之外:Scale+Dim 要把 .play 缩到 0.94,而 transform 会让内部的
     position:fixed 改以 .play 为包含块 —— 放里面的话这层会跟着一起缩。 -->
<cy-story-sheet
  show="{{story.show}}"
  title="{{story.title}}"
  step="{{story.step}}"
  cover="{{story.cover}}"
  text="{{story.text}}"
  reduced="{{reducedMotion}}"
  bind:close="closeStory"
/>

<!-- 隐私授权闸(真弹窗):页内组件,不压页面栈。app.js 在需要授权时调本页 showPrivacyGate()。 -->
<cy-privacy-gate show="{{privacyGateShow}}" bind:settled="onPrivacyGateSettled" />


<!-- 升级2:俱乐部局角色卡(首入本场弹一次;v5 语言:scrim + 玻璃卡 + 翻入动画) -->
<view class="rolemask" wx:if="{{roleCard.show}}" bindtap="closeRoleCard" aria-role="button" aria-label="关闭身份卡" hover-class="cy-pressed" hover-stay-time="80"></view>
<!-- v5.1/v5.2 新玩法分发器:kit 由 cy-advanced-game 抛上来的权威会话视图派生
     (见 utils/playkit-view.js)。这些壳是独立 sheet,套不进面板自己那层 sheet,所以渲染在这里。 -->
<cy-playkit id="playKit" kit="{{playKit.kit}}" show="{{playKit.show}}" bind:kitaction="onPlayKitAction" />

<!-- R14 旅程检定(入口在 encounter.allowedActions,与 playKit 是两套;
     失败也推进:结算前后都能退出,不拦节点完成) -->
<cy-playkit-journey-check show="{{journeyCheck.show}}" loading="{{journeyCheck.loading}}"
  skill="{{journeyCheck.skill}}" tier="{{journeyCheck.tier}}" mods="{{journeyCheck.mods}}"
  advantage="{{journeyCheck.advantage}}" disadvantage="{{journeyCheck.disadvantage}}"
  receipt="{{journeyCheck.receipt}}"
  bind:action="onJourneyCheckAction" bind:close="closeJourneyCheck" />

<view class="rolecard" wx:if="{{roleCard.show}}">
  <view class="rolecard__tag">今晚的身份</view>
  <view class="rolecard__emb"><cy-icon name="{{roleCard.iconName}}" size="72" /></view>
  <view class="rolecard__name">{{roleCard.name}}</view>
  <view class="rolecard__desc">{{roleCard.desc}}</view>
  <view class="rolecard__skill" wx:if="{{roleCard.skill}}"><cy-icon name="star" size="28" /><text>{{roleCard.skill}}</text></view>
  <view class="rolecard__skill" wx:if="{{gameModule.write.status === 'unknown' || gameModule.write.status === 'error'}}">{{gameModule.write.message}}</view>
  <view class="rolecard__cta" wx:if="{{roleCard.confirmed || (gameModule.enabled && gameModule.activityId)}}" bindtap="confirmPlayerRole" aria-role="button"
        aria-label="{{roleCard.confirmed ? '关闭身份卡' : (gameModule.write.status === 'unknown' ? '核对身份确认结果' : '确认本局身份')}}" hover-class="cy-pressed" hover-stay-time="80">
    {{roleCard.confirmed ? '接下身份，出发' : (gameModule.write.status === 'submitting' ? '正在确认…' : (gameModule.write.status === 'unknown' ? '核对结果' : '确认身份'))}}
  </view>
  <view wx:else>
    <view class="rolecard__skill">本局身份还在准备中，稍后再试</view>
    <view class="rolecard__retry" bindtap="retryGameModule" aria-role="button" aria-label="重新加载本局身份" hover-class="cy-pressed" hover-stay-time="80">重新加载</view>
  </view>
  <view class="rolecard__retry" wx:if="{{gameModule.write.status === 'unknown' && gameModule.write.canRetry}}" bindtap="retryPlayerUnknownWrite"
        aria-role="button" aria-label="用原请求号重试身份确认" hover-class="cy-pressed" hover-stay-time="80">重试原操作</view>
</view>

<block wx:if="{{gameModule.sheetShow}}">
<view class="mask" bindtap="closeGameModule" aria-role="button" aria-label="关闭本局线索" hover-class="cy-pressed" hover-stay-time="80"></view>
<view class="sheet" catchtap="noop">
  <view class="sheet-grab"></view>
  <view class="sheet__x" catchtap="closeGameModule" aria-role="button" aria-label="关闭本局线索" hover-class="cy-pressed" hover-stay-time="80"><view class="sheet__x-i"></view></view>
  <view class="sheet-body">
    <view class="sheet-name">本局线索</view>
  <view class="gmod" wx:if="{{gameModule.sheetShow}}">
    <view class="gmod__error" wx:if="{{gameModule.error && !gameModule.stale}}">
      <cy-icon name="warning" size="32" />
      <text>{{gameModule.error}}</text>
      <view class="gmod__retry" bindtap="retryGameModule" aria-role="button" aria-label="重新同步本局状态" hover-class="cy-pressed" hover-stay-time="80">重新同步</view>
    </view>
    <block wx:else>
      <view class="gmod__stale" wx:if="{{gameModule.stale}}">
        <cy-icon name="warning" size="32" />
        <text>同步失败，正在显示旧数据。旧数据更新于 {{gameModule.snapshotAt}}</text>
        <view class="gmod__retry" bindtap="retryGameModule" aria-role="button" aria-label="重试同步本局状态" hover-class="cy-pressed" hover-stay-time="80">重试同步</view>
      </view>
      <view class="gmod__role">
        <text class="gmod__eyebrow">我的身份</text>
        <text class="gmod__role-name">{{gameModule.role.name || '待俱乐部分配'}}</text>
        <text class="gmod__sync" wx:if="{{gameModule.snapshotAt}}">状态更新于 {{gameModule.snapshotAt}}</text>
      </view>
      <view class="gmod__write gmod__write--{{gameModule.write.status}}" wx:if="{{gameModule.write.status !== 'idle'}}">
        <text>{{gameModule.write.message}}</text>
        <view class="gmod__write-actions" wx:if="{{gameModule.write.status === 'unknown'}}">
          <view class="gmod__reconcile" bindtap="reconcilePlayerChoice"
                aria-role="button" aria-label="核对这次操作的结果" hover-class="cy-pressed" hover-stay-time="80">核对结果</view>
          <view class="gmod__reconcile" wx:if="{{gameModule.write.canRetry}}" bindtap="retryPlayerUnknownWrite"
                aria-role="button" aria-label="用原请求号重试这次操作" hover-class="cy-pressed" hover-stay-time="80">重试原操作</view>
        </view>
      </view>
      <view class="gmod__team" wx:if="{{gameModule.teamActions.length}}">
        <text class="gmod__eyebrow">队伍协作</text>
        <view class="gmod__team-row" wx:for="{{gameModule.teamActions}}" wx:key="memberId">
          <view class="gmod__team-copy">
            <text>{{item.displayName || '队友'}}</text>
            <text class="gmod__team-role">{{item.roleCode}}</text>
          </view>
          <text class="gmod__team-status">{{item.statusLabel}}</text>
        </view>
        <text class="gmod__privacy">这里只显示协作状态，不公开队友精确位置。</text>
      </view>
      <view class="gmod__leaderboard" wx:if="{{gameModule.leaderboard}}">
        <text class="gmod__eyebrow">本局榜单</text>
        <view class="gmod__leaderboard-row" wx:for="{{gameModule.leaderboard.entries}}" wx:key="teamId">
          <text class="gmod__leaderboard-rank">{{item.rank}}</text>
          <text class="gmod__leaderboard-name">{{item.displayName || '队伍'}}</text>
          <text class="gmod__leaderboard-score">{{item.score}} 次协作</text>
        </view>
        <cy-empty wx:if="{{!gameModule.leaderboard.entries.length}}" size="sm" title="本局榜单已开启" sub="暂时还没有有效协作记录" />
      </view>
      <view class="gmod__node" wx:for="{{gameModule.nodes}}" wx:key="nodeId">
        <view class="gmod__node-head">
          <text>节点 {{index + 1}}</text>
          <text class="gmod__status"
                wx:if="{{item.status === 'FALLBACK_COMPLETED' || item.completionStatus === 'FALLBACK_COMPLETED'}}">
            兜底完成 · 不计正常榜单分
          </text>
          <text class="gmod__status" wx:else>{{item.status}}</text>
        </view>
        <!-- R9-38:暂停不再只在有兜底路线时才说话。原因/预计恢复/退款去处是暂停本身的
             对外契约,与有没有替代行动无关;兜底路线仍然只在服务端批准时才有。 -->
        <view class="gmod__task-evidence" wx:if="{{item.status === 'PAUSED'}}">
          <text class="gmod__task-evidence-label">{{item.fallback ? '本站暂停 · 已启用替代行动' : '本站暂停'}}</text>
          <text class="gmod__task-evidence-status" wx:if="{{item.pause.reason}}">原因 · {{item.pause.reason}}</text>
          <text class="gmod__task-evidence-status" wx:if="{{item.pause.resumeEta}}">预计恢复 · {{item.pause.resumeEta}}</text>
          <text class="gmod__task-evidence-status" wx:if="{{item.fallback}}">{{item.fallback.playerMessage}}</text>
          <text class="gmod__task-evidence-status" wx:if="{{item.fallback}}">前往 {{item.fallback.targetNodeName}} · {{item.fallback.planCode}} v{{item.fallback.planVersion}}</text>
          <text class="gmod__task-evidence-status">如需退款请联系平台客服</text>
        </view>
        <text class="gmod__clue" wx:if="{{item.clue}}">{{item.clue}}</text>
        <view class="gmod__empty" wx:elif="{{item.status === 'LOCKED'}}">完成前置节点后才会下发本角色线索</view>
        <view class="gmod__task-evidence" wx:if="{{item.revealedAnswer}}">
          <text class="gmod__task-evidence-status">答案 · {{item.revealedAnswer}}</text>
        </view>
        <view class="gmod__task" wx:if="{{item.playerTask}}">
          <text class="gmod__task-title">本站任务</text>
          <text class="gmod__task-prompt">{{item.playerTask.prompt}}</text>
          <view class="gmod__task-evidence" wx:if="{{item.hint}}">
            <text class="gmod__task-evidence-status"
                  wx:for="{{item.hint.revealedTexts}}" wx:for-item="hintText" wx:key="level">
              提示 {{hintText.level}} · {{hintText.text}}
            </text>
            <block wx:if="{{item.hint.nextLevel && item.hint.nextImpactLabel}}">
              <text class="gmod__task-evidence-label">{{item.hint.nextImpactLabel}}</text>
              <view class="gmod__task-capture"
                    data-node="{{item.nodeId}}" data-level="{{item.hint.nextLevel}}" bindtap="requestPlayerHint"
                    aria-role="button" aria-label="查看第 {{item.hint.nextLevel}} 级提示：{{item.hint.nextImpactLabel}}" hover-class="cy-pressed" hover-stay-time="80">
                查看第 {{item.hint.nextLevel}} 级提示
              </view>
            </block>
            <block wx:if="{{item.hint.revealAvailable && item.hint.revealImpactLabel}}">
              <text class="gmod__task-evidence-label">{{item.hint.revealImpactLabel}}</text>
              <view class="gmod__task-capture"
                    data-node="{{item.nodeId}}" bindtap="requestPlayerReveal"
                    aria-role="button" aria-label="揭示答案：{{item.hint.revealImpactLabel}}" hover-class="cy-pressed" hover-stay-time="80">
                揭示答案 · 记为兜底完成、不计正常榜单分
              </view>
            </block>
          </view>
          <view class="gmod__task-evidence" wx:if="{{item.playerTask.inputType === 'TEXT'}}">
            <text class="gmod__task-evidence-label">填写文字凭证</text>
            <textarea class="gmod__task-text" value="{{item.taskEvidence.text}}" maxlength="300"
                      data-node="{{item.nodeId}}" bindinput="onPlayerTaskTextInput"
                      placeholder="输入你在现场观察或确认到的内容" aria-label="填写本站任务文字凭证" />
          </view>
          <view class="gmod__task-evidence" wx:elif="{{item.playerTask.inputType === 'SCAN'}}">
            <text class="gmod__task-evidence-label">扫描现场任务码</text>
            <view class="gmod__task-capture" data-node="{{item.nodeId}}" bindtap="scanPlayerTaskEvidence"
                  aria-role="button" aria-label="扫描本站现场任务码" hover-class="cy-pressed" hover-stay-time="80">
              {{item.taskEvidence.ready ? '重新扫码' : '开始扫码'}}
            </view>
          </view>
          <view class="gmod__task-evidence" wx:elif="{{item.playerTask.inputType === 'PHOTO'}}">
            <text class="gmod__task-evidence-label">上传现场照片凭证</text>
            <view class="gmod__task-capture" data-node="{{item.nodeId}}" bindtap="photoPlayerTaskEvidence"
                  aria-role="button" aria-label="拍摄或选择本站任务照片" hover-class="cy-pressed" hover-stay-time="80">
              {{item.taskEvidence.ready ? '重新选择照片' : '拍照或选择图片'}}
            </view>
          </view>
          <text class="gmod__task-evidence-error"
                wx:else>任务凭证类型尚未配置，请联系主办方</text>
          <text class="gmod__task-evidence-status" wx:if="{{item.taskEvidence.statusText}}">{{item.taskEvidence.statusText}}</text>
          <view class="gmod__submission" wx:if="{{item.submission}}">
            <text>{{item.submission.statusLabel}}</text>
            <text wx:if="{{item.submission.status === 'PENDING'}}">核验编号 {{item.submission.submissionId}}</text>
            <text wx:if="{{item.submission.status === 'REJECTED' && item.submission.decisionReason}}">
              驳回原因：{{item.submission.decisionReason}}
            </text>
          </view>
          <view class="gmod__task-submit {{gameModule.write.status === 'submitting' || gameModule.write.status === 'unknown' || !item.taskEvidence.ready ? 'is-disabled' : ''}}"
                wx:if="{{gameModule.canSubmitTask && item.playerTask.inputType && (!item.submission || item.submission.status === 'REJECTED')}}"
                data-node="{{item.nodeId}}" data-task="{{item.playerTask.taskCode}}" bindtap="submitPlayerTask"
                aria-role="button" aria-label="提交本站任务：{{item.playerTask.prompt}}" hover-class="cy-pressed" hover-stay-time="80">
            {{item.playerTask.completionPolicy === 'EVIDENCE_ONLY' ? '记录现场证据' : (item.playerTask.verificationRequired ? '提交并等待商家核验' : '提交本站任务')}}
          </view>
        </view>
        <view class="gmod__choices" wx:if="{{item.choices.length}}">
          <view class="gmod__choice {{gameModule.write.status === 'submitting' || gameModule.write.status === 'unknown' ? 'is-disabled' : ''}}"
                wx:for="{{item.choices}}" wx:for-item="choice" wx:key="id"
                data-node="{{item.nodeId}}" data-choice="{{choice.id}}" bindtap="submitPlayerChoice"
                aria-role="button" aria-label="选择：{{choice.label}}" hover-class="cy-pressed" hover-stay-time="80">
            <text>{{choice.label}}</text><cy-icon name="arrow-right" size="24" />
          </view>
        </view>
      </view>
      <view class="gmod__ending" wx:if="{{gameModule.story.ending}}">
        <text class="gmod__eyebrow">本局结局</text>
        <text class="gmod__ending-title">{{gameModule.story.ending.title}}</text>
        <text class="gmod__ending-copy">{{gameModule.story.ending.summary}}</text>
      </view>
    </block>
  </view>
  </view>
</view>
</block>

<!-- 升级3:同行者榜(cy-sheet 玻璃半屏;score=完成关数,同分先完成者靠前) -->
<block wx:if="{{board.show}}">
<view class="mask" bindtap="closeBoard" aria-role="button" aria-label="关闭同行者榜" hover-class="cy-pressed" hover-stay-time="80"></view>
<view class="sheet" catchtap="noop">
  <view class="sheet-grab"></view>
  <view class="sheet__x" catchtap="closeBoard" aria-role="button" aria-label="关闭同行者榜" hover-class="cy-pressed" hover-stay-time="80"><view class="sheet__x-i"></view></view>
  <view class="sheet-body">
    <view class="sheet-name">同行者榜</view>
  <view class="board" wx:if="{{board.show}}">
    <view class="board__loading" wx:if="{{board.loading}}" aria-role="status" aria-label="正在加载同行者榜"><cy-skeleton type="list" count="3" /></view>
    <block wx:else>
      <view class="board__empty" wx:if="{{board.error}}">{{board.error}}<text class="board__retry" bindtap="openBoard" hover-class="cy-pressed" hover-stay-time="80">重试</text></view>
      <view class="board__empty" wx:elif="{{!board.list.length}}">这一场还没人上榜,你走一关就是第一名</view>
      <view class="board__row {{index === 0 ? 'is-first' : ''}}" wx:for="{{board.list}}" wx:key="memberId">
        <text class="board__rank {{index === 0 ? 'is-first' : ''}}">{{item.rank}}</text>
        <image class="board__avatar" wx:if="{{item.avatar}}" src="{{item.avatar}}" mode="aspectFill" />
        <view class="board__avatar board__avatar--ph" wx:else></view>
        <text class="board__nick">{{item.nickname || '同行者'}}</text>
        <text class="board__score">{{item.score}} 关</text>
        <view class="board__crown" wx:if="{{index === 0}}"><cy-icon name="star" size="32" /></view>
      </view>
      <view class="board__me" wx:if="{{board.me}}">
        <text class="board__me-rank">{{board.me.rank || 0}}</text>
        <text class="board__me-nick">我</text>
        <text class="board__me-score">{{board.me.score}} 关{{board.me.rank ? '' : ' · 继续走进榜'}}</text>
      </view>
    </block>
    <cy-option-sheet show="{{tagSheetShow}}" title="改成哪个结果" items="{{tagSheetItems}}"
                   bind:select="onTagSheetSelect" bind:cancel="onTagSheetCancel" />
</view>
  </view>
</view>
</block>

<cy-playkit-album show="{{album.show}}" title="{{album.title}}" images="{{album.images}}" bind:close="closeAlbum" />

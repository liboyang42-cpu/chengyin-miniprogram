/* cy-ring-meter · 分段环形读数(Figma v5.1 计步挑战 48:274 / v5.2 GameTimerSheet 计时环)
 *
 * 为什么是「分段小棒」而不是连续弧:小程序渲染层不认 conic-gradient(渲成实心灰盘),
 * pages/play 的 .fx-ring 早就踩过并定了这个做法,这里沿用同一套几何,不另起炉灶。
 * 每根棒 transform-origin 落在环心,靠内联 rotate 摆到自己的角度。 */
.rm { position: relative; flex: none; }
.rm__track { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.rm__seg {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 6rpx;
  height: 20rpx;
  margin: calc(var(--rm-r) * -1) 0 0 -3rpx;
  transform-origin: 3rpx var(--rm-r);
  border-radius: var(--cy-radius-pill);
  background: var(--cy-color-play-accent-soft);
}
.rm--info .rm__seg--on { background: var(--cy-color-status-info); }
.rm--success .rm__seg--on { background: var(--cy-color-status-success); }
.rm--danger .rm__seg--on { background: var(--cy-color-status-danger); }
/* 玩法主题档:由调用方在自己的容器上定义 --rm-accent(见 v5.1 玩法主题色) */
.rm--playkit .rm__seg--on { background: var(--rm-accent, var(--cy-color-status-info)); }
/* 中心内容:大数字 + 副标由调用方经 slot 给,组件不预设排版 */
.rm__c {
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
}

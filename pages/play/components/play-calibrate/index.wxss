/* cy-play-calibrate · 传感器玩法开局前的校准(原型真源:模板编辑页 v2 · playkit calibrate) */
.cal {
  position: absolute;
  left: 0; right: 0; top: 0; bottom: 0;
  z-index: 18;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: var(--cy-space-3);
  padding: 0 var(--cy-space-6);
  text-align: center;
  background: var(--cy-color-play-scrim, rgba(8, 8, 10, .78));  /* ds-ok 玩法台面的遮罩,已带 token 兜底 */
}
.cal__t {
  font-size: var(--cy-type-card-title);
  font-weight: 900;
  color: var(--cy-color-text-primary);
}
.cal__bar {
  width: 300rpx;
  height: 8rpx;
  border-radius: var(--cy-radius-pill);
  overflow: hidden;
  background: var(--cy-color-play-accent-soft);
}
.cal__fill {
  width: 100%;
  height: 100%;
  background: var(--cy-color-text-primary);
  /* 用 scaleX 不用 width:改 width 每帧触发 layout+paint,而这条在校准的两秒里一直在动 */
  transform-origin: 0 50%;
  transition: transform var(--cy-dur-fast) linear;
}
.cal__s {
  font-size: var(--cy-type-label);
  color: var(--cy-color-text-tertiary);
}

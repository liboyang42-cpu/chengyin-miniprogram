@import "/pages/play/style/play-surface.wxss";

/* cy-playkit-sort · 排序题(设计规格:Figma 04 Blocks · 排序) */
.so { color: var(--ink); }
.so__prompt {
  font-size: var(--cy-type-sheet-title);
  font-weight: 800;
  line-height: 1.4;
}
/* 分组列表:一个圆角深灰块,行间一条发丝线 —— 行与行是同一组里的位置,不是一堆卡片 */
.so__list {
  width: 100%;
  border-radius: var(--cy-radius-md);     /* 圆角 12 = 24rpx */
  background: var(--soft);
  overflow: hidden;
}
.so__row {
  position: relative;
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 104rpx;
  padding: 12rpx 24rpx;
  box-sizing: border-box;
  text-align: left;
}
.so__row + .so__row { border-top: 1rpx solid var(--cy-color-border-subtle); }  /* 行间 0.5px */
.so__no {
  flex: none;
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--cy-color-bg-raised);
  color: var(--ink);
  font-family: var(--cy-font-numeric);
  font-size: var(--cy-type-label);
  font-weight: 800;
}
/* 只有整体通过才逐行变绿(那意味着每一位都对);判错不逐行标红 —— 服务端不给逐位置对错 */
.so__row.is-right .so__no { background: var(--ok); color: var(--cy-color-text-inverse); }
.so__img {
  flex: none;
  width: 64rpx;
  height: 64rpx;
  border-radius: var(--cy-radius-sm);
}
.so__label {
  flex: 1;
  min-width: 0;
  font-size: var(--cy-type-body);
  font-weight: 600;
  line-height: 1.4;
}
.so__nudge {
  flex: none;
  padding: 14rpx 20rpx;
  border-radius: var(--cy-radius-sm);
  background: var(--cy-color-bg-raised);
  color: var(--sub);
  font-size: var(--cy-type-label);
  font-weight: 800;
}
.so__grip {
  flex: none;
  padding: 14rpx 8rpx;
  color: var(--sub);
  font-size: var(--cy-type-card-title);
  letter-spacing: -4rpx;
}
.so__press { opacity: .88; }
.g-btn--press { opacity: .88; }
/* 正在拖的那一行:底色浅一级 + 带投影,把它从列表里「抬」起来 */
.so__row.is-dragging {
  background: var(--cy-color-bg-raised);
  box-shadow: 0 16rpx 36rpx rgba(0, 0, 0, .4);   /* ds-ok 抬起那行的投影,照设计稿 */
  z-index: 2;
}
.so--reduced .so__row { transition: none; }
.so__fb {
  flex: none;
  width: 100%;
  box-sizing: border-box;
  padding: 26rpx 30rpx;
  border-radius: var(--cy-radius-md);
  font-size: var(--cy-type-body);
  line-height: 1.6;
  text-align: left;
}
.so__fb.is-ok { background: var(--cy-color-status-success-soft); color: var(--cy-color-status-success); }
.so__fb.is-no { background: var(--cy-color-status-danger-soft); color: var(--cy-color-status-danger); }

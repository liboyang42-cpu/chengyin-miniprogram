/* cy-scratch · 擦开 / 刮开
   遮罩与内容严格同尺寸:canvas 绝对定位撑满,内容决定盒子大小。 */
:host { display: block; }

.scr {
  position: relative;
  overflow: hidden;
  border-radius: inherit;   /* 跟随调用方的圆角,不然方角遮罩会露出四个直角 */
}

.scr__content { display: block; }

.scr__canvas {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
}

/* 只给读屏,不占视觉:整层铺满但完全透明。
   不用 display:none —— 那会让读屏也读不到。 */
.scr__a11y {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  pointer-events: none;
}

.scr__direct {
  position: absolute;
  right: var(--cy-space-2);
  bottom: var(--cy-space-2);
  z-index: 2;
  min-width: 176rpx;
  min-height: 88rpx;
  padding: 0 var(--cy-space-2);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border-radius: var(--cy-radius-pill);
  background: var(--cy-color-bg-elevated);
  color: var(--cy-color-text-primary);
  font-size: var(--cy-type-label);
  font-weight: 700;
}

.cy-pressed { opacity: .88; }

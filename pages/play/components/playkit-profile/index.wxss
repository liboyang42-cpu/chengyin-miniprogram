@import "/pages/play/style/play-surface.wxss";

/* cy-playkit-profile · 出生登记(契约 §2.1)
 * 皮肤与台面语言都来自 play-surface(stage 传下来的 --ink/--sub/--soft 与 .g-col/.g-btn),
 * 这里只画表单自己那几块。⚠️ 本仓没有全局 border-box,凡带 padding 的宽度都显式声明。 */
.pf {
  /* .g-col 是绝对定位整屏列;内容可能超过一屏,所以这一屏自己可滚 */
  overflow-y: auto;
}
.pf__lead {
  margin-top: var(--cy-space-2);
  font-size: var(--cy-type-body);
  line-height: 1.7;
  color: var(--sub);
}

/* 头像位:一枚圆窗,选完把图填进去 */
.pf__ava {
  flex: none;
  margin-top: var(--cy-space-4);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--cy-space-1-5);
}
.pf__ava--press { opacity: .88; }
.pf__ava-img,
.pf__ava-ph {
  width: 176rpx;
  height: 176rpx;
  border-radius: 50%;
}
.pf__ava-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 2rpx dashed var(--cy-color-border-strong);
  background: var(--soft);
  color: var(--sub);
}
.pf__ava-t {
  font-size: var(--cy-type-label);
  color: var(--sub);
}

.pf__qs {
  width: 100%;
  margin-top: var(--cy-space-4);
  display: flex;
  flex-direction: column;
  gap: var(--cy-space-4);
}
.pf__q { width: 100%; text-align: left; }
.pf__label {
  display: flex;
  align-items: center;
  gap: var(--cy-space-1-5);
  font-size: var(--cy-type-body);
  font-weight: 700;
  color: var(--ink);
}
.pf__req {
  font-size: var(--cy-type-caption);
  font-weight: 500;
  color: var(--sub);
}
.pf__input {
  margin-top: var(--cy-space-2);
  width: 100%;
  height: 100rpx;
  box-sizing: border-box;
  padding: 0 var(--cy-space-3);
  border-radius: var(--cy-radius-lg);
  background: var(--soft);
  color: var(--ink);
  font-size: var(--cy-type-body);
}
.pf__input-ph { color: var(--cy-color-text-placeholder); }
.pf__opts {
  margin-top: var(--cy-space-2);
  display: flex;
  flex-wrap: wrap;
  gap: var(--cy-space-1-5);
}
.pf__opt {
  padding: var(--cy-space-1-5) var(--cy-space-3);
  box-sizing: border-box;
  border-radius: var(--cy-radius-pill);
  border: 2rpx solid var(--cy-color-border-strong);
  background: var(--soft);
  font-size: var(--cy-type-label);
  color: var(--ink);
}
.pf__opt--press { opacity: .8; }
.pf__opt.is-on {
  background: var(--ink);
  color: var(--bg);
  border-color: var(--ink);
}
.pf__done {
  margin-top: var(--cy-space-4);
  font-size: var(--cy-type-label);
  color: var(--ok);
}

.ai-plan-gen { flex: 1; text-align: center; padding: var(--cy-space-2-5); border-radius: var(--cy-radius-md); background: var(--cy-btn-solid-bg); color: var(--cy-btn-solid-fg); font-size: var(--cy-font-body); font-weight: 700; }
.ai-plan-gen--busy { opacity: 0.6; }
.ai-plan-ghost { padding: var(--cy-space-2-5) var(--cy-space-3-5); border-radius: var(--cy-radius-md); border: 1rpx solid var(--club-glass-border); color: var(--club-text-muted); font-size: var(--cy-font-body); }
.ai-plan-err { margin-top: var(--cy-space-2); font-size: var(--cy-font-caption); color: var(--cy-color-status-danger); line-height: 1.6; }
.ai-plan-res { margin-top: var(--cy-space-3); padding-top: var(--cy-space-3); border-top: 1rpx solid var(--club-glass-border); }
.ai-plan-tit { font-size: var(--cy-font-subtitle); font-weight: 700; color: var(--club-text); }
.ai-plan-sub { margin-top: var(--cy-legacy-6); font-size: var(--cy-font-caption); color: var(--club-text-muted); }
.ai-plan-tags { display: flex; flex-wrap: wrap; gap: var(--cy-space-1-5); margin-top: var(--cy-space-2); }
.ai-plan-tag { padding: var(--cy-legacy-6) var(--cy-space-2); border-radius: var(--cy-radius-pill); font-size: var(--cy-font-caption); color: var(--club-accent); border: 1rpx solid var(--club-glass-border); } /* ds-ok: 6rpx 无匹配 token */
.ai-plan-text { margin-top: var(--cy-space-2); font-size: var(--cy-font-body); color: var(--club-text); line-height: 1.7; }
.ai-plan-fit { margin-top: var(--cy-space-1-5); font-size: var(--cy-font-caption); color: var(--club-text-muted); line-height: 1.6; }
.ai-plan-lbl { margin-top: var(--cy-space-3); font-size: var(--cy-font-caption); font-weight: 700; color: var(--club-text); }
.ai-plan-copy { float: right; font-weight: 400; color: var(--club-accent); }
.ai-plan-node { display: flex; align-items: flex-start; gap: var(--cy-space-2); margin-top: var(--cy-space-1-5); }
.ai-plan-node-no { flex: 0 0 40rpx; height: 40rpx; line-height: 40rpx; text-align: center; border-radius: 50%; background: var(--club-surface); font-size: var(--cy-font-caption); color: var(--club-accent); }
.ai-plan-node-body { flex: 1; }
.ai-plan-node-name { font-size: var(--cy-font-body); color: var(--club-text); }
.ai-plan-node-addr { margin-top: var(--cy-legacy-4); font-size: var(--cy-font-caption); color: var(--club-text-muted); }
.ai-plan-risk, .ai-plan-msug { margin-top: var(--cy-space-1); font-size: var(--cy-font-caption); color: var(--club-text-muted); line-height: 1.6; }
.ai-plan-promo { margin-top: var(--cy-space-1-5); padding: var(--cy-space-2-5); border-radius: var(--cy-radius-md); background: var(--club-surface); font-size: var(--cy-font-caption); color: var(--club-text); line-height: 1.7; }
.ai-plan-source { margin-top: var(--cy-space-3); font-size: var(--cy-font-caption); color: var(--club-text-muted); }
.ai-plan-adopt { margin-top: var(--cy-space-2); text-align: center; padding: var(--cy-space-3); border-radius: var(--cy-radius-md); background: var(--cy-btn-solid-bg); color: var(--cy-btn-solid-fg); font-size: var(--cy-font-body); font-weight: 700; }
.ai-plan-adopt-note { margin-top: var(--cy-space-1-5); text-align: center; font-size: var(--cy-font-caption); color: var(--club-text-muted); }

/* 多团选团 picker */
.owner-picker-item { padding: var(--cy-space-3); border-radius: var(--cy-radius-md); text-align: center; font-size: var(--cy-font-body); color: var(--club-text); background: var(--club-surface); margin-top: var(--cy-space-1-5); }

/* T16:找商家搜索框 */
.merchant-search {
  margin: var(--cy-legacy-4) 0 var(--cy-space-2-5);
}

/* 成员 */
.member {
  display: flex;
  align-items: center;
  padding: var(--cy-space-2) 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}
.member--managed { flex-wrap: wrap; }
.member:last-child { border-bottom: 0; }
.member-avatar {

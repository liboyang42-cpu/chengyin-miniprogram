@import "../../../style/fade-in.wxss";  /* 减动效兜底要用它的 cy-fade-in(只淡不移) */
/* Strava 风俱乐部主页 — 纯黑顶区 + 炭灰内容区 + 橙色强调 */
page { background: var(--cy-bg-page); }

.club-page {
  min-height: 100vh;
  background: var(--cy-bg-page);
  --club-accent: var(--cy-brand);
  --club-surface: var(--cy-bg-card);
  --club-surface-2: var(--cy-bg-card);
  --club-text: var(--cy-text-title);
  --club-text-muted: #8a8a8e;
  --club-glass: rgba(255, 255, 255, 0.12);
  --club-glass-border: var(--cy-border-card);
}
.club-nav-spacer { width: 100%; }

/* —— 封面 Hero —— */
.cover-wrap {
  position: relative;
  /* 2026-08-26:400 → 240rpx。封面从「视觉主角」退成一条 banner,首屏多露一条帖子;
     俱乐部的身份感靠 logo + 名字撑住,不靠封面高度。
     2026-09-02 对稿(Figma 93:9 Hero cover 160px):240 → 320rpx。 */
  height: 320rpx;
  overflow: visible;
  background: #0a0a0a;
  /* 必须高于 .profile 的 z-index:2。本元素带 z-index 就会开一个层叠上下文,
     里面 .profile-logo-wrap 的 z-index:10 只在这个上下文内部有效、逃不出去;
     只要本值 <= .profile 的值,挂在封面下沿那半个 logo 就会被 .profile 的
     不透明底色盖掉 —— 这正是「logo 只有一半」的成因(不是裁切,也不是高度不够)。 */
  z-index: 3;
}
.cover-bg {
  position: absolute;
  inset: 0;
  overflow: hidden;
}
.cover-wrap::after {
  content: '';
  position: absolute;
  inset: 0;
  z-index: 2;
  background: linear-gradient(180deg, rgba(0,0,0,0.12) 0%, rgba(0,0,0,0.62) 100%);
  pointer-events: none;
}
.cover-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
}
.cover-fallback {
  position: absolute;
  inset: 0;
  z-index: 1;
  background: var(--cy-bg-card-2);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--cy-text-muted);
}
/* 没上传封面时用稿 304:395「默认俱乐部顶图 / BG-11 一起玩」那张插画,
   而不是原来的灰底 + 图片图标。插画自带配色(#04413C 墨绿底 + 撞色形状),
   ⚠️ 那些是**插画色**不是 UI 色 —— 只以图片资源形式存在,一个都不许抄进 wxss。
   .cover-fallback 的灰底留着:图还没解码出来的那一帧要有东西垫底,别闪白。 */
.cover-fallback-art { width: 100%; height: 100%; }
.cover-nav-acts { display: flex; align-items: center; gap: var(--cy-space-2); }
/* CU-C-61:分享/邀请改成原生 <button open-type="share"> 后要把 button 自带盒模型清零
   (margin/padding/border/行高/伪元素边框),否则圆钮会被撑成胶囊。
   ::after 对同一个类的 <view> 用法无效果,不必拆第二个类名。 */
.cover-nav-act {
  width: var(--cy-btn-h);
  height: var(--cy-btn-h);
  margin: 0;
  padding: 0;
  border: 0;
  line-height: normal;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.42);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.cover-nav-act::after { border: 0; }
/* 2026-09-04 截图走查改:原来是两张 <image> 引 svg,其中 icon_setting3.svg 内部写死
   fill="#000DFF",只能靠 filter: brightness(10) 硬拉 —— 拉亮了但没拉白,深色导航栏上
   实拍就是一枚扎眼的蓝。换成 DS 的 cy-icon(CSS mask,颜色由 currentColor 决定),
   svg 内部写死什么颜色都不再影响显示,filter 这条补丁也就不需要了。 */
.cover-nav-ico { color: var(--cy-color-text-primary); }

/* —— 资料区 —— */
.profile {
  position: relative;
  z-index: 2;
  /* 名字挪到 logo 右侧后,顶部只需让开 logo 露出的 48rpx 一点点;
     左侧让开 logo 宽 96 + 间距 20 = 116rpx。 */
  /* Figma 93:19 Identity:px14 pt8 pb4 —— 名字的绝对左边距要落在 84px(= 页边 14 + pl 70) */
  padding: var(--cy-space-2) 28rpx var(--cy-space-1); /* ds-ok: 与 logo 尺寸联动 */
  background: var(--cy-bg-page);
}
.profile-logo-wrap {
  position: absolute;
  left: var(--cy-space-4);
  /* Figma 93:18:logo 56px 落在 160px 封面的 y=136 → 只压出封面下沿 24px = 48rpx */
  bottom: -48rpx;
  z-index: 10;
  width: 112rpx;
  height: 112rpx;
  border-radius: var(--cy-radius-md);
  overflow: hidden;
  background: var(--club-accent);
  border: 6rpx solid var(--cy-color-bg-page);
  box-sizing: border-box;
}
.profile-logo { width: 100%; height: 100%; display: block; }
.profile-id {
  display: flex;
  align-items: flex-end;
  gap: var(--cy-space-2-5);
  padding-left: 140rpx; /* ds-ok: Figma 93:20 name row pl70;= logo 112 + 间距 28,与 .profile-logo-wrap 联动 */
  min-height: 64rpx;
}
.profile-id-main { flex: 1; min-width: 0; }
.profile-links {
  display: flex;
  gap: var(--cy-space-4);
  margin-top: var(--cy-space-2-5);
}
.profile-link {
  display: inline-flex;
  align-items: center;
  gap: var(--cy-legacy-4);
  min-height: var(--cy-btn-h);
  font-size: var(--cy-font-label);
  font-weight: 500;
  color: var(--club-text-muted);
}
.profile-link-arrow { flex: none; }
.profile-name {
  /* Figma 93:21:27px Bold 单行省略 */
  font-size: var(--cy-type-page-title);
  font-weight: 700;
  color: var(--club-text);
  line-height: var(--cy-leading-tight);
  letter-spacing: -0.02em;
  margin-top: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
/* Figma 93:22 Meta:三枚「图标 19 + 文字 15」chip,gap 20。
   2026-08-26 曾把它压成一行 · 拼接的纯文本并撤掉图标,282:x 那版稿又把图标行留着 —— 以稿为准复原。 */
.profile-meta {
  margin-top: var(--cy-space-3-5);
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  /* 稿上 chip 间距是 20px(93:23 末端 85 → 93:29 起点 105)= 40rpx;
     原来取了最近的 --cy-space-5(48rpx),实测每道缝多 3.2px、整行右端超稿 11px。 */
  gap: var(--cy-space-2-5) 40rpx; /* ds-ok: Figma 93:22 chip 间距 20px,8rpx 阶梯上无 40 这一档 */
}
.profile-meta-chip { display: flex; align-items: center; gap: var(--cy-space-1-5); min-width: 0; }
.profile-meta-ico { flex: none; color: var(--cy-color-text-primary); }
.profile-meta-text {
  font-size: var(--cy-type-card-title);
  color: var(--cy-color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 主按钮已收进身份行右侧,不再整宽 */
.profile-cta { flex-shrink: 0; }
/* join-btn 收编至 .cy-btn（primary 反色中性白/secondary/ghost）;此处仅留行内布局 */
.join-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 var(--cy-space-3-5);
  /* ⚠️ 不能再压:契约「俱乐部主要 CTA 触控高度不得小于 88rpx」是无障碍下限(44pt),
     2026-08-26 压到 64rpx 被单测抓出,已改回 --cy-btn-h。 */
  height: var(--cy-btn-h);
  border-radius: var(--cy-radius-pill);
  font-size: var(--cy-font-label);
  font-weight: 700;
  white-space: nowrap;
}
.join-btn--pending {
  display: flex; align-items: center; justify-content: center;
  color: var(--club-text-muted); background: var(--club-surface); border: 2rpx solid var(--club-glass-border);
}

/* 一次性动作与同页 tab 分开 */

.club-view-tabs {
  display: block;
  padding: 0 var(--cy-space-4);
  background: var(--cy-bg-page);
  border-bottom: 1rpx solid var(--cy-color-border-subtle);
}

.feed-divider {
  height: 2rpx;
  background: rgba(255, 255, 255, 0.06);
  margin: 0;
}

/* —— 内容区(无底色,与页面纯黑一致) —— */
.feed { padding: 0 0 var(--cy-space-4); background: var(--cy-bg-page); }
.feed--plain { background: var(--cy-bg-page); }

/* 发帖 */
.post-composer {
  display: flex;
  flex-direction: column;
  gap: var(--cy-space-2);
  padding: var(--cy-space-3) var(--cy-space-4);
  border-bottom: 2rpx solid rgba(255, 255, 255, 0.06);
}
.post-input {
  width: 100%;
  min-height: 64rpx;
  max-height: 240rpx;
  font-size: var(--cy-font-body);
  color: var(--club-text);
  line-height: 1.5;
  box-sizing: border-box;
}
.post-ph { color: var(--club-text-muted); }
.post-imgrow { display: flex; flex-wrap: wrap; align-items: center; gap: var(--cy-space-1-5); }
.post-thumb { position: relative; width: 120rpx; height: 120rpx; }
.post-thumb-img { width: 100%; height: 100%; border-radius: var(--cy-radius-sm); }
.post-thumb-del {
  position: absolute; top: calc(var(--cy-legacy-10) * -1); right: calc(var(--cy-legacy-10) * -1); width: var(--cy-btn-h); height: var(--cy-btn-h);
}
.post-thumb-del__glyph {
  position: absolute; top: 0; right: 0; width: var(--cy-legacy-36); height: var(--cy-legacy-36);
  display: flex; align-items: center; justify-content: center; background: var(--cy-color-overlay);
  color: var(--cy-color-text-inverse); border-radius: var(--cy-radius-pill);
}
.post-addimg {
  width: 120rpx; height: 120rpx; display: flex; align-items: center; justify-content: center;
  color: var(--club-text-muted);
  background: var(--club-surface); border: 1rpx dashed rgba(255,255,255,0.12);
  border-radius: var(--cy-radius-sm);
}
.post-send {
  min-height: var(--cy-btn-h); box-sizing: border-box; display: flex; align-items: center;
  margin-left: auto; align-self: flex-end; padding: 0 var(--cy-space-4);
  border-radius: var(--cy-radius-pill); background: var(--cy-btn-solid-bg); color: var(--cy-btn-solid-fg); font-size: var(--cy-font-label);
}
.post-send.disabled { opacity: 0.5; }

/* —— 活动 tab(Figma N2-A 282:350 / N2-B 282:499)—— */
/* 段头:20px Bold + 分隔线 + 右侧「发布 +」 */
.ev-sec-head {
  display: flex;
  align-items: center;
  gap: var(--cy-space-2);
  padding: 0 var(--cy-page-x);
  margin-top: var(--cy-space-5);
  margin-bottom: var(--cy-space-4);
}
.ev-sec-head--second { margin-top: var(--cy-space-5); }
.ev-sec-tit { font-size: var(--cy-type-section-title); font-weight: 700; color: var(--cy-color-text-primary); }
/* 稿里 282:622 / 23:16 / 23:41 这一格是 h-px 的**透明** spacer(get_design_context 无 bg,
   PNG 导出该区整片 RGB(0,0,0))—— 只负责把右侧文字链推到行尾,不画分隔线。 */
.ev-sec-rule { flex: 1; min-width: 0; height: 1rpx; }
.ev-sec-link {
  flex: none;
  min-height: var(--cy-btn-h);
  display: flex;
  align-items: center;
  gap: var(--cy-legacy-4);
  font-size: var(--cy-font-label);
  font-weight: 500;
  color: var(--cy-color-text-primary);
}

/* 活动卡(稿 N2 20:52):封面通栏 + 状态胶囊叠在封面左上 + 三列数字块。
   2026-09-09 从原来的 343×123 横卡改过来 —— 横卡跟的是较旧的组件 281:360。 */
.ev-card {
  margin: 0 var(--cy-page-x) var(--cy-space-3);
  border-radius: var(--cy-radius-lg);
  background: var(--cy-color-bg-elevated);
  overflow: hidden;
}
.ev-coverslot { position: relative; }
.ev-cover {
  display: block;
  width: 100%;
  height: 260rpx;
  background: var(--cy-color-bg-surface-strong);
}
.ev-body {
  display: flex;
  flex-direction: column;
  gap: var(--cy-space-1-5);
  padding: var(--cy-space-3);
}
/* 胶囊叠在封面上,所以底色要实、不能透 */
.ev-status {
  position: absolute;
  top: var(--cy-space-2);
  left: var(--cy-space-2);
  padding: var(--cy-legacy-4) var(--cy-space-2);
  border-radius: var(--cy-radius-pill);
  background: var(--cy-color-bg-elevated);
  font-size: var(--cy-font-micro);
  font-weight: 500;
}
.ev-stats { display: flex; gap: var(--cy-space-6); margin-top: var(--cy-space-1); }
.ev-stat { display: flex; flex-direction: column; gap: 2rpx; }
.ev-stat-num { font-size: var(--cy-font-subtitle); font-weight: 700; color: var(--cy-color-text-primary); }
.ev-stat-label { font-size: var(--cy-font-micro); color: var(--cy-color-text-tertiary); }
.ev-status--open { color: var(--cy-color-status-warning); }
.ev-status--live { color: var(--cy-color-status-success); }
.ev-status--muted { color: var(--cy-color-text-tertiary); }
.ev-name {
  font-size: var(--cy-font-body);
  font-weight: 700;
  color: var(--cy-color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ev-time { font-size: var(--cy-font-label); color: var(--cy-color-text-secondary); }
.ev-acts { display: flex; align-items: center; flex-wrap: wrap; gap: var(--cy-space-2); }

/* 空态(282:478):卡容器内标题 / 说明 / 主按钮 / 归属提示 */
.ev-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--cy-space-2);
  margin: 0 var(--cy-page-x);
  padding: var(--cy-space-4) var(--cy-space-5) var(--cy-space-3-5);
  border-radius: var(--cy-radius-lg);
  background: var(--cy-color-bg-elevated);
}

.event-group-code {
  min-height: var(--cy-btn-h);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  align-self: flex-start;
  margin-top: var(--cy-space-2);
  padding: var(--cy-space-1) var(--cy-space-2);
  border: 2rpx solid var(--club-accent);
  border-radius: var(--cy-radius-pill);
  color: var(--club-accent);
  font-size: var(--cy-font-caption);
}
.event-report {
  min-height: var(--cy-btn-h);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  align-self: flex-start;
  margin-top: var(--cy-space-1);
  padding: 0 var(--cy-space-2);
  color: var(--cy-color-status-warning);
  font-size: var(--cy-font-caption);
}
.event-view-tabs { display: block; padding: 0 var(--cy-space-4) var(--cy-space-2); }
.event-calendar { padding: 0 var(--cy-space-4) var(--cy-space-5); }
.event-calendar-head { display: flex; align-items: center; justify-content: space-between; min-height: var(--cy-btn-h); }
.event-calendar-title { color: var(--club-text); font-size: var(--cy-font-body); font-weight: 700; }
.event-calendar-shift {
  width: var(--cy-btn-h); height: var(--cy-btn-h); display: flex; align-items: center; justify-content: center;
  border-radius: var(--cy-radius-pill); background: var(--club-surface); color: var(--club-text);
  font-size: var(--cy-font-title);
}
.event-calendar-week, .event-calendar-grid { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); }
.event-calendar-week { padding: var(--cy-space-1) 0; color: var(--club-text-muted); font-size: var(--cy-font-caption); text-align: center; }
.event-calendar-day {
  min-height: 112rpx; /* ds-ok: month cell must hold date plus one event label */
  padding: var(--cy-space-1) 4rpx; /* ds-ok: seven columns need compact optical inset */
  border-top: 1rpx solid var(--cy-border-card); color: var(--club-text); overflow: hidden;
}
.event-calendar-day.is-outside { opacity: 0.35; }
.event-calendar-number { display: block; margin-bottom: var(--cy-space-1); text-align: center; font-size: var(--cy-font-caption); }
.event-calendar-day.has-event .event-calendar-number { color: var(--club-accent); font-weight: 700; }
.event-calendar-item {
  margin-top: 4rpx; /* ds-ok: compact labels within fixed calendar cell */
  padding: 4rpx 6rpx; /* ds-ok: compact labels within seven-column grid */
  border-radius: var(--cy-radius-sm); background: var(--cy-accent-soft); color: var(--club-text);
  font-size: var(--cy-font-caption); line-height: 1.25; white-space: nowrap; text-overflow: ellipsis; overflow: hidden;
}

/* 概览 */
.overview-text {
  font-size: var(--cy-font-body);
  color: var(--club-text);
  line-height: var(--cy-leading-normal);
}
.overview-section {
  padding: var(--cy-space-3-5) var(--cy-space-4); /* ds-ok: 28rpx 无匹配 token */
  border-bottom: 2rpx solid rgba(255, 255, 255, 0.06);
}
.overview-section-tit {
  font-size: var(--cy-font-body);
  font-weight: 700;
  color: var(--club-text);
  margin-bottom: var(--cy-space-2-5);
}
.overview-section-tit--action {
  min-height: var(--cy-btn-h);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--cy-space-2);
}
.overview-empty {
  font-size: var(--cy-font-label);
  color: var(--club-text-muted);
  padding: var(--cy-space-2) 0;
}
.sec-link {
  flex-shrink: 0;
  min-height: var(--cy-btn-h);
  display: inline-flex;
  align-items: center;
  font-size: var(--cy-font-label);
  font-weight: 400;
  color: var(--club-accent);
  gap: var(--cy-space-1);
}
.membership-summary-line { display: flex; align-items: center; justify-content: space-between; gap: var(--cy-space-2); }
.membership-summary-type { color: var(--club-text); font-size: var(--cy-font-body); font-weight: 700; }
.membership-summary-status {
  flex-shrink: 0; padding: var(--cy-space-1) var(--cy-space-2); border-radius: var(--cy-radius-pill);
  background: var(--club-surface); color: var(--club-text-muted); font-size: var(--cy-font-caption); font-weight: 700;
}
.membership-summary-status--ACTIVE, .membership-summary-status--GRACE { background: var(--cy-color-status-success-soft); color: var(--cy-color-status-success); }
.membership-summary-status--PAST_DUE, .membership-summary-status--EXPIRED { background: var(--cy-color-status-warning-soft); color: var(--cy-color-status-warning); }
.membership-summary .overview-text { margin-top: var(--cy-space-1-5); color: var(--club-text-muted); }
.membership-summary-error {
  min-height: var(--cy-btn-h); display: flex; align-items: center;
  color: var(--cy-danger); font-size: var(--cy-font-label);
}
.governance-actions { display: flex; align-items: center; gap: var(--cy-space-2); margin-top: var(--cy-space-2); }
.governance-action {
  min-height: var(--cy-btn-h); display: inline-flex; align-items: center;
  color: var(--club-accent); font-size: var(--cy-font-label); font-weight: 700;
}
.governance-action--warning { color: var(--cy-color-status-warning); }

/* owner 管理 tab：全部保持 C 端深色语义 */
.manage-feed { padding-top: var(--cy-space-3); }

/* 快捷动作行(Figma 78:5423):49px 圆钮 + 12px 标签,整行两端对齐。
   圆底走 bg-interactive(#4D4D4D)—— 控件底比卡底(elevated)再亮一档,才压得住页黑。 */
/* ⚠️ 2026-09-02 更正:原为左右 8rpx(4px),而同屏兄弟块 .manage-now / .overview-section
   都是 32rpx(16px)—— 五个圆钮比下面的卡各往外突出约 12px,而且因为 space-between,
   圆钮间距被撑开。稿 78:5423 的 Actions 帧 x=20。归位到页边同档。 */
.quick-acts { display: flex; align-items: flex-start; justify-content: space-between; padding: var(--cy-space-3) var(--cy-space-4) var(--cy-space-4); }
/* CU-C-61:「分享」这一格是原生 <button open-type="share">,button 自带的盒模型要清零。 */
.quick-act {
  display: flex; flex-direction: column; align-items: center; gap: 16rpx; width: 132rpx;
  margin: 0; padding: 0; border: 0; line-height: normal;
  background: transparent; border-radius: 0; overflow: visible;
}
.quick-act::after { border: 0; }
.quick-act-circle {
  width: 98rpx; height: 98rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;

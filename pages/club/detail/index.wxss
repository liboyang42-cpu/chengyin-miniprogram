.member-report { color: var(--cy-color-status-warning); }
.manage-todo-tool {
  min-height: var(--cy-btn-h-sm); padding: 0 var(--cy-space-2); display: flex; align-items: center;
  border: 1rpx solid var(--cy-border-line); border-radius: var(--cy-radius-pill);
  color: var(--club-accent); font-size: var(--cy-font-caption); white-space: nowrap;
}
.manage-todo-tool.disabled { opacity: 0.5; }

/* —— 本团贡献榜(Figma 23:39 LbHead + 23:43 Leaderboard)——
   排序从 chip tabs 收成榜头右侧「综合 ▾」;名次表进一张 bg-elevated 卡,
   自己那一行压 action/secondary-bg 底并带「我」角标。 */
.ov-lb {
  margin: 0 var(--cy-page-x);
  border-radius: var(--cy-radius-lg);
  background: var(--cy-color-bg-elevated);
  overflow: hidden;
}
.ov-lb-row {
  display: flex;
  align-items: center;
  gap: var(--cy-space-2-5);
  padding: var(--cy-space-2-5) var(--cy-space-3);
}
.ov-lb-row.is-me { background: var(--cy-color-action-secondary-bg); }
.ov-lb-rank {
  flex: none;
  width: var(--cy-space-5);
  text-align: center;
  font-size: var(--cy-font-label);
  font-weight: 500;
  color: var(--cy-color-text-tertiary);
}
.ov-lb-rank.is-top { font-weight: 700; color: var(--cy-color-status-warning); }
.ov-lb-avatar { flex: none; }
.ov-lb-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: var(--cy-legacy-4); }
.ov-lb-namerow { display: flex; align-items: center; gap: var(--cy-space-1-5); min-width: 0; }
.ov-lb-name {
  font-size: var(--cy-font-label);
  font-weight: 500;
  color: var(--cy-color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ov-lb-me {
  flex: none;
  padding: 0 var(--cy-space-1-5);
  border-radius: var(--cy-radius-pill);
  background: var(--cy-color-action-primary-bg);
  color: var(--cy-color-action-primary-fg);
  font-size: var(--cy-font-micro);
  font-weight: 600;
}
.ov-lb-meta { font-size: var(--cy-font-micro); color: var(--cy-color-text-tertiary); }
.ov-lb-pts { flex: none; font-size: var(--cy-type-card-title); font-weight: 700; color: var(--cy-color-text-primary); }
/* 折叠行(23:68):前 3 与我周边之间被省掉的名次 */
.ov-lb-gap {
  padding: var(--cy-space-2) var(--cy-space-3);
  font-size: var(--cy-font-micro);
  color: var(--cy-color-text-tertiary);
}
.ov-lb-empty { margin: 0 var(--cy-page-x); }
.ov-lb-note {
  margin: 0 var(--cy-page-x);
  padding-top: var(--cy-space-2);
  font-size: var(--cy-font-caption);
  color: var(--cy-color-text-tertiary);
}

/* 商家(2026-08-20 重设计:卡体样式在 components/cy/merchant-card 的 venue 变体,页面只留间距) */
.mcard { display: block; margin-bottom: var(--cy-space-3); }

/* 评论 */
.post-moderation { display: flex; flex-wrap: wrap; gap: var(--cy-space-3); }
.post-moderation__action {
  min-height: var(--cy-btn-h);
  display: inline-flex;
  align-items: center;
  color: var(--club-text-muted);
  font-size: var(--cy-font-label);
}
.comments {
  margin: var(--cy-space-2) var(--cy-page-x) var(--cy-space-3) calc(var(--cy-page-x) + var(--cy-space-8) + var(--cy-space-3));
  padding: var(--cy-space-2);
  background: transparent;
  border-radius: var(--cy-radius-sm);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}
.comment { font-size: var(--cy-font-label); line-height: 1.6; color: var(--club-text); }
.comment-name { color: var(--cy-info); }
.comment-mod { min-height: var(--cy-btn-h); margin-left: var(--cy-space-1-5); display: inline-flex; align-items: center; color: var(--club-text-muted); font-size: var(--cy-font-caption); }
.comment-bar { display: flex; align-items: center; gap: var(--cy-space-1-5); margin-top: var(--cy-legacy-14); }
.comment-input {
  flex: 1; height: 64rpx; background: var(--club-surface-2);
  border-radius: var(--cy-radius-pill); padding: 0 var(--cy-space-3); font-size: var(--cy-font-label); color: var(--club-text);
}
.comment-send {
  min-height: var(--cy-btn-h); box-sizing: border-box; flex-shrink: 0; display: flex; align-items: center; padding: 0 var(--cy-legacy-26); border-radius: var(--cy-radius-pill);
  background: var(--club-accent); color: #fff; font-size: var(--cy-font-label);
}
.comment-send.disabled { opacity: 0.5; }

.post-kind-toggle {
  margin-top: var(--cy-space-2); min-height: var(--cy-btn-h); padding: 0 var(--cy-space-3);
  display: flex; align-items: center; justify-content: space-between; box-sizing: border-box;
  border: 1rpx solid var(--cy-border-line); border-radius: var(--cy-radius-sm);
  color: var(--club-text-muted); font-size: var(--cy-font-label);
}
.post-kind-toggle.on { border-color: var(--club-accent); color: var(--club-accent); background: var(--cy-brand-soft); }
.post-edit-sheet, .post-history-sheet { padding: 0 var(--cy-page-x) calc(var(--cy-space-5) + env(safe-area-inset-bottom)); }
.post-edit-input { width: 100%; min-height: 220rpx; padding: var(--cy-space-3); box-sizing: border-box; border-radius: var(--cy-radius-sm); background: var(--club-surface-2); color: var(--club-text); font-size: var(--cy-font-body); line-height: var(--cy-leading-normal); }
.post-edit-note, .post-history-state { margin-top: var(--cy-space-2); color: var(--club-text-muted); font-size: var(--cy-font-caption); line-height: var(--cy-leading-normal); }
.post-edit-submit { margin-top: var(--cy-space-4); min-height: var(--cy-btn-h); display: flex; align-items: center; justify-content: center; border-radius: var(--cy-radius-sm); background: var(--cy-btn-solid-bg); color: var(--cy-btn-solid-fg); font-size: var(--cy-font-body); font-weight: 600; }
.post-edit-submit.disabled { opacity: 0.5; }
.post-history-row { padding: var(--cy-space-3) 0; border-bottom: 1rpx solid var(--cy-border-card); }
.post-history-meta { color: var(--club-text-muted); font-size: var(--cy-font-caption); }
.post-history-content { margin-top: var(--cy-space-1); color: var(--club-text); font-size: var(--cy-font-body); line-height: var(--cy-leading-normal); white-space: pre-wrap; }

/* 空态 / 错误 */
.empty { padding: 40rpx var(--cy-space-4); text-align: center; } /* ds-ok: 40rpx 无匹配 token */
.empty-tit { font-size: var(--cy-font-body); color: var(--club-text); font-weight: 600; }
.empty-sub { margin-top: var(--cy-legacy-10); font-size: var(--cy-font-label); color: var(--club-text-muted); line-height: 1.5; }
.error-state { padding: 160rpx var(--cy-space-5) var(--cy-space-7); } /* ds-ok: 160rpx/80rpx 无匹配 token */
.error-state .empty-tit { font-size: var(--cy-font-title); font-weight: 800; }
.error-state .empty-sub { max-width: 560rpx; margin: var(--cy-legacy-18) auto 0; }
.error-actions { display: flex; gap: var(--cy-legacy-18); margin: var(--cy-space-5) auto 0; max-width: 560rpx; }
.error-primary, .error-secondary {
  flex: 1; height: var(--cy-btn-h); line-height: var(--cy-btn-h); border-radius: var(--cy-radius-sm);
  font-size: var(--cy-font-body); font-weight: 700; box-sizing: border-box;
}
.error-primary { background: var(--cy-btn-solid-bg); color: var(--cy-btn-solid-fg); }
.error-secondary {
  background: var(--club-surface); color: var(--club-text);
  border: 2rpx solid rgba(255,255,255,0.12);
}

.safe-bottom { height: calc(40rpx + env(safe-area-inset-bottom)); }

/* P1 带领场标识 */

/* 团核销码 · 选场次(sheet 内容,弹窗化 2026-07-31) */
.gc-hint { padding: 0 var(--cy-page-x) var(--cy-space-3); color: var(--cy-text-secondary); font-size: var(--cy-font-caption); }
.gc-item { margin: 0 var(--cy-page-x) var(--cy-space-3); padding: var(--cy-space-4) var(--cy-space-3-5); display: flex; justify-content: space-between; align-items: center; border-radius: var(--cy-radius-sm); background: var(--cy-bg-card-2); font-size: var(--cy-font-body); color: var(--cy-text-title); }

/* —— 管理 tab 收敛(2026-08-26) —— */
/* ① 唯一显眼的东西:现在要做。承接 ownerStage 五态 ——
   文案说的是**哪一层**的事(CU-C-89:承接阶段是俱乐部级的,不点名单个项目)。 */
.manage-now {
  margin: 0 var(--cy-space-4) var(--cy-space-3);
  padding: var(--cy-space-4);
  border-radius: var(--cy-radius-lg);
  background: var(--club-surface);
  border: 1rpx solid var(--club-glass-border);
}
.manage-now-kicker {
  display: flex;
  align-items: center;
  gap: var(--cy-space-1-5);
  font-size: var(--cy-font-caption);
  color: var(--club-text-muted);
}
.manage-now-dot {
  width: 12rpx; height: 12rpx; border-radius: 50%;
  background: var(--cy-color-status-warning);
}
.manage-now--accepted .manage-now-dot { background: var(--cy-color-status-success); }
.manage-now--error .manage-now-dot { background: var(--cy-color-status-danger); }
.manage-now-title {
  margin-top: var(--cy-space-2);
  font-size: var(--cy-font-title);
  font-weight: 700;
  color: var(--club-text);
  line-height: var(--cy-leading-tight);
}
.manage-now-hint {
  margin-top: var(--cy-space-1-5);
  font-size: var(--cy-font-label);
  color: var(--club-text-muted);
  line-height: var(--cy-leading-normal);
}
.manage-now-timeline { display: block; margin-top: var(--cy-space-3); }
.manage-now-acts { display: flex; gap: var(--cy-space-2); margin-top: var(--cy-space-3); }
.manage-now-btn {
  flex: 1;
  height: var(--cy-btn-h);
  display: flex; align-items: center; justify-content: center;
  border-radius: var(--cy-radius-pill);
  font-size: var(--cy-font-label);
  font-weight: 700;
}
.manage-now-btn--minor { flex: 0 0 auto; padding: 0 var(--cy-space-4); }

/* ② 项目:卡片自己说明自己,不再单起一行 section 标题 */
.manage-group {
  border-radius: var(--cy-radius-lg);
  background: var(--club-surface);
  overflow: hidden;
}
.manage-add-row {
  display: flex; align-items: center; gap: var(--cy-space-2);
  min-height: var(--cy-btn-h);
  padding: 0 var(--cy-space-3);
  border-top: 1rpx solid var(--club-glass-border);
  font-size: var(--cy-font-label);
  color: var(--club-text-muted);
}
.manage-add-sign { flex: none; }

/* ③ 经营区块:收起时一行带摘要,展开在原地铺开 */
.manage-fold-row {
  display: flex; align-items: center; gap: var(--cy-space-2);
  padding: var(--cy-space-3);
  border-radius: var(--cy-radius-lg);
  background: var(--club-surface);
}
.manage-fold-main { flex: 1; min-width: 0; }
.manage-fold-title { display: block; font-size: var(--cy-font-body); font-weight: 500; color: var(--club-text); }
.manage-fold-sub {
  display: block; margin-top: var(--cy-legacy-4);
  font-size: var(--cy-font-caption); color: var(--club-text-muted);
}
/* 展开 300ms emphasized-decelerate / 收起 200ms accelerate —— M3 easing token,
   exit 比 enter 短。chevron 同曲线转 90°。
   2026-09-02:原来这四条写的是字面 cubic-bezier / ms,数值本身对(和稿 40:3 一致),
   但没有入口 —— 调一次动效要全仓找字面量。现改读 --cy-motion-* / --cy-ease-* 档。 */
.manage-fold-chevron {
  flex: none;
  transition: transform var(--cy-motion-collapse) var(--cy-ease-accelerate);
}
.manage-fold-chevron.open {
  transform: rotate(90deg);
  transition: transform var(--cy-motion-expand) var(--cy-ease-emphasized-decelerate);
}
.manage-fold-panel {
  padding: var(--cy-space-2) 0 var(--cy-space-1);
  animation: cy-fold-in var(--cy-motion-expand) var(--cy-ease-emphasized-decelerate) both;
}

/* ⚙ 俱乐部设置弹窗 */
.cset { padding-bottom: var(--cy-space-2); }
.cset-row {
  display: flex; align-items: center; gap: var(--cy-space-2);
  padding: var(--cy-space-3) 0;
  border-bottom: 1rpx solid var(--club-glass-border);
}
.cset-main { flex: 1; min-width: 0; }
.cset-titlerow { display: flex; align-items: center; gap: var(--cy-space-1-5); }
.cset-title { font-size: var(--cy-font-body); font-weight: 500; color: var(--club-text); }
.cset-sub {
  display: block; margin-top: var(--cy-legacy-4);
  font-size: var(--cy-font-caption); color: var(--club-text-muted);
}
.cset-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: var(--cy-color-status-warning); }
.cset-count {
  padding: 2rpx var(--cy-space-1-5); /* ds-ok: 计数角标内边距,与帖文身份标签同口径 */
  border-radius: var(--cy-radius-pill);
  background: var(--club-glass-border);
  font-size: var(--cy-font-micro);
  color: var(--club-text-muted);
}
/* 「带上一次游玩记录」:选中后是一枚可撤的 chip,没选时是一行浅入口。
   两者占同一个位置,不叠加 —— 已经带了还留着「带上」入口会让人以为能带两条。 */
.post-ref, .post-ref-add {
  margin-top: var(--cy-space-2); min-height: 72rpx;
  display: flex; align-items: center; gap: var(--cy-space-2);
  padding: 0 var(--cy-space-3);
  border-radius: var(--cy-radius-pill); background: var(--club-glass-border);
  font-size: var(--cy-font-caption); color: var(--club-text-muted);
}
.post-ref-name { flex: 1; min-width: 0; color: var(--club-text); overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.post-ref-del { flex: none; display: flex; align-items: center; justify-content: center; min-width: var(--cy-btn-h); min-height: var(--cy-btn-h); }
.post-ref-ico { flex: none; }
.post-ref-pick { padding: 0 var(--cy-page-x) var(--cy-space-4); max-height: 60vh; overflow-y: auto; }
.post-ref-opt {
  min-height: 104rpx; display: flex; align-items: center; gap: var(--cy-space-2);
  border-bottom: 1rpx solid var(--club-glass-border);
}
.post-ref-opt-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 6rpx; }
.post-ref-opt-name { font-size: var(--cy-font-body); color: var(--club-text); overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.post-ref-opt-sub { font-size: var(--cy-font-caption); color: var(--club-text-muted); }
.post-ref-opt-arrow { flex: none; color: var(--club-text-muted); }

/* 开放设置那一行右侧的状态字。稿上是个开关,这里用文字态 ——
   点整行切换,状态字就是当前值,保存中也在同一位置说话,不另起一处提示。 */
.cset-switch { flex: none; font-size: var(--cy-font-caption); color: var(--club-text-muted); }
.cset-inline-error { display: block; padding-bottom: var(--cy-space-3); }
.cset-chevron { flex: none; transition: transform var(--cy-motion-collapse) var(--cy-ease-accelerate); }
.cset-chevron.open { transform: rotate(90deg); transition: transform var(--cy-motion-expand) var(--cy-ease-emphasized-decelerate); }
.cset-panel {
  padding: var(--cy-space-2) 0 var(--cy-space-3);
  animation: cy-fold-in var(--cy-motion-expand) var(--cy-ease-emphasized-decelerate) both;
}

/* 行内展开的内容进场(稿 40:3「行内展开」/ 42:168「内容自 -4px 归位」)。
 * ⚠️ 只有一组 keyframes,两处折叠面板共用 —— 不许每个折叠点再抄一份。
 * ⚠️ 为什么是 keyframes 而不是 transition(motion-property-ratchet 要求先问这一句):
 *   两处面板都是 `wx:if` 挂载,挂载那一帧没有可补间的起始态,transition 根本不会播。
 *   而且折叠行点一下就翻转、再点是**卸载**不是重触发,不存在该门禁要防的
 *   「快速重触发从 0 重启导致抖」。
 * ⚠️ 稿写的是「height 与内容不透明度同步插值」,这里只做了不透明度 + 位移:
 *   height/max-height 是布局属性,受 LAYOUT_ANIMATION_CEILING 只减不增的棘轮管,
 *   为一个折叠面板去顶高那条上限不划算。可见结果(内容淡入 + 自 -4px 归位)已按稿落地,
 *   差的是外框高度不补间 —— 记在 PR 的「与稿出入」里。 */
@keyframes cy-fold-in {
  from { opacity: 0; transform: translateY(-4px); }
  to   { opacity: 1; transform: translateY(0); }
}
/* ★ 稿 40:3 最后一行「减少动态效果兜底」:
 *   「全部改成 150ms 纯淡入淡出;不缩放、不位移;sheet 直接出现」。
 * 所以这里不是简单 animation:none(那样内容会硬闪出来),而是换成只补间不透明度的
 * cy-fade-in(style/fade-in.wxss 里那一组,全站共用),时长压到 crossfade(150ms)。
 * 位移是前庭敏感用户真正不适的那一半,必须去掉;淡入本就该保留(Emil「减弱不是归零」)。 */
.cy-motion-reduced .manage-fold-panel,
.cy-motion-reduced .cset-panel {
  animation-name: cy-fade-in;
  animation-duration: var(--cy-motion-crossfade);
  animation-timing-function: linear;
}
.cset-panel-act {
  min-height: var(--cy-btn-h);
  display: flex; align-items: center; justify-content: flex-end;
  font-size: var(--cy-font-label);
  color: var(--club-text-muted);
  /* CU-C-61:「邀请成员」是原生 <button open-type="share">。 */
  margin: 0; padding: 0; border: 0; line-height: normal;
  width: 100%;
  background: transparent;
}
.cset-panel-act::after { border: 0; }

/* 发帖收起态 */
/* Figma 285:395:头像 40 + 右列(昵称 / 提示语 / 工具栏),px12 py13 gap12。
   原来是一条 pill,稿把它展成三行 —— 工具栏三枚图标就是稿画的入口 */
.post-composer-collapsed {
  display: flex;
  align-items: flex-start;
  gap: var(--cy-space-3);
  padding: 26rpx var(--cy-space-3); /* ds-ok: py13 = 26rpx */
  border-bottom: 1rpx solid var(--cy-color-border-subtle);
}
.post-composer-me { flex: none; }
.post-composer-col { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: var(--cy-legacy-4); }
.post-composer-who {
  font-size: var(--cy-type-card-title);
  font-weight: 500;
  color: var(--cy-color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.post-composer-ph { font-size: var(--cy-type-card-title); color: var(--cy-color-text-secondary); }
.post-composer-tools { display: flex; align-items: center; gap: var(--cy-space-5); padding-top: var(--cy-space-3); }
.post-composer-ico { flex: none; color: var(--cy-color-text-secondary); }
.post-cancel {
  min-height: var(--cy-btn-h);
  display: flex; align-items: center;
  padding: 0 var(--cy-space-3);
  font-size: var(--cy-font-label);
  color: var(--club-text-muted);
}

/* —— 概览 tab(Figma N3 23:2 / N5 24:216 / N6 24:355)——
   页边 16 · 区块间距 16。简介直接铺开:全局规约「标题下不要小标题」,
   原「俱乐部简介」那行 label 已撤。 */
.ov { padding-top: var(--cy-space-3-5); }
.ov-intro {
  margin: 0 var(--cy-page-x) var(--cy-space-4);
  font-size: var(--cy-font-body);
  line-height: 1.4;
  color: var(--cy-color-text-secondary);
}

/* Facts 三宫格(23:4):主理人 / 等级 / 所在城市 */
.ov-facts {
  display: flex;
  gap: var(--cy-space-4);
  margin: 0 var(--cy-page-x) var(--cy-space-4);
}
.ov-fact {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx; /* ds-ok: Figma gap3 */
  padding: var(--cy-space-3) var(--cy-space-2-5) var(--cy-space-3) var(--cy-space-3-5);
  border-radius: var(--cy-radius-lg);
  background: var(--cy-color-bg-surface-strong);
}
.ov-fact-value {
  max-width: 100%;
  font-size: var(--cy-font-label);
  font-weight: 600;
  color: var(--cy-color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ov-fact-label { font-size: var(--cy-font-micro); color: var(--cy-color-text-secondary); }

/* 分区头(23:14 / 23:39):标题 + 分隔线 + 右侧文字链 */
.ov-head {
  display: flex;
  align-items: center;
  gap: var(--cy-space-2);
  margin: 0 var(--cy-page-x) var(--cy-space-4);
}
.ov-head-tit { font-size: var(--cy-type-card-title); font-weight: 600; color: var(--cy-color-text-primary); }
.ov-head-rule { flex: 1; min-width: 0; height: 1rpx; } /* 同 .ev-sec-rule:稿是透明 spacer,不画线 */
.ov-head-link {
  flex: none;
  min-height: var(--cy-btn-h);
  display: inline-flex;
  align-items: center;
  gap: var(--cy-legacy-4);
  font-size: var(--cy-font-caption);
  font-weight: 500;
  color: var(--cy-color-text-secondary);
  /* CU-C-61:「邀请成员」是原生 <button open-type="share">。 */
  margin: 0;
  padding: 0;
  border: 0;
  line-height: normal;
  background: transparent;
}
.ov-head-link::after { border: 0; }
.ov-head-link-ico { flex: none; }
/* 下拉三角:图标集里没有向下 chevron,把 slide-arrow(向右 chevron)转 90° —— 
   仓库规约禁止拿 ▾ 这种字符当图标。 */
.ov-head-caret { flex: none; transform: rotate(90deg); }
.ev-sec-link-ico { flex: none; }

/* 成员横向头像条(23:18):44px 圆头像 + 名字 + 角色标,第 5 位是「+N」溢出位 */
.ov-strip {
  display: flex;
  align-items: flex-start;
  gap: var(--cy-space-2-5);
  margin: 0 var(--cy-page-x) var(--cy-space-4);
}
.ov-strip-item {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx; /* ds-ok: Figma gap5 */
}
.ov-strip-avatar {
  width: var(--cy-space-8);
  height: var(--cy-space-8);
  border-radius: 50%;
  flex: none;
  background: var(--cy-color-bg-surface-strong);
}
.ov-strip-name {
  max-width: 100%;
  font-size: var(--cy-font-micro);
  font-weight: 500;
  color: var(--cy-color-text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ov-strip-role { font-size: 18rpx; } /* ds-ok: Figma 9px 角色标,micro(20rpx) 之下的一次性例外 */
.ov-strip-role--owner { color: var(--cy-color-status-warning); }
.ov-strip-role--admin { color: var(--cy-color-text-tertiary); }

/* Locked(25:2 / 25:5):未加入时成员条与榜单整块换成一张说明卡 */
.ov-locked {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--cy-space-1-5);
  margin: 0 var(--cy-page-x) var(--cy-space-4);
  padding: var(--cy-space-4) 28rpx;
  border-radius: var(--cy-radius-lg);
  background: var(--cy-color-bg-elevated);
}
.ov-locked-tit { font-size: var(--cy-font-label); font-weight: 600; color: var(--cy-color-text-secondary); }
.ov-locked-sub { font-size: var(--cy-font-caption); color: var(--cy-color-text-tertiary); text-align: center; }

/* Figma「管理员 管理页面」B2 可对接的活动。与同屏「可对接商家」同构:卡内不放写操作。 */
.pool-card { display: flex; flex-direction: column; gap: var(--cy-space-2); box-sizing: border-box; margin-bottom: var(--cy-space-3); padding: var(--cy-space-4); border-radius: var(--cy-radius-lg); background: var(--cy-color-bg-raised); }
.pool-card.is-dim { opacity: 0.55; }
.pool-card-top { display: flex; align-items: baseline; justify-content: space-between; gap: var(--cy-space-3); }
.pool-card-name { flex: 1; min-width: 0; overflow: hidden; color: var(--cy-color-text-primary); font-size: var(--cy-font-label); font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.pool-card-state { flex: none; color: var(--cy-color-text-tertiary); font-size: var(--cy-font-caption); }
.pool-card-meta { color: var(--cy-color-text-tertiary); font-size: var(--cy-font-caption); }
.pool-card-foot { display: flex; align-items: baseline; justify-content: space-between; gap: var(--cy-space-3); }
.pool-card-deadline { color: var(--cy-color-text-secondary); font-size: var(--cy-font-caption); }
.pool-card-cta { display: flex; flex: none; align-items: center; gap: 4rpx; min-height: 88rpx; padding: 0 var(--cy-space-2); /* 就地申请可点:44pt 命中区 */ color: var(--cy-color-text-primary); font-size: var(--cy-font-caption); font-weight: 700; }
/* 稿 M 268:223:设置弹窗按组分段,组标题是小号次要色 */
.cset-group { display: block; margin: 32rpx var(--cy-page-x) 8rpx; color: var(--cy-text-secondary); font-size: var(--cy-font-caption); }
.cset-group:first-of-type { margin-top: 8rpx; }


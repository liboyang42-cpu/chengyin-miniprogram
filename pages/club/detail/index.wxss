.manage-project-main { flex: 1; min-width: 0; margin-left: var(--cy-space-2-5); }
.manage-project-name { color: var(--club-text); font-size: var(--cy-font-body); font-weight: 700; }
.manage-project-meta { margin-top: var(--cy-space-1); color: var(--club-text-muted); font-size: var(--cy-font-caption); }
.manage-project-director {

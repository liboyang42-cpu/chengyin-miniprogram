.ai-plan-input { flex: 1; box-sizing: border-box; height: var(--cy-btn-h); line-height: var(--cy-btn-h); padding: 0 var(--cy-space-2-5); border-radius: var(--cy-radius-md); background: var(--club-surface); border: 1rpx solid var(--club-glass-border); font-size: var(--cy-font-body); color: var(--club-text); }
.ai-plan-input--sm { flex: 0 0 240rpx; }

  font-weight: 700;
  box-sizing: border-box;
}
.manage-message, .manage-invite {
  display: flex;
  align-items: center;
  padding: var(--cy-space-2) 0;
  border-bottom: 1rpx solid var(--cy-color-border-subtle);
  box-sizing: border-box;
}
.manage-message { min-height: 88rpx; }
.manage-invite { min-height: 88rpx; }
.manage-message-main, .manage-invite-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: var(--cy-space-1); }

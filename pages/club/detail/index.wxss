.manage-message-time { margin-left: var(--cy-space-2); }
.manage-invite-status { margin-left: var(--cy-space-2); color: var(--club-text-muted); font-size: var(--cy-font-caption); font-weight: 700; }
.manage-invite-status--pending { color: var(--club-accent); }
.manage-invite-status--accepted { color: var(--cy-success); }
.manage-invite-status--rejected, .manage-invite-status--expired { color: var(--cy-danger); }
.manage-invite-status--cancelled, .manage-invite-status--replaced { color: var(--cy-info); }

/* AI 策划活动 sheet(cy-sheet slot 内) */
.ai-plan-hint { font-size: var(--cy-font-caption); color: var(--club-text-muted); line-height: 1.6; margin-bottom: var(--cy-space-2); }
.ai-plan-chips { display: flex; flex-wrap: wrap; gap: var(--cy-space-1-5); margin-bottom: var(--cy-space-2); }
.ai-plan-chip { padding: var(--cy-legacy-10) var(--cy-space-2-5); border-radius: var(--cy-radius-pill); font-size: var(--cy-font-caption); color: var(--club-text-muted); background: var(--club-surface); border: 1rpx solid var(--club-glass-border); }
.ai-plan-idea { width: 100%; box-sizing: border-box; height: 140rpx; padding: var(--cy-space-2-5); border-radius: var(--cy-radius-md); background: var(--club-surface); border: 1rpx solid var(--club-glass-border); font-size: var(--cy-font-body); color: var(--club-text); }

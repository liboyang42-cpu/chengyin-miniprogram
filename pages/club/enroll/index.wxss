page { background: var(--cy-bg-page); }
/* fill 真正居中(标题下方到屏幕底部的剩余空间)靠 cy-empty--fill 的 flex:1,
   前提是这层父容器是 flex column 且有确定高度——2026-07-31 根因修复配套改动 */
.page { min-height: 100vh; padding-bottom: var(--cy-space-5); display: flex; flex-direction: column; }
/* cy-empty 是 isolated 组件,:host 自带 display:block,组件内部的 flex:1 撑不动
   这层 host 本身——host 要在页面侧显式声明也是 flex item 才会真正吃满剩余空间。 */
cy-empty { display: flex !important; flex: 1 !important; min-height: 0; }

.ep1 { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }

/* 导航 */
.sub { padding: 8rpx var(--cy-page-x) var(--cy-space-2-5); font-size: var(--cy-font-label); color: var(--cy-text-secondary); }

/* 状态 */
.refreshing { padding: 0 var(--cy-page-x) var(--cy-space-2); color: var(--cy-text-secondary); font-size: var(--cy-font-caption); }
.list-inline-error { margin: 0 var(--cy-page-x) var(--cy-space-3); }

/* 列表 */
.list { padding: 0 var(--cy-page-x); }
/* 整页上的卡 = bg-elevated。--cy-bg-card 解析到 bg-surface(#0A0A0B),与页黑几乎同色。 */
.team { background: var(--cy-color-bg-elevated); border-radius: var(--cy-radius-lg); margin-bottom: 24rpx; overflow: hidden; }
.team-head { display: flex; align-items: center; padding: var(--cy-space-4); transition: transform var(--cy-motion-press) var(--cy-ease-out), background var(--cy-motion-fast) var(--cy-ease-out); }
.team-head--pressed { transform: scale(.99); background: var(--cy-bg-subtle); }
.team-cover { width: 200rpx; height: 200rpx; border-radius: var(--cy-radius-sm); flex-shrink: 0; background: var(--cy-bg-subtle); }
.team-main { flex: 1; min-width: 0; padding: 0 var(--cy-space-3); }
.team-name { font-size: var(--cy-font-title); font-weight: 600; color: var(--cy-text-title); }
.team-meta { margin-top: var(--cy-space-1-5); font-size: var(--cy-font-body); color: var(--cy-text-secondary); }
.team-arrow { color: var(--cy-text-placeholder); transform: rotate(90deg); transition: transform var(--cy-dur); flex-shrink: 0; }
.team-arrow.open { transform: rotate(-90deg); }

/* 展开体 */
/* 展开体左右内边距跟 .team-head 的 space-4 对齐,整张名册卡内边距统一 */
.team-body { padding: 0 var(--cy-space-4) 8rpx; border-top: 2rpx solid var(--cy-border-card); animation: club-team-expand var(--cy-motion-standard) var(--cy-ease-out) both; }

.ticket { padding: 24rpx 0; border-bottom: 2rpx solid var(--cy-border-card); }
.ticket:last-child { border-bottom: none; }
.ticket-top { display: flex; align-items: center; justify-content: space-between; }
.ticket-name { font-size: var(--cy-font-body); font-weight: 500; color: var(--cy-color-text-primary); flex: 1; min-width: 0; }
.ticket-num { flex-shrink: 0; margin-left: var(--cy-space-2-5); font-size: var(--cy-font-body); font-weight: 600; color: var(--cy-color-text-primary); text-align: right; }

.regs { margin-top: var(--cy-legacy-18); }
/* 成员行:行高 88rpx、行距 space-2(用户反馈「卡片需要大一点」) */
.reg { display: flex; align-items: center; justify-content: space-between; padding: var(--cy-space-1-5) 0; min-height: 88rpx; box-sizing: border-box; }
.reg + .reg { margin-top: var(--cy-space-2); }
.reg-l { display: flex; align-items: center; flex: 1; min-width: 0; }
.reg-ava { width: 56rpx; height: 56rpx; border-radius: 50%; background: var(--cy-bg-subtle); flex-shrink: 0; }
.reg-name { font-size: var(--cy-font-label); color: var(--cy-text-body); padding: 0 16rpx 0 var(--cy-legacy-14); flex: 1; min-width: 0; }
/* 退款按钮从品牌紫描边改白描边(按钮走黑白系,紫只留给强调时刻) */
.reg-refund { min-height: var(--cy-btn-h); box-sizing: border-box; flex-shrink: 0; display: flex; align-items: center; font-size: var(--cy-font-label); color: var(--cy-text-title); border: 2rpx solid var(--cy-border-line); padding: 0 24rpx; border-radius: var(--cy-radius-lg); }
.reg-action.is-disabled .reg-refund { opacity: var(--cy-opacity-disabled); }
.reg-action { display: flex; flex-direction: column; align-items: flex-end; gap: var(--cy-space-1-5); max-width: 380rpx; }

/* 「谁能退款」这句原来在页脚,离展开的名册十几屏远;挪进展开卡内,
   跟真正的退款按钮同屏 —— 管理员在这里才知道自己为什么没有那个钮。 */
.detail-note { padding: 24rpx 0 8rpx; font-size: var(--cy-font-caption); color: var(--cy-color-text-tertiary); line-height: var(--cy-leading-normal); }

@keyframes club-team-expand {
  0% { opacity: 0; transform: translateY(-8rpx); }
  100% { opacity: 1; transform: translateY(0); }
}
.cy-motion-reduced .team-head,
.cy-motion-reduced .team-arrow { transition: none !important; }
.cy-motion-reduced .team-body { animation: none !important; }

/* 区块内空态:上面给整屏态 cy-empty 配了 flex:1,这两处在票种/名册里,退回块级 */
.enroll-inline-empty { display: block !important; flex: none !important; }

/* 核销台账:名册每一行的到场状态。数据早就在回包里,原来只用来算能不能退款。 */
.reg-checkin { flex: none; margin-right: var(--cy-space-2); font-size: var(--cy-font-caption); }
.reg-checkin--done { color: var(--cy-color-status-success); }
.reg-checkin--pending { color: var(--cy-color-status-warning); }
.reg-checkin--unknown { color: var(--cy-text-secondary); }

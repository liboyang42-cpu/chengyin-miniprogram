<cy-scene-sheet show="{{show}}" variant="half" title="{{title}}" closable maskClosable bind:close="onClose">
  <view class="cdis__body">
    <cy-club-director-row-list rows="{{incidents}}" surface="raised" selectable bind:rowtap="onIncidentTap" />

    <text class="cdis__section-title">{{modeSectionTitle}}</text>
    <cy-club-director-chip-group options="{{modes}}" value="{{selectedMode}}" bind:change="onModeChange" />

    <view
      class="cdis__primary {{confirmDisabled ? 'is-disabled' : ''}}"
      bindtap="onConfirmTap"
      aria-role="button" aria-label="{{confirmText}}"
      hover-class="cy-pressed" hover-stay-time="80"
    >{{confirmText}}</view>
    <text class="cdis__caption" wx:if="{{caption}}">{{caption}}</text>
  </view>
</cy-scene-sheet>

@import '../../../style/merchant-light.wxss';
@import '../style/merchant-finance.wxss';

page { background: var(--cy-bg-page); }
.acl-page { min-height: 100vh; box-sizing: border-box; background: var(--cy-bg-page); display: flex; flex-direction: column; }
.acl-scroll { flex: 1; min-height: 0; }
.acl-shell { box-sizing: border-box; padding: 0 var(--cy-page-x) var(--cy-space-8); }
.acl-filter { display: block; margin-bottom: var(--cy-space-3); }
.acl-search { display: block; margin-bottom: var(--cy-space-5); }
.acl-search-hint { display: flex; align-items: center; justify-content: space-between; gap: var(--cy-space-2); margin: calc(0rpx - var(--cy-space-3)) var(--cy-space-1) var(--cy-space-4); color: var(--cy-text-secondary); font-size: var(--cy-font-caption); }
.acl-search-more { min-height: var(--cy-btn-h); display: flex; align-items: center; flex-shrink: 0; color: var(--cy-text-title); font-weight: 600; }
.acl-group-head { display: flex; align-items: baseline; justify-content: space-between; gap: var(--cy-space-2); margin: 0 var(--cy-space-1) var(--cy-space-2); }
.acl-group-label { color: var(--cy-text-title); font-size: var(--cy-font-subtitle); font-weight: 700; }
.acl-group-total { color: var(--cy-text-secondary); font-size: var(--cy-font-label); font-variant-numeric: tabular-nums; }
.acl-row { min-height: var(--cy-btn-h); }
.acl-avatar { width: var(--cy-btn-h); height: var(--cy-btn-h); flex-shrink: 0; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: var(--cy-bg-subtle); color: var(--cy-text-title); }
.acl-status--warning { color: var(--cy-color-status-warning); }
.acl-status--success { color: var(--cy-color-status-success); }
.acl-status--neutral { color: var(--cy-text-secondary); }
.acl-activity { margin-top: var(--cy-space-1); overflow: hidden; white-space: nowrap; text-overflow: ellipsis; color: var(--cy-text-secondary); font-size: var(--cy-font-caption); }
.acl-more { display: block; padding: var(--cy-space-4) 0; text-align: center; color: var(--cy-text-secondary); font-size: var(--cy-font-caption); }

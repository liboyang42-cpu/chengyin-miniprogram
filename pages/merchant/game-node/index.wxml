<view class="gn-page theme-merchant m-flush-nav" style="padding-top: {{statusBarHeight + navBarHeight}}px;">
  <cy-toast id="cy-toast" />
  <cy-loading-mask id="cy-loading" />
  <cy-modal-host id="cy-modal-host" />
  <cy-access-gate id="cy-access-gate" kind="merchant" need="" />
  <!-- 2026-09-18 ✕统一裁决:打卡码弹层显示时页面导航退场,唯一出口是弹层✕/遮罩,不再双出口 -->
  <cy-nav-bar title="本站准备与运行" wx:if="{{!checkinVisible}}" />

  <view class="gn-unknown gn-unknown--global" wx:if="{{writeState === 'unknown'}}">
    <view class="gn-unknown-copy">
      <text class="gn-unknown-title">操作结果待确认</text>
      <text class="gn-unknown-sub">{{writeMessage}}</text>
    </view>
    <view class="gn-unknown-actions">
      <cy-btn size="sm" variant="secondary" bindtap="confirmUnknownWrite">确认操作结果</cy-btn>
      <cy-btn wx:if="{{canRetryUnknownWrite}}" size="sm" variant="secondary" bindtap="retryUnknownWrite">重试原操作</cy-btn>
    </view>
  </view>

  <cy-skeleton wx:if="{{viewState === 'loading'}}" class="gn-state" type="card" count="{{3}}" />
  <cy-empty wx:elif="{{viewState === 'empty'}}" class="gn-state cy-fade-in" kind="empty" fill="{{true}}" size="lg"
            title="暂无本站任务" sub="俱乐部或主办方发出站点邀请后，会显示在这里" />
  <cy-error wx:elif="{{viewState === 'business-error'}}" class="gn-state cy-fade-in" fill="{{true}}" size="lg"
            title="暂时不能查看本站" sub="{{errorMessage}}" bind:retry="retryLoad" auto-back />
  <cy-error wx:elif="{{viewState === 'network-error'}}" class="gn-state cy-fade-in" fill="{{true}}" size="lg"
            title="本站状态加载失败" sub="{{errorMessage}}" bind:retry="retryLoad" auto-back />

  <scroll-view wx:elif="{{viewState === 'ready'}}" scroll-y class="gn-scroll cy-fade-in" enhanced show-scrollbar="{{false}}">
    <view class="gn-content">
      <cy-dropdown wx:if="{{stations.length > 1}}" range="{{stations}}" range-key="nodeName"
              value="{{stationIndex}}" bind:change="onStationSelect">
        <view class="gn-station-picker" aria-role="button" aria-label="切换本站">
          <text>{{station.nodeName}}</text>
          <view class="gn-chevron"><text>切换</text><cy-icon name="arrow-right" size="28" /></view>
        </view>
      </cy-dropdown>

      <view class="gn-hero">
        <view class="gn-hero-head">
          <view class="gn-hero-copy">
            <text class="gn-eyebrow">{{station.stationCode || '本站任务'}}</text>
            <text class="gn-title">{{station.nodeName || '未命名站点'}}</text>
          </view>
          <text class="gn-status gn-status--{{summary.tone}}">{{station.statusText}}</text>
        </view>
        <text class="gn-summary">{{summary.text}}</text>
        <view class="gn-facts">
          <view class="gn-fact"><text class="gn-fact-value">{{station.capacity || 0}}</text><text class="gn-fact-label">接待容量</text></view>
          <view class="gn-fact"><text class="gn-fact-value">{{station.pendingVerificationCount}}</text><text class="gn-fact-label">待核验</text></view>
          <view class="gn-fact"><text class="gn-fact-value">{{station.playable ? '可接待' : '不可接待'}}</text><text class="gn-fact-label">玩家状态</text></view>
        </view>
      </view>

      <view class="gn-inline-error" wx:if="{{writeState !== 'unknown' && writeMessage}}">{{writeMessage}}</view>

      <view class="gn-card gn-runbook">
        <view class="gn-section-head">
          <!-- 稿 469:1002 的标题是「这一站怎么接待」——「本站执行卡」是内部叫法,
               商家看不出它跟自己今晚要干的事有什么关系。 -->
          <view><text class="gn-section-title">这一站怎么接待</text><text class="gn-section-sub">商家只做什么 —— 剧情你不用知道</text></view>
        </view>
        <block wx:if="{{station.playerTask}}">
          <!-- 稿 469:1002 的顺序是「你要做的 → 玩家会做什么 → 不能说的」。
               原来把「玩家会做什么」排第一 —— 商家翻开这张卡,第一眼要看的是自己要干什么,
               不是先读一段别人的剧本。 -->
          <view class="gn-runbook-row">
            <text class="gn-runbook-label">你要做的</text>
            <text class="gn-runbook-copy">{{station.merchantInstruction || '按核验编号确认玩家已完成公开任务；不代替玩家解题。'}}</text>
          </view>
          <view class="gn-runbook-row">
            <text class="gn-runbook-label">玩家会做什么</text>
            <text class="gn-runbook-copy">{{station.playerTask.prompt}}</text>
          </view>
          <view class="gn-runbook-row gn-runbook-row--guard">
            <text class="gn-runbook-label">不能说的</text>
            <text class="gn-runbook-copy">{{station.hiddenInfoReminder || '不要透露答案、其他角色线索或后台剧情条件。'}}</text>
          </view>
          <!-- 稿 469:1002 结尾这句是整张卡的理由:说清「为什么不给你看剧情」,
               否则「不能说的」读起来像在防着商家。 -->
          <text class="gn-runbook-why">这三条会毁掉后面几站的体验 —— 主办方设计的剧情你看不到,也不需要看到。</text>
        </block>
        <text class="gn-muted" wx:else>主办方尚未配置本站任务，当前不要引导玩家开始。</text>
      </view>

      <view class="gn-card" wx:if="{{station.canAccept || station.canDecline}}">
        <view class="gn-section-head">
          <view><text class="gn-section-title">站点邀请</text><text class="gn-section-sub">接受后才能填写准备清单并开放本站</text></view>
        </view>
        <view class="gn-dual-actions">
          <cy-btn class="gn-action" wx:if="{{station.canDecline}}" variant="secondary" disabled="{{writeState !== 'idle'}}" loading="{{writeState === 'submitting'}}" bindtap="openDeclineSheet">拒绝邀请</cy-btn>
          <cy-btn class="gn-action" wx:if="{{station.canAccept}}" variant="primary" disabled="{{writeState !== 'idle'}}" loading="{{writeState === 'submitting'}}" bindtap="acceptStation">接受邀请</cy-btn>
        </view>
      </view>

      <view class="gn-card" wx:if="{{station.canReady}}">
        <view class="gn-section-head">
          <view><text class="gn-section-title">准备清单</text><text class="gn-section-sub">全部完成后，本站才可进入准备完成状态</text></view>
        </view>
        <view class="gn-check-row" wx:for="{{readyDraft.checklist}}" wx:key="code"
              bindtap="onChecklistToggle" data-index="{{index}}" aria-role="checkbox" aria-checked="{{item.checked}}" hover-class="cy-pressed" hover-stay-time="80">
          <view class="gn-check {{item.checked ? 'gn-check--on' : ''}}"><cy-icon wx:if="{{item.checked}}" name="check" size="24" /></view>
          <text class="gn-check-label">{{item.label}}</text>
        </view>

        <view class="gn-field">
          <text class="gn-label">接待容量</text>
          <input class="gn-input" type="number" value="{{readyDraft.capacity}}" placeholder="每个时段最多接待人数"
                 bindinput="onCapacityInput" maxlength="4" />
        </view>
        <view class="gn-field">
          <text class="gn-label">服务日期</text>
          <cy-date-field mode="date" value="{{readyDraft.serviceDate}}" bind:change="onServiceDateChange">
            <view class="gn-picker-value">{{readyDraft.serviceDate || '选择服务日期'}}</view>
          </cy-date-field>
        </view>
        <view class="gn-field">
          <text class="gn-label">服务时段</text>
          <view class="gn-time-row" bindtap="openServiceTime" hover-class="cy-pressed" hover-stay-time="80"
                aria-role="button"
                aria-label="选择服务时段，当前 {{readyDraft.serviceStartTime && readyDraft.serviceEndTime ? readyDraft.serviceStartTime + ' 至 ' + readyDraft.serviceEndTime : '未选'}}">
            <view class="gn-picker-value">{{readyDraft.serviceStartTime && readyDraft.serviceEndTime ? readyDraft.serviceStartTime + ' 至 ' + readyDraft.serviceEndTime : '选择服务时段'}}</view>
          </view>
        </view>
        <view class="gn-field">
          <text class="gn-label">准备备注（选填）</text>
          <input class="gn-input" value="{{readyDraft.note}}" placeholder="给主办方留一句现场说明" bindinput="onReadyNoteInput" maxlength="200" />
        </view>
        <cy-btn variant="primary" disabled="{{writeState !== 'idle'}}" loading="{{writeState === 'submitting'}}" bindtap="submitReady">确认准备完成</cy-btn>
      </view>

      <view class="gn-card" wx:if="{{station.status === 'PAUSED'}}">
        <view class="gn-section-head"><view><text class="gn-section-title">暂停信息</text><text class="gn-section-sub">玩家端不会把暂停站点显示为可接待</text></view></view>
        <view class="gn-info-row"><text>暂停原因</text><text>{{station.pauseReason || station.pauseReasonCode || '未说明'}}</text></view>
        <view class="gn-info-row"><text>预计恢复</text><text>{{station.resumeEta || '待确认'}}</text></view>
        <view class="gn-info-row"><text>备用方案</text><text>{{station.fallbackPlanCode || '未设置'}}{{station.fallbackPlanVersion ? ' v' + station.fallbackPlanVersion : ''}}</text></view>
        <!-- R9-38(用户裁决 C):暂停期间不做自动免费退,也不新增资金路径;退款统一走平台客服。 -->
        <text class="gn-muted">暂停期间如需退款请联系平台客服。</text>
        <cy-btn wx:if="{{station.canResume}}" variant="primary" disabled="{{writeState !== 'idle'}}" loading="{{writeState === 'submitting'}}" bindtap="resumeStation">恢复接待</cy-btn>
      </view>

      <view class="gn-card" wx:if="{{station.canPause || station.canVerify || station.playable}}">
        <view class="gn-section-head"><view><text class="gn-section-title">本站运行</text><text class="gn-section-sub">只处理本站当前可执行的动作</text></view></view>
        <cy-btn wx:if="{{station.playable}}" variant="primary" disabled="{{writeState !== 'idle'}}" bindtap="showLiveCheckin">出示打卡码</cy-btn>
        <cy-btn wx:if="{{station.canPause}}" class="gn-verify-actions" variant="secondary" disabled="{{writeState !== 'idle'}}" bindtap="openPauseSheet">暂停接待</cy-btn>
        <view class="gn-dual-actions gn-verify-actions" wx:if="{{station.canVerify}}">
          <cy-btn class="gn-action" variant="secondary" disabled="{{writeState !== 'idle'}}" bindtap="openManualVerification">输入核验编号</cy-btn>
          <cy-btn class="gn-action" variant="primary" disabled="{{writeState !== 'idle'}}" bindtap="scanSubmission">扫码核验</cy-btn>
        </view>
      </view>

      <view class="gn-card">
        <view class="gn-section-head"><view><text class="gn-section-title">最近操作</text><text class="gn-section-sub">这里只展示已经确认完成的操作</text></view></view>
        <view class="gn-receipt" wx:for="{{recentReceipts}}" wx:key="requestId">
          <view><text class="gn-receipt-title">{{item.actionText}}</text><text class="gn-receipt-sub">第 {{item.revision}} 版{{item.replayed ? ' · 本次请求已处理，无需重复操作' : ''}}</text></view>
          <text class="gn-receipt-outcome">{{item.outcomeText}}</text>
        </view>
        <cy-empty wx:if="{{!recentReceipts.length}}" size="sm" title="本次进入页面后还没有已确认操作" />
      </view>

      <view class="gn-card">
        <view class="gn-section-head"><view><text class="gn-section-title">本站复盘</text><text class="gn-section-sub">只看自己这一站 · 缺的指标不显示为零</text></view></view>
        <block wx:if="{{recap}}">
          <view class="gn-info-row"><text>到站玩家</text><text>{{recap.arrivedPlayers}}</text></view>
          <view class="gn-info-row"><text>任务提交</text><text>{{recap.submissionCount}}</text></view>
          <view class="gn-info-row"><text>核验通过 / 驳回</text><text>{{recap.approvedCount}} / {{recap.rejectedCount}}</text></view>
          <view class="gn-info-row"><text>证据已记录</text><text>{{recap.recordedCount}}</text></view>
          <view class="gn-info-row"><text>正常完成 / 兜底完成</text><text>{{recap.normalCompletedCount}} / {{recap.fallbackCompletedCount}}</text></view>
          <view class="gn-info-row"><text>暂停事件</text><text>{{recap.pauseEventCount}}</text></view>
          <view class="gn-info-row"><text>公开授权内容</text><text>{{recap.authorizedContentCount}}</text></view>
          <text class="gn-muted">仅显示本站安全聚合，不公开玩家内容。</text>
        </block>
        <text class="gn-muted" wx:else>复盘数据待确认</text>
      </view>
    </view>
  </scroll-view>

  <cy-sheet show="{{declineSheetShow}}" title="拒绝站点邀请" bind:close="closeDeclineSheet">
    <view class="gn-sheet">
      <text class="gn-sheet-tip">请选择拒绝原因，主办方会看到</text>
      <view class="gn-choice-grid">
        <view class="gn-choice {{declineDraft.reasonCode === item.code ? 'gn-choice--on' : ''}}"
              wx:for="{{declineReasons}}" wx:key="code" data-code="{{item.code}}" bindtap="onDeclineReasonTap" hover-class="cy-pressed" hover-stay-time="80">{{item.label}}</view>
      </view>
      <cy-btn variant="danger" loading="{{writeState === 'submitting'}}" bindtap="submitDecline">确认拒绝</cy-btn>
    </view>
  </cy-sheet>

  <cy-sheet show="{{pauseSheetShow}}" title="暂停接待" bind:close="closePauseSheet">
    <view class="gn-sheet">
      <text class="gn-sheet-tip">暂停后玩家端将立即看到本站不可接待</text>
      <view class="gn-choice-grid">
        <view class="gn-choice {{pauseDraft.reasonCode === item.code ? 'gn-choice--on' : ''}}"
              wx:for="{{pauseReasons}}" wx:key="code" data-code="{{item.code}}" bindtap="onPauseReasonTap" hover-class="cy-pressed" hover-stay-time="80">{{item.label}}</view>
      </view>
      <view class="gn-field">
        <text class="gn-label">预计恢复</text>
        <view class="gn-time-row">
          <cy-date-field class="gn-time-picker" mode="date" value="{{pauseDraft.resumeDate}}" bind:change="onResumeDateChange"><view class="gn-picker-value">{{pauseDraft.resumeDate || '日期'}}</view></cy-date-field>
          <cy-date-field class="gn-time-picker" mode="time" value="{{pauseDraft.resumeTime}}" bind:change="onResumeTimeChange"><view class="gn-picker-value">{{pauseDraft.resumeTime || '时间'}}</view></cy-date-field>
        </view>
      </view>
      <view class="gn-field">
        <text class="gn-label">备用方案（选填）</text>
        <cy-dropdown wx:if="{{fallbackOptions.length}}" range="{{fallbackOptions}}" range-key="nodeName" bind:change="onFallbackChange">
          <view class="gn-picker-value">{{pauseDraft.fallbackNodeName || '选择已审核的备用方案'}}</view>
        </cy-dropdown>
        <text class="gn-muted" wx:if="{{pauseDraft.playerMessage}}">玩家将看到：{{pauseDraft.playerMessage}}</text>
        <!-- 两种情况分开说:一个都没有 vs 有但还没选。R9-38:备用方案选填,没有也能直接暂停,
             玩家只看到本站暂停 + 原因 + 预计恢复(pages/play 暂停卡),不会被引导去别的站。 -->
        <text class="gn-muted" wx:elif="{{!fallbackOptions.length}}">当前没有已审核的备用方案，可以直接暂停；玩家会看到本站暂停和预计恢复时间。</text>
        <text class="gn-muted" wx:else>选了备用方案，玩家会被引导到那一站；不选则只显示本站暂停。</text>
      </view>
      <!-- 两个必填(原因 / 恢复日期)与 buildStationPauseCommand 的缺参 toast 同源。
           R9-38(后端 resolvePauseFallback 无方案不绑兜底):备用方案不再是必填,稿 281:494
           「没有已审核备用方案时置灰」那道闸已被后端裁决取代;不选方案时提交前另弹确认。 -->
      <cy-btn variant="danger" loading="{{writeState === 'submitting'}}"
              disabled="{{!pauseDraft.reasonCode || !pauseDraft.resumeDate}}"
              bindtap="submitPause">确认暂停</cy-btn>
    </view>
  </cy-sheet>

  <cy-sheet show="{{verifySheetShow}}" title="核验游戏提交" bind:close="closeVerifySheet">
    <view class="gn-sheet">
      <view class="gn-field">
        <text class="gn-label">核验编号</text>
        <input class="gn-input" type="number" value="{{verifyDraft.submissionId}}" placeholder="输入玩家提交页显示的正整数编号"
               maxlength="19" bindinput="onSubmissionIdInput" />
      </view>
      <view class="gn-segment">
        <view class="gn-segment-item {{verifyDraft.decision === 'APPROVE' ? 'gn-segment-item--on' : ''}}" data-decision="APPROVE" bindtap="onVerifyDecisionTap" hover-class="cy-pressed" hover-stay-time="80">通过</view>
        <view class="gn-segment-item {{verifyDraft.decision === 'REJECT' ? 'gn-segment-item--on' : ''}}" data-decision="REJECT" bindtap="onVerifyDecisionTap" hover-class="cy-pressed" hover-stay-time="80">驳回</view>
      </view>
      <view class="gn-choice-grid" wx:if="{{verifyDraft.decision === 'REJECT'}}">
        <view class="gn-choice {{verifyDraft.reasonCode === item.code ? 'gn-choice--on' : ''}}"
              wx:for="{{verifyRejectReasons}}" wx:key="code" data-code="{{item.code}}" bindtap="onRejectReasonTap" hover-class="cy-pressed" hover-stay-time="80">{{item.label}}</view>
      </view>
      <cy-btn variant="primary" loading="{{writeState === 'submitting'}}" bindtap="submitVerification">提交核验结论</cy-btn>
    </view>
  </cy-sheet>
</view>
<cy-time-range
  show="{{serviceTimeShow}}"
  title="服务时段"
  value="{{serviceTimeValue}}"
  minute-step="{{5}}"
  bind:confirm="onServiceTimeConfirm"
  bind:cancel="closeServiceTime"
/>
<cy-privacy-gate show="{{privacyGateShow}}" bind:settled="onPrivacyGateSettled" />
<cy-qr-voucher wx:if="{{checkinVisible}}"
  show="{{true}}"
  state="{{checkinQrState}}"
  qr="{{checkinQrUrl}}"
  title="本站打卡码"
  desc="请让玩家扫这一张。扫过即作废，请再出示一张新的。"
  countdown="{{checkinQrState === 'ready' ? checkinCountdown + 's 后自动换新' : ''}}"
  error-text="{{checkinErr || '打卡码暂时没能生成'}}"
  mask-closable="{{true}}"
  bind:close="closeLiveCheckin"
  bind:retry="issueLiveCheckin"
/>

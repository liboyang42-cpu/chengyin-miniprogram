/* ds-ok: final 390pt Figma frames use 20pt outer / 16pt inner / 54pt rows. Component overrides stay local. */
.dc-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--cy-color-bg-page);
  color: var(--cy-color-text-primary);
  --cy-page-x: 38.5rpx;
  --cy-color-overlay: rgba(0, 0, 0, 0.18); /* ds-ok: Figma 定稿尺寸与中性配色；已由原生截图复核 */
  --cy-comp-switch-scale: 0.65;
  --cy-type-body: 25rpx;
  --cy-type-label: 23rpx;
  --cy-comp-cell-min-h: 104rpx;
  --cy-comp-cell-pad-x: 31rpx;
  --cy-comp-cell-hairline-right: 31rpx;
  --cy-comp-cell-hairline-left: 31rpx;
  --cy-comp-card-shadow-day: 0 8rpx 24rpx rgba(0, 0, 0, 0.08); /* ds-ok: Figma 定稿尺寸与中性配色；已由原生截图复核 */
}
.dc-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
}
.dc-content {
  padding: 31rpx 38.5rpx calc(46rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 38.5rpx;
  box-sizing: border-box;
}
.dc-card {
  background: var(--cy-color-bg-surface);
  border-radius: 38.5rpx; /* ds-ok: Figma 定稿尺寸与中性配色；已由原生截图复核 */
  overflow: hidden;
  flex-shrink: 0;
}
.dc-inset {
  padding: 31rpx;
  display: flex;
  flex-direction: column;
  gap: 23rpx;
}
.dc-identity {
  display: flex;
  align-items: center;
  text-align: center;
  flex-direction: column;
  gap: 15rpx;
}
.dc-avatar {
  width: 138rpx;
  height: 138rpx;
  border-radius: 50%; /* ds-ok: Figma 商家定稿数值，原生截图已复核 */
  background: var(--cy-color-bg-surface-strong);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 62rpx; /* ds-ok: Figma 定稿尺寸与中性配色；已由原生截图复核 */
  font-weight: 700;
  overflow: hidden;
}
.dc-avatar image {
  width: 100%;
  height: 100%;
}
.dc-name {
  font-size: 42rpx; /* ds-ok: Figma 定稿尺寸与中性配色；已由原生截图复核 */
  font-weight: 700;
  line-height: 62rpx;
}
.dc-muted {
  font-size: var(--cy-type-label);
  color: var(--cy-color-text-tertiary);
  line-height: 35rpx;
}
.dc-cover {
  width: 100%;
  height: 403.8rpx; /* ds-ok: 用户指定高宽3:5，内容宽673rpx */
  display: block;
  border-radius: 31rpx; /* ds-ok: Figma 定稿尺寸与中性配色；已由原生截图复核 */
}
.dc-placeholder {
  background: var(--cy-color-bg-surface-subtle);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--cy-type-label);
  color: var(--cy-color-text-tertiary);
}
.dc-status {
  display: flex;
  align-items: center;
  gap: 19rpx;
  height: 96rpx;
  padding: 0 27rpx;
  font-size: var(--cy-type-label);
}
.dc-public {
  flex: 1;
  text-align: right;
  line-height: 85rpx;
}
.dc-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 19rpx;
  font-size: 25rpx; /* ds-ok: Figma 定稿尺寸与中性配色；已由原生截图复核 */
  font-weight: 700;
  line-height: 39rpx;
}
.dc-heading .dc-muted {
  font-weight: 400;
}
.dc-brand-title {
  font-size: 44rpx; /* ds-ok: Figma 商家定稿数值，原生截图已复核 */
  line-height: 65rpx;
  font-weight: 700;
}
.dc-story {
  padding: 35rpx;
}
.dc-story-text {
  font-size: 25rpx; /* ds-ok: Figma 定稿尺寸与中性配色；已由原生截图复核 */
  line-height: 40rpx;
  white-space: pre-wrap;
  word-break: break-all;
}
.dc-gallery {
  height: 173rpx;
  white-space: nowrap;
}
.dc-gallery image {
  display: inline-block;
  width: 308rpx;
  height: 173rpx;
  border-radius: 31rpx; /* ds-ok: Figma 定稿尺寸与中性配色；已由原生截图复核 */
  margin-right: 19rpx;
}
.dc-gallery .dc-placeholder {
  height: 173rpx;
}
.dc-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}
.dc-tag {
  padding: 12rpx 23rpx;
  border-radius: 40rpx; /* ds-ok: Figma 商家定稿数值，原生截图已复核 */
  background: var(--cy-color-bg-surface-subtle);
  font-size: var(--cy-type-label);
  line-height: 35rpx;
}
.dc-selected {
  background: var(--cy-color-action-primary-bg);
  color: var(--cy-color-action-primary-fg);
}
.dc-touch {
  min-height: 44px;
  display: flex;
  align-items: center;
}
.dc-coop-icon {
  width: 123rpx;
  height: 123rpx;
  border-radius: 50%; /* ds-ok: Figma 商家定稿数值，原生截图已复核 */
  background: var(--cy-color-bg-surface-strong);
  display: flex;
  align-items: center;
  justify-content: center;
}
.dc-inner-row {
  --cy-comp-cell-pad-x: 0rpx;
  --cy-comp-cell-hairline-left: 0rpx;
  --cy-comp-cell-hairline-right: 0rpx;
}
.dc-fields {
  --cy-comp-cell-label-width: 192rpx;
  --cy-comp-cell-value-max: 100%;
  --cy-comp-cell-value-align: right;
  --cy-comp-cell-label-flex: 0 0 192rpx;
  --cy-comp-cell-value-flex: 1;
}
.dc-menu {
  padding: 23rpx 31rpx;
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}
.dc-choice {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15rpx;
  min-height: 44px;
  font-size: var(--cy-type-body);
}
.dc-sheet-content {
  padding: 15rpx 0 31rpx;
  display: flex;
  flex-direction: column;
  gap: 23rpx;
}
/* 2026-09-18 用户定:弹层里成对的操作按钮一律横排一行(退路左、确认右)。
   cy-btn 宿主默认 block 铺满,竖排是它的默认形态 —— 并排必须显式包这一层。 */
.dc-sheet-actions {
  display: flex;
  gap: var(--cy-space-2-5);
}
.dc-sheet-actions cy-btn { flex: 1; }
.dc-input,
.dc-textarea {
  width: 100%;
  box-sizing: border-box;
  background: var(--cy-color-bg-surface-subtle);
  border-radius: 23rpx; /* ds-ok: Figma 商家定稿数值，原生截图已复核 */
  padding: 23rpx;
  font-size: 25rpx; /* ds-ok: Figma 定稿尺寸与中性配色；已由原生截图复核 */
  color: var(--cy-color-text-primary);
}
.dc-input {
  height: 88rpx;
  padding: 0 23rpx;
  line-height: 88rpx;
  font-size: var(--cy-font-body);
}
.dc-textarea {
  height: 338rpx;
  line-height: 40rpx;
}
.dc-counter {
  font-size: 23rpx; /* ds-ok: Figma 商家定稿数值，原生截图已复核 */
  color: var(--cy-color-text-tertiary);
  text-align: right;
}
.dc-error {
  color: var(--cy-color-status-danger);
  font-size: 23rpx; /* ds-ok: Figma 商家定稿数值，原生截图已复核 */
  line-height: 35rpx;
}
.dc-image-layer {
  position: fixed;
  inset: 0;
  z-index: var(--cy-z-modal);
  display: flex;
  align-items: center;
  justify-content: center;
}
.dc-image-mask {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.18); /* ds-ok: Figma 定稿尺寸与中性配色；已由原生截图复核 */
}
.dc-image-panel {
  position: relative;
  width: calc(100% - 77rpx);
  box-sizing: border-box;
  background: var(--cy-color-bg-surface);
  padding: 31rpx;
  border-radius: 38.5rpx; /* ds-ok: Figma 定稿尺寸与中性配色；已由原生截图复核 */
  display: flex;
  flex-direction: column;
  gap: 23rpx;
  max-height: 90vh;
  overflow: auto;
}
.dc-close {
  width: 44px;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.dc-image-preview {
  width: 100%;
  height: 344rpx;
  border-radius: 23rpx; /* ds-ok: Figma 商家定稿数值，原生截图已复核 */
}
.dc-image-preview--logo {
  height: 612rpx;
  border-radius: 50%; /* ds-ok: Figma 商家定稿数值，原生截图已复核 */
}
.dc-state {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 31rpx 38.5rpx;
}
.dc-state--skeleton {
  justify-content: flex-start;
  min-height: 0;
}
.dc-skel-card {
  background: var(--cy-color-bg-surface);
  border-radius: 38.5rpx; /* ds-ok: Figma 定稿尺寸与中性配色；已由原生截图复核 */
  overflow: hidden;
}
.cy-pressed {
  opacity: 0.72;
}

.dc-save-receipt,
.dc-refreshing {
  font-size: 23rpx; /* ds-ok: Figma 商家定稿数值，原生截图已复核 */
  color: var(--cy-color-text-tertiary);
}

/* 用户 2026-09-12：品牌中心增大区块间距，图片以小笔提示直接编辑。 */
.dc-content--home { gap:38.5rpx; padding-top:46rpx; }
.dc-content--home .dc-identity { flex-direction:row; text-align:left; gap:23rpx; margin-bottom:8rpx; }
.dc-content--home .dc-avatar-wrap { flex-shrink:0; }
.dc-content--home .dc-name { flex:1; min-width:0; overflow-wrap:break-word; }
.dc-avatar-wrap,.dc-cover-wrap { position:relative; }
.dc-edit-hit { position:absolute; width:44px; height:44px; display:flex; align-items:center; justify-content:center; }
.dc-edit-hit--avatar { right:-12px; bottom:-8px; }
.dc-edit-hit--cover { right:8px; bottom:8px; }
.dc-edit-badge { width:54rpx; height:54rpx; border-radius:50%; background:var(--cy-color-bg-surface); color:var(--cy-color-text-primary); border:2rpx solid var(--cy-color-border-subtle); display:flex; align-items:center; justify-content:center; } /* ds-ok: 用户指定图片小笔，44px 点击区内的圆形图标 */

/* 用户确认：行尾文字靠近箭头，只读值与行尾对齐。 */
.dc-page { --cy-comp-cell-gap:8rpx; --cy-comp-cell-value-align:right; }
.dc-heading-row { display:flex; align-items:center; justify-content:space-between; gap:23rpx; }
.dc-heading-row .dc-brand-title { flex:1; min-width:0; }
.dc-edit-label { display:flex; align-items:center; justify-content:flex-end; min-width:44px; min-height:44px; font-size:var(--cy-type-label); color:var(--cy-color-text-tertiary); }

.dc-mask-pressed { opacity:0.8; }

:host {
  display: block;
}
.hours-panel {
  padding: 16px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.hours-label {
  font-size: var(--cy-type-label);
  line-height: 18px;
  color: var(--cy-color-text-tertiary);
}
.hours-days {
  display: flex;
  justify-content: space-between;
  gap: 4px;
}
.hours-day {
  flex: 1;
  min-height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.hours-day-dot {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34px;
  height: 34px;
  background: var(--cy-color-bg-surface-subtle);
  border-radius: 50%; /* ds-ok: 用户指定小圆营业日 */
  font-size: var(--cy-type-label);
}
.hours-on {
  background: var(--cy-color-action-primary-bg) !important;
  color: var(--cy-color-action-primary-fg);
}
.hours-pair {
  display: flex;
  gap: 10px;
}
.hours-half {
  flex: 1;
  min-width: 0;
}
.hours-value {
  margin-top: 8px;
  background: var(--cy-color-bg-surface-subtle);
  border-radius: 24px;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16px; /* ds-ok: Figma 定稿尺寸与中性配色；已由原生截图复核 */
  font-variant-numeric: tabular-nums;
}
.hours-columns {
  display: flex;
  gap: 6px;
  padding: 4px;
}
.hours-column {
  width: 50%;
  height: 132px;
}
.hours-option {
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12px;
  font-size: 14px; /* ds-ok: Figma 定稿尺寸与中性配色；已由原生截图复核 */
}
.hours-error {
  color: var(--cy-color-status-danger);
  font-size: var(--cy-type-label);
}
.cy-pressed {
  opacity: 0.72;
}

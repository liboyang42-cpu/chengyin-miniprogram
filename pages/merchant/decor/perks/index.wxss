@import '../../../../style/merchant-light.wxss';

.dp-page { height: 100vh; display: flex; flex-direction: column; background: var(--cy-bg-page); }
.dp-scroll { flex: 1; min-height: 0; }
.dp-retry { --cy-btn-h-sm: var(--cy-btn-h); }
.dp-refreshing,
.dp-save-receipt { display: flex; align-items: center; justify-content: center; min-height: var(--cy-btn-h); padding: 0 var(--cy-page-x); color: var(--cy-text-secondary); font-size: var(--cy-font-caption); }
.dp-save-receipt { color: var(--cy-success); }
.dp-card { display: flex; align-items: center; margin: 0 0 var(--cy-space-2); padding: var(--cy-space-2-5) var(--cy-space-3); background: var(--cy-bg-card); border-radius: var(--cy-radius-lg); }
.dp-main { flex: 1; min-width: 0; }
.dp-head { display: flex; align-items: center; gap: var(--cy-space-1-5); }
.dp-name { max-width: 400rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--cy-text-title); font-size: var(--cy-font-body); font-weight: 600; }
/* CU-M-172:一档一个不换行事实,横向排不开就整档换行 —— 与 pages/club/event-ops
   的 .roster-summary 同形。原来是一条自然折行的 text,断行只认空格,
   「· 至」会留在行末、日期单独一行。 */
.dp-meta { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--cy-space-1-5) var(--cy-space-2-5); margin-top: var(--cy-space-1); color: var(--cy-text-secondary); font-size: var(--cy-font-caption); }
.dp-meta-item { white-space: nowrap; }
.dp-delete { display: inline-flex; align-items: center; justify-content: center; min-width: var(--cy-btn-h); min-height: var(--cy-btn-h); margin-left: var(--cy-space-2); color: var(--cy-danger); font-size: var(--cy-font-label); }
.dp-pad { height: var(--cy-space-5); }
.dp-cta { padding: var(--cy-space-2) var(--cy-page-x) calc(var(--cy-space-2) + env(safe-area-inset-bottom)); background: var(--cy-bg-card); border-top: 2rpx solid var(--cy-border-card); }
.dp-form { padding: 0 var(--cy-page-x) calc(var(--cy-space-3) + env(safe-area-inset-bottom)); }
.dp-field { margin-bottom: var(--cy-space-2); }
.dp-field-label { display: block; margin-bottom: var(--cy-space-1); color: var(--cy-text-title); font-size: var(--cy-font-label); font-weight: 600; }
.dp-field-required { color: var(--cy-danger); font-size: var(--cy-font-caption); font-weight: 500; }
.dp-field-optional { color: var(--cy-text-secondary); font-size: var(--cy-font-caption); font-weight: 400; }
.dp-types { display: flex; gap: var(--cy-space-1-5); margin-bottom: var(--cy-space-2-5); }
.dp-type { display: inline-flex; align-items: center; justify-content: center; min-height: var(--cy-btn-h); padding: 0 var(--cy-space-3); border-radius: var(--cy-radius-pill); background: var(--cy-bg-card-2); color: var(--cy-text-secondary); font-size: var(--cy-font-label); }
.dp-type.on { background: var(--cy-btn-solid-bg); color: var(--cy-btn-solid-fg); }
.dp-input { box-sizing: border-box; width: 100%; min-height: var(--cy-btn-h); padding: 0 var(--cy-space-3); border-radius: var(--cy-radius-md); background: var(--cy-bg-card-2); color: var(--cy-text-title); font-size: var(--cy-font-body); }
.dp-date { display: flex; align-items: center; color: var(--cy-text-secondary); }

@import "../design.wxss";
.dp-scroll{padding:0 38.5rpx;box-sizing:border-box;}.dp-intro{display:flex;flex-direction:column;gap:23rpx;margin:31rpx 0 38rpx;}.dp-form{padding:15rpx 38.5rpx 31rpx;gap:23rpx;}.dp-pair{display:flex;gap:23rpx;}.dp-pair .dp-field{flex:1;min-width:0;margin:0;}.dp-input{height:81rpx;min-height:81rpx;padding:19rpx 23rpx;background:var(--cy-color-bg-surface-subtle);font-size:25rpx;border-radius:23rpx;box-sizing:border-box;}.dp-field-label{font-size:23rpx;line-height:35rpx;}.dp-field-required{color:var(--cy-color-status-danger);}.dp-field-optional{font-size:21rpx;}.dp-name{font-size:27rpx;}.dp-meta{font-size:23rpx;}.dp-cta{padding:23rpx 38.5rpx calc(23rpx + env(safe-area-inset-bottom));}.dp-card{border-radius:38.5rpx;}.dp-delete{min-width:44px;min-height:44px;display:flex;align-items:center;justify-content:center;} /* ds-ok: Figma 定稿尺寸与中性配色；已由原生截图复核 */

/* ds-ok: Figma 33:312, sheet already owns the 20pt outer inset. */
.dp-page { --cy-page-x:38.5rpx; --cy-color-overlay:rgba(0,0,0,.18); } /* ds-ok: Figma 定稿尺寸与中性配色；已由原生截图复核 */
.dp-form { display:flex; flex-direction:column; padding:0 0 31rpx; gap:23rpx; }
.dp-field { margin:0; }
.dp-field-label { display:flex; align-items:center; gap:4rpx; margin:0 0 8rpx; min-height:35rpx; font-weight:400; color:var(--cy-color-text-tertiary); white-space:nowrap; }
.dp-field-required,.dp-field-optional { display:inline; line-height:35rpx; }
.dp-pair { align-items:flex-start; }
.dp-pair .dp-field { display:flex; flex-direction:column; }

.dp-editor-page { flex:1; min-height:0; padding:31rpx 38.5rpx; box-sizing:border-box; }

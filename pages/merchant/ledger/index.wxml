<view class="ledger theme-merchant">
  <cy-toast id="cy-toast" />
  <cy-loading-mask id="cy-loading" />
  <cy-modal-host id="cy-modal-host" />
  <cy-nav-bar custom-back bind:back="onNavBack" />
  <view class="ledger-nav-spacer" style="height: {{statusBarHeight + navBarHeight}}px;"></view>
  <cy-page-title title="{{pageTitle}}" safe-top="{{false}}" flush="{{true}}" />
  <cy-state-shell class="fill-slot" wx:if="{{routeError}}" kind="missing-param" fill size="lg"
                  title="链接已失效" sub="请从商家工作台重新进入"
                  primary="返回工作台" bind:primary="onNavBack" />
  <block wx:elif="{{view === 'redemptions'}}">
    <!-- 退款售后不再单独一张卡(UI-06,2026-09-18 用户走查):退款条目并进下面的状态 tab,
         待处理/已处理与核销记录同列展示,点条目进售后详情。 -->
    <!-- 固定四段筛选显式开启 shared slab；切换期间 shell 不卸载，只替换下方内容区。 -->
    <cy-tabs class="ledger-filter" wx:if="{{merchantAccess.canReadFinance}}" variant="chip" shared-slab tabs="{{redemptionTabs}}" active="{{redemptionFilter}}" bind:change="onRedemptionFilter" />
    <view class="ledger-redemption-content" aria-role="region" aria-label="核销与退款" aria-busy="{{loading ? 'true' : 'false'}}">
      <cy-skeleton wx:if="{{loading && !hasLoaded}}" type="list" count="{{3}}" />
      <cy-error wx:elif="{{error && !hasLoaded}}" size="lg" fill title="核销记录加载失败" sub="数据服务暂不可用，请稍后重试" retry="重新加载" bind:retry="retry" />
      <block wx:else>
        <view class="ledger-inline-state" wx:if="{{(loading || error) && hasLoaded}}">
          <text class="ledger-sync" wx:if="{{loading && hasLoaded}}" aria-role="status">正在核对最新记录…</text>
          <cy-inline-error wx:if="{{error && hasLoaded}}" title="最新记录暂未取回"
                           sub="已保留上次确认的数据" action="重试" bind:action="retry" />
        </view>

        <view class="fin-summary" wx:if="{{summary}}">
          <view class="fin-summary__cell"><text class="fin-summary__k">本月核销</text><text class="fin-summary__v">{{summary.countText}}</text></view>
          <view class="fin-summary__cell" wx:if="{{merchantAccess.canReadFinance}}"><text class="fin-summary__k">待结算</text><text class="fin-summary__v fin-summary__v--pending">{{summary.pendingDisplay}}</text></view>
          <view class="fin-summary__cell" wx:if="{{merchantAccess.canReadFinance}}"><text class="fin-summary__k">已入账</text><text class="fin-summary__v fin-summary__v--arrived">{{summary.arrivedDisplay}}</text></view>
        </view>

        <block wx:if="{{redemptionGroups.length}}">
          <view class="fin-group" wx:for="{{redemptionGroups}}" wx:for-item="group" wx:key="dayKey">
            <view class="fin-group__title">{{group.dayLabel}}</view>
            <view class="fin-card">
              <view class="fin-row" wx:for="{{group.rows}}" wx:key="recordKey" bindtap="goRedemptionDetail" data-item="{{item}}" hover-class="fin-row--tap" aria-role="button" aria-label="{{item.recordType === 'aftercare' ? '查看退款详情' : '查看核销详情'}}">
                <view class="fin-row__dot fin-row__dot--{{item.stateVariant}}"></view>
                <view class="fin-row__main">
                  <text class="fin-row__t1">{{item.title}}</text>
                  <view class="fin-row__t2">
                    <text>{{item.customerDisplayName || '顾客信息受保护'}}</text>
                    <text wx:if="{{item.timeText}}"> · {{item.timeText}}</text>
                    <cy-badge class="fin-row__chip" type="status" variant="{{item.stateVariant}}" label="{{item.stateText}}" />
                  </view>
                </view>
                <text class="fin-row__v fin-row__v--{{item.amountTone}}" wx:if="{{merchantAccess.canReadFinance}}">{{item.amountDisplay}}</text>
              </view>
            </view>
          </view>
        </block>
        <cy-empty wx:elif="{{!loading && !error && !redemptionGroups.length}}" fill size="lg" kind="empty" title="还没有记录" sub="顾客到店核销或发起退款后会显示在这里" />
      </block>
    </view>
  </block>

  <cy-skeleton wx:elif="{{loading && !hasLoaded}}" type="merchant-metric" count="{{3}}" />
  <cy-error wx:elif="{{error && !hasLoaded}}" size="lg" fill title="结算数据加载失败" sub="数据服务暂不可用，请稍后重试" retry="重新加载" bind:retry="retry" auto-back />

  <block wx:else>
  <block wx:if="{{view === 'settlement'}}">
    <view class="ledger-inline-state ledger-inline-state--global"
          wx:if="{{hasLoaded && (loading || error) && !settlementLoading.overview && !settlementLoading.entries && !settlementLoading.batches && !settlementErrors.overview && !settlementErrors.entries && !settlementErrors.batches}}">
      <text class="ledger-sync" wx:if="{{loading}}" aria-role="status">正在核对商家身份与最新结算…</text>
      <cy-inline-error wx:elif="{{error}}" title="最新结算暂未取回"
                       sub="已保留上次确认的金额与明细"
                       action="重试" bind:action="retry" />
    </view>
    <view class="ledger-inline-state">
      <cy-skeleton wx:if="{{settlementLoading.overview && !overview}}" type="amount" count="{{1}}" />
      <text class="ledger-sync" wx:if="{{settlementLoading.overview && overview}}" aria-role="status">正在更新结算概览…</text>
      <cy-inline-error wx:if="{{settlementErrors.overview}}" title="{{settlementErrors.overview}}"
                       sub="{{overview ? '已保留上次确认的概览' : '其它结算区块仍可继续查看'}}"
                       action="重试此部分" bind:action="retrySettlementOverview" />
    </view>
    <!-- hero:每页只准一个主数字。毛额/调整/待对公降为卡内 key-value,和主数字拉开量级。 -->
    <view class="fin-hero" wx:if="{{overview}}">
      <text class="fin-hero__lab">本月个人账户{{overview.netLabel}}</text>
      <text class="fin-hero__amt">{{overview.personalNetDisplay}}</text>
      <view class="fin-hero__chips" wx:if="{{overview.hasAdjustmentPending}}">
        <cy-badge type="status" variant="warning" label="{{overview.adjustmentPendingDisplay}} 调整待处理" />
      </view>
      <view class="fin-kv"><text class="fin-kv__k">个人账户毛额</text><text class="fin-kv__v">{{overview.personalGrossDisplay}}</text></view>
      <view class="fin-kv"><text class="fin-kv__k">已执行调整</text><text class="fin-kv__v {{overview.hasPersonalAdjustment ? 'fin-kv__v--neg' : 'fin-kv__v--neutral'}}">{{overview.personalAdjustmentDisplay}}</text></view>
      <view class="fin-kv"><text class="fin-kv__k">待对公结算</text><text class="fin-kv__v">{{overview.publicPendingDisplay}}</text></view>
    </view>

    <cy-btn class="fin-assets-cta" bindtap="goAssets">去我的资产</cy-btn>
    <view class="fin-alert-row" role="switch" aria-checked="{{settleAlertsEnabled}}">
      <view class="fin-alert-copy"><text class="fin-alert-title">结算到账提醒</text><text class="fin-alert-sub">入账后通过服务通知告诉你</text></view>
      <cy-switch checked="{{settleAlertsEnabled}}" disabled="{{settleAlertsLoading}}"
        accessibility-label="结算到账提醒" bind:change="enableCoopSettleAlerts" />
    </view>

    <view class="fin-group">
      <view class="fin-group__title">收入明细</view>
      <text class="ledger-sync" wx:if="{{settlementLoading.entries && entries.length}}" aria-role="status">正在更新收入明细…</text>
      <cy-inline-error wx:if="{{settlementErrors.entries}}" title="{{settlementErrors.entries}}"
                       sub="{{entries.length ? '已保留上次确认的明细' : '结算概览和对公批次不受影响'}}"
                       action="重试此部分" bind:action="retrySettlementEntries" />
      <view class="fin-card" wx:if="{{entries.length}}">
        <view class="fin-row" wx:for="{{entries}}" wx:key="entryKey">
          <view class="fin-row__dot fin-row__dot--{{item.stateVariant}}"></view>
          <view class="fin-row__main">
            <text class="fin-row__t1">{{item.sourceText}}</text>
            <view class="fin-row__t2"><text>{{item.timeText}}</text><cy-badge class="fin-row__chip" type="status" variant="{{item.stateVariant}}" label="{{item.stateText}}" /></view>
          </view>
          <text class="fin-row__v fin-row__v--{{item.amountTone}}">{{item.amountDisplay}}</text>
        </view>
      </view>
      <cy-skeleton wx:elif="{{settlementLoading.entries}}" type="list" count="{{2}}" />
      <cy-empty wx:elif="{{!settlementLoading.entries && !settlementErrors.entries}}" kind="empty"
                title="还没有已成立的收入明细" />
    </view>

    <view class="fin-group">
      <view class="fin-group__title">对公结算</view>
      <text class="ledger-sync" wx:if="{{settlementLoading.batches && batches.length}}" aria-role="status">正在更新对公结算…</text>
      <cy-inline-error wx:if="{{settlementErrors.batches}}" title="{{settlementErrors.batches}}"
                       sub="{{batches.length ? '已保留上次确认的批次' : '结算概览和收入明细不受影响'}}"
                       action="重试此部分" bind:action="retrySettlementBatches" />
      <view class="fin-card" wx:if="{{batches.length}}">
        <view class="fin-row" wx:for="{{batches}}" wx:key="batchId" bindtap="goBatchDetail" data-id="{{item.batchId}}" hover-class="fin-row--tap" aria-role="button" aria-label="查看对公批次详情">
          <view class="fin-row__dot fin-row__dot--{{item.stateVariant}}"></view>
          <view class="fin-row__main">
            <text class="fin-row__t1">{{item.periodYm}} 对公结算</text>
            <view class="fin-row__t2">
              <cy-badge class="fin-row__chip" type="status" variant="{{item.stateVariant}}" label="{{item.stateText}}" />
              <cy-badge wx:if="{{item.invoiceText}}" class="fin-row__chip" type="status" variant="neutral" label="{{item.invoiceText}}" />
            </view>
          </view>
          <text class="fin-row__v">{{item.amountDisplay}}</text>
        </view>
      </view>
      <cy-skeleton wx:elif="{{settlementLoading.batches}}" type="list" count="{{2}}" />
      <cy-empty wx:elif="{{!settlementLoading.batches && !settlementErrors.batches}}" kind="empty"
                title="还没有对公结算批次" />
    </view>
  </block>

  <block wx:else>
    <view class="ledger-action" bindtap="goInbox" hover-class="ledger-action--tap"><view class="ledger-action-copy"><text class="ledger-action-title">站内消息</text><text class="ledger-action-sub">查看聊天与系统通知</text></view></view>
    <!-- CU-M-123:这一屏原本还挂着一行「经营动态 / 消息入口保留为兼容模式」。
         「兼容模式」是内部实现口径,对商家没有信息量;而这一路并没有任何动态数据源,
         留着标题就是给一个永远为空的分组占位。整块摘掉,只留真正可点的站内消息入口。 -->
  </block>
  </block>
</view>

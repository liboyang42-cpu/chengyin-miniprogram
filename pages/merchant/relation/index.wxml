<wxs module="relation">
function valid(items) {
  var result = [];
  if (!items || !items.length) return result;
  for (var i = 0; i < items.length; i++) {
    if (items[i] && typeof items[i].displayName === 'string' && items[i].displayName) result.push(items[i]);
  }
  return result;
}
module.exports = { valid: valid };
</wxs>
<view class="page theme-merchant m-flush-nav" style="padding-top:{{statusBarHeight + navBarHeight}}px">
  <cy-toast id="cy-toast" />
  <cy-loading-mask id="cy-loading" />
  <cy-modal-host id="cy-modal-host" />
  <cy-access-gate id="cy-access-gate" kind="merchant" need="canManageCoop" />
  <!-- tab 页无返回箭头,标题居中(与商家其余页 / 「我的」同一形态) -->
  <cy-nav-bar title="合作" back="{{false}}" />

  <!-- 2026-08-09:删掉「我的合作」与三格跨项目统计。合作在业务上是跟着项目走的
       (coop_invite 每条都绑 topicId),已谈成的合作方在对应主题工作台按俱乐部/商家/客户
       分好了;这里再摊平一份跨项目名册,既丢了项目上下文,又让人误以为存在长期关系。
       本页职责收窄为「找新的合作对象」,按商家/俱乐部分 tab。 -->
  <cy-tabs class="rel-tabs" variant="fill" wide="{{true}}" tabs="{{tabs}}" active="{{activeTab}}" bind:change="onTabChange" />

  <view class="body">
    <cy-skeleton wx:if="{{pageState === 'loading'}}" type="card" count="{{3}}" loading-label="合作对象加载中" />
    <!-- 未登录不再整屏拦:静默登录后自动加载;登录失败只留这条内联错误 + 重试。 -->
    <cy-inline-error class="rel-inline-error" wx:elif="{{pageState === 'error'}}" kind="data"
      title="合作数据加载失败" sub="{{error}}" action="重新加载" bind:action="retryRelation" />
    <block wx:else>
      <view wx:if="{{refreshing}}" class="refresh-note" aria-role="status" aria-live="polite">
        <text>正在更新合作对象</text>
      </view>

      <block wx:if="{{activeTab === 'merchant'}}">
        <cy-inline-error class="rel-inline-error" wx:if="{{merchantError}}" kind="data"
          title="部分商家资料暂不可用" sub="{{merchantError}}" action="重新加载" bind:action="loadRelationHome" />
        <!-- 2026-08-20 卡片重设计:cy-cell 行换新版商家卡(与玩家发现页同一组件,浅色主题 token 自适应) -->
        <view class="rel-list" wx:if="{{relation.valid(merchants).length}}">
          <view class="rel-item" wx:for="{{relation.valid(merchants)}}" wx:key="id" wx:if="{{item.displayName}}">
            <cy-merchant-card
              interactive="{{true}}"
              aria-label="查看商家{{item.displayName}}"
              data-memberid="{{item.memberId}}"
              bind:tap="goMerchant" bind:action="goMerchant"
              cover="{{item.coverUrl}}"
              logo="{{item.logoUrl}}"
              category-name="{{item.categoryName}}"
              name="{{item.displayName}}"
              city-role="{{item.cityRole || ''}}"
              desc="{{item.displayDescription}}"
              status="{{item.displayStatus}}"
              distance="{{item.distanceText}}"
              verified="{{item.displayLocationVerified}}"
              action-text="去看看" />
          </view>
        </view>
        <cy-empty wx:elif="{{!merchantError}}" kind="empty" title="暂无可合作商家" sub="稍后再来看看" />
      </block>

      <block wx:else>
        <cy-inline-error class="rel-inline-error" wx:if="{{clubError}}" kind="data"
          title="部分俱乐部资料暂不可用" sub="{{clubError}}" action="重新加载" bind:action="loadRelationHome" />
        <!-- 俱乐部换新版俱乐部卡；整卡进主页看资料，按钮「发起合作」直达 type=1 邀约表单 -->
        <view class="rel-list" wx:if="{{relation.valid(clubs).length}}">
          <view class="rel-item" wx:for="{{relation.valid(clubs)}}" wx:key="id" wx:if="{{item.displayName}}">
            <cy-club-card club="{{item}}" cta="发起合作" interactive="{{true}}"
              data-id="{{item.id}}" bind:tap="goClub" bind:action="goClubCoop"  hover-class="cy-pressed" hover-stay-time="80"/>
          </view>
        </view>
        <cy-empty wx:elif="{{!clubError}}" kind="empty" title="暂无可合作俱乐部" sub="稍后再来看看" />
      </block>
    </block>
  </view>

  <tabBar mode="merchant" activeKey="relation" />
</view>

/* 共用「九宫格上传器」样式。@import 到各编辑页使用。
   结构:
   <view class="pgrid-head"><text class="pgrid-hint">说明</text><text class="pgrid-count">n/9</text></view>
   <view class="pgrid">
     <view class="pgrid-cell"><image class="pgrid-cell-img"/><view class="pgrid-del">×</view></view> ...
     <view class="pgrid-cell pgrid-add"><text class="pgrid-add-plus">＋</text><text class="pgrid-add-txt">添加照片</text></view>
   </view>
*/
.pgrid-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--cy-space-1-5);
}
.pgrid-hint {
  font-size: 24rpx;
  color: #8a94a6;
}
.pgrid-count {
  font-size: 24rpx;
  color: #8a94a6;
  font-variant-numeric: tabular-nums;
}
.pgrid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.pgrid-cell {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #e5e7eb;
}
.pgrid-cell-img {
  width: 100%;
  height: 100%;
}
.pgrid-del {
  position: absolute;
  top: var(--cy-legacy-4);
  right: var(--cy-legacy-4);
  width: var(--cy-btn-h);
  height: var(--cy-btn-h);
}
.pgrid-del__glyph {
  position: absolute;
  top: 0;
  right: 0;
  width: 40rpx;
  height: 40rpx;
  line-height: 38rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 28rpx;
}
.pgrid-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #f8fafc;
  border: 2rpx dashed #cbd5e1;
}
.pgrid-add-plus {
  font-size: 52rpx;
  color: #0088ff;
  line-height: 1;
}
.pgrid-add-txt {
  font-size: 22rpx;
  color: #8a94a6;
  margin-top: var(--cy-legacy-6);
}

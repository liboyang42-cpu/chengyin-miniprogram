  <!-- 节点下一站：只显示“玩法结果 → 地点”，不把起点、结局或技术规则交给创作者。 -->
  <cy-sheet show="{{routeMappingShow}}" style="--cy-comp-sheet-max-h: calc(100vh - {{chrome.sheetTop}}px)" bind:close="closeNodeRouteMapping">
    <view class="route-mapping-sheet node-sheet">
      <view class="node-sheet__top">
        <view class="node-sheet__done" bindtap="finishNodeRouteMapping" aria-role="button" aria-label="完成下一站编辑" hover-class="cy-pressed" hover-stay-time="80">完成</view>
        <view class="node-sheet__close" bindtap="closeNodeRouteMapping" aria-role="button" aria-label="关闭下一站编辑" hover-class="cy-pressed" hover-stay-time="80">
          <view class="node-sheet__close-circle"><cy-icon name="close-sm" size="44" /></view>
        </view>
      </view>
      <view class="node-sheet__titlebar route-mapping-sheet__titlebar">
        <text class="node-sheet__eyebrow">{{routeMappingSourceLabel}}{{routeMappingTemplateLabel && routeMappingTemplateLabel !== routeMappingSourceLabel ? ' · ' + routeMappingTemplateLabel : ''}}</text>
        <text class="node-sheet__name node-sheet__name--static">下一站</text>
      </view>
      <!-- 稿 S36 的这句是防走错门用的:人常把这张当成"改玩法"的地方。 -->
      <text class="route-mapping-sheet__note">这一页只决定「玩完之后去哪」。玩法本身在节点弹窗的「配置模板」里改。</text>

      <view class="node-card route-mapping-card">
        <view class="route-mapping-row" wx:for="{{routeMappingRows}}" wx:key="code" wx:for-item="mapping" wx:for-index="mappingIndex">
          <text class="route-mapping-row__label">{{mapping.label}}</text>
          <cy-dropdown class="route-mapping-row__picker" range="{{mapping.targetOptions}}" range-key="label" data-rowindex="{{mappingIndex}}" bind:change="onRouteMappingTargetPick">
            <view class="route-mapping-row__target"><text>{{mapping.targetLabel}}</text><cy-icon name="arrow-right" size="24" /></view>
          </cy-dropdown>
        </view>
        <view class="route-mapping-row route-mapping-row--fallback">
          <view>
            <text class="route-mapping-row__label">其他结果</text>
            <text class="route-mapping-row__hint">没有单独对应时</text>
          </view>
          <text class="route-mapping-row__fallback">{{routeMappingFallbackLabel}}</text>
        </view>
      </view>

    </view>
  </cy-sheet>


  <!-- 章节设置 -->
  <view class="pop-model pop-temp pop-chapter-settings {{ popChapter?'show':''}}">
    <!-- CU-C-156:原来左上是「取消」、右上是「完成」,整层没有右上角 ✕。
         改成完成在左、✕ 在右 —— 关闭位置不再和相邻弹层反向,「完成」仍是那颗保存动作。 -->
    <view class="pop-top flex-cb">
      <cy-btn variant="ghost" size="xs" class="cy-btn-inline" bindtap="confrimChapter">完成</cy-btn>
      <view class="tit">{{popChapterAction==0?'添加章节':'编辑章节'}}</view>
      <view class="cs-close" bindtap="cancelChapter" aria-role="button" aria-label="关闭章节设置" hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="close-sm" size="44" /></view>
    </view>
   
      <view class="david_tk chapter-settings-body">
        <!-- 2026-09-05 按 Figma:原来是「大标题 + 半截 228rpx 蓝下划线」,标题与输入内容
             挤在同一行、下划线只压半截,读起来像排版坏了。改成常规的「标签 + 填充输入框」。 -->
        <view class="chapter-name-field">
          <text class="chapter-name-field__label">章节名称</text>
          <input class="chapter-name-field__input" type="text" placeholder="章节名称"
                 placeholder-class="chapter-name-field__ph"
                 value="{{chapterForm.name}}" bindinput="onChapterNameInputChange" data-field="name" />
        </view>

        <!-- 自由探索不进入 V1 块化路径，保留原章节概述；城市定向正文只在全屏故事流编辑器写。 -->
        <view class="chapter-story-field" wx:if="{{formData.productType === 2}}">
          <view class="chapter-story-field__label">
            <text>章节剧情</text>
            <text class="chapter-story-field__req">选填</text>
          </view>
          <textarea
            class="chapter-story-field__input"
            placeholder="这一章讲什么？（选填）"
            placeholder-class="slopes-story-placeholder"
            value="{{chapterForm.description}}"
            bindinput="onChapterDescInput"
            maxlength="500"
            auto-height
            fixed="{{true}}" />
        </view>
        <!-- CU-C-165:这一句原先只按模式分岔(非自由探索就说「创建后…」),于是编辑一章早已
             存在的章节还在预告创建之后会发生什么;故事流此刻就在背后开着。「块间插入点」是实现术语。
             现在按【本章是否还没建】出示:只有点完成会真的把这一章追加进去、并自动打开故事流
             (fabu/index.js:3368 cityStoryFlow → :3402 openStoryEditor)时才说这句话。
             编辑既有章节不出提示 —— 这里能改的就是名称、音频、配色和商家承接。 -->
        <view class="chapter-story-entry-hint" wx:elif="{{popChapterAction == 0}}">点「完成」后进入全屏故事流，剧情和地点在那一屏写</view>

        <!-- 2026-09-04 拍板:音频从故事流的可重复块升成【章节的一个属性】,一章最多一段。
             它是这一章的背景旁白 —— 玩家进入本章时自动播放,所以它没有"插在第几段"这回事,
             留在故事流里就是给一个不存在的位置感。玩家端对应改动见 pages/play/index.js。 -->
        <view class="chapter-audio">
          <view class="chapter-audio__head">
            <text>章节音频</text>
            <text>玩家进入本章时自动播放</text>
          </view>
          <view class="chapter-audio__empty" wx:if="{{!chapterForm.audioUrl}}" bindtap="uploadChapterAudio"
                aria-role="button" aria-label="添加章节音频" hover-class="cy-pressed" hover-stay-time="80">
            <cy-icon name="plus" size="28" /><text>添加音频</text>
          </view>
          <view class="chapter-audio__file" wx:else>
            <view class="chapter-audio__play" bindtap="onPreviewChapterAudio"
                  aria-role="button" aria-label="{{audioPreviewPlaying ? '暂停预听' : '预听章节音频'}}" hover-class="cy-pressed" hover-stay-time="80">
              <text>{{audioPreviewPlaying ? '暂停' : '预听'}}</text>
            </view>
            <view class="chapter-audio__meta">
              <text class="chapter-audio__name">{{chapterForm.audioFileName || '章节音频'}}</text>
              <text class="chapter-audio__dur" wx:if="{{chapterForm.audioDuration}}">{{chapterForm.audioDuration}}″</text>
            </view>
            <view class="chapter-audio__del" bindtap="clearChapterAudio"
                  aria-role="button" aria-label="移除章节音频" hover-class="cy-pressed" hover-stay-time="80">移除</view>
          </view>
        </view>

        <view class="chapter-atmosphere" wx:if="{{formData.productType === 1}}">
          <view class="chapter-atmosphere__head">
            <text>章节配色</text>
            <text>决定玩家端整章的配色</text>
          </view>
          <scroll-view class="chapter-atmosphere__list" scroll-x enhanced show-scrollbar="{{false}}">
            <view class="chapter-atmosphere__track">
              <view class="chapter-atmosphere__item {{item.className}} {{chapterForm.atmospherePreset === item.value ? 'is-on' : ''}}"
                    wx:for="{{atmosphereOptions}}" wx:key="value" data-value="{{item.value}}"
                    bindtap="onChapterAtmosphereSelect" aria-role="button" aria-label="选择{{item.label}}氛围" hover-class="cy-pressed" hover-stay-time="80">
                <text class="chapter-atmosphere__name">{{item.label}}</text>
                <text class="chapter-atmosphere__note">{{item.note}}</text>
              </view>
            </view>
          </scroll-view>
        </view>

        <!-- 商家承接段(稿 P6/C6/M6 都画了,三身份一致)。
             ⚠️ 2026-08-10 曾把这块整块移出章节弹窗,理由是「招商要等商家看到主题才会来报名,
             发布前填不准、发布后 WHITELIST 又改不了」。**2026-09-05 用户裁决推翻那条:
             「D6 就写在里面」** —— 所以装回来。原来的 handler 一直留在 JS 里(那批零绑定债务
             正是它们),这次只是把线接回去,不是新写一套。
             ⚠️ 品类是自由探索的必填闸:normalizeChapterMerchantConfig 在 productType===2 且
             开了招募时,没选品类会当场拦下并 toast。 -->
        <!-- 2026-09-07 用户裁决:「商家承接只有俱乐部主理人能开」。
             判据用 merchantPoolEditable —— 它就是「本账号是不是俱乐部主理人」的权限快照,
             和后端 CmsTopicServiceImpl.resolveMerchantPoolFlag 是同一条闸(2026-08-11 定的)。
             ⚠️ 此前这一段没有任何 wx:if:玩家和商家也看得到整套控件,开了要到发布时才被后端拒。 -->
        <view class="chapter-recruit" wx:if="{{merchantPoolEditable}}">
          <view class="chapter-recruit__head">
            <text>商家承接</text>
            <text>承接的商家给玩家权益,或者只做引流。</text>
          </view>

          <view class="node-card">
            <view class="node-card__row">
              <view class="node-card__ico"><cy-icon name="discover-shop" size="32" /></view>
              <view class="node-card__main">
                <text class="node-card__title">本章开放商家承接</text>
                <text class="node-card__value">{{chapterForm.recruitEnabled ? '开后商家可在合作池申请承接本章' : '本章不对商家开放'}}</text>
              </view>
              <cy-switch checked="{{chapterForm.recruitEnabled}}" bindchange="onChapterRecruitToggleChange" />
            </view>

            <block wx:if="{{chapterForm.recruitEnabled}}">
              <view class="node-card__hr"></view>
              <cy-dropdown range="{{merchantCategoryList}}" range-key="categoryName" bind:change="onChapterMerchantCategoryChange">
                <view class="node-card__row">
                  <view class="node-card__ico"><cy-icon name="discover-shop" size="32" /></view>
                  <view class="node-card__main">
                    <text class="node-card__title">商家品类</text>
                    <text class="node-card__value">{{chapterForm.category || '限定可承接的商家类型'}}</text>
                  </view>
                  <view class="node-pill"><text>选择品类</text><cy-icon name="chevron-right" size="24" /></view>
                </view>
              </cy-dropdown>

              <view class="node-card__hr"></view>
              <view class="tk-field">
                <text class="tk-label">承接条款</text>
                <view class="tk-segment">
                  <view class="tk-segment__item {{chapterForm.termsMode !== 'TRAFFIC' ? 'is-active' : ''}}" bindtap="onChapterTermsModeChange" data-mode="PERK" aria-role="button" aria-label="承接条款选给权益" hover-class="cy-pressed" hover-stay-time="80">给权益</view>
                  <view class="tk-segment__item {{chapterForm.termsMode === 'TRAFFIC' ? 'is-active' : ''}}" bindtap="onChapterTermsModeChange" data-mode="TRAFFIC" aria-role="button" aria-label="承接条款选只引流" hover-class="cy-pressed" hover-stay-time="80">只引流</view>
                </view>
              </view>

              <block wx:if="{{chapterForm.termsMode !== 'TRAFFIC'}}">
                <view class="node-card__hr"></view>
                <view class="node-card__row">
                  <view class="node-card__ico"><cy-icon name="star" size="32" /></view>
                  <view class="node-card__main">
                    <text class="node-card__title">权益门槛 (¥)</text>
                    <text class="node-card__value">商家给出的权益不低于这个价值</text>
                  </view>
                  <input class="chapter-recruit__num" type="digit" value="{{chapterForm.perkMinValue}}" placeholder="不限" placeholder-class="chapter-recruit__ph" bindinput="onChapterPerkMinValueInput" />
                </view>
              </block>

              <view class="node-card__hr"></view>
              <view class="node-card__row">
                <view class="node-card__ico"><cy-icon name="tab-club" size="32" /></view>
                <view class="node-card__main">
                  <text class="node-card__title">名额上限 (家)</text>
                  <text class="node-card__value">{{chapterForm.maxMerchant ? '最多 ' + chapterForm.maxMerchant + ' 家可承接' : '名额不限'}}</text>
                </view>
                <input class="chapter-recruit__num" type="number" value="{{chapterForm.maxMerchant}}" placeholder="不限" placeholder-class="chapter-recruit__ph" bindinput="onChapterMaxMerchantInput" />
              </view>
            </block>
          </view>
        </view>


        <!-- 从故事流「下一步」进来时不给删除(用户 2026-09-05 定):那一步是「把刚编排完的章节收尾」,
             删除留在章节卡那条单层入口。也顺带避免「删掉了章节、下层故事流还开着并指向它」这种悬空态。 -->
        <view class="chapter-settings-delete" bindtap="deleteChapter" wx:if="{{popChapterAction==1 && !chapterSettingsFromStory}}" aria-role="button" aria-label="删除章节" hover-class="cy-pressed" hover-stay-time="80">删除章节</view>

      </view>
  </view>

  <!-- 发布前检查弹层 -->
  <view class="pop-model pop-publish-check {{ publishCheck.show?'show':'' }}">
    <!-- 2026-09-05 用户拍板:点「发布」不直接发 —— 先自动检查,再让人过一遍眼,确认了才真发布。
         所以这一层不再只是「检查报告」,它就是那一页确认页:检查结果 + 玩家看到的样子 + 两颗底部动作。 -->
    <!-- CU-C-156:退出从左上箭头改成右上角 ✕(同一个 closePublishCheck,
         仍是「回编辑器改」)。底部那颗「返回修改」是发布前二选一的一半,原样保留。 -->
    <view class="pop-top flex-cb">
      <view class="pc-lead"></view>
      <view class="tit">发布确认</view>
      <view class="pc-close" bindtap="closePublishCheck" aria-role="button" aria-label="关闭发布确认" hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="close-sm" size="44" /></view>
    </view>
    <view class="pop-cont pc-cont">
      <view class="pc-lede">确认无误后才会真正发布，发布后进入平台审核。</view>
      <view class="pc-section-tit">本次发布</view>
      <cy-card class="pc-summary">
        <view class="pc-summary__line" wx:for="{{publishCheck.summary}}" wx:key="*this">{{item}}</view>
        <view class="pc-summary__visibility">{{publishToCreative ? '默认公开：发布后会在创意广场公开展示；继续即按当前公开范围发布。' : '当前不在创意广场公开展示，仅通过主题入口访问。'}}</view>
      </cy-card>
      <block wx:if="{{publishCheck.passed.length}}">
        <view class="pc-section-tit">自动检查</view>
        <cy-card class="pc-passed">
          <view class="pc-passed__head">
            <view class="pc-passed__mark"><cy-icon name="check" size="28" /></view>
            <text class="pc-passed__title">自动检查已通过 · {{publishCheck.passed.length || 0}} 项</text>
          </view>
          <view class="pc-passed__item" wx:for="{{publishCheck.passed}}" wx:key="label">
            <text class="pc-dot pc-dot-ok"></text>
            <text class="pc-label">{{item.label}}</text>
          </view>
        </cy-card>
      </block>
      <block wx:if="{{publishCheck.blocking.length || !identityReady}}">
        <view class="pc-section-tit pc-blocking">必填项(需补全才能发布)</view>
        <view class="pc-item pc-item-blocking" wx:for="{{publishCheck.blocking}}" wx:key="index"
              data-field="{{item.field}}" data-tab="{{item.tab}}" bindtap="locatePublishIssue" aria-role="button" aria-label="去填写 {{item.label}}" hover-class="cy-pressed" hover-stay-time="80">
          <text class="pc-dot pc-dot-red"></text>
          <text class="pc-label">{{item.label}}</text>
          <view class="pc-arrow"><text>去填写</text><cy-icon name="arrow-right" size="24" /></view>
        </view>
        <!-- RUN-52 发布者实名:玩家没有向导,这一层就是最后一步,补全的控件就在下面,
             所以这一条不带「去填写」——没有别处可去,指向本层那三格(不是死箭头)。 -->
        <view class="pc-item pc-item-blocking" wx:if="{{!identityReady}}">
          <text class="pc-dot pc-dot-red"></text>
          <text class="pc-label">发布者实名未填写</text>
          <view class="pc-arrow pc-arrow--static"><text>在本层填写</text></view>
        </view>
      </block>
      <block wx:if="{{publishCheck.advisory.length}}">
        <view class="pc-section-tit pc-advisory">建议完善(不影响发布)</view>
        <view class="pc-item pc-item-advisory" wx:for="{{publishCheck.advisory}}" wx:key="index"
              data-field="{{item.field}}" data-tab="{{item.tab}}" bindtap="locatePublishIssue" aria-role="button" aria-label="去完善 {{item.label}}" hover-class="cy-pressed" hover-stay-time="80">
          <text class="pc-dot pc-dot-gray"></text>
          <text class="pc-label">{{item.label}}</text>
          <view class="pc-arrow"><text>去完善</text><cy-icon name="arrow-right" size="24" /></view>
        </view>
      </block>
      <!-- RUN-52 发布者实名:要收钱就得知道收钱的人是谁(电商法 §27)。姓名 + 身份证号 + 单独同意,
           挂在发布确认这一层(用户裁定「放最后一步」)。已登记的人整节不见,只在上面的
           「自动检查已通过」里多一行「已登记」——接口只回真假,值不下发也不回显。 -->
      <block wx:if="{{!identityRegistered}}">
        <view class="pc-section-tit">发布者实名</view>
        <view class="pc-identity">
          <cy-field label="真实姓名" required placeholder="与身份证一致"
                    value="{{identityRealName}}" maxlength="{{20}}"
                    data-field="identityRealName" bindinput="onIdentityFieldInput" />
          <cy-field label="身份证号" required placeholder="18 位"
                    value="{{identityIdCard}}" maxlength="{{18}}"
                    data-field="identityIdCard" bindinput="onIdentityFieldInput" />
          <cy-consent-check class="pc-identity__consent" checked="{{identityConsented}}"
                            text="{{identityHint}}" bind:change="onIdentityConsent" />
          <view class="pc-identity__foot">填过一次就不再出现。变更实名信息请联系平台客服。</view>
        </view>
        <cy-inline-error class="pc-identity__err" wx:if="{{identityError}}" kind="error"
                         title="实名没有登记" sub="{{identityError}}" />
      </block>
      <!-- P0.5 奖励总览(只读:XP 自动分配 / 通关勋章) -->
      <view class="pc-section-tit">奖励总览</view>
      <cy-card class="pc-reward">
        <view class="pc-reward-row"><text class="pc-reward-k">探索值(XP)</text><text class="pc-reward-v">自动分配 · 按任务难度拆 60%,余额为通关奖励</text></view>
        <view class="pc-reward-row"><text class="pc-reward-k">通关勋章</text><text class="pc-reward-v">{{formData.finishMedalName || (formData.name || '主题名') + ' · 通关(默认)'}}</text></view>
      </cy-card>
      <!-- blocking 非空(内容安全/AI 判定为 error)时不给继续发布。
           2026-09-05 按 Figma 统一按钮位置:阻断态原来只有一行红字、连个按钮都没有,
           和「仅建议」那态长得完全不同 —— 现在两态都有同一颗底部按钮,阻断时禁用,
           红字提示留在按钮上方说明为什么点不动。 -->
      <!-- 玩家看到的样子。⚠️ 读的是编辑器里的当前草稿(_buildPublishPreview),不是 ?id= 拉服务端 ——
           拿服务端那版预览就是上一次保存的内容,与眼前的编辑器对不上。 -->
      <block wx:if="{{publishCheck.preview}}">
        <view class="pc-section-tit">玩家看到的样子</view>
        <cy-card class="pc-preview">
          <image wx:if="{{publishCheck.preview.cover}}" class="pc-preview__cover" src="{{publishCheck.preview.cover}}" mode="aspectFill" lazy-load="true" />
          <view wx:else class="pc-preview__cover pc-preview__cover--empty"><cy-icon name="image" size="48" /></view>
          <text class="pc-preview__name">{{publishCheck.preview.name}}</text>
          <text class="pc-preview__sub" wx:if="{{publishCheck.preview.subtitle}}">{{publishCheck.preview.subtitle}}</text>
          <view class="pc-preview__stats">
            <view class="pc-preview__stat" wx:for="{{publishCheck.preview.stats}}" wx:key="k">
              <text class="pc-preview__stat-v">{{item.v}}</text>
              <text class="pc-preview__stat-k">{{item.k}}</text>
            </view>
          </view>
          <text class="pc-preview__desc" wx:if="{{publishCheck.preview.description}}">{{publishCheck.preview.description}}</text>
          <view class="pc-preview__chapter" wx:for="{{publishCheck.preview.chapters}}" wx:key="name" wx:for-item="chapter">
            <text class="pc-preview__chapter-name">{{chapter.name}}</text>
            <view class="pc-preview__node" wx:for="{{chapter.nodes}}" wx:key="name">
              <text class="pc-preview__node-name">{{item.name}}</text>
              <text class="pc-preview__node-addr">{{item.address}}</text>
            </view>
          </view>
        </cy-card>
      </block>
      <!-- blocking 非空(内容安全/AI 判定为 error)时不给发布:按钮禁用,红字说明为什么点不动。 -->
      <view class="pc-actions">
        <view wx:if="{{publishCheck.blocking.length || !identityReady}}" class="pc-blocked-tip">请先处理上方必填项后再发布</view>
        <view class="pc-actions__row">
          <cy-btn class="pc-actions__btn" variant="secondary" bindtap="closePublishCheck">返回修改</cy-btn>
          <cy-btn class="pc-actions__btn" variant="primary" disabled="{{!!publishCheck.blocking.length || !identityReady}}"
                  aria-disabled="{{!!publishCheck.blocking.length || !identityReady}}"
                  bind:disabledtap="onPublishCheckDisabledTap"
                  bindtap="confirmPublishCheck">确认发布</cy-btn>
        </view>
      </view>
    </view>
  </view>



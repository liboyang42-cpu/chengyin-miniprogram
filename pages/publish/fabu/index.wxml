          <view bindtap="selectTemp" class="temp-rail__li {{selectedTempId === item.id ? 'is-on' : ''}}" wx:for="{{publicTempList}}" wx:key="id" data-item="{{item}}" hover-class="cy-pressed" hover-stay-time="80">
            <view class="item">
              <image lazy-load="true" src="{{item.imgUrl}}" mode="aspectFill" class="temp-rail__pic" />
              <view class="item-txt">

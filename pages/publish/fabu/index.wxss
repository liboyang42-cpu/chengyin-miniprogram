/* ===== Slopes 风格专业主题编辑器 ===== */
page { background: var(--cy-btn-solid-bg); }

.slopes {
  min-height: 100vh;
  background: var(--cy-btn-solid-bg);
  position: relative;
  overflow: hidden;
}

/* 用户 2026-08-11 定:点「地图」= 看路线,地图【铺满全屏】。
   原来只给 42vh、下面 58vh 还压着内容 sheet —— 顶上一条地图既看不清整条路线,
   也没法缩放挪动(手一拖就碰到 sheet)。想回内容点左下角那个图标,不必留半截。 */
.slopes-map-wrap {
  position: fixed;
  inset: 0;
  z-index: 1;
}

.slopes-map {
  width: 100%;
  height: 100%;
  display: block;
}

/* 状态栏保护层:.slopes-map-wrap 是 fixed top:0,地图瓦片直接铺到系统状态栏底下;
   状态栏前景是白字,压在浅色瓦片上就看不见。这里在状态栏区域盖一层由深到透明的 scrim。
   --cy-scrim-statusbar 由 wxml 注入 = 系统状态栏实高:满色段严格覆盖到状态栏底边,
   再用一档 space token 的距离淡出,所以刘海机 / Android 小状态栏都是对的,不靠百分比猜。
   单层 --cy-comp-scrim(.46)压在纯白瓦片上,白字对比度只有约 3.5:1;两层同色叠加后
   顶部实际 1-(1-.46)²≈.71(白字约 8.8:1),最浅的地图底色下也能读。
   (叠两层是因为 tokens.wxss 属共享样式层、本轮不由本线改,加不了更深的 scrim token;
    若日后 --cy-comp-scrim 被调浅,这里的对比度会静默下降 —— 待共享样式线补一个向下的
    scrim 渐变 token 后换掉。)
   scrim 用的是主题无关 token(照片遮罩/白字那一层,tokens.wxss 单点定义、各 theme 均未覆写),
   所以不会出现「换主题后遮罩变浅」的反向问题。
   返回键(statusBarHeight+8)与步骤条(+18)落在淡出段中部、约 .4 不透明:两者本身是白字 /
   深色胶囊,压深只增不减可读性;pointer-events:none 保证不吃点击。 */
.slopes-status-scrim {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: calc(var(--cy-scrim-statusbar, 0px) + var(--cy-space-5));
  z-index: 2;
  pointer-events: none;
  background:
    linear-gradient(to bottom, var(--cy-comp-scrim) 0, var(--cy-comp-scrim) var(--cy-scrim-statusbar, 0px), transparent 100%),
    linear-gradient(to bottom, var(--cy-comp-scrim) 0, var(--cy-comp-scrim) var(--cy-scrim-statusbar, 0px), transparent 100%);
}

/* 同 .pd-step-progress--map:从地图的 cover-view 里提到页面级,故 fixed。
   压在地图上时(--on-map)用 oncover 前景色,压在 sheet 上时用常规文字色。 */
/* 稿子(4028:13649)是 40px 白色圆钮 + 阴影。白底自带对比度,压在地图瓦片上也读得出来,
   所以不再需要原来那套 --on-map 翻成 oncover 前景色的分支。 */
.slopes-back {
  position: fixed;
  left: var(--cy-page-x);
  z-index: 20;
  width: var(--cy-btn-h);
  height: var(--cy-btn-h);
  border-radius: var(--cy-radius-pill);
  color: var(--cy-color-text-primary);
  background: var(--cy-color-bg-surface);
  /* 稿子画的是投影;本域(theme-topic-editor)的表面规范是「零投影、留描边」
     (tokens.wxss §表面规范:起层手段二选一,--cy-shadow-card 在这里恒为 none),
     所以起层改用描边。写 box-shadow 在这里等于没写。 */
  border: 2rpx solid var(--cy-color-border-subtle);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

.slopes-back__ico {
  width: 20rpx;
  height: 20rpx;
  margin-left: 6rpx;
  box-sizing: border-box;
  border-left: 4rpx solid currentColor;
  border-bottom: 4rpx solid currentColor;
  transform: rotate(45deg);
}

.slopes-crosshair.map-crosshair {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: var(--cy-space-5);
  height: var(--cy-space-5);
  border: 2rpx solid rgba(255, 255, 255, 0.85);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.slopes-crosshair .map-crosshair__dot {
  width: var(--cy-space-1-5);
  height: var(--cy-space-1-5);
  background: var(--cy-color-action-primary-bg);
}

/* 不带 --full = 地图视图。地图既然铺满全屏,这张内容 sheet 就整体滑出屏幕,
   ⚠️ 用 transform 而不是改 top/height:scroll-view 高度归零会把滚动位置一起清掉,
   切回「内容」时人就被弹回列表最顶上,刚才看到哪儿全丢了。
   pointer-events 必须一起关,否则一层看不见的 sheet 仍然吃掉地图上的拖拽和缩放。 */
.slopes-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  top: 28vh;
  transform: translateY(105%);
  pointer-events: none;
  z-index: 10;
  background: var(--cy-color-bg-elevated);
  border-radius: var(--cy-comp-sheet-radius) var(--cy-comp-sheet-radius) 0 0;
  box-sizing: border-box;
  /* ⚠️ 只让开底栏【实心的那一段】,不是整条。底栏是 220rpx 高的渐变带,下 55%(≈120rpx,
     安全区已包含在内)是实底、上面 45% 化开 —— 内容要能滚进那段渐隐区才有"从下面透出来"
     的效果,这正是稿子(4034:14718)的样子。原来这里留 240rpx + 安全区 ≈ 308rpx,比整条
     底栏还高:内容在够到渐变之前就先被 padding 顶住,于是底部一大块死灰、没有任何渐隐,
     最后一张章节卡被整齐切掉。 */
  padding-bottom: 120rpx; /* ds-ok: 与底栏渐变实心段等高,不套用间距量表 */
}

/* 没有地图的两步(路线/设置):sheet 顶到状态栏下方,让出的 28vh 全给列表。
   顶部仍留出返回钮 + 步骤条的高度,否则内容会钻到它们底下。 */
.slopes-sheet--full {
  top: 0;
  transform: none;
  pointer-events: auto;
  /* --cy-sheet-chrome-top = 胶囊底 + 间隙(px,由 wxml 注入),内容从这里开始。
     ⚠️ 2026-08-10:原先还 +112rpx,那是给【顶部两格步骤条】留的位置 —— 步骤条在
     59fd3d6aa 已经删了,这档留白就成了纯空档:实拍返回钮与主题名之间空出一大截,
     整页像被压扁往下推。删掉那一项,标题紧跟在返回钮下面(稿子 4028:13649 的
     TopBar pb=14 + Heading 就是这个节奏)。 */
  padding-top: var(--cy-sheet-chrome-top, 0px);
  border-radius: 0;
}

/* 满屏态没有地图可抓,grabber 只是个装饰横条,去掉省一行空间 */
.slopes-sheet--full .slopes-grabber {
  display: none;
}

.slopes-sheet-anchor {
  height: 1rpx;
}

.slopes-grabber {
  width: var(--cy-legacy-72);
  height: var(--cy-space-1);
  border-radius: var(--cy-radius-pill);
  background: #3a3a3c;
  margin: 16rpx auto 8rpx;
}

.slopes-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 32rpx 24rpx;
}

.slopes-title {
  flex: 1;
  font-size: var(--cy-font-display-xl);
  font-weight: 800;
  color: #fff;
  line-height: 1.1;
  letter-spacing: -0.5rpx;
}

.slopes-header-pill {
  display: flex;
  align-items: center;
  background: #2c2c2e;
  border-radius: var(--cy-radius-pill);
  padding: 8rpx var(--cy-space-1-5);
  margin-left: var(--cy-space-2);
  flex-shrink: 0;
}

.slopes-pill-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: var(--cy-font-display);
  font-weight: 300;
  line-height: 1;
}

.slopes-pill-btn--add {
  background: transparent;
}

.slopes-chevron {
  display: flex;
  align-items: center;
  color: #636366;
  flex-shrink: 0;
}

.slopes-section {
  padding: 0 32rpx 27rpx;
}

/* 区块标题 ↔ 下一张卡:16rpx → 27rpx。step3 的 .pd-section-title 早就是 27rpx(F1 补充二),
   这一处当时漏了,两页的同一个关系用两个数。 */
.slopes-section-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 27rpx;
}

.slopes-section-tit {
  font-size: var(--cy-font-subtitle);
  font-weight: 800;
  color: #fff;
}

.slopes-section-link {
  font-size: var(--cy-font-body);
  font-weight: 600;
  color: var(--cy-color-action-primary-bg);
}

/* 圆角与 .pd-list / .pd-entry-card 取齐 lg:2026-08-10 页底改灰后卡片真的浮出来了,
   同屏三种卡再用两档圆角会看出来参差 */
.slopes-empty-card {
  --cy-comp-card-radius: var(--cy-radius-lg);
  --cy-comp-card-pad: var(--cy-legacy-36) var(--cy-space-3-5);
  margin-bottom: var(--cy-space-1-5);
}

.slopes-empty-txt {
  font-size: var(--cy-font-label);
  color: #8e8e93;
  line-height: 1.5;
}


.slopes-card:active {
  opacity: 0.85;
}






/* ⚠️ 别按「底栏 220rpx 高就留 220rpx」来加这个值 —— 我 2026-09-05 这么改过一次,当场
   把渐变效果改没了,用户第一眼就看出来「底部 sheet 不一样了」。
   原因是尾部留白**不止这一处**:承载滚动的 .slopes-sheet 自己还有 padding-bottom:120rpx
   (= 底栏渐变带里【实心的那一段】)。两处加起来才是内容的实际净空。
   底栏 220rpx 里只有下 55%(≈120rpx)是实底,上面 45% 是化开的 —— 内容本来就该滚进那段
   渐隐区,那正是稿子要的「从底栏下面透出来」。留白给到整条底栏的高度,内容在够到渐变之前
   就被顶住,底部一大块死灰、没有任何渐隐(与上面 .slopes-sheet 注释里记的是同一个坑)。 */
/* 2026-09-08 用户裁决:「按钮不被压住」。
   ⇒ 尾部净空补到**整条底栏**的高度:.slopes-sheet 自己的 padding-bottom 120rpx
     + 这里 100rpx = 220rpx = .slopes-tabbar 的高。滚到底时最后一颗按钮正好压在底栏上沿。
   ★ 和 2026-09-05 那次改坏渐变的区别在于「加到多少」,不是「加不加」:
     那次我把**这一处**直接写成 220rpx,连同 sheet 的 120rpx 一共 340rpx —— 内容还没够到
     渐隐区就被顶住,底部一大块死灰。现在两处相加正好等于底栏高度,中途滚动照旧从
     渐变里透出来,只有终点被抬到底栏之上。 */
.slopes-sheet-bottom {
  height: calc(100rpx + env(safe-area-inset-bottom));
}

.slopes-map-editbar {
  position: fixed;
  left: var(--cy-space-4);
  right: var(--cy-space-4);
  bottom: calc(32rpx + env(safe-area-inset-bottom));
  z-index: 100;
  display: flex;
  gap: var(--cy-space-2);
  background: rgba(28, 28, 30, 0.92);
  border-radius: var(--cy-radius-md);
  padding: var(--cy-space-2);
  backdrop-filter: blur(12px);
}

/* 章节块 + 嵌套节点 */
.slopes-chapter-block {
  --cy-comp-card-radius: var(--cy-radius-lg);

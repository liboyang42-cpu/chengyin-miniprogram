.slopes-tab.is-on .slopes-tab__dot { background: var(--cy-color-text-primary); }

/* 稿 4959:13549:高 48px(92rpx)、内距 0/28(53rpx)、r999。
   ⚠️ cy-btn 是 isolated 组件,页面选择器够不到它内部的 .btn —— 只能靠**自定义属性**
   (custom property 会沿继承链穿过 styleIsolation)。.btn 的高与内距本来就读
   --cy-btn-h / --cy-btn-pad-x,在宿主上覆盖这两个变量即可,且只作用于这一颗。
   ⚠️ 高度**不覆盖**:稿子写 48px,但仓库有一条 D25「全站 cy-btn 统一按钮高度」的审计
   (还带负控:任一页面把 cy-btn 改回自定义高度就判红)。88rpx=46px 与稿子差 2px,
   不值得为它破一条全站规则 —— 只取内距与药丸圆角。 */
.slopes-tabbar__cta {
  flex: none;
  --cy-btn-pad-x: 53rpx;
  --cy-comp-btn-radius: var(--cy-radius-pill);
}

/* 第 2 页(票务)的「完成」。2026-08-11 用户定:两页平铺、没有先后,不用返回箭头 ——
   「完成」说的是这一页编完了,不是"退回上一步"。
   2026-09-05 按稿 P11 / C11 改成【整宽黑色药丸】:原来是左下角一行小字,与稿子差很远,
   而且票务页左槽没有视图切换,整条底栏本来就该交给这一颗收尾动作。 */
.slopes-tabbar__doneCta {
  flex: 1;
  --cy-comp-btn-radius: var(--cy-radius-pill);
}

/* 主题名:稿子是一整行大标题,不是表单里的一个输入框。 */
.pd-title-input {
  font-size: var(--cy-font-page-title);
  font-weight: 700;
  letter-spacing: -1rpx;
}

/* 主题详情入口行与章节卡统一到 20px 圆角。 */
.pd-entry-card,
.slopes-chapter-block,
.slopes-empty-card { border-radius: var(--cy-radius-xl); }

/* 空态(Figma 4028:13880):居中 + 图标 + 药丸按钮。
   原来是左对齐纯文字铺在一张大白卡上,读起来像"加载失败"而不是"等你建第一章"。 */
.slopes-empty-card__body {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: var(--cy-space-5) var(--cy-space-3);
}

.slopes-empty-ico {
  width: 104rpx;
  height: 104rpx;
  margin-bottom: var(--cy-space-3);
  border-radius: var(--cy-radius-pill);
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--cy-color-bg-surface-subtle);
  color: var(--cy-color-text-tertiary);
}

.slopes-empty-txt {
  color: var(--cy-color-text-primary);
  font-size: var(--cy-font-subtitle);
  font-weight: 700;
}

.slopes-empty-sub {
  padding-top: var(--cy-space-1);
  color: var(--cy-color-text-tertiary);
  font-size: var(--cy-font-caption);
  line-height: 1.6;
}

.slopes-empty-cta { margin-top: var(--cy-space-4); }

/* ===== 节点编辑弹窗(Figma 4029:14152) =====
   三张白卡(地点 / 配置模板 / 照片)+ 一张红字删除卡,壳子是 cy-sheet 的 bottom 变体。
   卡内两段式:上段「圆图标 + 标题 + 右侧动作」,下段隔一条线放次要信息/次要动作。
   颜色一律走 --cy-* :cy-sheet 的 .sh__panel 会把 role 档整组重声明,写死色号会在
   玩家深色弹窗里翻车(2026-08-07 白卡白字那一族的成因)。 */
/* CU-M-159(2026-09-24):✕ 固定落右上角(全仓统一),主操作「完成」紧贴其左。
   原来这行是 space-between 的「左 ✕ / 右 完成」,和相邻弹层的右上 ✕ 反向,
   人在同一个发布流程里找关闭要来回换方向。
   「上一步」那颗仍留最左:它退一层,不是关闭,和 cy-sheet 的 canBack + ✕ 同一分工。 */
.node-sheet__top {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: var(--cy-space-2);
  padding: var(--cy-space-4) 0 var(--cy-space-3);
}

.node-sheet__back {
  margin-right: auto;
  width: 88rpx;
  height: 88rpx;
  margin-left: calc(var(--cy-space-1) * -1);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--cy-color-text-secondary);
}

/* 外框 88rpx 是触达下限,里面那颗 72rpx 才是稿子画的圆 —— 两者分开,
   缩视觉不缩热区。 */
.node-sheet__close {
  width: 88rpx;
  height: 88rpx;
  margin-right: calc(var(--cy-space-1) * -1);
  display: flex;
  align-items: center;
  justify-content: center;
}

.node-sheet__close-circle {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--cy-color-text-secondary);
  /* ✕纯字形无圆底(2026-09-18 终裁);热区由 .node-sheet__close 88rpx 承担 */
}

.node-sheet__done {
  min-width: 128rpx;
  height: var(--cy-btn-h);
  padding: 0 var(--cy-space-4);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--cy-radius-pill);
  background: var(--cy-color-action-primary-bg);
  color: var(--cy-color-action-primary-fg);
  font-size: var(--cy-font-label);
  font-weight: 700;
}

/* 节点名不是表单里的一个字段,它就是这张弹窗的标题(稿子 4029:14281) */
.node-sheet__titlebar {
  padding: var(--cy-space-1) 0 var(--cy-space-5);
  text-align: center;
}

.node-sheet__eyebrow {
  display: block;
  font-size: var(--cy-font-label);
  color: var(--cy-color-text-tertiary);
}

.node-sheet__name {
  margin-top: var(--cy-space-1);
  /* 稿值 22px = 44rpx。字阶原本在 card-title(32) 与 page-title(58) 之间是空的,
     已补 --cy-type-sheet-title 这一档(节点/主题两张弹窗都用它)。 */
  font-size: var(--cy-font-sheet-title);
  font-weight: 700;
  color: var(--cy-color-text-primary);
  text-align: center;
}

.node-sheet__name-ph { color: var(--cy-color-text-placeholder); }

.node-card {
  margin-bottom: var(--cy-space-2-5);
  padding: var(--cy-space-3-5);
  box-sizing: border-box;
  border-radius: var(--cy-radius-xl);
  background: var(--cy-color-bg-surface);
}

.node-card__row {
  display: flex;
  align-items: center;
  gap: var(--cy-space-3);
}

.node-card__ico {
  width: 64rpx;
  height: 64rpx;
  flex: none;
  border-radius: var(--cy-radius-pill);
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--cy-color-bg-surface-subtle);
  color: var(--cy-color-text-primary);
}

.node-card__main {
  flex: 1;
  min-width: 0;
}

.node-card__title {
  display: block;
  font-size: var(--cy-font-body);
  font-weight: 700;
  color: var(--cy-color-text-primary);
}

.node-card__value {
  display: block;
  margin-top: var(--cy-legacy-4);
  font-size: var(--cy-font-caption);
  color: var(--cy-color-text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.node-card__foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--cy-space-2);
  margin-top: var(--cy-space-2-5);
  padding-top: var(--cy-space-2);
  border-top: 2rpx solid var(--cy-color-border-subtle);
}

.node-card__addr {
  flex: 1;
  min-width: 0;
  font-size: var(--cy-font-caption);
  color: var(--cy-color-text-tertiary);
}

.node-pill {
  flex: none;
  max-width: 60%;
  height: var(--cy-btn-h);
  padding: 0 var(--cy-space-3);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: var(--cy-space-1);
  border-radius: var(--cy-radius-pill);
  background: var(--cy-color-bg-surface-subtle);
  color: var(--cy-color-text-primary);
  font-size: var(--cy-font-label);
  font-weight: 700;
  overflow: hidden;
  white-space: nowrap;
}

.node-pill:active { opacity: 0.7; }

.node-badge {
  flex: none;
  padding: var(--cy-legacy-6) var(--cy-space-2);
  border-radius: var(--cy-radius-pill);
  background: var(--cy-color-bg-surface-subtle);
  color: var(--cy-color-text-tertiary);
  font-size: var(--cy-font-label);
  font-variant-numeric: tabular-nums;
}

/* 2026-09-05 按 Figma:删除节点从一行裸红字提成整宽按钮 —— 和删除章节同一档,
   两个「删除 X」在不同弹窗里长得不一样是没道理的。 */
.node-card--danger {
  min-height: var(--cy-btn-h);
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: var(--cy-space-3);
  border-radius: var(--cy-radius-md);
  background: var(--cy-color-status-danger-soft);
  color: var(--cy-color-status-danger);
  font-size: var(--cy-font-body);
  font-weight: 700;
}

.node-sheet .pending-node-description {
  width: 100%;
  margin-top: var(--cy-space-3);
  font-size: var(--cy-font-body);
  color: var(--cy-color-text-primary);
}

/* 九宫格在这张卡里是三列、82px 高的方格(稿子 4029:14257),
   和共享 styles/photo-grid.wxss 的 200rpx 大格不同 —— 只在本弹窗内覆盖,不动共享文件。 */
.node-sheet .pgrid {
  margin-top: var(--cy-space-3);
  gap: var(--cy-space-2);
}

.node-sheet .pgrid-cell {
  width: calc((100% - var(--cy-space-4)) / 3);
  height: 164rpx;
  border-radius: var(--cy-radius-md);
  background: var(--cy-color-bg-surface-subtle);
}

.node-sheet .pgrid-add {
  background: transparent;
  border: 4rpx dashed var(--cy-color-border-strong);
  box-sizing: border-box;
}

.node-sheet .pgrid-add-plus {
  display: flex;
  align-items: center;
  color: var(--cy-color-text-tertiary);
}

.node-sheet .pgrid-del__glyph {
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ——— 主题详情弹窗复用节点弹窗的卡片语言(设计源码:编辑主题弹窗.dc.html) ——— */

/* 卡内分隔线。稿子是 1px #EFEFF1,通栏到卡内边距为止(不是全出血)。 */
.node-card__hr {
  height: 2rpx;
  margin: var(--cy-space-2-5) 0;
  background: var(--cy-color-border-subtle);
}

/* 主动作药丸(稿子里「＋ 上传 3:4」是黑的,「＋ 上传 16:9」是灰的 —— 竖版封面必填、横版选填) */
.node-pill--solid {
  gap: var(--cy-space-1);
  background: var(--cy-color-action-primary-bg);
  color: var(--cy-color-action-primary-fg);
}

/* 圆图标位放缩略图/头像时不再是「图标底」,而是图片本身 */
.node-card__ico--media {
  overflow: hidden;
  background: var(--cy-color-bg-surface-subtle);
}

.pd-pill-thumb {
  width: 36rpx;
  height: 48rpx;
  border-radius: var(--cy-radius-sm);
  flex: none;
}

.node-sheet__name--static { display: block; }

/* 卡内就地输入:稿子那一行是「副文」的位置,这里换成可写的输入框,
   字号/颜色跟副文一致,不让它看起来像另起一层表单。 */
.pd-card-input {
  margin-top: var(--cy-legacy-4);
  font-size: var(--cy-font-caption);
  color: var(--cy-color-text-secondary);
}

.pd-card-textarea {
  width: 100%;
  margin-top: var(--cy-space-3);
  padding: var(--cy-space-2-5);
  box-sizing: border-box;
  min-height: 160rpx;
  border-radius: var(--cy-radius-md);
  background: var(--cy-color-bg-surface-subtle);
  font-size: var(--cy-font-body);
  color: var(--cy-color-text-primary);
}

.node-card .pd-gallery {
  display: flex;
  flex-wrap: wrap;
  gap: var(--cy-space-2);
  margin-top: var(--cy-space-3);
}

.node-card .pd-gitem {
  position: relative;
  width: calc((100% - var(--cy-space-4)) / 3);
  height: 164rpx;
  border-radius: var(--cy-radius-md);
  overflow: hidden;
  background: var(--cy-color-bg-surface-subtle);
}

.node-card .pd-gimg { width: 100%; height: 100%; }

/* 弹窗正文底色。cy-sheet 的面板底走 role-glass,在本主题里是纯白(#FFFFFF),
   而卡片底 role-surface 也是纯白 —— 白卡贴白面板 = 卡片边界整个消失,一屏字全糊在
   一张白纸上(设计源码里面板是 #F7F7F8、卡是 #FFF,靠这一层差把卡分出来)。
   面板在组件内部(isolated),页面样式够不着,所以在 slot 这一层负边距出血铺 page 底色。 */
.node-sheet {
  margin: 0 calc(var(--cy-page-x) * -1);
  padding: 0 var(--cy-page-x) var(--cy-space-3);
  background: var(--cy-color-bg-page);
}

.node-route-entry:active,
.story-node-block__route:active { opacity: 0.7; }

.route-mapping-sheet {
  padding-bottom: calc(var(--cy-space-4) + env(safe-area-inset-bottom));
}

.route-mapping-sheet__titlebar { padding-bottom: var(--cy-space-4); }

.route-mapping-card { padding: 0 var(--cy-space-3-5); }

.route-mapping-row {
  min-height: var(--cy-btn-h);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--cy-space-3);
  border-bottom: 2rpx solid var(--cy-color-border-subtle);
}

.route-mapping-row:last-child { border-bottom: 0; }

.route-mapping-row__label {
  display: block;
  flex: 1;
  min-width: 0;
  color: var(--cy-color-text-primary);
  font-size: var(--cy-font-body);
  font-weight: 700;
}

.route-mapping-row__hint {
  display: block;
  margin-top: var(--cy-legacy-4);
  color: var(--cy-color-text-tertiary);
  font-size: var(--cy-font-caption);
}

.route-mapping-row__picker {
  flex: 0 1 58%;
  min-width: 0;
}

.route-mapping-row__target {
  min-height: var(--cy-btn-h);
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: var(--cy-space-2);
  color: var(--cy-color-text-primary);
  font-size: var(--cy-font-label);
  font-weight: 700;
}

.route-mapping-row__target text:first-child {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.route-mapping-row--fallback { padding: var(--cy-space-2) 0; }

.route-mapping-row__fallback {
  flex: none;
  color: var(--cy-color-text-secondary);
  font-size: var(--cy-font-label);
}


/* 故事流节点块的实拍缩略图(用户 2026-08-10 定)。没传图时放一个占位图标,
   而不是让这一格塌掉 —— 塌掉会让"有图/没图"两种节点块高度不一,列表读起来是锯齿。 */
/* 2026-09-05 按 Figma 改成横图:88rpx 见方的小方块认不出是哪个点,
   190×138 能看清门脸。没传图时仍走占位图标,保持有图/没图等高。 */
.story-node-block__thumb {
  width: 190rpx;
  height: 138rpx;
  flex: none;
  margin-right: var(--cy-space-2);
  border-radius: var(--cy-radius-md);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--cy-color-bg-surface);
  color: var(--cy-color-text-placeholder);
}

.story-node-block__img { width: 100%; height: 100%; }

/* ✕ 删除:只在选中的块上出现(用户 2026-08-10 定)。原来是常驻的红色「删除 / 删除文字块」,
   两行文案比它删的那个块还长,而且一屏里每块都挂一个,红字比正文还抢眼。 */
/* 选中块上的删除键。2026-09-06 用户在 Figma 上定稿:选中态不画描边,
   删除是一枚**裸的红色垃圾桶图标**(不套底色圆)—— 它出现本身就是「这一块被选中了」。
   ⚠️ right 取 52rpx 而不是各块自己的右内距(媒体 40rpx / 文字 32rpx):四种块的图标
   右沿要落在同一条竖线(364)上,那条线是插入缝横线右端再内缩 16rpx。 */
.story-block-x {
  position: absolute;
  right: 52rpx;
  top: 50%;
  transform: translateY(-50%);
  width: var(--cy-btn-h);
  height: var(--cy-btn-h);
}

.story-block-x__glyph {
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--cy-color-status-danger);
}

/* 玩法卡在这张弹窗里的收口:共享的 .temp-list 是给整屏列表页写的(266rpx 大图),
   放进弹窗里图一旦为空就是一大片纯白空档,标题被挤到很下面(实拍如此)。
   这里只在本弹窗内压小并给底色 —— 空图时看到的是一个占位方块,不是一个洞。 */
/* ===== 票务页 / 票种编辑器(Figma 2770:13325 自由探索档 · 2770:11762 城市定向档) =====
   稿子的配色是另一套(slate + 蓝/绿/橙),这里只搬【信息结构与控件形态】,
   颜色一律回到创作域这套中性语言 —— 一个编辑器里出现第二套色系,才是真的不统一。 */

.tk-field { padding: var(--cy-space-1) 0; }

.tk-label {
  display: block;
  margin-bottom: var(--cy-space-2);
  font-size: var(--cy-font-label);
  font-weight: 500;
  color: var(--cy-color-text-secondary);
}

.tk-input {
  width: 100%;
  height: 88rpx;
  padding: 0 var(--cy-space-3);
  box-sizing: border-box;
  border-radius: var(--cy-radius-md);
  background: var(--cy-color-bg-surface-subtle);
  font-size: var(--cy-font-body);
  color: var(--cy-color-text-primary);
}

/* 票单价格 / 发行数量 稿子是并排两列,不是上下两行 —— 它们是一组参数,竖排会被
   中间的分隔线切成两件事。 */
.tk-grid {
  display: flex;
  gap: var(--cy-space-3);
}

.tk-grid .tk-field {
  flex: 1;
  min-width: 0;
}

/* 稿子的提示条是橙底橙字。橙色在本域的语义是「待办 / 还差点什么」(章节卡的
   待选地点标签就是它),这里的两句都是说明而不是待办,所以走中性说明色。 */
.tk-note {
  margin-top: var(--cy-space-2);
  padding: var(--cy-space-2-5);
  border-radius: var(--cy-radius-md);
  background: var(--cy-color-bg-surface-subtle);
  color: var(--cy-color-text-tertiary);
  font-size: var(--cy-font-caption);
  line-height: 1.6;
}

.tk-note--inline { margin-top: 0; background: transparent; padding: var(--cy-space-1) 0; }

.tk-subhead {
  display: flex;
  align-items: center;
  gap: var(--cy-space-2);
  color: var(--cy-color-text-primary);
  font-size: var(--cy-font-body);
  font-weight: 700;
}

/* 保存按钮在头部和底部各一颗:头部那颗是"随手存",底部那颗是稿子上的主动作。
   禁用态要看得出来,否则点不动会被当成卡死。 */
.node-sheet__done.is-disabled {
  background: var(--cy-color-bg-surface-subtle);
  color: var(--cy-color-text-placeholder);
}


/* 玩法两段改横滑(用户 2026-08-11 定)。竖着铺网格时,两段加起来能把整屏吃满,
   人要滚很久才走到「自己建一个玩法」;横滑之后两段各占一行高,整页一屏能看完。
   ⚠️ scroll-view 横滑必须 white-space: nowrap + inline-block 子项,
   用 flex 会被 scroll-view 的内容宽度算成一屏、滑不动。 */
.temp-rail {
  width: 100%;
  white-space: nowrap;
}

.temp-rail__ul {
  display: inline-block;
  white-space: nowrap;
}

/* 2026-09-05 按 Figma:横向缩略图(260×168)改成正方形卡。横图在横滑轨里一屏只塞得下
   一张半,读起来像"一条被截断的列表";方卡一屏三张,才像一个可挑选的库。 */
.temp-rail__li {
  display: inline-block;
  vertical-align: top;
  width: 210rpx;
  margin-right: var(--cy-space-2);
  white-space: normal;
}

.temp-rail__li:last-child { margin-right: 0; }

.temp-rail__pic {
  width: 210rpx;
  height: 210rpx;
  display: block;
  border-radius: var(--cy-radius-xl);
  background: var(--cy-color-bg-surface-subtle);
}

/* 选中态用描边,不用换底色:卡上本来就有图,换底色在深浅不一的图下面根本看不出来 */
.temp-rail__li.is-on .temp-rail__pic {
  box-shadow: 0 0 0 4rpx var(--cy-color-text-primary);
}

.temp-rail__li .item-txt { padding-top: var(--cy-space-1); }

.temp-rail__li .tit {
  font-size: var(--cy-font-label);
  font-weight: 700;
  color: var(--cy-color-text-primary);
}

.temp-rail__li .david_mbxi {
  display: flex;
  gap: var(--cy-space-1);
  font-size: var(--cy-font-caption);
  color: var(--cy-color-text-tertiary);
}

/* 主题模式选择器的两个选项。选中走【主打色低透明度填充】,不描边(2026-08-11 用户定):
   创作域整体中性,但"选哪种玩法"是这页唯一需要一眼分开两条路的地方,给一点颜色。
   ⚠️ 这两个色只做身份标识,不参与状态语义 —— 状态(危险/待办)仍然只走 status-*,
   否则以后蓝色在这页是"定向"、在别处是"信息",同一个色两套读法。 */
.mode-opt--city.is-on { background: var(--cy-color-mode-city-soft); }
.mode-opt--roam.is-on { background: var(--cy-color-mode-roam-soft); }

.mode-opt--city.is-on .mode-opt__ico,
.mode-opt--city.is-on .mode-opt__name { color: var(--cy-color-mode-city); }
.mode-opt--roam.is-on .mode-opt__ico,
.mode-opt--roam.is-on .mode-opt__name { color: var(--cy-color-mode-roam); }

.mode-opt--city.is-on .mode-opt__ico { background: var(--cy-color-mode-city-soft); }
.mode-opt--roam.is-on .mode-opt__ico { background: var(--cy-color-mode-roam-soft); }

.mode-opt--city.is-on .mode-opt__mark { background: var(--cy-color-mode-city); }
.mode-opt--roam.is-on .mode-opt__mark { background: var(--cy-color-mode-roam); }

.mode-opt__desc {
  display: block;
  margin-top: var(--cy-space-1);
  font-size: var(--cy-font-caption);
  color: var(--cy-color-text-tertiary);
  line-height: 1.6;
}

.mode-opt__mark {
  flex: none;
  align-self: flex-start;
  padding: var(--cy-legacy-6) var(--cy-space-2);
  border-radius: var(--cy-radius-pill);
  background: var(--cy-color-action-primary-bg);
  color: var(--cy-color-action-primary-fg);
  font-size: var(--cy-font-label);
}

/* 玩法选择的两段小标题(公共玩法库 / 我的模板)。分段是为了让人一眼分清
   「这是平台的」还是「这是我自己建的」—— 混在一个列表里,选错了也看不出来。
   ⚠️ 这一段 2026-08-11 00:36 被并行会话的写入吞掉过一次(wxml 还引用着、wxss 里没了,
   于是两段标题挤成一坨)。补回时一并加大上边距:横滑轨道自己不留下边距,
   两段之间只靠这里撑开,24rpx 时「我的模板」会贴着上一张卡的「2–6人 | 15分钟」。 */
.temp-seg {
  display: flex;
  align-items: baseline;
  gap: var(--cy-space-2);
  padding: var(--cy-space-5) 0 var(--cy-space-2);
}

.temp-seg:first-child { padding-top: var(--cy-space-2); }

.temp-seg__tit {
  font-size: var(--cy-font-body);
  font-weight: 700;
  color: var(--cy-color-text-primary);
}

.temp-seg__sub {
  font-size: var(--cy-font-caption);
  color: var(--cy-color-text-tertiary);
}

/* 票种编辑器就地展开(2026-08-11):不再是 position:fixed 的整屏覆盖。
   这一页常常本身就是从主题编辑器里进来的,再盖一层就成了「弹窗的弹窗」,
   返回钮也跟着叠两个 —— 现在它只是票种列表里长出来的一段。 */
/* 2026-09-08 用户走查:「外面一个灰色,里面选框还是灰色很奇怪 —— 整体白色,
   里面选框灰色就好」。外壳改白;内层 .node-card 不再另铺白(白压白看不出层),
   真正的灰只留给输入框本身。 */
.tk-editor {
  margin-bottom: var(--cy-space-3);
  padding: var(--cy-space-3) 0 var(--cy-space-1);
  border-radius: var(--cy-radius-xl);
  background: var(--cy-color-bg-surface);
}

.tk-editor .node-card { background: transparent; }

.tk-editor .node-card { margin: 0 var(--cy-space-2-5) var(--cy-space-2-5); }

.tk-editor__hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 var(--cy-space-4) var(--cy-space-3);
}

.tk-editor__label {
  font-size: var(--cy-font-body);
  font-weight: 700;
  color: var(--cy-color-text-primary);
}

.tk-editor .pd-ticket-editor-footer { padding: 0 var(--cy-space-2-5) var(--cy-space-3); }
/* 商家承接段(2026-09-05 用户裁决装回章节弹窗):与「章节配色」「章节音频」同一组头部规格。 */
.chapter-recruit{ margin-top:var(--cy-space-4); }
.chapter-recruit__head{ margin-bottom:var(--cy-legacy-18); font-size:var(--cy-type-body); color:var(--cy-comp-sheet-role-text-secondary); }
.chapter-recruit__head text:last-child{ display:block; margin-top:4rpx; font-size:var(--cy-type-caption); color:var(--cy-comp-sheet-role-muted); }
.chapter-recruit__num{ flex:none; width:150rpx; text-align:right; font-size:var(--cy-type-body); color:var(--cy-comp-sheet-role-text); }
.chapter-recruit__ph{ color:var(--cy-comp-sheet-role-muted); }

/* 章节音频(2026-09-04):一章一段的背景旁白,与「章节配色」同一组视觉规格 */
.chapter-audio{ margin-top:var(--cy-space-4); }
.chapter-audio__head{ display:flex; align-items:center; justify-content:space-between; margin-bottom:var(--cy-legacy-18); font-size:var(--cy-type-body); color:var(--cy-comp-sheet-role-text-secondary); }
.chapter-audio__head text:last-child{ font-size:var(--cy-type-caption); color:var(--cy-comp-sheet-role-muted); }
.chapter-audio__empty{ display:flex; align-items:center; justify-content:center; gap:var(--cy-space-2); height:104rpx; border-radius:var(--cy-radius-md); border:2rpx dashed var(--cy-comp-sheet-role-divider); font-size:var(--cy-type-body); color:var(--cy-comp-sheet-role-text-secondary); }
.chapter-audio__file{ display:flex; align-items:center; gap:var(--cy-space-3); height:104rpx; padding:0 var(--cy-space-3); box-sizing:border-box; border-radius:var(--cy-radius-md); background:var(--cy-comp-sheet-role-card); }
.chapter-audio__play{ flex:none; padding:0 var(--cy-space-3); height:60rpx; display:flex; align-items:center; border-radius:var(--cy-radius-pill); background:var(--cy-comp-sheet-role-elevated); font-size:var(--cy-type-caption); color:var(--cy-comp-sheet-role-text); }
.chapter-audio__meta{ flex:1; min-width:0; display:flex; flex-direction:column; gap:4rpx; }
.chapter-audio__name{ font-size:var(--cy-type-body); color:var(--cy-comp-sheet-role-text); overflow:hidden; white-space:nowrap; text-overflow:ellipsis; }
.chapter-audio__dur{ font-size:var(--cy-type-micro); color:var(--cy-comp-sheet-role-muted); }
.chapter-audio__del{ flex:none; font-size:var(--cy-type-caption); color:var(--cy-comp-sheet-role-muted); }

.chapter-atmosphere{ margin-top:var(--cy-space-4); }
.pop-chapter-settings .pop-top .tit{ color:var(--cy-comp-sheet-role-text); }
.pop-chapter-settings .chapter-story-entry-hint{ color:var(--cy-comp-sheet-role-muted); }
.chapter-atmosphere__head{ display:flex; align-items:center; justify-content:space-between; margin-bottom:var(--cy-legacy-18); font-size:var(--cy-type-body); color:var(--cy-comp-sheet-role-text-secondary); }
.chapter-atmosphere__head text:last-child{ font-size:var(--cy-type-caption); color:var(--cy-comp-sheet-role-muted); }
.chapter-atmosphere__list{ width:100%; white-space:nowrap; }
.chapter-atmosphere__track{ display:inline-flex; gap:var(--cy-space-2); padding:var(--cy-legacy-4) var(--cy-legacy-4) var(--cy-space-2); }
.chapter-atmosphere__item{ width:154rpx; min-height:112rpx; box-sizing:border-box; display:flex; flex-direction:column; justify-content:flex-end; padding:var(--cy-legacy-18); border:3rpx solid transparent; border-radius:var(--cy-radius-md); color:#fff; box-shadow:inset 0 0 0 1rpx rgba(255,255,255,.16); } /* ds-ok 固定氛围卡上用常量白 */
.chapter-atmosphere__item.is-on{ border-color:var(--cy-comp-sheet-role-text); box-shadow:0 0 0 3rpx var(--cy-comp-sheet-role-page); }
.chapter-atmosphere__name{ font-size:var(--cy-type-body); font-weight:700; }
.chapter-atmosphere__item.atmosphere-swatch--white{ box-shadow:inset 0 0 0 1rpx rgba(0,0,0,.12); } /* ds-ok 白卡在浅底上要有边界才看得见 */
.chapter-atmosphere__note{ margin-top:4rpx; font-size:var(--cy-type-micro); opacity:.78; }
/* 2026-09-06 用户拍板:黑 / 蓝 / 红 / 黄 / 白,**纯色,没有渐变**(原来五档都是 145° 线性渐变)。 */
.atmosphere-swatch--default{ background:#0A0A0A; } /* ds-ok 固定章节配色色板 */
.atmosphere-swatch--blue{ background:#14294F; } /* ds-ok 固定章节配色色板 */
.atmosphere-swatch--red{ background:#4E1C24; } /* ds-ok 固定章节配色色板 */
.atmosphere-swatch--yellow{ background:#4E4114; } /* ds-ok 固定章节配色色板 */
/* 白档是唯一的浅色:卡内文字要翻黑,否则白底白字 */
.atmosphere-swatch--white{ background:#F5F6F8; color:#111318; } /* ds-ok 固定章节配色色板 */

.tk-segment {
  display: flex;
  gap: var(--cy-space-2);
  margin-top: var(--cy-space-2);
}

.tk-segment__item {
  flex: 1;
  padding: var(--cy-space-2);
  border: 1rpx solid var(--cy-color-border-subtle);
  border-radius: var(--cy-radius-sm);
  color: var(--cy-color-text-secondary);
  text-align: center;
}

.tk-segment__item.is-active {
  border-color: var(--cy-color-action-primary-bg);
  color: var(--cy-color-action-primary-bg);
}

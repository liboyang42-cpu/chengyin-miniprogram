@charset "UTF-8";
@import "../styles/photo-grid.wxss";
page{background: var(--cy-bg-card);}
.fabu .fabu1 {
  background: var(--cy-bg-subtle);
  padding: var(--cy-legacy-36) 0 var(--cy-space-7);
}

.fabu .fabu1 .icon image {
  width: var(--cy-space-7);
  height: var(--cy-space-7);
}

.fabu .fabu1 .desc {
  text-align: center;
  padding: 0 38rpx; /* ds-ok: 未被 wxml 引用的历史遗留样式,不渲染,不追求量表精度 */
  font-size: var(--cy-font-caption);
  color: var(--cy-text-body);
}

.fabu .tab2 {
  border-top: 2rpx solid var(--cy-border-card);
  background: var(--cy-bg-card);
}

.fabu .tab2.steps {
  padding: 24rpx 38rpx; /* ds-ok: 未被 wxml 引用的历史遗留样式,不渲染,不追求量表精度 */
}

.fabu .tab2 .step {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.fabu .tab2 .step .step-num {
  width: var(--cy-space-5);
  height: var(--cy-space-5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--cy-font-caption);
  border: 2rpx solid var(--cy-border-card);
  color: var(--cy-text-body);
  background: var(--cy-bg-card);
}

.fabu .tab2 .step .step-label {
  margin-top: var(--cy-space-1);
  font-size: var(--cy-font-caption);
  color: var(--cy-text-body);
}

.fabu .tab2 .step.current .step-num {
  background: var(--cy-accent);
  border-color: var(--cy-accent);
  color: var(--cy-text-inverse);
}

.fabu .tab2 .step.current .step-label {
  color: var(--cy-text-title);
  font-weight: bold;
}

.fabu .tab2 .step.done .step-num {
  border-color: var(--cy-accent);
  color: var(--cy-accent);
}

.fabu .tab2 .step.done .step-label {
  color: var(--cy-text-title);
}

.fabu .tab2 .step.locked .step-num {
  opacity: 0.5;
}

.fabu .tab2 .step.locked .step-label {
  opacity: 0.5;
}

.fabu .tab2 .step-line {
  flex: 1;
  height: 2rpx;
  margin: 0 16rpx;
  margin-bottom: var(--cy-space-4);
  background: var(--cy-border-card);
}

.fabu .tab2 .step-line.done {
  background: var(--cy-accent);
}

.fabu .tabcont1 {
  padding-bottom: 330rpx; /* ds-ok: 未被 wxml 引用的历史遗留样式,不渲染,不追求量表精度 */
}

.fabu .tabcont1 .li .item .item-top {
  padding: var(--cy-space-3-5) 0; /* ds-ok: 未被 wxml 引用的历史遗留样式,不渲染,不追求量表精度 */
  box-sizing: border-box;
  border-bottom: 2rpx solid var(--cy-border-line);
}

.fabu .tabcont1 .li .item .item-top .tit {
  font-size: var(--cy-font-display);
  font-weight: bold;
}

.fabu .tabcont1 .li .item .item-top .tit .collapse-arrow {
  font-size: var(--cy-font-body);
  color: var(--cy-text-secondary);
  margin-right: var(--cy-space-1-5);
  transition: transform 0.2s ease;
}

.fabu .tabcont1 .li .item .item-top .tit .collapse-arrow.collapsed {
  transform: rotate(-90deg);
}

.fabu .tabcont1 .li .item .item-top .attr {
  margin-top: var(--cy-space-2);
}

.fabu .tabcont1 .li .item .item-top .attr .dd {
  font-size: var(--cy-font-caption);
  color: var(--cy-text-body);
}

.fabu .tabcont1 .li .item .item-top .attr .dd image {
  width: var(--cy-legacy-26);
  height: var(--cy-legacy-26);
  margin-right: var(--cy-legacy-6);
}

.fabu .tabcont1 .li .item .item-top .attr .dd:nth-child(2) {
  margin: 0 var(--cy-space-2); /* ds-ok: 未被 wxml 引用的历史遗留样式,不渲染,不追求量表精度 */
}

.fabu .tabcont1 .li .item .item-top .col2 {
  width: 66rpx;
  height: 66rpx;
  background: var(--cy-btn-solid-bg);
  box-shadow: 0rpx 8rpx 24rpx 0rpx rgba(13, 10, 44, 0.06);
  border-radius: 44rpx;
}

.fabu .tabcont1 .li .item .item-top .col2 image {
  width: 34rpx;
  height: 34rpx;
}

/* 移除时间轴竖线(原 common.wxss 绘制的 ::before / ::after) */
.fabu .tabcont1 .li .item .item-cont .list::before,
.fabu .tabcont1 .li .item .item-cont .list::after {
  display: none;
}

.fabu .tabcont1 .li .item .item-cont .list .li {
  margin-bottom: var(--cy-space-2-5);
}

.fabu .tabcont1 .li .item .item-cont .list .li:last-child {
  margin-bottom: 0;
}

/* 地址弹窗 */
.pop-address .search1 {
  height: 88rpx;
  background: var(--cy-bg-card);
  border-radius: var(--cy-radius-pill);
  margin: 0 0 var(--cy-space-3-5) 0; /* ds-ok: 未被 wxml 引用的历史遗留样式,不渲染,不追求量表精度 */
}

.pop-address .add-list .li {
  padding: var(--cy-legacy-22) 40rpx 27rpx 0; /* ds-ok: 未被 wxml 引用的历史遗留样式,不渲染,不追求量表精度 */
  position: relative;
}

.pop-address .add-list .li .icon {
  flex-shrink: 0;
  margin-right: var(--cy-space-4);
}

.pop-address .add-list .li .icon image {
  width: var(--cy-legacy-36);
  height: 43rpx;
}

.pop-address .add-list .li .info .tit {
  color: var(--cy-text-title);
  font-size: var(--cy-font-body);
}

.pop-address .add-list .li .info .desc {
  color: var(--cy-text-secondary);
  font-size: var(--cy-font-label);
  margin-top: 5rpx; /* ds-ok: 未被 wxml 引用的历史遗留样式,不渲染,不追求量表精度 */
}

.pop-address .add-list .li .jt {
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
}

.pop-address .add-list .li .jt image {
  width: 27rpx;
  height: var(--cy-space-2);
}

.pop-address .pop-cont {
  max-height: 73vh;
}

/* 节点编辑 */
.pop-chapter {
  color: var(--cy-text-title);
}

.pop-chapter .pop-cont-games {
  padding-top: var(--cy-space-1);
}

.topic-list .list .li .item .item-box1 .item-add {
  border-top:0; padding-right: 0;
}

.topic-list .list .li .item .item-box1 .item-add .dz{ color: var(--cy-text-title); width: 290rpx;}


/* 2026-09-08:.david_tk* 五条随三个文本编辑弹窗一起撤(那三个弹窗全仓没有入口,是死 UI)。 */

/* 2026-09-05 按 Figma:章节名改「标签 + 填充输入框」。 */
.chapter-name-field {
  margin-top: var(--cy-space-2-5);
}

.chapter-name-field__label {
  display: block;
  margin-bottom: var(--cy-space-1-5);
  color: var(--cy-color-text-secondary);
  font-size: var(--cy-font-label);
}

.chapter-name-field__input {
  box-sizing: border-box;
  width: 100%;
  min-height: 104rpx;
  padding: 0 var(--cy-space-3);
  border-radius: var(--cy-radius-md);
  background: var(--cy-color-bg-surface-subtle);
  color: var(--cy-color-text-primary);
  font-size: var(--cy-font-subtitle);
  font-weight: 700;
}

.chapter-name-field__ph {
  color: var(--cy-color-text-placeholder);
  font-weight: 700;
}

/* 删除章节:从一行红字提成整宽按钮。稿子把它放在弹窗底部当一颗动作,
   一行裸红字既不像按钮、触达也只有文字那么宽。 */
.chapter-settings-delete {
  min-height: var(--cy-btn-h);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: var(--cy-space-4);
  border-radius: var(--cy-radius-md);
  background: var(--cy-color-status-danger-soft);
  color: var(--cy-color-status-danger);
  font-size: var(--cy-type-body);
  font-weight: 600;
}

.chapter-settings-body {
  box-sizing: border-box;
  overflow-y: auto;
  height: auto;
  max-height: 68vh;
  padding-bottom: calc(var(--cy-space-4) + env(safe-area-inset-bottom));
}
.pop-chapter-settings { max-height: 82vh; color: var(--cy-color-text-primary); }
.pop-chapter-settings::before { background: var(--cy-color-bg-surface); border-top-color: var(--cy-color-border-subtle); backdrop-filter: none; }
.pop-chapter-settings .pop-top { padding: var(--cy-space-3) 0; color: var(--cy-color-text-primary); }
.pop-chapter-settings .pop-top button { color: var(--cy-color-text-primary); }
/* CU-C-156:左上的「取消」换成右上角一颗 ✕(热区整档 88rpx,字形-only)。
   这颗是 view 不是 button,上面那条 button 色管不到它,单独给一次。 */
.cs-close {
  width: 88rpx;
  height: var(--cy-btn-h);
  margin-right: calc(var(--cy-space-1) * -1);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--cy-color-text-secondary);
}

/* 2026-09-08 用户逐屏走查:发布确认也要白底。它和章节设置共用 style/common.wxss 的
   .pop-model —— 那条是全站遗留的深色玻璃(rgba(10,9,13,.85) + color:#fff),
   改它会波及所有还在用 .pop-model 的页面,所以照章节设置的先例在本页就地覆盖。 */
.pop-publish-check { color: var(--cy-color-text-primary); }
.pop-publish-check::before {
  background: var(--cy-color-bg-surface);
  border-top-color: var(--cy-color-border-subtle);
  backdrop-filter: none;
}
.pop-publish-check .pop-top,
.pop-publish-check .pop-top button { color: var(--cy-color-text-primary); }

.chapter-merchant-config {
  margin-top: var(--cy-space-3-5);
  --cy-comp-card-pad: var(--cy-space-3);
  --cy-comp-card-radius: var(--cy-radius-md);
}

.chapter-merchant-config--muted {
  color: var(--cy-color-text-secondary);
  font-size: var(--cy-type-caption);
  line-height: 1.6;
}

.chapter-merchant-config__heading {
  margin-bottom: var(--cy-space-3);
}

.chapter-merchant-config__title,
.chapter-merchant-config__label {
  display: block;
  color: var(--cy-color-text-primary);
  font-size: var(--cy-type-label);
  font-weight: 700;
}

.chapter-merchant-config__hint,
.chapter-merchant-config__helper {
  display: block;
  margin-top: var(--cy-space-1);
  color: var(--cy-color-text-tertiary);
  font-size: var(--cy-type-caption);
  line-height: 1.5;
}

.chapter-merchant-config__field {
  margin-top: var(--cy-space-3);
}

.chapter-merchant-config__input {
  width: 100%;
  height: 76rpx;
  margin-top: var(--cy-legacy-14);
  padding: 0 var(--cy-legacy-18);
  box-sizing: border-box;
  border: 2rpx solid var(--cy-color-border-subtle);
  border-radius: var(--cy-radius-sm);
  background: var(--cy-color-bg-surface);
  color: var(--cy-color-text-primary);
  font-size: var(--cy-type-body);
}

.chapter-merchant-config__required {
  display: flex;
  min-height: 76rpx;
  align-items: center;
  justify-content: space-between;
  gap: var(--cy-space-2-5);
  padding: 0 var(--cy-legacy-18);
  border: 2rpx solid var(--cy-color-border-subtle);
  border-radius: var(--cy-radius-sm);
  background: var(--cy-color-bg-surface);
}

.chapter-terms-options {
  display: flex;
  gap: var(--cy-legacy-14);
  margin-top: var(--cy-legacy-14);
}

.chapter-terms-option {
  flex: 1;
  min-height: 94rpx;
  padding: var(--cy-space-2);
  box-sizing: border-box;
  border: 2rpx solid var(--cy-color-border-subtle);
  border-radius: var(--cy-radius-sm);
  background: var(--cy-color-bg-surface);
}

.chapter-terms-option.is-active {
  border-color: var(--cy-color-selection);
  background: var(--cy-color-brand-soft);
}

.chapter-terms-option text:first-child {
  display: block;
  color: var(--cy-color-text-primary);
  font-size: var(--cy-type-label);
  font-weight: 700;
}

.chapter-terms-option text:last-child {
  display: block;
  margin-top: var(--cy-legacy-6);
  color: var(--cy-color-text-tertiary);
  font-size: var(--cy-type-caption);
}




/* 多选弹框样式 */
/* 2026-09-02:原 999/1000 越过 token 档(还压过 celebrate 990)。这是居中弹窗 = modal 档。 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: var(--cy-z-modal);
}

/* 2026-09-05 按品牌手册 T3(全屏弹窗)重做:面板底从纯白改成 bg-surface-subtle,
   行从「白底 + 分隔线」改成一张张白卡 —— 白底上再画白行,分隔线是唯一的边界,
   行与面板读起来是一层;卡与浅灰面板之间才有真正的层次。 */
.multi-select-modal {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--cy-color-bg-surface-subtle);
  border-radius: var(--cy-comp-sheet-radius) var(--cy-comp-sheet-radius) 0 0;
  z-index: calc(var(--cy-z-modal) + 1);
  max-height: 70vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding-bottom: env(safe-area-inset-bottom);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--cy-space-4);
}

.modal-title {
  font-size: var(--cy-font-subtitle);
  font-weight: bold;
}

.modal-close {
  width: var(--cy-btn-h);
  height: var(--cy-btn-h);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--cy-font-display);
  color: var(--cy-text-secondary);
}

.modal-content {
  flex: 1;
  overflow-y: auto;
  max-height: 50vh;
}

.category-list {
  padding: 0 var(--cy-page-x);
}

.category-item {
  min-height: 107rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  padding: 0 var(--cy-space-3);
  margin-bottom: var(--cy-space-2);
  border-radius: var(--cy-radius-md);
  background: var(--cy-color-bg-surface);
}

.category-checkbox {
  width: 40rpx;
  height: 40rpx;
  box-sizing: border-box;
  border-radius: var(--cy-radius-sm);
  border: 3rpx solid var(--cy-color-border-subtle);
  background: var(--cy-color-bg-surface);
  margin-right: var(--cy-space-2-5);
  display: flex;
  align-items: center;
  justify-content: center;
}

.category-checkbox.is-on {
  border-color: var(--cy-color-text-primary);
  background: var(--cy-color-text-primary);
  color: var(--cy-color-bg-surface);
}


.category-name {
  font-size: var(--cy-font-body);
  color: var(--cy-text-title);
}

.modal-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--cy-space-4);
}

.selected-count {
  font-size: var(--cy-font-body);
  color: var(--cy-text-body);
}

/* 选中状态样式 */
.li.selected .item {
  position: relative;
  background: var(--cy-color-action-primary-bg);
  color: var(--cy-color-action-primary-fg);
  border-radius: 0px;
}


.selected-mark image {
  width: 100%;
  height: 100%;
}

/* 地址列表样式 */
.add-list .li {
  padding: var(--cy-space-2-5);
  border-bottom: 1rpx solid var(--cy-border-line);
  /* .selected 只改 background-color 与左侧色条 */
  transition: background-color 0.3s, border-left-width 0.3s, border-left-color 0.3s; /* ds-ok: 沿用改写前 `transition: all 0.3s` 的实测时长,只把属性显式化 */
}

.add-list .li.selected {
  background-color: var(--cy-bg-page);
  border-left: 4rpx solid var(--cy-accent);
}

.add-list .li .icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: var(--cy-space-2-5);
}

.add-list .li .icon image {
  width: 100%;
  height: 100%;
}

.add-list .li .info {
  flex: 1;
  flex-direction: column;
  align-items: flex-start;
}

.add-list .li .tit {
  font-size: var(--cy-font-body);
  font-weight: bold;
  color: var(--cy-text-title);
  margin-bottom: var(--cy-space-1);
}

.add-list .li .desc {
  font-size: var(--cy-font-label);
  color: var(--cy-text-body);
}

.add-list .li .jt {
  width: var(--cy-space-3);
  height: var(--cy-space-3);
  margin-left: var(--cy-space-2-5);
}

.add-list .li .jt image {
  width: 100%;
  height: 100%;
}


.no-data image {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: var(--cy-space-2-5);
}

.no-data .txt {
  font-size: var(--cy-font-body);
  color: var(--cy-text-secondary);
}

.topic-list .list{ overflow: hidden;}
/* 节点行:去掉时间轴预留的左缩进 */
.fabu .tabcont1 .topic-list .list .li{ padding-left: 0; }
/* 定高自包含卡片(为 movable-view 铺路) */
.fabu .tabcont1 .topic-list .list .li:not(.add) .item{
  position: relative;
  margin-left: 0;
  height: 200rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  padding: var(--cy-space-2-5) 96rpx var(--cy-space-2-5) var(--cy-space-2-5);
  background: var(--cy-bg-card);
  border: 2rpx solid var(--cy-border-line);
  border-radius: var(--cy-radius-sm);
  box-shadow: 0rpx 8rpx 24rpx 0rpx rgba(13, 10, 44, 0.06);
  transition: background .15s, border-color .15s;
}
.fabu .tabcont1 .topic-list .list .li .item .item-box1{
  flex: 1;
  min-width: 0;
  align-items: center;
  border: 0;
  padding: 0;
  min-height: 0;
}
/* 序号 chip:卡片内左上角,正常流(取消 common 的绝对定位与外圈) */
.fabu .tabcont1 .topic-list .list .li .xh{
  position: static;
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  font-size: var(--cy-font-caption);
  font-weight: 500;
  flex-shrink: 0;
  margin-right: var(--cy-space-2);
  background: var(--cy-bg-subtle);
  color: var(--cy-text-title);
  border: 2rpx solid var(--cy-border-line);
  border-radius: 50%;
  transition: background .15s, color .15s, transform .15s;
}
.fabu .tabcont1 .topic-list .list .li .xh::before{ display: none; }
/* 拖拽手柄:48rpx 触摸区,按住进入 movable-view 拖拽态 */
.fabu .tabcont1 .topic-list .list .li .item .drag-handle{
  position: absolute;
  right: 52rpx;
  top: 50%;
  transform: translateY(-50%);
  width: var(--cy-space-5);
  height: var(--cy-space-5);
  line-height: 48rpx; /* ds-ok: 行高不是间距,不复用 space token */
  text-align: center;
  font-size: var(--cy-font-body);
  color: var(--cy-text-secondary);
}
/* movable-view 拖拽重排:movable-area 高度=nodes*rowHpx(随内容增长),各行用 y 绝对定位 */
.fabu .tabcont1 .topic-list .list .node-marea{
  position: relative;
  width: 100%;
}
.fabu .tabcont1 .topic-list .list .node-mview{
  width: 100%;
  box-sizing: border-box;
}
/* 拖拽中的行抬起:加重阴影提示(token,不新硬编码色) */
.fabu .tabcont1 .topic-list .list .node-mview.dragging{ z-index: 5; }
.fabu .tabcont1 .topic-list .list .node-mview.dragging .item{
  box-shadow: 0rpx 16rpx 40rpx 0rpx rgba(13, 10, 44, 0.16);
  border-color: var(--cy-accent);
}
/* 选中节点行高亮(地图 marker 同步放大变蓝) */
.fabu .tabcont1 .topic-list .list .li.selected .xh{ background: var(--cy-accent); color: var(--cy-text-inverse); border-color: var(--cy-accent); transform: scale(1.08); }
.fabu .tabcont1 .topic-list .list .li.selected .item{ background: var(--cy-bg-subtle); border-color: var(--cy-accent); }


/* 居中准星(加点/移点态) */
.map-crosshair {
  position: absolute; left: 50%; top: 50%;
  transform: translate(-50%, -50%);
  width: var(--cy-legacy-36); height: var(--cy-legacy-36);
  border: 4rpx solid var(--cy-accent); border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
}

/* ===== 2026-08-10 平铺形态(去三步向导)新增 ===== */

/* 主题名:第一屏第一个元素,占位符本身就是输入框(参考 Trip Way 的 Activity Name) */
/* 2026-09-05 按 Figma:标题左沿 38rpx,比卡片(32rpx)外凸 6rpx —— 这是稿子的光学内缩,
   不是错位。文字没有卡片的圆角与投影,左沿对齐时视觉上反而会显得往里缩。 */
/* 底边距 8rpx → 27rpx → 48rpx(用户 2026-09-05 连提两次「间距大一点」「还不够」)。
   48rpx = 25px = --cy-space-5。L1 标题与它下面第一张卡的距离,本来就该比
   「区块标题 ↔ 卡」(27rpx)再大一档 —— 那是两个层级,不是同一档节奏。 */
.pd-title-field {
  padding: var(--cy-space-2) 38rpx var(--cy-space-5); /* ds-ok 38rpx=20px 主标题左沿,比卡片(--cy-page-x=16px)有意外凸 4px,见 F1 补充二 */
}

.pd-title-input {
  width: 100%;
  /* 用 page-title 而不是已标废弃的 --cy-font-display:这就是本页的 L1 标题 */
  font-size: var(--cy-font-page-title);
  font-weight: 800;
  /* 1.2 行高在 58rpx 的中文字上会把上下各削一刀(「患」的横、竖钩都超出 em box);
     <input> 又不会像 <text> 那样被内容撑开,削掉就是削掉了。 */
  line-height: 1.35;
  min-height: 84rpx;
  color: var(--cy-color-text-primary);
}

.pd-title-input__ph {
  color: var(--cy-color-text-placeholder);
  font-weight: 800;
}

/* 发布动作常驻右上;返回钮在左,两者共用 chrome.actionTop 做胶囊避让 */
.pd-topbar-action {
  position: fixed;
  z-index: 20;
}

/* 章节剧情正文:在节点列表之上,auto-height 让它随内容长,写长故事不用挤在小框里 */


/* 空态卡:只说明「还没有章节」。主动作是下方那条虚线 .slopes-add-chapter,
   不在卡里再放一颗 —— 两颗并排出现过一次(2026-08-10 实拍)。 */
.slopes-empty-sub {
  display: block;
  margin: var(--cy-legacy-6) 0 var(--cy-space-2);
  color: var(--cy-color-text-tertiary);
  font-size: var(--cy-font-caption);
}

/* 被选中的节点(点序号定位后)在列表里也要有回应,否则只有地图那边亮、列表这边没反馈 */
.slopes-node-rail--handle.is-selected .slopes-node-num {
  color: var(--cy-color-action-primary-bg);
}

/* ===== 2026-08-10 两页结构 ===== */

/* 主题详情入口卡:一个入口 → 一个弹窗 */
/* 内边距走组件钩子,不在宿主上另写 padding —— 宿主 padding 会和 .cy-card 自己的
   --cy-comp-card-pad 叠加成双层内边距。 */
/* 卡间距 24rpx → 32rpx(用户 2026-09-05:「主题详情下面卡片上下间距也松一点」)。
   下面的 .pd-modecards 用同一个值,两处必须一起改,不然卡列的节奏会一段紧一段松。 */
.pd-entry-card {
  --cy-comp-card-pad: var(--cy-space-3) var(--cy-space-3-5);
  margin: 0 var(--cy-page-x) var(--cy-space-4);
}

/* 横排在 slot 内容自己这一层做(宿主是 isolated 组件,flex 挂宿主对 slot 无效) */
.pd-entry-card__row {
  display: flex;
  align-items: center;
}

.pd-entry-card__main {
  flex: 1;
  min-width: 0;
}

.pd-entry-card__title {
  display: block;
  font-size: var(--cy-font-body);
  font-weight: 700;
  color: var(--cy-color-text-primary);
}

.pd-entry-card__sub {
  display: block;
  margin-top: var(--cy-legacy-6);
  font-size: var(--cy-font-caption);
  color: var(--cy-color-text-tertiary);
}

/* ===== 创作引导卡(四步清单,非向导)=====
   卡壳与 .pd-entry-card 同规格;每步 = 序号圈 + 标题/说明 + 「去做」。
   完成态只换序号圈样式与隐藏「去做」,不加进度条(那是被删掉的隐喻)。 */
.pd-guide-card {
  --cy-comp-card-pad: var(--cy-space-3) var(--cy-space-3-5);
  margin: 0 var(--cy-page-x) var(--cy-space-3);
}

.pd-guide-card__hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--cy-space-1);
}

.pd-guide-card__title {
  font-size: var(--cy-font-body);
  font-weight: 700;
  color: var(--cy-color-text-primary);
}

.pd-guide-card__dismiss {
  min-height: var(--cy-btn-h);
  display: flex;
  align-items: center;
  font-size: var(--cy-font-caption);
  color: var(--cy-color-text-tertiary);
  padding-left: var(--cy-space-3);
}

.pd-guide-step {
  min-height: var(--cy-btn-h);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: var(--cy-space-2);
  padding: var(--cy-space-2) 0;
}

.pd-guide-step__num {
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  border-radius: var(--cy-radius-pill);
  background: var(--cy-color-bg-surface-subtle);
  color: var(--cy-color-text-secondary);
  font-size: var(--cy-font-label);
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pd-guide-step__num.is-done {
  background: var(--cy-color-status-success-soft);
  color: var(--cy-color-status-success);
}

.pd-guide-step__main {
  flex: 1;
  min-width: 0;
}

.pd-guide-step__tit {
  display: block;
  font-size: var(--cy-font-body);
  color: var(--cy-color-text-primary);
}

.pd-guide-step__sub {
  display: block;
  margin-top: var(--cy-legacy-6);
  font-size: var(--cy-font-caption);
  color: var(--cy-color-text-tertiary);
}

.pd-guide-step__go {
  display: flex;
  align-items: center;
  gap: var(--cy-space-1);
  flex-shrink: 0;
  font-size: var(--cy-font-caption);
  color: var(--cy-color-text-secondary);
}

/* 弹窗内的主题详情:去掉卡片外边距,让它贴合 sheet 自己的内边距 */
.pd-topic-detail .pd-list {
  margin-left: 0;
  margin-right: 0;
}
.pd-completion-rule { display: flex; align-items: center; gap: var(--cy-space-2); padding: var(--cy-space-3) var(--cy-space-4); color: var(--cy-color-text-primary); font-size: var(--cy-font-body); }
.pd-completion-rule__input { width: 120rpx; height: 72rpx; text-align: center; border: 2rpx solid var(--cy-color-border-strong); border-radius: var(--cy-radius-md); background: var(--cy-color-bg-surface-subtle); }
.pd-completion-rule__input.is-error { border-color: var(--cy-color-status-danger); background: var(--cy-color-status-danger-soft); }
/* 宾果九宫格:九行「名称 + 文案 + 券」。用行不用 3×3 网格 —— 手机上格子里放不下这三样。 */
.pd-bingo-row { margin-top: var(--cy-space-3); padding-top: var(--cy-space-3); border-top: 2rpx solid var(--cy-color-border-subtle); }
.pd-bingo-row:first-child { border-top: 0; padding-top: 0; }
.pd-bingo-row__head { display: flex; align-items: baseline; gap: var(--cy-space-2); }
.pd-bingo-row__no { flex: none; font-size: var(--cy-font-caption); font-weight: 600; color: var(--cy-color-text-primary); }
.pd-bingo-row__cond { flex: 1; min-width: 0; font-size: var(--cy-font-caption); color: var(--cy-color-text-secondary); }
.pd-bingo-row__input { width: 100%; height: 72rpx; margin-top: var(--cy-space-2); padding: 0 var(--cy-space-2); border: 2rpx solid var(--cy-color-border-strong); border-radius: var(--cy-radius-md); background: var(--cy-color-bg-surface-subtle); font-size: var(--cy-font-body); }
.pd-bingo-hint { margin-top: var(--cy-space-2); font-size: var(--cy-font-caption); color: var(--cy-color-text-secondary); line-height: 1.6; }
.pd-completion-rule__error { display: block; margin: 0 var(--cy-space-4) var(--cy-space-3); }

/* 章节卡上的状态标记(取代全局「推荐下一步」) */
.slopes-chapter-tags {
  display: flex;
  flex-wrap: wrap;
  gap: var(--cy-space-2);
  padding: var(--cy-space-3) var(--cy-space-4);
}

/* 2026-09-07 按稿 P2 补状态图标(✓ / ⚠):颜色之外再给一个非色觉的信号,
   色盲与深色环境下也读得出「这条是好了还是缺着」。图标随 currentColor,跟着下面三档走。 */
.slopes-tag {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: var(--cy-legacy-6) var(--cy-space-1);
  border-radius: var(--cy-radius-sm);
  background: var(--cy-color-bg-surface-subtle);
  color: var(--cy-color-text-tertiary);
  font-size: var(--cy-font-label);
}

/* 状态不能只靠颜色 —— 文案本身已经写明「缺剧情/待选地点」,配色只做强化。
   稿子(4028:13649)把两档分开:待选地点=琥珀(可以带着继续做),缺剧情=红(拦发布)。 */
.slopes-tag.is-warn {
  background: var(--cy-color-status-warning-soft);
  color: var(--cy-color-status-warning);
}

.slopes-tag.is-danger {
  background: var(--cy-color-status-danger-soft);
  color: var(--cy-color-status-danger);
}

.slopes-tag.is-ok {
  color: var(--cy-color-text-secondary);
}

/* 标签行与「编辑故事流」之间的通栏分隔线(稿子 4028:13743)。卡片 pad 为 0,
   所以这条线本来就是通栏的,不用负 margin 去撑。 */
.slopes-chapter-divider {
  height: 2rpx;
  background: var(--cy-color-border-subtle);
}

/* 两颗并排(稿 P2/C2):左「编辑故事流」右「编辑章节」。 */
.slopes-chapter-cta {
  display: flex;
  gap: var(--cy-space-2);
  padding: var(--cy-space-3) var(--cy-space-4) var(--cy-space-4);
}

/* 章节卡底部双动作:左编辑章节、右创建节点 */
.slopes-chapter-actions {
  display: flex;
  gap: var(--cy-space-2);
  padding: var(--cy-space-2) var(--cy-space-2-5) var(--cy-space-2-5);
}

/* 添加章节:列表最下方,不在右上角。
   稿子(4028:13849)是白底 + 虚线描边的大卡,不是一条透明虚线框 —— 它跟上面几张
   章节卡是同一族(同宽同圆角同底),虚线只表示"这张还不存在"。 */
.slopes-add-chapter {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  box-sizing: border-box;
  gap: var(--cy-space-1-5);
  margin: var(--cy-space-2) var(--cy-page-x) 0;
  padding: var(--cy-space-4) 0;
  border-radius: var(--cy-radius-xl);
  border: 4rpx dashed var(--cy-color-border-strong);
  background: var(--cy-color-bg-surface);
  color: var(--cy-color-text-primary);
}

.slopes-add-chapter:active {
  opacity: 0.7;
}

.slopes-add-chapter__ico {
  display: flex;
  align-items: center;
}

.slopes-add-chapter__txt {
  font-size: var(--cy-font-body);
  font-weight: 700;
}

/* 章节弹窗里的剧情正文(唯一编辑入口) */
.chapter-story-field {
  padding: var(--cy-space-2) 0;
}

.chapter-story-field__label {
  display: flex;
  align-items: center;
  gap: var(--cy-space-1-5);
  margin-bottom: var(--cy-space-1-5);
  font-size: var(--cy-font-caption);
  color: var(--cy-color-text-secondary);
}

.chapter-story-field__req {
  color: var(--cy-color-text-tertiary);
}

.chapter-story-field__input {
  width: 100%;
  min-height: 200rpx;
  box-sizing: border-box;
  padding: var(--cy-space-2-5);
  border-radius: var(--cy-radius-sm);
  background: var(--cy-color-bg-surface-subtle);
  font-size: var(--cy-font-body);
  line-height: 1.6;
  color: var(--cy-color-text-primary);
}

/* 待编排区：node/place 只在页面态存在，补齐坐标并归章后才离开这里。 */
/* 2026-09-05:这层不再是一张卡,只是「区块标题 + 若干张素材卡」的容器。
   ⚠️ 它在 .slopes-section 里面,而那层已经给了 32rpx 的横向 padding。
   再叠一层 page-x margin 就比同列的章节卡窄一整圈(实拍如此)。只留下边距。 */
.pending-materials {
  display: block;
  margin: 0 0 var(--cy-space-2-5);
}

.pending-materials__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--cy-space-2);
}

.pending-materials__title,
.pending-materials__count,
.pending-materials__notice,
.pending-material__kind,
.pending-material__name,
.pending-material__desc,
.pending-material__state {
  display: block;
}

.pending-materials__title {
  color: var(--cy-color-text-primary);
  font-size: var(--cy-font-subtitle);
  font-weight: 800;
}

.pending-materials__count,
.pending-materials__notice {
  margin-top: var(--cy-legacy-6);
  color: var(--cy-color-text-tertiary);
  font-size: var(--cy-font-caption);
}

.pending-materials__continue {
  min-height: var(--cy-btn-h);
  display: flex;
  align-items: center;
  color: var(--cy-color-action-primary-bg);
  font-size: var(--cy-font-caption);
  font-weight: 700;
}

.pending-material {
  --cy-comp-card-radius: var(--cy-radius-xl);
  --cy-comp-card-pad: var(--cy-space-3);
  position: relative;
  display: block;
  margin-top: var(--cy-space-2-5);
  border-radius: var(--cy-radius-xl);
}

/* 删除素材:每张卡自己的右上角 ✕。原来是第四颗与「补内容」平级的红字按钮,
   读起来像"这一步也是编排流程的一环",而它其实是丢弃。 */
.pending-material__x {
  position: absolute;
  z-index: 1;
  top: var(--cy-space-1-5);
  right: var(--cy-space-1-5);
  width: var(--cy-btn-h);
  height: var(--cy-btn-h);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--cy-color-text-tertiary);
}

/* 2026-09-05:素材行补缩略图,与故事流节点卡同一档尺寸。 */
.pending-material__head {
  display: flex;
  align-items: center;
  gap: var(--cy-space-2);
}

.pending-material__thumb {
  width: 190rpx;
  height: 138rpx;
  flex: none;
  border-radius: var(--cy-radius-md);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--cy-color-bg-surface-subtle);
  color: var(--cy-color-text-placeholder);
}

.pending-material__img { width: 100%; height: 100%; }

.pending-material__head .pending-material__main {
  flex: 1;
  min-width: 0;
}

.pending-material__kind {
  color: var(--cy-color-text-tertiary);
  font-size: var(--cy-type-micro);
}

.pending-material__name {
  margin-top: var(--cy-legacy-6);
  color: var(--cy-color-text-primary);
  font-size: var(--cy-font-body);
  font-weight: 700;
}

.pending-material__desc,
.pending-material__state {
  margin-top: var(--cy-legacy-6);
  color: var(--cy-color-text-secondary);
  font-size: var(--cy-font-caption);
  line-height: 1.5;
}

.pending-material__state.is-warn {
  color: var(--cy-color-status-warning);
}

.pending-material__actions {
  display: flex;
  flex-wrap: wrap;
  gap: var(--cy-space-1-5);
  margin-top: var(--cy-space-2);
}

.pending-material__action {
  min-height: var(--cy-btn-h);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  padding: 0 var(--cy-space-2);
  border-radius: var(--cy-radius-sm);
  background: var(--cy-color-bg-surface-subtle);
  color: var(--cy-color-text-secondary);
  font-size: var(--cy-font-caption);
  font-weight: 700;
}

.pending-undo {
  position: fixed;
  z-index: 280;
  left: var(--cy-page-x);
  right: var(--cy-page-x);
  bottom: calc(var(--cy-btn-h) + var(--cy-space-6) + env(safe-area-inset-bottom));
  min-height: var(--cy-btn-h);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 var(--cy-space-3);
  border-radius: var(--cy-radius-md);
  background: var(--cy-color-bg-elevated);
  color: var(--cy-color-text-primary);
  box-shadow: var(--cy-shadow-card);
  font-size: var(--cy-font-caption);
}

.pending-undo__action {
  min-height: var(--cy-btn-h);
  display: flex;
  align-items: center;
  color: var(--cy-color-action-primary-bg);
  font-weight: 800;
}

.pending-node-name,
.pending-node-description {
  width: 100%;
  box-sizing: border-box;
  padding: var(--cy-space-2-5);
  border-radius: var(--cy-radius-sm);
  background: var(--cy-color-bg-surface-subtle);
  color: var(--cy-color-text-primary);
  font-size: var(--cy-font-body);
}

.pending-node-description {
  min-height: 160rpx;
  line-height: 1.6;
}

.pending-node-game {
  margin: var(--cy-space-3) 0;
}

/* 全屏故事流编辑器 */
/* ===== 故事流编辑器(Figma 4028:13330) =====
   形态改为底部半屏 sheet(原是全屏页):留出上方一截,创作者始终看得见自己在编哪一章。
   ⚠️ 节点块【没有拖拽手柄】—— 稿子里画了,但 2026-08-10 用户裁决不做拖拽
   (小程序原生 textarea 渲染层级在 web 层之上,movable-view 拖过去必然抽风)。
   改顺序走「删除 → 待编排区 → 重新插入」。这是有意省略,别照稿补回来。 */
.story-editor { position: fixed; inset: 0; z-index: 240; }

/* 叠层(用户 2026-09-05 定):编辑章节从故事流「下一步」进来时,故事流留在下层被压暗。
   pop-model 的 z-index(333)本来就在 story-editor(240)之上,所以这里只管下层的观感。 */
.story-editor.is-stacked .story-editor__sheet { filter: brightness(.82); }

.story-editor__backdrop { position: absolute; inset: 0; background: var(--cy-color-overlay); }

.story-editor__sheet {
  position: absolute;
  /* top 由 wxml 注入 chrome.sheetTop(胶囊底 +5px);这里的 136rpx 只是拿不到胶囊时的兜底,
     行内 style 会盖掉它。原来写死 136rpx,在刘海屏上「完成」正好顶到胶囊边上。 */
  left: 0; right: 0; bottom: 0; top: 136rpx;
  display: flex;
  flex-direction: column;
  border-radius: var(--cy-radius-lg) var(--cy-radius-lg) 0 0;
  background: var(--cy-color-bg-surface);
  overflow: hidden;
}

.story-editor__grabber {
  flex: 0 0 auto;
  width: 72rpx; height: 8rpx;
  margin: var(--cy-space-2) auto 0;
  border-radius: var(--cy-radius-pill);
  background: var(--cy-color-border-strong);
}

.story-editor__header {
  flex: 0 0 auto;
  height: 112rpx;
  display: flex;
  align-items: center;
  padding: 0 var(--cy-space-4);
}

.story-editor__back,
.story-editor__done {
  min-width: var(--cy-btn-h);
  min-height: var(--cy-btn-h);
  display: flex;
  align-items: center;
  color: var(--cy-color-text-primary);
}

.story-editor__back { font-size: var(--cy-font-page-title); }
.story-editor__done { justify-content: flex-end; font-size: var(--cy-font-body); font-weight: 700; }

.story-editor__heading {
  flex: 1; min-width: 0;
  text-align: center;
  color: var(--cy-color-text-primary);
  font-size: var(--cy-font-subtitle);
  font-weight: 700;
}

.story-editor__namerow { flex: 0 0 auto; padding: 0 var(--cy-space-4) var(--cy-space-2); }

.story-editor__title {
  width: 100%;
  height: 104rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
  border-radius: var(--cy-radius-md);
  background: var(--cy-color-bg-surface-subtle);
  color: var(--cy-color-text-primary);
  font-size: var(--cy-font-subtitle);
  font-weight: 700;
}

.story-editor__scroll { flex: 1; min-height: 0; }

.story-editor__pending {
  margin: var(--cy-space-3) var(--cy-space-4) 0;
  padding: var(--cy-space-2-5) var(--cy-space-3);
  border-radius: var(--cy-radius-sm);
  background: var(--cy-color-brand-soft);
  color: var(--cy-color-text-primary);
  font-size: var(--cy-font-caption);
  line-height: 1.55;
}

/* 左侧导引线把文字块与节点块串成一条时间轴 —— 「位置即时序」在视觉上得成立。 */
.story-editor__rail { position: relative; padding-bottom: var(--cy-space-5); }

.story-editor__rail::before {
  content: '';
  position: absolute;
  left: 54rpx; top: 0; bottom: var(--cy-space-5);
  width: 4rpx;
  background: var(--cy-color-border-subtle);
}

/* 插入点:收起是一颗小圆,展开成横线 + 两颗药丸。两态等高,展开不跳版。 */
.story-insert {
  position: relative;
  height: var(--cy-btn-h);
  display: flex;
  align-items: center;
  justify-content: center;
}

.story-insert__plus {
  position: relative; z-index: 1;
  width: 44rpx; height: 44rpx;
  border-radius: var(--cy-radius-pill);
  border: 2rpx solid var(--cy-color-border-subtle);
  background: var(--cy-color-bg-surface);
  color: var(--cy-color-text-tertiary);
  font-size: var(--cy-font-caption);
  display: flex;
  align-items: center;
  justify-content: center;
}

.story-insert__rule {
  position: absolute;
  left: 88rpx; right: 40rpx;
  height: 2rpx;
  background: var(--cy-color-border-subtle);
}

.story-insert__menu { position: relative; z-index: 1; display: flex; gap: var(--cy-space-2); }

/* 2026-09-05 按稿把药丸做小(26px),但**命中区不缩**(用户裁决 A)。
   稿子给的 26px 低于 44px 触控下限,而 publish-story-editor-hit-targets-contract
   正是为此存在的。做法:这一层只当命中区(min-height 仍是 --cy-btn-h、无边框无底色),
   看得见的药丸由 ::before 画成 50rpx 高、垂直居中 —— 看起来是稿子的尺寸,手指够到的还是 44px。
   ⚠️ 别把 min-height 改回 height 或改小:那样两件事会一起变,契约会红。 */
.story-insert__action {
  position: relative;
  min-height: var(--cy-btn-h);
  padding: 0 17rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--cy-space-1);
  color: var(--cy-color-text-secondary);
  font-size: var(--cy-font-caption);
}

.story-insert__action::before {
  content: '';
  position: absolute;
  z-index: -1;
  left: 0; right: 0; top: 50%;
  height: 50rpx;
  margin-top: -25rpx;
  border-radius: var(--cy-radius-pill);
  border: 2rpx solid var(--cy-color-border-subtle);
  background: var(--cy-color-bg-surface);
}

/* ⚠️ 实底那档要画在 ::before 那颗药丸上,不能画在外层 —— 外层现在是 44rpx 高、无圆角的
   透明命中区(见上面 B7 的说明),在它身上刷底色会盖住药丸,整条渲染成一根黑色长条。 */
.story-insert__action--node { color: var(--cy-btn-solid-fg); }

.story-insert__action--node::before {
  border-color: transparent;
  background: var(--cy-btn-solid-bg);
}

/* 文字块:无边框直接写,左侧一颗小圆点挂在导引线上。 */
.story-text-block { position: relative; padding: 12rpx var(--cy-space-4) 12rpx 88rpx; }

.story-text-block::before {
  content: '';
  position: absolute;
  left: 48rpx; top: 40rpx;
  width: 16rpx; height: 16rpx;
  border-radius: var(--cy-radius-pill);
  background: var(--cy-color-text-placeholder);
}

/* ⚠️ <textarea auto-height> 的**首次渲染**是微信组件自身的默认高,不是内容高
   ——实测一行文字量到 136px,再渲染一次才收敛到 56px。**CSS 改不动它**
   (height:auto / min-height 都试过,无效),只能在 JS 里补一次渲染,
   见 index.js#_reflowStoryTextareas。 */
.story-text-block__input {
  width: 100%;
  min-height: 108rpx;
  box-sizing: border-box;
  color: var(--cy-color-text-primary);
  font-size: var(--cy-font-body);
  line-height: 1.7;
}

/* 媒体块(图片 / 音频):与文字块同一条 88rpx 左缩进,导引线上不挂序号圈 ——
   序号是节点的语义,图片和音频不占站点编号。 */
/* 右内距按插入缝横线的右端给(40rpx),不是 --cy-space-4(32rpx)——
   差这 8rpx 会让音频块的灰底比横线右端多出 4px(2026-09-06 用户实拍指出)。 */
.story-media-block { position: relative; padding: 12rpx 40rpx 12rpx 88rpx; }

.story-media-block__img {
  width: 100%;
  border-radius: var(--cy-radius-md);
  background: var(--cy-color-bg-surface-subtle);

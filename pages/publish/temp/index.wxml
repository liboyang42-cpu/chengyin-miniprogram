          <view class="cg-cfg-label">角色配置</view>
          <view class="cg-adv-repeat" wx:for="{{advanced.multiplayer.roles}}" wx:key="id" wx:for-index="mi" wx:for-item="role">
            <view class="cg-adv-repeat-head"><text>角色 {{mi + 1}}</text><view class="cg-adv-del" data-index="{{mi}}" bindtap="removeMultiplayerRole" aria-role="button" aria-label="删除" hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="close-sm" size="28" /></view></view>
            <input class="cg-cfg-input" value="{{role.id}}" placeholder="角色 ID" data-index="{{mi}}" data-field="id" bindinput="updateMultiplayerRole" />
            <input class="cg-cfg-input" value="{{role.label}}" placeholder="角色名称" data-index="{{mi}}" data-field="label" bindinput="updateMultiplayerRole" />
            <view class="cg-adv-grid"><input class="cg-cfg-input" type="number" value="{{role.min}}" placeholder="最少" data-index="{{mi}}" data-field="min" data-numeric="1" bindinput="updateMultiplayerRole" /><input class="cg-cfg-input" type="number" value="{{role.max}}" placeholder="最多" data-index="{{mi}}" data-field="max" data-numeric="1" bindinput="updateMultiplayerRole" /></view>

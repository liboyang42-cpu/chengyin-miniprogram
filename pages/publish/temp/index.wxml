          <view class="cg-cfg-label">轮次顺序（角色 ID，用逗号分隔）</view>
          <input class="cg-cfg-input" value="{{advanced.multiplayer.turnOrder}}" placeholder="例如 scout,player" bindinput="onTurnOrderChange" />

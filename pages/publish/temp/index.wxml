      </view>

      <view class="cg-gcfg cg-adv-section" wx:if="{{advanced.musicCorner.enabled}}">
        <view class="cg-rw-line"><view class="cg-rw-meta"><view class="cg-rw-name">治愈音乐角</view><view class="cg-rw-sub">播放背景音乐，不影响通关</view></view><cy-switch checked="{{advanced.musicCorner.enabled}}" data-key="musicCorner" bindchange="onAdvancedToggle" /></view>
        <view class="cg-adv-body" wx:if="{{advanced.musicCorner.enabled}}">
          <view class="cg-cfg-label">标题</view>
          <input class="cg-cfg-input" value="{{advanced.musicCorner.title}}" placeholder="例如 坐下来 这一站只用耳朵" data-section="musicCorner" data-field="title" bindinput="onAdvancedField" />
          <view class="cg-cfg-label">曲目名</view>
          <input class="cg-cfg-input" value="{{advanced.musicCorner.trackName}}" placeholder="例如 店主的歌单" data-section="musicCorner" data-field="trackName" bindinput="onAdvancedField" />
          <view class="cg-cfg-label">曲目地址 · 选填</view>

            <view class="cg-adv-grid">
              <view><view class="cg-cfg-label">难度 DC · 1 至 40</view><input class="cg-cfg-input" type="number" value="{{advanced.diceRoll.dc}}" aria-label="D20 难度 DC" data-section="diceRoll" data-field="dc" bindinput="onAdvancedField" /></view>
              <view><view class="cg-cfg-label">加值 · -20 至 20</view><input class="cg-cfg-input" type="text" value="{{advanced.diceRoll.modifier}}" aria-label="D20 加值，可填负数" data-section="diceRoll" data-field="modifier" bindinput="onAdvancedField" /></view>
            </view>
            <view class="cg-cfg-label">掷骰方式</view>
            <cy-dropdown portal="{{false}}" range="{{d20RollModes}}" range-key="label" value="{{opt.idx(d20RollModes, advanced.diceRoll.rollMode)}}" bind:change="onD20RollMode"><view class="cg-pick {{opt.idx(d20RollModes, advanced.diceRoll.rollMode) < 0 ? 'empty' : ''}}">{{opt.label(d20RollModes, advanced.diceRoll.rollMode)}}<view class="cg-caret"><cy-icon name="back" size="28" /></view></view></cy-dropdown>
            <view class="cg-cfg-label">成功结果</view>
            <view class="cg-cfg-hint" wx:if="{{formData.originalTemplateId}}">结果留空将沿用原模板，填写后采用你的新文案。</view>
            <textarea class="cg-cfg-textarea" auto-height maxlength="200" value="{{advanced.diceRoll.successText}}" placeholder="成功后发生什么" aria-label="D20 成功结果" data-section="diceRoll" data-field="successText" bindinput="onAdvancedField" />
            <view class="cg-cfg-label">失败结果</view>
            <textarea class="cg-cfg-textarea" auto-height maxlength="200" value="{{advanced.diceRoll.failText}}" placeholder="失败后发生什么，玩家接下来做什么" aria-label="D20 失败结果" data-section="diceRoll" data-field="failText" bindinput="onAdvancedField" />
            <view class="cg-cfg-hint">二十面骰点数 + 加值 ≥ DC 即成功。1 和 20 不自动判定成败；优势取较高点数，劣势取较低点数。成功和失败都完成本次检定，结果可用于主题分支。</view>
          </block>
          <block wx:else>
          <view class="cg-cfg-label">几颗</view>
          <cy-dropdown portal="{{false}}" range="{{diceCountOptions}}" range-key="label" value="{{opt.idx(diceCountOptions, advanced.diceRoll.diceCount)}}" bind:change="onDiceCount"><view class="cg-pick {{opt.idx(diceCountOptions, advanced.diceRoll.diceCount) < 0 ? 'empty' : ''}}">{{opt.label(diceCountOptions, advanced.diceRoll.diceCount)}}<view class="cg-caret"><cy-icon name="back" size="28" /></view></view></cy-dropdown>
          <view class="cg-cfg-label">六个面各写一件事</view>
          <view class="cg-adv-repeat" wx:for="{{advanced.diceRoll.faces}}" wx:key="index" wx:for-index="fi">
            <view class="cg-adv-repeat-head">{{fi + 1}}</view>
            <input class="cg-cfg-input" value="{{item}}" placeholder="掷到 {{fi + 1}} 要做什么" data-index="{{fi}}" bindinput="onDiceFace" />
          </view>
          <view class="cg-cfg-hint">写具体：「跟店员说一句今天的天气」比「和店员互动」好使，后者玩家不知道该干嘛。两颗那一档只报点数和，用来分胜负，不对应任务。</view>
          </block>
        </view>
          </view>
          <view class="cg-gcfg" wx:if="{{gameSection === 'reaction'}}">
        <view class="cg-adv-body">
          <view class="cg-cfg-label">标题</view>
          <input class="cg-cfg-input" value="{{advanced.reaction.kicker}}" placeholder="例如 变绿就点" data-section="reaction" data-field="kicker" bindinput="onAdvancedField" />
          <view class="cg-adv-grid">
            <view><view class="cg-cfg-label">几轮</view><input class="cg-cfg-input" type="number" value="{{advanced.reaction.rounds}}" placeholder="1 至 10" data-section="reaction" data-field="rounds" data-numeric="1" bindinput="onAdvancedField" /></view>
            <view><view class="cg-cfg-label">达标毫秒</view><input class="cg-cfg-input" type="number" value="{{advanced.reaction.goalMs}}" placeholder="120 至 2000" data-section="reaction" data-field="goalMs" data-numeric="1" bindinput="onAdvancedField" /></view>
          </view>
          <view class="cg-cfg-hint">抢跑单独判——不判的话所有人都会在变色前狂点，这游戏就没了。每轮等待时长都会随机生成，固定间隔第二轮就能背下来。达标毫秒不能低于 120：那是人类反应下限，低于它等于设了个没人能达标的目标。</view>
        </view>
          </view>
          <view class="cg-gcfg" wx:if="{{gameSection === 'ballShake'}}">
        <view class="cg-adv-body">
          <view class="cg-cfg-label">标题</view>
          <input class="cg-cfg-input" value="{{advanced.ballShake.kicker}}" placeholder="例如 撞够 30 次" data-section="ballShake" data-field="kicker" bindinput="onAdvancedField" />
          <view class="cg-cfg-label">要撞多少次</view>
          <input class="cg-cfg-input" type="number" value="{{advanced.ballShake.goal}}" placeholder="1 至 200" data-section="ballShake" data-field="goal" data-numeric="1" bindinput="onAdvancedField" />
          <view class="cg-rw-line"><view class="cg-rw-meta"><view class="cg-rw-name">限时</view><view class="cg-rw-sub">开了顶上出倒计时；不开就撞满为止，不催</view></view><cy-switch checked="{{advanced.ballShake.timed}}" data-key="ballShake.timed" bindchange="onAdvancedSubToggle" /></view>
          <view wx:if="{{advanced.ballShake.timed}}">
            <view class="cg-cfg-label">时限（秒）</view>
            <input class="cg-cfg-input" type="number" value="{{advanced.ballShake.seconds}}" placeholder="3 至 300" data-section="ballShake" data-field="seconds" data-numeric="1" bindinput="onAdvancedField" />
          </view>
          <view class="cg-cfg-hint">墙就是手机的四条边，不画内框。没有陀螺仪的机器按住屏幕也能玩。</view>

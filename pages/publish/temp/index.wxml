                <input class="cg-cfg-input" value="{{o.label}}" placeholder="玩家看到的文案，如 店员" data-qindex="{{qi}}" data-index="{{oi}}" data-field="label" bindinput="updateProfileOption" />
                <input class="cg-cfg-input" value="{{o.key}}" placeholder="存下来的值，如 clerk" data-qindex="{{qi}}" data-index="{{oi}}" data-field="key" bindinput="updateProfileOption" />
                <view class="cg-cfg-label">选了它写什么状态（暗的，不会告诉玩家）</view>
                <view class="cg-adv-repeat" wx:for="{{o.effects}}" wx:key="index" wx:for-index="ei" wx:for-item="eff">
                  <view class="cg-adv-repeat-head">
                    <text>加成 {{ei + 1}}</text>
                    <view class="cg-adv-del" data-path="{{'profile.questions.' + qi + '.options.' + oi + '.effects'}}" data-index="{{ei}}" bindtap="removeEffectRow" aria-role="button" aria-label="删除" hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="close-sm" size="28" /></view>
                  </view>
                  <input class="cg-cfg-input" value="{{eff.var}}" placeholder="变量名，如 counter.energy"
                         data-path="{{'profile.questions.' + qi + '.options.' + oi + '.effects'}}" data-index="{{ei}}" data-field="var" bindinput="updateEffectField" />
                  <cy-dropdown portal="{{false}}" range="{{effectOps}}" range-key="label" value="{{opt.idx(effectOps, eff.op)}}" data-path="{{'profile.questions.' + qi + '.options.' + oi + '.effects'}}" data-index="{{ei}}" bind:change="pickEffectOp"><view class="cg-pick {{opt.idx(effectOps, eff.op) < 0 ? 'empty' : ''}}">{{opt.label(effectOps, eff.op)}}<view class="cg-caret"><cy-icon name="back" size="28" /></view></view></cy-dropdown>
                  <input class="cg-cfg-input" type="{{eff.op === 'ADD_TAG' ? 'text' : 'number'}}" value="{{eff.value}}"
                         placeholder="{{eff.op === 'ADD_TAG' ? 'tag.hurried（tag. 开头）' : '1'}}"
                         data-path="{{'profile.questions.' + qi + '.options.' + oi + '.effects'}}" data-index="{{ei}}" data-field="value" bindinput="updateEffectField" />
                </view>
                <view class="cg-adv-add" wx:if="{{o.effects.length < 16}}" data-path="{{'profile.questions.' + qi + '.options.' + oi + '.effects'}}" bindtap="addEffectRow" hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="plus" size="28" />添加加成</view>
                <view class="cg-cfg-hint">变量名要带前缀：精力 counter.energy、念头 counter.thought、不稳定度 counter.instability；幸运用保留的 sys.luck，只能「加」1 至 3。</view>
              </view>
              <view class="cg-adv-add" wx:if="{{q.options.length < 6}}" data-qindex="{{qi}}" bindtap="addProfileOption" hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="plus" size="28" />添加选项</view>
            </block>
          </view>
          <view class="cg-adv-add" wx:if="{{advanced.profile.questions.length < 8}}" bindtap="addProfileQuestion" hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="plus" size="28" />添加问题</view>

          <view class="cg-cfg-label">填完奖励分</view><input class="cg-cfg-input" type="number" value="{{advanced.profile.xp}}" placeholder="0 表示不给分" data-section="profile" data-field="xp" data-numeric="1" bindinput="onAdvancedField" />
          <view class="cg-cfg-hint">每个问题都要起一个变量名 —— 后面故事里写 {变量名}，玩家填过就会被换掉。选项的数值加成是暗的，不会告诉玩家。</view>
        </view>
          </view>

          <view class="cg-gcfg" wx:if="{{gameSection === 'photoCheck'}}">
        <view class="cg-adv-body">
          <view class="cg-cfg-label">标题</view>
          <input class="cg-cfg-input" value="{{advanced.photoCheck.title}}" placeholder="例如 拍一张窗外" data-section="photoCheck" data-field="title" bindinput="onAdvancedField" />
          <!-- 拍物成卡的兜底卡名:卡名先用 AI 认出来的物品名,认不出来用这里的,这里也空就用上面的标题。
               只在拍物成卡模式出现 —— 普通拍照审核没有卡。 -->
          <view wx:if="{{advanced.photoCheck.mode === 'CARD'}}">
            <view class="cg-cfg-label">兜底卡名 · 选填</view>
            <input class="cg-cfg-input" value="{{advanced.photoCheck.cardTitle}}" placeholder="例如 一枚旧弹壳" maxlength="64" data-section="photoCheck" data-field="cardTitle" bindinput="onAdvancedField" />
            <view class="cg-cfg-hint cg-cfg-hint--gap">卡名先用 AI 认出来的物品名；认不出来时用这里的名字，这里也空就用上面的标题。</view>
          </view>
          <view class="cg-cfg-label">提示词 · 选填</view>
          <input class="cg-cfg-input" value="{{advanced.photoCheck.shotNote}}" placeholder="例如 把窗框也拍进去" data-section="photoCheck" data-field="shotNote" bindinput="onAdvancedField" />
          <view class="cg-cfg-label">要拍到什么才算过</view>
          <input class="cg-cfg-input" value="{{advanced.photoCheck.requirement}}" placeholder="例如 画面里要能看见窗外的街景，窗框入镜" maxlength="60" data-section="photoCheck" data-field="requirement" bindinput="onAdvancedField" />
          <view class="cg-cfg-label">取景轮廓 · 选填</view>
          <!-- cg-qmedia--one:只有一个槽。不加这个修饰类的话 .cg-qmedia 的 flex:1 会把它
               撑满整行 —— 那个宽度是给「配图 + 音频」两个槽并排设计的(见题干附件那段)。 -->
          <view class="cg-qmedia cg-qmedia--one">
            <view class="cg-qmedia-slot" wx:if="{{advanced.photoCheck.frameUrl}}">
              <image class="cg-qmedia-img" src="{{advanced.photoCheck.frameUrl}}" mode="aspectFit" />
              <view class="cg-qmedia-x" catchtap="clearPhotoFrame" aria-role="button" aria-label="删除取景轮廓" hover-class="cy-pressed" hover-stay-time="80">
                <cy-icon name="close-sm" size="28" />
              </view>
            </view>
            <view class="cg-qmedia-add" wx:else bindtap="uploadPhotoFrame" aria-role="button" aria-label="上传取景轮廓" hover-class="cy-pressed" hover-stay-time="80">
              <cy-icon name="image" size="40" /><text class="cg-qmedia-t">轮廓图</text>
            </view>
          </view>
          <!-- 浓淡是连续量,用滑块不用数字框:商家不该为了调个透明度去敲键盘。
               slider 的 bindchange 同样给 e.detail.value,onAdvancedField 原样能收,不用加 js。 -->
          <view wx:if="{{advanced.photoCheck.frameUrl}}">
            <view class="cg-cfg-label">轮廓浓淡</view>
            <slider min="0" max="100" step="5" value="{{advanced.photoCheck.frameOpacity}}" show-value
                    activeColor="var(--cy-color-action-primary-bg)" backgroundColor="var(--cy-color-border-subtle)"
                    block-size="24" data-section="photoCheck" data-field="frameOpacity" data-numeric="1" bindchange="onAdvancedField" />
          </view>
          <view class="cg-cfg-hint">轮廓只是给玩家的辅助线 —— 举起手机时镜头里先浮着它，把实物套进去再按快门。它不参与判定，过不过仍然只看上面那句「要拍到什么」。用一张透明底的线条图最清楚。</view>
          <view class="cg-adv-grid">
            <view><view class="cg-cfg-label">置信度分数线（0 至 100）</view><slider min="0" max="100" step="1" value="{{advanced.photoCheck.minConfidence}}" show-value activeColor="var(--cy-color-action-primary-bg)" backgroundColor="var(--cy-color-border-subtle)" block-size="24" data-section="photoCheck" data-field="minConfidence" data-numeric="1" bindchange="onAdvancedField" /></view>
            <view><view class="cg-cfg-label">可以拍几次（1 至 10）</view><input class="cg-cfg-input" type="number" value="{{advanced.photoCheck.maxTries}}" placeholder="3" data-section="photoCheck" data-field="maxTries" data-numeric="1" bindinput="onAdvancedField" /></view>
          </view>
          <view class="cg-cfg-label">次数用尽还没过</view>
          <cy-dropdown portal="{{false}}" range="{{photoCheckFallbacks}}" range-key="label" value="{{opt.idx(photoCheckFallbacks, advanced.photoCheck.fallback)}}" bind:change="pickPhotoCheckFallback"><view class="cg-pick {{opt.idx(photoCheckFallbacks, advanced.photoCheck.fallback) < 0 ? 'empty' : ''}}">{{opt.label(photoCheckFallbacks, advanced.photoCheck.fallback)}}<view class="cg-caret"><cy-icon name="back" size="28" /></view></view></cy-dropdown>
          <view class="cg-cfg-label">通过奖励分</view><input class="cg-cfg-input" type="number" value="{{advanced.photoCheck.xp}}" placeholder="0 表示不给分" data-section="photoCheck" data-field="xp" data-numeric="1" bindinput="onAdvancedField" />
          <view class="cg-cfg-hint">玩家拍完会自动判定，你不用写分数规则 —— 把那句「要拍到什么」写具体就行。「放过他」会在档案里留一个标记，你事后看得到谁是被放过的。自动判定暂不可用时会标成「没能审」往下走，不会把这一关卡死。</view>
        </view>
          </view>


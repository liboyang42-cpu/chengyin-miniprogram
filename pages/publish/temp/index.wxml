<!-- 创建节点玩法 · 关卡编辑器(玻璃拟态重做) -->
<!-- 视觉照设计稿 docs/design/城市解谜玩法创建.dc.html;数据接真实系统 -->
<!-- 单选一律 cy-dropdown(2026-09-22 用户定):存的是 key、显示的是 label,由 key 反查下标;
     不另存一份「选中下标」—— 模板回填只写 key,另存一份迟早对不上。找不到返回 -1(面板里不打勾,触发器显示「请选择」)。 -->
<wxs module="opt">
  var idx = function (list, key, field) {
    var f = field || 'key';
    for (var i = 0; i < (list || []).length; i++) { if (list[i][f] === key) return i; }
    return -1;
  };
  module.exports = {
    idx: idx,
    // 触发器上显示的字:找不到(没选过 / 老模板存了不认识的值)一律「请选择」;没起名的按序号叫
    label: function (list, key, field, prefix) {
      var i = idx(list, key, field);
      if (i < 0) return '请选择';
      return list[i].label || ((prefix || '') + (i + 1));
    },
    names: function (list, prefix) {
      var out = [];
      for (var i = 0; i < (list || []).length; i++) { out.push(list[i].label || (prefix + (i + 1))); }
      return out;
    }
  };
</wxs>
<view class="cg theme-topic-editor {{reducedMotion ? 'cg--reduced-motion' : ''}}">
  <cy-toast id="cy-toast" />
  <cy-loading-mask id="cy-loading" />
  <cy-modal-host id="cy-modal-host" />

  <!-- ============ 顶部导航 ============ -->
  <!-- 试玩玩法屏时整条导航让位:玩法屏自己带「退出」,再画一个返回箭头会和它叠在一起,
       而且那条白底会把深色的玩法屏框成一张卡。 -->
  <cy-nav-bar wx:if="{{ !(previewVisible && pvKit && pvStepKey === 'challenge') }}" custom-back bind:back="goBack" />
  <view class="cg-nav-spacer" style="height: {{ statusBarHeight + navBarHeight }}px;"></view>
  <cy-page-title title="{{ previewVisible ? '玩家视角预览' : '编辑玩法模板' }}" safe-top="{{false}}" />

  <view class="cg-load-state" wx:if="{{editorLoading}}">
    <cy-skeleton type="detail" />
    <view class="cg-load-state__hint">正在加载玩法内容…</view>
  </view>
  <view class="cg-load-state" wx:elif="{{loadError}}">
    <cy-error title="玩法详情没有加载出来" sub="{{loadError}}" retry="重新加载" bind:retry="retryGetData" />
  </view>

  <!-- ============ 编辑态 ============ -->
  <scroll-view wx:else scroll-y class="cg-scroll" enhanced show-scrollbar="{{false}}" scroll-into-view="{{scrollIntoView}}">

    <!-- 封面 + 名字:原型是**同一张卡** —— 上半是 1:1 的大方块封面(斜纹占位 + 圆形 ＋),
         下半是名字输入框(原型 .hero / .hero-cover / .hero-body)。 -->
    <view class="cg-hero" id="sec-top">
      <view class="cg-hero-cover cg-hero-cover--picked" wx:if="{{ formData.imgUrl }}">
        <image class="cg-hero-img" src="{{ formData.imgUrl }}" mode="aspectFill" />
        <view class="cg-cover-del" catchtap="clearCover" aria-role="button" aria-label="删除玩法封面" hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="close-sm" size="32" /></view>
      </view>
      <view class="cg-hero-cover" wx:else bindtap="uploadPic" aria-role="button" aria-label="上传玩法封面"
            hover-class="cy-pressed" hover-stay-time="80">
        <view class="cg-hero-plus"><cy-icon name="plus" size="36" /></view>
        <view class="cg-hero-c1">上传玩法封面</view>
        <view class="cg-hero-c2">1:1 方图 · 1 张</view>
      </view>
      <view class="cg-hero-body">
        <input class="cg-title-input {{errors.title ? 'err' : ''}}" bindinput="onTitleChange" value="{{ formData.title }}"
          maxlength="20" placeholder="给这个玩法起个名字" placeholder-class="cg-ph" />
        <cy-inline-error class="cg-inline-error" wx:if="{{errors.title}}" title="{{errors.title}}" action="清除" data-field="title" bind:action="clearBasicField" />
      </view>
    </view>


    <!-- ============ 基本信息 ============ -->
    <cy-card class="cg-card" id="sec-basic">
      <view class="cg-card-head">
        <view class="cg-bar"></view><view class="cg-card-tit">模板信息</view>
        <view class="cg-card-note">发布后展示给玩家</view>
      </view>

      <!-- 玩法描述 -->
      <view class="cg-field">
        <view class="cg-row-between">
          <view class="cg-label">玩法看点 <text class="cg-opt">一句话</text></view>
          <view class="cg-count">{{ formData.description.length || 0 }}/30</view>
        </view>
        <textarea class="cg-textarea sm {{errors.description ? 'err' : ''}}" value="{{ formData.description }}" bindinput="onDescriptionChange"
          maxlength="30" placeholder="一句话介绍这个玩法的看点" placeholder-class="cg-ph" />
        <cy-inline-error class="cg-inline-error" wx:if="{{errors.description}}" title="{{errors.description}}" action="清除" data-field="description" bind:action="clearBasicField" />
      </view>

      <!-- 玩家人数 / 玩法时长 -->
      <view class="cg-field cg-divider">
        <view class="cg-two">
          <view class="cg-col">
            <view class="cg-label">玩家人数 <text class="req">*</text></view>
            <view class="cg-pick {{ formData.players ? '' : 'empty' }} {{ errors.players ? 'err' : '' }}" bindtap="openPlayersSheet" hover-class="cy-pressed" hover-stay-time="80">
              <text>{{ dictLoading.players ? '正在加载…' : (playersText || '请选择') }}</text><view class="cg-caret"><cy-icon name="back" size="28" /></view>
            </view>
            <cy-inline-error wx:if="{{dictErrors.players}}" title="人数选项未加载" sub="{{dictErrors.players}}" action="重试" bind:action="retryPlayersOptions" />
            <cy-inline-error class="cg-inline-error" wx:if="{{errors.players}}" title="{{errors.players}}" />
          </view>
          <view class="cg-col">
            <view class="cg-label">玩法时长 <text class="cg-opt">选填</text></view>
            <view class="cg-pick {{ formData.duration ? '' : 'empty' }} {{ errors.duration ? 'err' : '' }}" bindtap="openDurationSheet" hover-class="cy-pressed" hover-stay-time="80">
              <text>{{ dictLoading.duration ? '正在加载…' : (durationText || '请选择') }}</text><view class="cg-caret"><cy-icon name="back" size="28" /></view>
            </view>
            <cy-inline-error wx:if="{{dictErrors.duration}}" title="时长选项未加载" sub="{{dictErrors.duration}}" action="重试" bind:action="retryDurationOptions" />
            <cy-inline-error class="cg-inline-error" wx:if="{{errors.duration}}" title="{{errors.duration}}" />
          </view>
        </view>
      </view>

      <!-- 所需材料 / 商铺类型 -->
      <view class="cg-field cg-divider">
        <view class="cg-two">
          <view class="cg-col">
            <view class="cg-label">所需材料</view>
            <input class="cg-input" value="{{ formData.requiredMaterials }}" bindinput="onRequiredMaterialsChange"
              placeholder="如:手机、笔" placeholder-class="cg-ph" />
          </view>
          <view class="cg-col">
            <view class="cg-label">商铺类型</view>
            <view class="cg-pick {{ formData.usageLocation ? '' : 'empty' }}" bindtap="openVenueSheet" hover-class="cy-pressed" hover-stay-time="80">
              <text>{{ formData.usageLocation || '请选择' }}</text><view class="cg-caret"><cy-icon name="back" size="28" /></view>
            </view>
          </view>
        </view>
      </view>

      <!-- 玩法类别(走真实选择页) -->
      <view class="cg-field cg-divider">
        <view class="cg-label">玩法类别 <text class="req">*</text><text class="cg-opt"> 可多选</text></view>
        <view class="cg-chips">
          <view class="cg-chip" wx:for="{{ categoryList }}" wx:key="id">
            {{ item.categoryName }}
            <view class="cg-chip-x" catchtap="removeCategory" data-id="{{ item.id }}" aria-role="button" aria-label="删除类别 {{item.categoryName}}" hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="close-sm" size="28" /></view>
          </view>
          <view class="cg-chip-add" bindtap="navigateToCategorySelect" aria-role="button" aria-label="添加玩法类别" hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="plus" size="28" />添加类别</view>
        </view>
        <cy-inline-error class="cg-inline-error" wx:if="{{errors.categoryIds}}" title="{{errors.categoryIds}}" />
      </view>

      <!-- 同步到模板广场。★ formData.isSync 与 switch1Change 早就在,只是一直没有入口 ——
           于是这颗开关恒定停在默认值上,商家改不了。
           CU-C-163:这一颗是全页唯一的入口。原来滚动流底部还有一颗「同步到模板库」,
           同绑 formData.isSync / switch1Change,名字不同、相距很远,实点任一颗两颗一起动 ——
           两个入口控制同一个公开设置,只留这一处;生效时机的说明放在预览态的「保存前摘要」。 -->
      <view class="cg-sq-row">
        <view class="cg-sq-meta">
          <view class="cg-sq-name">同步到模板广场</view>
          <view class="cg-sq-sub">开了别人也能用;关着只存在我的模板里</view>
        </view>
        <cy-switch checked="{{ formData.isSync === 1 }}" bindchange="switch1Change" />
      </view>

      <!-- 据点玩法语义:正交于「完成方式」,决定玩家在店里看到的是什么形态。
           只有从据点进来才有 —— 普通模板发布 DTO 没有 interaction_type 这个字段。 -->
      <view class="cg-field cg-divider" wx:if="{{ from === 'citynode' }}">
        <view class="cg-label">玩法形态 <text class="req">*</text></view>
        <cy-dropdown portal="{{false}}" range="{{ interactionTypes }}" range-key="label" value="{{ opt.idx(interactionTypes, interactionType) }}" bind:change="onPickInteraction"><view class="cg-pick {{ interactionType ? '' : 'empty' }} {{ errors.interactionType ? 'err' : '' }}"><text>{{ opt.label(interactionTypes, interactionType) }}</text><view class="cg-caret"><cy-icon name="back" size="28" /></view></view></cy-dropdown>
        <cy-inline-error class="cg-inline-error" wx:if="{{errors.interactionType}}" title="{{errors.interactionType}}" />
      </view>
    </cy-card>

    <!-- ============ 玩法规则 ============ -->
    <cy-card class="cg-card" id="sec-rule">
      <view class="cg-card-head">
        <view class="cg-bar"></view><view class="cg-card-tit">玩法规则</view>
        <view class="cg-card-note">玩家按顺序照做</view>
      </view>
      <!-- 原型:序号是个圆点,画在输入框**外面**左侧;每步一个自增高的输入框 + 删除。
           整份规则仍然存在 formData.ruleInstructions 里(一行一步),没有新建后端字段。 -->
      <view class="cg-steps">
        <view class="cg-step" wx:for="{{ ruleSteps }}" wx:key="*this" wx:for-index="si">
          <view class="cg-step-no">{{ si + 1 }}</view>
          <view class="cg-step-field">
            <textarea class="cg-step-ta" value="{{ item }}" data-index="{{ si }}" bindinput="onRuleStepInput"
              auto-height maxlength="60" placeholder="第 {{ si + 1 }} 步要玩家做什么" placeholder-class="cg-ph" />
            <view class="cg-step-del" wx:if="{{ ruleSteps.length > 1 }}" catchtap="removeRuleStep" data-index="{{ si }}"
                  aria-role="button" aria-label="删除第 {{ si + 1 }} 步" hover-class="cy-pressed" hover-stay-time="80">
              <cy-icon name="close-sm" size="28" />
            </view>
          </view>
        </view>
      </view>
      <view class="cg-step-add" bindtap="addRuleStep" aria-role="button" aria-label="添加一步"
            hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="plus" size="28" />添加一步</view>
    </cy-card>

    <!-- ============ 玩法模块 ============ -->
    <view class="cg-modsec" id="sec-module">
      <view class="cg-modsec-tit">玩法模块</view>
      <view class="cg-modsec-sub">玩法的核心 · 决定玩家怎么玩、玩完拿什么</view>
    </view>

    <!-- 完成方式缺失提示 -->
    <cy-inline-error class="cg-inline-error cg-inline-error--banner" wx:if="{{errors.finish}}" title="{{errors.finish}}" />

    <block wx:for="{{ moduleList }}" wx:key="key" wx:for-item="mod">

      <!-- ======= 完成方式(核心) ======= -->
      <cy-card class="cg-mod cg-mod--blue" wx:if="{{ mod.key === 'finish' }}">
        <view class="cg-mod-head cg-mod-head--blue">
          <view class="cg-mod-ico cg-mod-ico--blue"><cy-icon name="check" size="40" /></view>
          <view class="cg-mod-meta">
            <view class="cg-mod-name">玩法 <text class="cg-tag cg-tag--core">核心</text></view>
            <view class="cg-mod-desc">选择主玩法，也可添加带「可叠加」标记的玩法</view>
          </view>
          <view class="cg-mod-del" bindtap="removeModule" data-key="finish" aria-role="button" aria-label="移除玩法模块" hover-class="cy-pressed" hover-stay-time="80">
            <cy-icon name="close-sm" size="32" />
          </view>
        </view>
        <view class="cg-mod-body">
          <!-- 玩法槽位:没选之前是一个虚线框,选了就变成「已选 · 更换」那张卡。
               一个节点只能选一个玩法(施工文档 §1.1),所以这里是单选,不是一排开关。 -->
          <view class="cg-gpick-empty" wx:if="{{!gameKey}}" bindtap="openGameSheet"
                aria-role="button" aria-label="选择玩法" hover-class="cy-pressed" hover-stay-time="80">
            <view class="cg-gpick-empty__t1"><cy-icon name="plus" size="30" />选择玩法</view>
            <view class="cg-gpick-empty__t2">问答 · 互动 · 挑战 · 剧情 · 主题级</view>
          </view>
          <view class="cg-gpick" wx:else>
            <view class="cg-gpick__ico"><cy-icon name="{{gameCurrent.icon}}" size="36" /></view>
            <view class="cg-gpick__meta">
              <view class="cg-gpick__label">{{gameCurrent.label}}<text wx:if="{{gameCurrent.badge}}" class="cg-tag cg-tag--topic">{{gameCurrent.badge}}</text></view>
              <view class="cg-gpick__sub">{{gameCurrent.sub}}</view>
            </view>
            <view class="cg-gpick__swap" bindtap="openGameSheet" aria-role="button" aria-label="更换玩法"
                  hover-class="cy-pressed" hover-stay-time="80">更换</view>
          </view>

          <!-- 呈现方式(契约 §1.5,2026-09-18 用户拍板):玩法长在哪里由作者选,不由 kit 类型定死。
               选项类/问答类默认内嵌,其余默认整屏 —— 默认只是选中态,不写进配置也生效。
               「只能全屏」那批(判定靠整屏几何或设备能力)把内嵌这一档**置灰并写明原因**,
               不是藏起来:藏起来作者只会以为内嵌还没做。九宫格在主题级,这里没有呈现可配。 -->
          <view class="cg-gcfg" wx:if="{{gameKey && gameKey !== 'bingo' && gameKey !== 'album'}}">
            <view class="cg-cfg-label">这个玩法怎么出现</view>
            <cy-dropdown portal="{{false}}" range="{{presentOptions}}" range-key="label" value="{{opt.idx(presentOptions, presentChoice)}}" disabled="{{presentInlineLocked}}" bind:change="onPickPresent"><view class="cg-pick {{opt.idx(presentOptions, presentChoice) < 0 ? 'empty' : ''}}">{{opt.label(presentOptions, presentChoice)}}<view class="cg-caret"><cy-icon name="back" size="28" /></view></view></cy-dropdown>
            <view class="cg-cfg-hint" wx:if="{{presentInlineLocked}}">只能整屏：{{presentLockReason}}</view>
            <view class="cg-cfg-hint" wx:else>内嵌 = 长在故事流里，玩家读到这一块时直接作答；整屏 = 到这一站单独弹一屏。</view>
          </view>
          <view class="cg-gcfg" wx:if="{{gameKey === 'bingo'}}">
            <view class="cg-cfg-label">主题级玩法</view>
            <view class="cg-cfg-hint">九宫格的格子和奖励在主题编辑页配置，这里无需填写独立节点参数。</view>
          </view>
          <!-- 推理类三段:校验错当场说清楚,不必等到点保存(见 data.gameConfigError) -->
          <cy-inline-error class="cg-inline-error" wx:if="{{gameConfigError}}" title="{{gameConfigError}}" />

          <view class="cg-gcfg" wx:if="{{gameSection === 'random'}}">
        <view class="cg-adv-body">
          <view class="cg-cfg-label">这副卡叫什么</view><input class="cg-cfg-input" value="{{advanced.random.deckName}}" placeholder="如 今日线索卡" data-section="random" data-field="deckName" bindinput="onAdvancedField" />
          <view class="cg-cfg-label">每局抽取数量</view><input class="cg-cfg-input" type="number" value="{{advanced.random.drawCount}}" data-section="random" data-field="drawCount" data-numeric="1" bindinput="onAdvancedField" />
          <view class="cg-adv-repeat" wx:for="{{advanced.random.items}}" wx:key="id" wx:for-index="ri">
            <view class="cg-adv-repeat-head"><text>物品 {{ri + 1}}</text><view class="cg-adv-del" data-index="{{ri}}" bindtap="removeRandomItem" aria-role="button" aria-label="删除" hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="close-sm" size="28" /></view></view>
            <input class="cg-cfg-input" value="{{item.id}}" placeholder="唯一 ID，如 clue_1" data-index="{{ri}}" data-field="id" bindinput="updateRandomItem" />
            <input class="cg-cfg-input" value="{{item.label}}" placeholder="玩家看到的名称" data-index="{{ri}}" data-field="label" bindinput="updateRandomItem" />
            <input class="cg-cfg-input" type="number" value="{{item.weight}}" placeholder="权重" data-index="{{ri}}" data-field="weight" data-numeric="1" bindinput="updateRandomItem" />
            <textarea class="cg-cfg-textarea" value="{{item.content}}" placeholder="抽中后展示的内容" data-index="{{ri}}" data-field="content" bindinput="updateRandomItem" />
          </view>
          <view class="cg-adv-add" bindtap="addRandomItem" hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="plus" size="28" />添加盲盒物品</view>
        </view>
          </view>
          <view class="cg-gcfg" wx:if="{{gameSection === 'branch'}}">
        <view class="cg-adv-body">
          <view class="cg-cfg-label">起点步骤 ID</view><input class="cg-cfg-input" value="{{advanced.branch.startStepId}}" data-section="branch" data-field="startStepId" bindinput="onAdvancedField" />
          <view class="cg-adv-repeat" wx:for="{{advanced.branch.steps}}" wx:key="id" wx:for-index="si" wx:for-item="step">
            <view class="cg-adv-repeat-head"><text>步骤 {{si + 1}}</text><view class="cg-adv-del" data-index="{{si}}" bindtap="removeBranchStep" aria-role="button" aria-label="删除" hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="close-sm" size="28" /></view></view>
            <input class="cg-cfg-input" value="{{step.id}}" placeholder="步骤 ID" data-index="{{si}}" data-field="id" bindinput="updateBranchStep" />
            <input class="cg-cfg-input" value="{{step.title}}" placeholder="步骤标题" data-index="{{si}}" data-field="title" bindinput="updateBranchStep" />
            <textarea class="cg-cfg-textarea" value="{{step.body}}" placeholder="剧情正文" data-index="{{si}}" data-field="body" bindinput="updateBranchStep" />
            <view class="cg-rw-line compact"><view class="cg-rw-name">这是终点</view><cy-switch checked="{{step.terminal}}" data-index="{{si}}" bindchange="toggleBranchTerminal" /></view>
            <view wx:if="{{step.terminal}}" class="cg-outcome-fields">
              <view class="cg-cfg-label">稳定 outcomeCode</view>
              <input class="cg-cfg-input" value="{{step.outcomeCode}}" placeholder="例如 FOUND_CLOCK" data-index="{{si}}" data-field="outcomeCode" bindinput="updateBranchStep" />
              <view class="cg-cfg-label">作者可读名称</view>
              <input class="cg-cfg-input" value="{{step.outcomeLabel}}" placeholder="例如 找到钟楼" data-index="{{si}}" data-field="outcomeLabel" bindinput="updateBranchStep" />
              <view class="cg-cfg-hint">路线只读取 outcomeCode；目标地点在整个主题中绑定。</view>
            </view>
            <view wx:if="{{!step.terminal}}" class="cg-adv-options">
              <view class="cg-adv-repeat" wx:for="{{step.options}}" wx:key="id" wx:for-index="oi" wx:for-item="option">
                <view class="cg-adv-repeat-head"><text>选项 {{oi + 1}}</text><view class="cg-adv-del" data-stepindex="{{si}}" data-optionindex="{{oi}}" bindtap="removeBranchOption" aria-role="button" aria-label="删除选项" hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="close-sm" size="28" /></view></view>
                <input class="cg-cfg-input" value="{{option.id}}" placeholder="选项 ID" data-stepindex="{{si}}" data-optionindex="{{oi}}" data-field="id" bindinput="updateBranchOption" />
                <input class="cg-cfg-input" value="{{option.label}}" placeholder="选项文案" data-stepindex="{{si}}" data-optionindex="{{oi}}" data-field="label" bindinput="updateBranchOption" />
                <input class="cg-cfg-input" value="{{option.nextStepId}}" placeholder="下一步骤 ID" data-stepindex="{{si}}" data-optionindex="{{oi}}" data-field="nextStepId" bindinput="updateBranchOption" />
                <input class="cg-cfg-input" type="number" value="{{option.score}}" placeholder="得分" data-stepindex="{{si}}" data-optionindex="{{oi}}" data-field="score" data-numeric="1" bindinput="updateBranchOption" />
              </view>
              <view class="cg-adv-add" data-index="{{si}}" bindtap="addBranchOption" hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="plus" size="28" />添加选项</view>
            </view>
          </view>
          <view class="cg-adv-add" bindtap="addBranchStep" hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="plus" size="28" />添加剧情步骤</view>
        </view>
      </view>

          <view class="cg-gcfg" wx:if="{{gameSection === 'steps'}}">
        <view class="cg-adv-body">
          <view class="cg-cfg-label">目标步数</view>
          <input class="cg-cfg-input" type="number" value="{{advanced.steps.goal}}" placeholder="100 至 100000" data-section="steps" data-field="goal" data-numeric="1" bindinput="onAdvancedField" />
          <view class="cg-cfg-label">眉标</view>
          <input class="cg-cfg-input" value="{{advanced.steps.eyebrow}}" placeholder="例如 低碳行动 · 今日步数" data-section="steps" data-field="eyebrow" bindinput="onAdvancedField" />

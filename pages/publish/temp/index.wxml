        </view>
      </view>

      <view class="cg-gcfg cg-adv-section" wx:if="{{advanced.multiplayer.enabled}}">
        <view class="cg-rw-line"><view class="cg-rw-meta"><view class="cg-rw-name">多人协作</view><view class="cg-rw-sub">按角色和轮次共同完成任务</view></view><cy-switch checked="{{advanced.multiplayer.enabled}}" data-key="multiplayer" bindchange="onAdvancedToggle" /></view>
        <view class="cg-adv-body" wx:if="{{advanced.multiplayer.enabled}}">
          <view class="cg-adv-grid">
            <cy-dropdown portal="{{false}}" range="{{multiplayerModeOptions}}" data-section="multiplayer" data-field="mode" data-options="multiplayerModeOptions" bind:change="onAdvancedPicker"><view class="cg-pick">{{advanced.multiplayer.mode}}<view class="cg-caret"><cy-icon name="back" size="28" /></view></view></cy-dropdown>
            <cy-dropdown portal="{{false}}" range="{{multiplayerAssignmentOptions}}" data-section="multiplayer" data-field="assignment" data-options="multiplayerAssignmentOptions" bind:change="onAdvancedPicker"><view class="cg-pick">{{advanced.multiplayer.assignment}}<view class="cg-caret"><cy-icon name="back" size="28" /></view></view></cy-dropdown>
            <input class="cg-cfg-input" type="number" value="{{advanced.multiplayer.minPlayers}}" placeholder="最少人数" data-section="multiplayer" data-field="minPlayers" data-numeric="1" bindinput="onAdvancedField" />
            <input class="cg-cfg-input" type="number" value="{{advanced.multiplayer.maxPlayers}}" placeholder="最多人数" data-section="multiplayer" data-field="maxPlayers" data-numeric="1" bindinput="onAdvancedField" />
            <input class="cg-cfg-input" type="number" value="{{advanced.multiplayer.requiredTurns}}" placeholder="完成轮数" data-section="multiplayer" data-field="requiredTurns" data-numeric="1" bindinput="onAdvancedField" />
            <input class="cg-cfg-input" type="number" value="{{advanced.multiplayer.unitScore}}" placeholder="每轮得分" data-section="multiplayer" data-field="unitScore" data-numeric="1" bindinput="onAdvancedField" />

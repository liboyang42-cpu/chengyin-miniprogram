           不是一个「选一种玩法」的单选。段名与服务端 AdvancedGameConfigValidator 一一对应。 -->

      <view class="cg-gcfg cg-adv-section" wx:if="{{advanced.timeWindow.enabled}}">
        <view class="cg-rw-line"><view class="cg-rw-meta"><view class="cg-rw-name">时段限定</view><view class="cg-rw-sub">只在开放时段内允许开局，以活动统一时间为准</view></view><cy-switch checked="{{advanced.timeWindow.enabled}}" data-key="timeWindow" bindchange="onAdvancedToggle" /></view>
        <view class="cg-adv-body" wx:if="{{advanced.timeWindow.enabled}}">
          <view class="cg-adv-grid">
            <view><view class="cg-cfg-label">开放起</view><input class="cg-cfg-input" value="{{advanced.timeWindow.openFrom}}" placeholder="23:00" data-section="timeWindow" data-field="openFrom" bindinput="onAdvancedField" /></view>
            <view><view class="cg-cfg-label">开放止</view><input class="cg-cfg-input" value="{{advanced.timeWindow.openTo}}" placeholder="01:00" data-section="timeWindow" data-field="openTo" bindinput="onAdvancedField" /></view>
          </view>
          <view class="cg-cfg-hint">24 小时制 HH:mm。跨夜是合法的（23:00–01:00 表示深夜时段），起止不能相同。</view>

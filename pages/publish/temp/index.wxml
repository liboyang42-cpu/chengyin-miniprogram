            <view><view class="cg-cfg-label">允许误差（毫秒）</view><input class="cg-cfg-input" type="number" value="{{advanced.stopwatch.toleranceMs}}" placeholder="50 至 5000" data-section="stopwatch" data-field="toleranceMs" data-numeric="1" bindinput="onAdvancedField" /></view>

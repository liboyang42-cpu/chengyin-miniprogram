      <view class="cg-gcfg cg-adv-section" wx:if="{{relaxOptions.length}}">
        <view class="cg-rw-line"><view class="cg-rw-meta"><view class="cg-rw-name">状态不好时松一点</view><view class="cg-rw-sub">只对血量低的玩家生效</view></view><cy-switch checked="{{relaxIndex >= 0}}" bindchange="toggleRelax" /></view>
        <cy-dropdown portal="{{false}}" wx:if="{{relaxIndex >= 0}}" class="cg-adv-reveal" range="{{relaxOptions}}" range-key="label" value="{{relaxIndex}}" bind:change="onRelaxPick"><view class="cg-pick">{{relaxOptions[relaxIndex].label}}<view class="cg-caret"><cy-icon name="back" size="28" /></view></view></cy-dropdown>
      </view>

      <view class="cg-gcfg cg-adv-section" wx:if="{{advanced.leaderboard.enabled}}">
        <view class="cg-rw-line"><view class="cg-rw-meta"><view class="cg-rw-name">排行榜</view><view class="cg-rw-sub">按时间、得分或完成轮数排名</view></view><cy-switch checked="{{advanced.leaderboard.enabled}}" data-key="leaderboard" bindchange="onAdvancedToggle" /></view>

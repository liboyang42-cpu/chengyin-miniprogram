.b3{ position:relative; width:100vw; height:100vh; background:#0A0A0B; color:#F8F8F8; display:flex; flex-direction:column; } /* ds-ok Figma 实测(用户裁决字面值) */
.b3__head{ display:flex; align-items:center; justify-content:space-between; padding-left:23rpx; padding-right:23rpx; }
.b3__back{ width:88rpx; height:88rpx; display:flex; align-items:center; justify-content:center; color:#F8F8F8; } /* ds-ok Figma 实测(用户裁决字面值) */
.b3__back--ghost{ pointer-events:none; opacity:0; }
.b3__title{ font-size:46rpx; font-weight:700; } /* ds-ok Figma 实测(用户裁决字面值) */
.b3__stage{ position:relative; flex:1; min-height:0; } /* ds-ok Figma 实测(用户裁决字面值) */
.b3__xr{ position:absolute; inset:0; display:block; width:100%; height:100%; opacity:1; transition:opacity var(--cy-motion-standard) var(--cy-ease-out); } /* ds-ok Figma 实测(用户裁决字面值) */
.b3__xr--loading{ opacity:0; pointer-events:none; }
.b3__fallback{ position:absolute; inset:0; width:100%; height:100%; } /* ds-ok Figma 实测(用户裁决字面值) */
.b3__name{ text-align:center; font-size:34rpx; font-weight:700; } /* ds-ok Figma 实测(用户裁决字面值) */
.b3__sub{ margin-top:10rpx; text-align:center; font-size:23rpx; color:#919191; } /* ds-ok Figma 实测(用户裁决字面值) */
.b3__hint{ margin:23rpx 0 calc(46rpx + env(safe-area-inset-bottom)); text-align:center; font-size:23rpx; color:#6A7282; } /* ds-ok Figma 实测(用户裁决字面值) */


/* glow 样式:与勋章墙同族的发光观感(单枚特写,CSS 层) */
.b3__glow{ position:relative; width:100%; height:100%; display:flex; align-items:center; justify-content:center; }
.b3__glow-core{ width:340rpx; height:340rpx; border-radius:50%; display:flex; align-items:center; justify-content:center;
  background:radial-gradient(circle at 50% 42%, #22242C, #0A0A0B 72%); /* ds-ok Figma 实测(用户裁决字面值) */
  box-shadow:0 0 60rpx rgba(120,160,255,.45), 0 0 140rpx rgba(120,160,255,.18), inset 0 0 40rpx rgba(255,255,255,.06); } /* ds-ok Figma 实测(用户裁决字面值) */
.b3__glow-core image{ width:64%; height:64%; }
.b3__glow-ring{ position:absolute; border-radius:50%; border:2rpx solid rgba(140,170,255,.35); } /* ds-ok Figma 实测(用户裁决字面值) */
.b3__glow-ring--1{ width:460rpx; height:460rpx; box-shadow:0 0 40rpx rgba(120,160,255,.25); } /* ds-ok Figma 实测(用户裁决字面值) */
.b3__glow-ring--2{ width:600rpx; height:600rpx; border-color:rgba(140,170,255,.16); } /* ds-ok Figma 实测(用户裁决字面值) */

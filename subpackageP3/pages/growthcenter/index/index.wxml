<view class="theme-dark">
  <cy-toast id="cy-toast" />
  <cy-loading-mask id="cy-loading" />
  <cy-modal-host id="cy-modal-host" />
<view class="gc-page">
  <cy-nav-bar />
  <cy-page-title title="成长中心" subtitle="城市探索 · 成就与排行榜" />

  <!-- 第一层：积分与本人名次。只用中性色面，不再把分数做成彩色仪表。 -->
  <view class="gc-score-card">
    <text class="gc-score-kicker">当前积分</text>
    <cy-skeleton wx:if="{{rankState === 'loading' && !me}}" type="amount" count="{{1}}" />
    <block wx:else>
      <view class="gc-score-line">
        <text class="gc-score-value">{{me ? me.scoreText : '0'}}</text>
        <text class="gc-score-unit">{{unit}}</text>
      </view>
      <cy-progress-status wx:if="{{rankState === 'refreshing'}}" class="gc-rank-inline"
        title="正在更新我的排名" sub="现有排名仍可查看" />
      <view wx:elif="{{errorMsg && !me}}" class="gc-state gc-state--error">
        <cy-inline-error kind="{{rankErrorKind}}"
          title="{{boardState === 'permission' ? '当前无法查看排行榜' : '排行榜没有加载出来'}}"
          sub="{{errorMsg}}" action="重试" bind:action="retryRank" />
      </view>
    </block>
    <view wx:if="{{me}}" class="gc-score-rank" bindtap="goLeaderboard" aria-role="button" aria-label="查看完整排行榜"
      hover-class="gc-row--press" hover-stay-time="80">
      <view class="gc-score-person">
        <image wx:if="{{me.avatarUrl}}" class="gc-score-avatar" src="{{me.avatarUrl}}" mode="aspectFill" />
        <view wx:else class="gc-score-avatar gc-score-avatar--text">{{me.initial}}</view>
        <view class="gc-score-rank-copy">
          <text>{{me.name}}</text>
          <text>总榜第 {{ me.rank || 0 }} 名</text>
        </view>
      </view>
      <view class="gc-score-link"><text>查看榜单</text><cy-icon name="arrow-right" size="28" /></view>
    </view>
    <cy-empty wx:elif="{{rankLoaded}}" title="暂无排名" />
  </view>

  <!-- 第二层：四项足迹指标。 -->
  <view class="gc-section">
    <view class="gc-section-head">
      <text class="gc-section-title">我的足迹</text>
      <text class="gc-section-meta">{{overview.levelText}}</text>
    </view>
    <cy-skeleton wx:if="{{overviewState === 'loading' && !overviewLoaded}}" type="list" count="{{4}}" />
    <block wx:else>
      <cy-progress-status wx:if="{{overviewState === 'refreshing'}}" class="gc-overview-inline"
        title="正在更新足迹" sub="现有数据仍可查看" />
      <cy-inline-error wx:elif="{{overviewError}}" class="gc-overview-inline"
        kind="{{overviewErrorKind}}" title="{{overviewState === 'partial' ? '部分足迹暂不可用' : '足迹没有更新'}}"
        sub="{{overviewError}}" action="重试" bind:action="loadOverview" />
    <view class="gc-metric-list" aria-role="list" aria-label="我的城市足迹">
      <view class="gc-metric-row" wx:for="{{overview.stats}}" wx:key="key" aria-role="listitem">
        <text class="gc-metric-label">{{item.label}}</text>
        <view class="gc-metric-value"><text>{{item.value}}</text><text>{{item.unit}}</text></view>
      </view>
    </view>
    </block>
  </view>

  <!-- 第三层：中性徽章列表；点按只展开真实获得时刻。 -->
  <view class="gc-section gc-badge-sec">
    <view class="gc-section-head">
      <text class="gc-section-title">我的徽章</text>
      <text class="gc-section-meta">{{badgeCountText}}</text>
    </view>

    <cy-skeleton wx:if="{{overviewState === 'loading' && !overviewLoaded}}" type="list" count="{{2}}" />
    <block wx:else>
      <view wx:if="{{badgeLoadError}}" class="gc-badge-state">
        <text class="gc-badge-state-copy">{{showBadges ? '徽章数据暂时不可用，已保留上次成功内容' : '徽章数据暂时不可用'}}</text>
        <view class="gc-badge-state-retry" bindtap="loadOverview" aria-role="button" aria-label="重试徽章数据"
          hover-class="gc-row--press" hover-stay-time="80">重试</view>
      </view>

    <view wx:if="{{showBadges}}" class="gc-badge-list" aria-role="list" aria-label="我的徽章">
      <view class="gc-badge-row {{expandedBadge === item.code ? 'is-open' : ''}}" wx:for="{{badges}}" wx:key="name"
        data-code="{{item.code}}" bindtap="onBadgeTap" aria-role="button" aria-label="{{item.name}}，查看获得时刻"
        hover-class="gc-row--press" hover-stay-time="80">
        <view class="gc-badge-disc">
          <image wx:if="{{item.iconUrl}}" class="gc-badge-icon" src="{{item.iconUrl}}" mode="aspectFit" />
          <text wx:else>{{item.initial}}</text>
        </view>
        <view class="gc-badge-copy">
          <text class="gc-badge-name">{{item.name}}</text>
          <text class="gc-badge-moment" wx:if="{{expandedBadge === item.code && item.unlockText}}">获得于 {{item.unlockText}}</text>
          <text class="gc-badge-moment" wx:elif="{{expandedBadge === item.code}}">获得时间未记录</text>
          <text class="gc-badge-hint" wx:else>查看获得时刻</text>
        </view>
        <text class="gc-badge-arrow">{{expandedBadge === item.code ? '收起' : '查看'}}</text>
      </view>
    </view>

    <cy-empty wx:if="{{showBadgeEmpty}}" kind="empty" size="lg" title="还没有点亮任何徽章"
      sub="继续探索城市，第一枚徽章会在这里出现" cta="去探索" bind:cta="goExplore" />
    </block>
  </view>

  <view wx:if="{{badgeAnnouncement}}" class="gc-sr-status" aria-role="status" aria-live="polite">{{badgeAnnouncement}}</view>
  <cy-celebrate event-key="{{celebrationEvent}}" />
</view>
</view>

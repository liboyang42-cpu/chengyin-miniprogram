page { background: var(--cy-bg-page); }

.gc-page {
  min-height: 100vh;
  background: var(--cy-bg-page);
  padding-bottom: var(--cy-space-5);
  font-family: -apple-system, 'PingFang SC', 'Noto Sans SC', sans-serif;
}

.gc-state { padding: var(--cy-space-7) 0; text-align: center; color: var(--cy-text-secondary); font-size: var(--cy-font-body); }
.gc-state.gc-state--error { color: var(--cy-danger); }
.gc-rank-inline,
.gc-overview-inline { display: block; margin-top: var(--cy-space-3); }
.gc-row--press { opacity: .72; }
.gc-sr-status {
  position: fixed;
  width: 1px;
  height: 1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
}

.gc-rank-avatar { width: var(--cy-space-7); height: var(--cy-space-7); border-radius: 50%; flex: none; display: flex; align-items: center; justify-content: center; color: #fff; font-weight: 800; font-size: var(--cy-font-subtitle); overflow: hidden; position: relative; } /* ds-ok: 头像渐变底上的姓名缩写,同 .gc-badge-disc 既有模式 */
.gc-badge-state { display: flex; align-items: center; justify-content: space-between; gap: var(--cy-space-3); padding: var(--cy-space-3); border: 1rpx solid var(--cy-border-card); border-radius: var(--cy-radius-lg); background: var(--cy-bg-card-2); }
.gc-badge-state-copy { flex: 1; min-width: 0; font-size: var(--cy-font-label); color: var(--cy-text-secondary); }
.gc-badge-state-retry { display: flex; align-items: center; justify-content: center; flex: none; min-height: 88rpx; padding: 0 var(--cy-space-3); border: 1rpx solid var(--cy-border-card); border-radius: var(--cy-radius-pill); color: var(--cy-text-title); font-size: var(--cy-font-label); }
.gc-badge-disc { width: var(--cy-space-7); height: var(--cy-space-7); border-radius: var(--cy-radius-md); display: flex; align-items: center; justify-content: center; font-size: var(--cy-font-title); font-weight: 800; color: var(--cy-color-text-primary); overflow: hidden; background: var(--cy-color-bg-surface-subtle); border: 1rpx solid var(--cy-color-border-strong); flex: none; }
.gc-badge-icon { width: 76rpx; height: 76rpx; border-radius: 50%; }

.gc-badge-empty { display: flex; flex-direction: column; align-items: center; gap: var(--cy-space-3-5); padding: 56rpx 32rpx; border-radius: 40rpx; background: rgba(255,255,255,0.03); border: 2rpx dashed rgba(255,255,255,0.12); } /* ds-ok */
.gc-lock { position: relative; width: 32rpx; height: var(--cy-legacy-26); border-radius: 6rpx; background: rgba(255,255,255,0.22); } /* ds-ok */
.gc-lock-arc { position: absolute; top: -16rpx; left: 50%; transform: translateX(-50%); width: var(--cy-legacy-22); height: var(--cy-space-2-5); border: 5rpx solid rgba(255,255,255,0.22); border-bottom: none; border-radius: 12rpx 12rpx 0 0; } /* ds-ok */
.gc-be-btn { padding: var(--cy-legacy-18) 44rpx; border-radius: 999rpx; background: linear-gradient(135deg,#F5C542,#F2A01E); color: #000; font-weight: 700; font-size: var(--cy-font-label); } /* ds-ok */

/* B68：黑白灰成长信息层；上面的历史例外行按批次纪律保持原样。 */
.gc-score-card {
  margin: 0 var(--cy-page-x);
  padding: var(--cy-space-4);
  border: 1rpx solid var(--cy-color-border-subtle);
  border-radius: var(--cy-radius-lg);
  background: var(--cy-color-bg-surface);
}
.gc-score-kicker { display: block; color: var(--cy-color-text-tertiary); font-size: var(--cy-type-label); }
.gc-score-line { display: flex; align-items: baseline; gap: var(--cy-space-2); margin-top: var(--cy-space-2); }
.gc-score-value { font-size: var(--cy-type-data-xl); line-height: 1; font-weight: 750; color: var(--cy-color-text-primary); font-variant-numeric: tabular-nums; }
.gc-score-unit { color: var(--cy-color-text-secondary); font-size: var(--cy-type-label); }
.gc-score-rank { display: flex; align-items: center; justify-content: space-between; gap: var(--cy-space-3); margin-top: var(--cy-space-4); padding-top: var(--cy-space-3); border-top: 1rpx solid var(--cy-color-border-subtle); }
.gc-score-person { display: flex; align-items: center; gap: var(--cy-space-2); min-width: 0; }
.gc-score-avatar { width: var(--cy-space-6); height: var(--cy-space-6); border-radius: var(--cy-radius-pill); flex: none; }
.gc-score-avatar--text { display: flex; align-items: center; justify-content: center; background: var(--cy-color-bg-surface-subtle); color: var(--cy-color-text-primary); font-weight: 700; }
.gc-score-rank-copy { display: flex; min-width: 0; flex-direction: column; gap: var(--cy-space-1); color: var(--cy-color-text-primary); font-size: var(--cy-type-label); }
.gc-score-rank-copy text + text { color: var(--cy-color-text-tertiary); font-size: var(--cy-type-caption); }
.gc-score-link { display: flex; align-items: center; gap: var(--cy-space-1); flex: none; color: var(--cy-color-text-secondary); font-size: var(--cy-type-label); }
.gc-score-card .gc-state { padding: var(--cy-space-4) 0 0; text-align: left; }

.gc-section { margin: var(--cy-space-5) var(--cy-page-x) 0; }
.gc-section-head { display: flex; align-items: baseline; justify-content: space-between; gap: var(--cy-space-3); margin-bottom: var(--cy-space-2); }
.gc-section-title { color: var(--cy-color-text-primary); font-size: var(--cy-type-section-title); font-weight: 700; }
.gc-section-meta { color: var(--cy-color-text-tertiary); font-size: var(--cy-type-label); }
.gc-metric-list { overflow: hidden; border: 1rpx solid var(--cy-color-border-subtle); border-radius: var(--cy-radius-lg); background: var(--cy-color-bg-surface); }
.gc-metric-row { display: flex; align-items: baseline; justify-content: space-between; gap: var(--cy-space-3); min-height: var(--cy-comp-cell-min-h); padding: 0 var(--cy-space-3); }
.gc-metric-row + .gc-metric-row { border-top: 1rpx solid var(--cy-color-border-subtle); }
.gc-metric-label { color: var(--cy-color-text-secondary); font-size: var(--cy-type-label); }
.gc-metric-value { display: flex; align-items: baseline; gap: var(--cy-space-1); color: var(--cy-color-text-primary); font-size: var(--cy-type-card-title); font-weight: 700; font-variant-numeric: tabular-nums; }
.gc-metric-value text + text { color: var(--cy-color-text-tertiary); font-size: var(--cy-type-caption); font-weight: 500; }

.gc-badge-sec { padding: 0 0 calc(var(--cy-space-5) + var(--cy-safe-bottom)); }
.gc-badge-list { overflow: hidden; border: 1rpx solid var(--cy-color-border-subtle); border-radius: var(--cy-radius-lg); background: var(--cy-color-bg-surface); }
.gc-badge-row { display: flex; align-items: center; gap: var(--cy-space-3); min-height: calc(var(--cy-space-8) + var(--cy-space-3)); padding: var(--cy-space-3); box-sizing: border-box; }
.gc-badge-row + .gc-badge-row { border-top: 1rpx solid var(--cy-color-border-subtle); }
.gc-badge-copy { display: flex; flex: 1; min-width: 0; flex-direction: column; gap: var(--cy-space-1); }
.gc-badge-row .gc-badge-name { min-width: 0; max-width: none; overflow: hidden; color: var(--cy-color-text-primary); font-size: var(--cy-type-card-title); font-weight: 600; text-align: left; text-overflow: ellipsis; white-space: nowrap; }
.gc-badge-hint,
.gc-badge-row .gc-badge-moment { margin: 0; color: var(--cy-color-text-tertiary); font-size: var(--cy-type-caption); }
.gc-badge-arrow { flex: none; color: var(--cy-color-text-secondary); font-size: var(--cy-type-label); }

:host { display: block; }
.ss {
  position: fixed;
  inset: 0;
  z-index: var(--cy-z-sheet);
  display: flex;
  align-items: flex-end;
  font-family: -apple-system, BlinkMacSystemFont, "Inter", "PingFang SC", sans-serif;
  color: var(--cy-sheet-text-primary);
}
.ss__mask {
  position: absolute;
  inset: 0;
  background: var(--cy-sheet-overlay);
}
/* 不参与视觉的结构容器。
   ⚠️ 不许在这条链路上加 max-width 或横向 margin。这里曾挂过 max-width: 392.975px
   (iPhone 14 画板宽,当时是个 token),面板自己 width:100% 于是跟着被夹住,而 .ss 是
   flex + justify-content 默认 flex-start ⇒ 整叠卡靠左,屏宽 >393px 的机器右侧露出底层页
   (430px 露 37px,440px 露 47px)。390px 及以下不触发,所以模拟器和历史截图全绿、
   只有真机报。该 token 已连同本条一起删除。 */
.ss__stack {
  position: relative;
  z-index: 1;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: stretch;
}

.ss__panel {
  position: relative;
  z-index: 1;
  /* 稿上是 392.975px(iPhone 14 画板绝对宽),但那是画板宽不是面板约束:面板本就该满宽。 */
  width: 100%;
  /* 任何档位的面板都不许越过胶囊 —— 见 --cy-comp-sheet-max-height 的算式 */
  max-height: var(--cy-comp-sheet-max-height);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  overflow: hidden;
  background: var(--cy-sheet-bg);
  border-top: var(--cy-comp-sheet-border-width) solid var(--cy-sheet-border);
  border-right: var(--cy-comp-sheet-border-width) solid var(--cy-sheet-border);
  border-left: var(--cy-comp-sheet-border-width) solid var(--cy-sheet-border);
  backdrop-filter: blur(var(--cy-comp-sheet-blur, 24rpx));
  -webkit-backdrop-filter: blur(var(--cy-comp-sheet-blur, 24rpx));
  border-radius: var(--cy-comp-sheet-radius) var(--cy-comp-sheet-radius) 0 0;
  box-shadow: var(--cy-sheet-inset-shadow);
  animation: ss-up var(--cy-motion-standard) var(--cy-ease-out);
}
.ss--full .ss__panel {
  height: var(--cy-comp-sheet-full-height);
}
/* T1 底部弹窗(Brand Handbook 弹层四型):一次选择、短表单、一段说明,≤70vh。
   2026-09-02 合并掉 .ss--peek —— 它与 half 的 min-height 完全相同、只有上限差 12vh,
   内容不够长时两档渲染结果像素级相同;而 min-height:42vh 会把短内容强行撑高,
   一句话的说明也占掉近半屏。两个毛病一起治:删下限、并成一档。 */
.ss--half .ss__panel {
  max-height: 70vh;
}
.ss--player {
  /* 玩家记录/明细卡以 scene-roam-history 的 .hs-card 为单一真源。 */
  --cy-scene-card-bg: var(--cy-comp-sheet-player-history-card);
  --cy-scene-card-radius: var(--cy-comp-sheet-history-card-radius);
  --cy-scene-card-pad-y: var(--cy-space-3-5);
  --cy-scene-card-pad-x: var(--cy-space-4);
  --cy-scene-card-gap: var(--cy-space-2-5);
  --cy-scene-card-border: transparent;
  --cy-scene-card-shadow: none;
  --cy-scene-card-inner-bg: var(--cy-comp-sheet-player-history-metric);
  --cy-scene-content-bg: transparent;
  --cy-sheet-bg: var(--cy-comp-sheet-player-glass);
  --cy-sheet-border: var(--cy-comp-sheet-player-border);
  --cy-sheet-overlay: var(--cy-comp-sheet-player-overlay);
  --cy-sheet-text-primary: var(--cy-comp-sheet-player-text);
  --cy-sheet-text-secondary: var(--cy-comp-sheet-player-text-secondary);
  --cy-sheet-close-bg: var(--cy-comp-sheet-player-close-bg);
  --cy-sheet-close-fg: var(--cy-comp-sheet-player-close-fg);
  --cy-sheet-inset-shadow: var(--cy-comp-sheet-player-inset-shadow);
  --cy-color-bg-page: var(--cy-comp-sheet-player-page);
  --cy-color-bg-surface: var(--cy-comp-sheet-player-surface);
  --cy-color-bg-surface-subtle: var(--cy-comp-sheet-player-card);
  --cy-color-bg-elevated: var(--cy-comp-sheet-player-elevated);
  /* ⚠️ 2026-09-02:raised / interactive 是后加进中性阶的两档(PR #981),
     当时没同步扩展弹层的重映射 —— 于是它们会**穿透到宿主页**,而字被弹层强制成本域色。
     实测:挂在 merchant-light 宿主页上时,卡 #E6E6E6 + 字 #F8F8F8 = 1.18:1、
     控件底 #FFFFFF + 字 #F8F8F8 = 1.06:1,白字压白底完全看不见。
     弹层既然自己声明了一整套中性阶,就必须**覆盖到阶梯末端**,不能只覆盖一半。 */
  --cy-color-bg-raised: var(--cy-comp-sheet-player-raised);
  --cy-color-bg-surface-strong: var(--cy-comp-sheet-player-surface-strong);
  --cy-color-bg-interactive: var(--cy-comp-sheet-player-interactive);
  --cy-color-text-primary: var(--cy-comp-sheet-player-text);
  --cy-color-text-secondary: var(--cy-comp-sheet-player-text-secondary);
  --cy-color-text-tertiary: var(--cy-comp-sheet-player-muted);
  --cy-color-action-primary-bg: var(--cy-comp-sheet-player-text);
  --cy-color-action-primary-fg: var(--cy-comp-sheet-player-page);
  --cy-color-border-subtle: var(--cy-comp-sheet-player-divider);
  --cy-color-border-strong: var(--cy-comp-sheet-player-border-strong);
  --cy-color-action-secondary-bg: var(--cy-comp-sheet-player-action-secondary);
  --cy-color-status-success: var(--cy-comp-sheet-player-success);
  --cy-btn-solid-bg: var(--cy-comp-sheet-player-text);
  --cy-btn-solid-fg: var(--cy-comp-sheet-player-page);
  --cy-comp-sheet-bg: var(--cy-comp-sheet-player-bg);
  --cy-bg-card: var(--cy-comp-sheet-player-surface);
  --cy-bg-card-2: var(--cy-comp-sheet-player-card);
  --cy-border-card: var(--cy-comp-sheet-player-divider);
  --cy-text-title: var(--cy-comp-sheet-player-text);
  --cy-text-body: var(--cy-comp-sheet-player-text-secondary);
  --cy-text-secondary: var(--cy-comp-sheet-player-muted);
}
.ss--merchant {
  /* 用户拍板(2026-08-07 修订):弹窗双规范——玩家=深玻璃,商家=白。商家场景恢复白系。 */
  --cy-sheet-bg: var(--cy-comp-sheet-merchant-bg);
  --cy-sheet-border: var(--cy-comp-sheet-merchant-border);
  --cy-sheet-overlay: var(--cy-comp-sheet-merchant-overlay);
  --cy-sheet-text-primary: var(--cy-comp-sheet-merchant-title);
  --cy-sheet-text-secondary: var(--cy-comp-sheet-merchant-text-tertiary);
  --cy-sheet-close-bg: var(--cy-comp-sheet-merchant-close-bg);
  --cy-sheet-close-fg: var(--cy-comp-sheet-merchant-close-fg);
  --cy-sheet-inset-shadow: var(--cy-comp-sheet-merchant-inset-shadow);
  --cy-color-bg-page: var(--cy-comp-sheet-merchant-page);
  --cy-color-bg-surface: var(--cy-comp-sheet-merchant-bg);
  --cy-color-bg-surface-subtle: var(--cy-comp-sheet-merchant-surface-subtle);
  --cy-color-bg-elevated: var(--cy-comp-sheet-merchant-elevated);
  /* 同上:阶梯要覆盖到末端,否则挂在暗色宿主页上会变成暗卡配深色商家字。 */
  --cy-color-bg-raised: var(--cy-comp-sheet-merchant-raised);
  --cy-color-bg-surface-strong: var(--cy-comp-sheet-merchant-surface-strong);
  --cy-color-bg-interactive: var(--cy-comp-sheet-merchant-interactive);
  --cy-color-text-primary: var(--cy-comp-sheet-merchant-title);
  --cy-color-text-secondary: var(--cy-comp-sheet-merchant-text-secondary);
  --cy-color-text-tertiary: var(--cy-comp-sheet-merchant-text-tertiary);
  --cy-color-border-subtle: var(--cy-comp-sheet-merchant-border-subtle);
  --cy-color-border-strong: var(--cy-comp-sheet-merchant-border-strong);
  --cy-color-action-secondary-bg: var(--cy-comp-sheet-merchant-secondary);
  --cy-color-status-success: var(--cy-comp-sheet-merchant-success);
  --cy-border-card: var(--cy-comp-sheet-merchant-border);
  --cy-text-title: var(--cy-comp-sheet-merchant-title);
  --cy-text-body: var(--cy-comp-sheet-merchant-text-secondary);
  --cy-text-secondary: var(--cy-comp-sheet-merchant-text-tertiary);
  --cy-comp-sheet-bg: var(--cy-comp-sheet-merchant-bg);
}
.ss--reduced-motion .ss__panel { animation: none; }
.ss__head {
  width: 100%;
  flex: none;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: var(--cy-comp-sheet-header-pad-top) var(--cy-comp-sheet-header-pad-x) var(--cy-comp-sheet-header-pad-bottom);
}
.ss__back,
.ss__close {
  width: var(--cy-comp-sheet-close-hit-size);
  height: var(--cy-comp-sheet-close-hit-size);
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--cy-sheet-close-fg);
  font-size: var(--cy-comp-sheet-close-font-size);
  line-height: 1;
}
.ss__control {
  width: var(--cy-comp-sheet-close-size);
  height: var(--cy-comp-sheet-close-size);
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--cy-radius-pill);
  /* 2026-09-02(vault §3.21 已定 · 用户当面点名):去圆底只留字形。
     这一层本身保留 —— 它是「视觉尺寸」与「88rpx 热区」的分界:热区在外层
     .ss__back/.ss__close 上,不许靠放大这个圆来凑热区(scene-sheet-contract 有断言)。 */
  background: transparent;
}
.ss__title {
  width: auto;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: var(--cy-sheet-text-primary);
  font-size: var(--cy-comp-sheet-title-size);
  line-height: var(--cy-comp-sheet-title-leading);
  font-weight: 700;
  letter-spacing: var(--cy-comp-sheet-title-tracking);
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ss__body {
  width: 100%;
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  box-sizing: border-box;
  padding: 0 var(--cy-comp-sheet-body-pad-x) calc(48rpx + env(safe-area-inset-bottom));
}
.ss__footer {
  width: 100%;
  flex: none;
  padding: 32rpx var(--cy-comp-sheet-body-pad-x) calc(32rpx + env(safe-area-inset-bottom));
  background: var(--cy-sheet-bg);
}
@keyframes ss-up { from { transform: translateY(100%); } to { transform: translateY(0); } }

/* isolated 组件内全局 .cy-pressed 进不来,必须本地定义一份。
   只减淡不位移:位移要配 .cy-motion-reduced 兜底,而那个类挂在组件外的祖先上,
   isolated 下同样够不着 —— 与其留个撤不掉的位移,不如按仓库既有组件按压类的做法只减淡。 */
.cy-pressed { opacity: .88; }

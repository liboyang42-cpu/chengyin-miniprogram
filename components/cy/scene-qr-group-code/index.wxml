<view class="group-code-body">
  <view wx:if="{{state === 'selecting'}}" class="group-picker">
    <cy-page-title title="{{pickerTitle}}" subtitle="{{pickerSubtitle}}" safe-top="{{false}}" />
    <text class="group-picker__hint">团码只登记当前场次，不能跨场次使用</text>
    <view wx:for="{{options}}" wx:key="id" class="group-picker__item" bindtap="chooseActivity" data-id="{{item.id}}" aria-role="button" aria-label="选择{{item.name}}" hover-class="cy-pressed" hover-stay-time="80"><text>{{item.name}}</text><cy-icon name="arrow-right" size="28" /></view>
  </view>
  <cy-empty wx:elif="{{state === 'empty'}}" fill size="lg" kind="empty" title="暂无可带队的场次" sub="当前路线还没有开放报名的场次，开放后会显示在这里" cta="返回" bind:cta="close" />
  <cy-empty wx:elif="{{state === 'missing'}}" fill size="lg" kind="missing-param" title="团核销码打不开" sub="{{errorText}}" cta="返回" bind:cta="close" />
  <cy-error wx:elif="{{state === 'error'}}" fill size="lg" title="团核销码暂时打不开" sub="{{errorText}}" retry="重试" bind:retry="retry" />
  <cy-qr-voucher wx:else embedded="{{true}}" show="{{true}}" state="{{state === 'ready' ? 'ready' : state === 'error' ? 'error' : 'loading'}}" qr="{{qr}}" code="{{code}}" title="{{title}} · 团核销码" desc="仅限本场次合作商家扫码，登记本团接待" countdown="{{state === 'ready' ? countdown + 's 后自动刷新' : ''}}" error-text="{{errorText || '团码暂时没能生成，请稍后重试'}}" mask-closable="{{false}}" bind:close="close" bind:retry="retry" />
</view>

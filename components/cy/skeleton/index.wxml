<!-- 首页/广场 Feed:封面、标题、摘要和标签位与最终卡片同构。 -->
<view wx:if="{{type === 'feed-card'}}" class="sk sk-feed {{reducedMotion ? 'sk--static' : ''}}"
      aria-role="status" aria-live="polite" aria-label="{{loadingLabel}}">
  <view class="sk-feed-card" wx:for="{{items}}" wx:key="index">
    <view class="sk-bar sk-feed-cover"></view>
    <view class="sk-feed-copy">
      <view class="sk-bar sk-line sk-w70"></view>
      <view class="sk-bar sk-line"></view>
      <view class="sk-bar sk-line sk-w85"></view>
      <view class="sk-feed-meta">
        <view class="sk-bar sk-chip"></view>
        <view class="sk-bar sk-chip sk-chip--short"></view>
      </view>
    </view>
  </view>
</view>

<!-- 地图卡:地图画布、地点标题与两行元信息。 -->
<view wx:elif="{{type === 'map-card'}}" class="sk sk-map-list {{reducedMotion ? 'sk--static' : ''}}"
      aria-role="status" aria-live="polite" aria-label="{{loadingLabel}}">
  <view class="sk-map-card" wx:for="{{items}}" wx:key="index">
    <view class="sk-bar sk-map-canvas"></view>
    <view class="sk-map-copy">
      <view class="sk-bar sk-line sk-w60"></view>
      <view class="sk-bar sk-line sk-w40"></view>
    </view>
  </view>
</view>

<!-- 商家指标:保留标签、主数和趋势三层，加载中不渲染伪金额/伪数值。 -->
<view wx:elif="{{type === 'merchant-metric'}}" class="sk sk-metric-grid {{reducedMotion ? 'sk--static' : ''}}"
      aria-role="status" aria-live="polite" aria-label="{{loadingLabel}}">
  <view class="sk-metric-card" wx:for="{{items}}" wx:key="index">
    <view class="sk-bar sk-metric-label"></view>
    <view class="sk-bar sk-metric-value"></view>
    <view class="sk-bar sk-metric-trend"></view>
  </view>
</view>

<!-- 路线时间线:节点、连接线、标题与说明。 -->
<view wx:elif="{{type === 'route-timeline'}}" class="sk sk-route {{reducedMotion ? 'sk--static' : ''}}"
      aria-role="status" aria-live="polite" aria-label="{{loadingLabel}}">
  <view class="sk-route-row" wx:for="{{items}}" wx:key="index">
    <view class="sk-route-rail">
      <view class="sk-bar sk-route-dot"></view>
      <view class="sk-bar sk-route-line"></view>
    </view>
    <view class="sk-route-copy">
      <view class="sk-bar sk-line sk-w60"></view>
      <view class="sk-bar sk-line sk-w85"></view>
    </view>
  </view>
</view>

<!-- 表单区:字段标签和输入框同构，避免加载后整页跳位。 -->
<view wx:elif="{{type === 'form-section'}}" class="sk sk-form {{reducedMotion ? 'sk--static' : ''}}"
      aria-role="status" aria-live="polite" aria-label="{{loadingLabel}}">
  <view class="sk-form-field" wx:for="{{items}}" wx:key="index">
    <view class="sk-bar sk-form-label"></view>
    <view class="sk-bar sk-form-input"></view>
  </view>
</view>

<!-- 金额骨架:资金 hero / 余额行。只画结构，不渲染伪金额或“加载中”文案。 -->
<view wx:elif="{{type === 'amount'}}" class="sk sk-amount {{reducedMotion ? 'sk--static' : ''}}"
      aria-role="status" aria-live="polite" aria-label="{{loadingLabel}}">
  <view class="sk-bar sk-amount-label"></view>
  <view class="sk-bar sk-amount-value"></view>
</view>

<!-- 详情骨架:Hero 大图 + 标题 + 多行 -->
<view wx:elif="{{type === 'detail'}}" class="sk sk-detail {{reducedMotion ? 'sk--static' : ''}}"
      aria-role="status" aria-live="polite" aria-label="{{loadingLabel}}">
  <view class="sk-bar sk-hero"></view>
  <view class="sk-bar sk-line sk-w70"></view>
  <view class="sk-bar sk-line sk-w40"></view>
  <view class="sk-gap"></view>
  <view class="sk-bar sk-line"></view>
  <view class="sk-bar sk-line"></view>
  <view class="sk-bar sk-line sk-w85"></view>
</view>

<!-- 票券骨架:票面 + 撕线 + 票根，与票夹最终卡片同构，避免转圈结束后整块跳位。 -->
<view wx:elif="{{type === 'ticket'}}" class="sk sk-ticket-list {{reducedMotion ? 'sk--static' : ''}}"
      aria-role="status" aria-live="polite" aria-label="{{loadingLabel}}">
  <view class="sk-ticket" wx:for="{{items}}" wx:key="index">
    <view class="sk-bar sk-ticket-band"></view>
    <view class="sk-ticket-face">
      <view class="sk-bar sk-ticket-cover"></view>
      <view class="sk-ticket-copy">
        <view class="sk-bar sk-ticket-title"></view>
        <view class="sk-bar sk-ticket-time"></view>
      </view>
    </view>
    <view class="sk-ticket-stub">
      <view class="sk-bar sk-ticket-label"></view>
      <view class="sk-bar sk-ticket-action"></view>
    </view>
  </view>
</view>

<!-- 帖文鱼骨:头像 + 三条长短不一的正文线 + 媒体块 + 操作行,与 cy-post-card 同构。
     线必须长短不一 —— 等长看起来像表格不像文字。 -->
<view wx:elif="{{type === 'post-card'}}" class="sk sk-post-list {{reducedMotion ? 'sk--static' : ''}}"
      aria-role="status" aria-live="polite" aria-label="{{loadingLabel}}">
  <view class="sk-post" wx:for="{{items}}" wx:key="index">
    <view class="sk-bar sk-post-avatar"></view>
    <view class="sk-post-main">
      <view class="sk-bar sk-post-line sk-post-l1"></view>
      <view class="sk-bar sk-post-line sk-post-l2"></view>
      <view class="sk-bar sk-post-line sk-post-l3"></view>
      <view class="sk-bar sk-post-media"></view>
      <view class="sk-post-acts">
        <view class="sk-bar sk-post-act"></view>
        <view class="sk-bar sk-post-act"></view>
        <view class="sk-bar sk-post-act"></view>
      </view>
    </view>
  </view>
</view>

<!-- 卡片骨架:图 + 标题 + 元信息 -->
<view wx:elif="{{type === 'card'}}" class="sk {{reducedMotion ? 'sk--static' : ''}}"
      aria-role="status" aria-live="polite" aria-label="{{loadingLabel}}">
  <view class="sk-card" wx:for="{{items}}" wx:key="index">
    <view class="sk-bar sk-cover"></view>
    <view class="sk-bar sk-line sk-w60"></view>
    <view class="sk-bar sk-line sk-w35"></view>
  </view>
</view>

<!-- 列表骨架:头像 + 两行 -->
<view wx:else class="sk {{reducedMotion ? 'sk--static' : ''}}"
      aria-role="status" aria-live="polite" aria-label="{{loadingLabel}}">
  <view class="sk-row" wx:for="{{items}}" wx:key="index">
    <view class="sk-bar sk-avatar"></view>
    <view class="sk-row-main">
      <view class="sk-bar sk-line sk-w50"></view>
      <view class="sk-bar sk-line sk-w80"></view>
    </view>
  </view>
</view>

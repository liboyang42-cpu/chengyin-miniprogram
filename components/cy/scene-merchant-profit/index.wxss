/* 分润明细样式沿用原页面;去掉页面 chrome(nav-bar / page-title,顶部交给 scene-sheet)。
   面板底色由 .ss__panel 出,这里不重刷。 */
:host { display: block; height: 100%; min-height: 0; }
.mp { width: 100%; height: 100%; min-height: 0; box-sizing: border-box; }
@import '../../../style/merchant-light.wxss';

/* display:flex;flex-direction:column 让 cy-empty/cy-error 的 fill 变体真能吃满剩余空间
   (标题下方到屏幕底部这段),不是只退化成 min-height:60vh 的兜底 */
.mp { display: flex; flex-direction: column; background: var(--cy-bg-page); padding: 0 var(--cy-page-x) var(--cy-space-5); box-sizing: border-box; }
.err-wrap { flex: 1; display: flex; flex-direction: column; }

.stat-grid {
  display: block;
  width: 100%;
  min-width: 0;
  margin: 0 0 var(--cy-space-3);
  --cy-radius-md: var(--cy-radius-lg);
  --cy-color-border-subtle: transparent;
}
.withdraw-entry { margin-bottom: var(--cy-space-5); text-align: center; }
.withdraw-reason { display: block; margin-top: var(--cy-space-2); color: var(--cy-text-secondary); font-size: var(--cy-font-caption); }

.sec-title { margin: var(--cy-space-3-5) 0 var(--cy-space-2); }   /* 排版走 .cy-h2;.mp 已有横向 padding,此处不再叠加 */

/* 主题只显示可扫描摘要；金额分解与进度统一进入 settlement-detail。 */
.fc-list { background: transparent; }
.fc-card { min-height: var(--cy-btn-h); display: flex; align-items: center; gap: var(--cy-space-2); margin-bottom: var(--cy-space-2); padding: var(--cy-space-3); border-radius: var(--cy-radius-lg); background: var(--cy-bg-card); box-sizing: border-box; }
.fc-card:last-child { margin-bottom: 0; }
.fc-card--tap { opacity: .72; }
.fc-main { min-width: 0; flex: 1; }
.fc-top, .fc-bottom { display: flex; align-items: center; justify-content: space-between; gap: var(--cy-space-2); }
.fc-bottom { margin-top: var(--cy-space-2); }
.fc-name { min-width: 0; flex: 1; font-size: var(--cy-font-body); font-weight: 600; color: var(--cy-text-title); }
.fc-income { flex-shrink: 0; font-size: var(--cy-font-body); font-weight: 700; color: var(--cy-text-title); font-variant-numeric: tabular-nums; }
.fc-meta { min-width: 0; flex: 1; font-size: var(--cy-font-caption); color: var(--cy-text-secondary); }
.fc-state-copy { min-width: 0; flex: 1; display: flex; flex-direction: column; gap: var(--cy-space-1); }
.fc-arrived-date { font-size: var(--cy-font-caption); color: var(--cy-text-body); }
.fc-settled-badge { flex-shrink: 0; }
.fc-explainer { margin-top: var(--cy-space-3); padding: 0 var(--cy-space-1); color: var(--cy-text-secondary); font-size: var(--cy-font-caption); line-height: 1.6; }
.fc-arrow { flex-shrink: 0; color: var(--cy-text-secondary); }
.ep1 { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

/* Figma G2:结算调整的原因说明 */
.adjust-reason {
  display: block;
  margin-top: 12rpx;
  color: var(--cy-text-secondary);
  font-size: var(--cy-font-caption);
  line-height: 1.6;
}

:host { display: block; }
.npc-chat { display: flex; flex-direction: column; min-height: 680rpx; color: var(--cy-color-text-primary); }
.npc-chat__notice { display: flex; align-items: center; gap: var(--cy-space-1); padding: var(--cy-space-2) 0 var(--cy-space-3); color: var(--cy-color-text-tertiary); font-size: var(--cy-type-caption); }
.npc-chat__notice .cyi { color: var(--cy-color-text-secondary); flex: none; }
.npc-chat__messages { flex: 1; min-height: 360rpx; max-height: 56vh; padding: var(--cy-space-2) 0; box-sizing: border-box; }
.npc-chat__row { display: flex; margin-bottom: var(--cy-space-3); }
.npc-chat__row--user { justify-content: flex-end; }
.npc-chat__row--assistant { justify-content: flex-start; }
.npc-chat__bubble { max-width: 82%; padding: var(--cy-space-3) var(--cy-space-4); border-radius: var(--cy-radius-lg); font-size: var(--cy-type-body); line-height: var(--cy-leading-normal); white-space: pre-wrap; word-break: break-word; }
.npc-chat__bubble--user { color: var(--cy-color-action-primary-fg); background: var(--cy-color-action-primary-bg); }
.npc-chat__bubble--assistant { color: var(--cy-color-text-primary); background: var(--cy-color-bg-surface-subtle); border: 1rpx solid var(--cy-color-border-subtle); }
.npc-chat__thinking { align-self: flex-start; display: flex; align-items: center; gap: var(--cy-space-1); margin-bottom: var(--cy-space-3); padding: var(--cy-space-3) var(--cy-space-4); background: var(--cy-color-bg-surface-subtle); border: 1rpx solid var(--cy-color-border-subtle); border-radius: var(--cy-radius-lg); }
.npc-chat__dot { width: var(--cy-legacy-10); height: var(--cy-legacy-10); border-radius: var(--cy-radius-pill); background: var(--cy-color-text-tertiary); }
.npc-chat__empty { padding: var(--cy-space-6) var(--cy-space-4); color: var(--cy-color-text-tertiary); font-size: var(--cy-type-body); text-align: center; }
.npc-chat__composer { margin-top: var(--cy-space-2); padding: var(--cy-space-3); background: var(--cy-color-bg-surface-subtle); border: 1rpx solid var(--cy-color-border-subtle); border-radius: var(--cy-radius-lg); }
.npc-chat__input { width: 100%; min-height: 76rpx; max-height: 180rpx; color: var(--cy-color-text-primary); font-size: var(--cy-type-body); line-height: var(--cy-leading-normal); box-sizing: border-box; }
.npc-chat__placeholder { color: var(--cy-color-text-disabled); }
.npc-chat__composer-foot { display: flex; align-items: center; justify-content: space-between; margin-top: var(--cy-space-2); }
.npc-chat__count { color: var(--cy-color-text-tertiary); font-size: var(--cy-type-micro); }
.npc-chat__send { min-width: 112rpx; min-height: var(--cy-btn-h-sm); padding: 0 var(--cy-space-4); box-sizing: border-box; border-radius: var(--cy-radius-pill); display: flex; align-items: center; justify-content: center; color: var(--cy-color-action-primary-fg); background: var(--cy-color-action-primary-bg); font-size: var(--cy-type-label); font-weight: 700; }
.npc-chat__send--disabled { color: var(--cy-color-text-disabled); background: var(--cy-color-action-secondary-bg); }

/* isolated 组件内全局 .cy-pressed 进不来,必须本地定义一份。
   只减淡不位移:位移要配 .cy-motion-reduced 兜底,而那个类挂在组件外的祖先上,
   isolated 下同样够不着 —— 与其留个撤不掉的位移,不如按仓库既有组件按压类的做法只减淡。 */
.cy-pressed { opacity: .88; }

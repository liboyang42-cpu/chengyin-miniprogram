<view class="upload">
  <view wx:if="{{tipText}}" class="upload__tip">{{tipText}}</view>
  <view class="upload__grid">
    <view class="upload__item" wx:for="{{items}}" wx:key="index">
      <image class="upload__img" src="{{item.url}}" mode="aspectFill" bindtap="onPreview" aria-role="button" aria-label="预览" data-index="{{index}}"  hover-class="cy-pressed" hover-stay-time="80"/>

      <!-- uploading:进度遮罩 -->
      <view wx:if="{{item.uploading}}" class="upload__mask">
        <view class="upload__spin"></view>
      </view>
      <!-- error:保留位就地重试(§3.13 禁静默丢图) -->
      <view wx:elif="{{item.error}}" class="upload__mask upload__mask--error" catchtap="onRetry" data-index="{{index}}" hover-class="cy-pressed" hover-stay-time="80">
        <text class="upload__err-txt">上传失败</text>
        <text class="upload__retry">点此重试</text>
      </view>

      <view wx:if="{{!disabled && !item.uploading}}" class="upload__remove" catchtap="onRemove" data-index="{{index}}" aria-label="删除" hover-class="cy-pressed" hover-stay-time="80">
        <view class="upload__remove-x"><cy-icon name="close-sm" size="26" /></view>
      </view>
    </view>

    <!-- 添加位:达上限 / disabled 时隐藏 -->
    <view wx:if="{{showAdd}}" class="upload__add" bindtap="onAdd" aria-label="添加图片" hover-class="cy-pressed" hover-stay-time="80">
      <view class="upload__plus"><cy-icon name="plus" size="44" /></view>
    </view>
  </view>
</view>

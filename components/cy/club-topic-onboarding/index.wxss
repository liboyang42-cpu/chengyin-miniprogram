:host { display: block; }
.cto { width: 100%; padding-top: 12rpx; padding-bottom: 8rpx; box-sizing: border-box; }

.cto__hint {
  display: block;
  font-size: var(--cy-type-label);
  color: var(--cy-color-text-tertiary);
  line-height: 1.5;
}
.cto__summary {
  display: block;
  margin-top: 28rpx;
  font-size: var(--cy-type-label);
  font-weight: 500;
  color: var(--cy-color-text-primary);
}
.cto__progress {
  margin-top: 12rpx;
  width: 100%;
  height: 12rpx;
  border-radius: var(--cy-radius-pill);
  background: var(--cy-color-bg-interactive);
  overflow: hidden;
}
.cto__progress-fill { height: 100%; border-radius: var(--cy-radius-pill); background: var(--cy-color-text-primary); }

.cto__section-head {
  margin-top: 32rpx;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}
.cto__section-title { font-size: var(--cy-type-body); font-weight: 700; color: var(--cy-color-text-primary); }
.cto__section-meta { flex-shrink: 0; font-size: var(--cy-type-caption); color: var(--cy-color-text-tertiary); }

.cto__node {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 16rpx;
  box-sizing: border-box;
  background: var(--cy-color-bg-raised);
  border-radius: var(--cy-radius-md);
}
.cto__node--open { background: transparent; border: 1px dashed var(--cy-color-bg-interactive); }
.cto__node-seq {
  flex-shrink: 0;
  width: 52rpx;
  height: 52rpx;
  border-radius: var(--cy-radius-pill);
  border: 1px solid var(--cy-color-bg-interactive);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--cy-type-label);
  font-weight: 700;
  color: var(--cy-color-text-primary);
}
.cto__node-text { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4rpx; }
.cto__node-trail { flex-shrink: 0; display: flex; flex-direction: column; align-items: flex-end; gap: 4rpx; }
.cto__title {
  font-size: var(--cy-type-body);
  font-weight: 500;
  color: var(--cy-color-text-primary);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.cto__meta { display: block; font-size: var(--cy-type-caption); color: var(--cy-color-text-tertiary); }
.cto__status { font-size: var(--cy-type-caption); }
.cto__status--success { color: var(--cy-color-status-success); }
.cto__status--warning { color: var(--cy-color-status-warning); }

.cto__cta {
  flex-shrink: 0;
  padding: 0 24rpx;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: var(--cy-radius-pill);
  background: var(--cy-color-text-primary);
  color: var(--cy-color-text-inverse);
  font-size: var(--cy-type-label);
  font-weight: 500;
}

.cto__pool-btn {
  margin-top: 32rpx;
  width: 100%;
  box-sizing: border-box;
  height: 104rpx;
  line-height: 104rpx;
  text-align: center;
  border-radius: var(--cy-radius-pill);
  border: 1px solid var(--cy-color-bg-interactive);
  color: var(--cy-color-text-primary);
  font-size: var(--cy-type-body);
  font-weight: 500;
}

/* ===== chapter 模式 ===== */
.cto__chapter-heading {
  display: block;
  font-size: var(--cy-type-body);
  font-weight: 700;
  color: var(--cy-color-text-primary);
}
.cto__chapter-heading + .cto__hint { margin-top: 12rpx; }

.cto__chapter-card {
  margin-top: 32rpx;
  padding: 32rpx;
  box-sizing: border-box;
  background: var(--cy-color-bg-raised);
  border-radius: var(--cy-radius-lg);
}
.cto__chapter-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.cto__chapter-name { font-size: var(--cy-type-card-title); font-weight: 700; color: var(--cy-color-text-primary); }
.cto__chip {
  flex-shrink: 0;
  padding: 0 20rpx;
  height: 48rpx;
  line-height: 48rpx;
  border-radius: var(--cy-radius-pill);
  font-size: var(--cy-type-caption);
  font-weight: 500;
}
.cto__chip--success { background: var(--cy-color-status-success-soft); color: var(--cy-color-status-success); }
.cto__chip--default { background: var(--cy-color-bg-interactive); color: var(--cy-color-text-primary); }

.cto__chapter-card .cto__meta { margin-top: 12rpx; }

.cto__tags { margin-top: 20rpx; display: flex; flex-wrap: wrap; gap: 12rpx; }
.cto__tag {
  padding: 0 20rpx;
  height: 48rpx;
  line-height: 48rpx;
  border-radius: var(--cy-radius-pill);
  background: var(--cy-color-bg-interactive);
  color: var(--cy-color-text-primary);
  font-size: var(--cy-type-caption);
}

.cto__approved {
  display: block;
  margin-top: 20rpx;
  font-size: var(--cy-type-label);
  font-weight: 500;
  color: var(--cy-color-text-primary);
}

.cto__hairline { margin-top: 20rpx; width: 100%; height: 1px; background: var(--cy-color-border-subtle); }

.cto__chapter-foot { margin-top: 20rpx; display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.cto__link { font-size: var(--cy-type-label); font-weight: 500; color: var(--cy-color-text-tertiary); }
.cto__pill {
  flex-shrink: 0;
  padding: 0 24rpx;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: var(--cy-radius-pill);
  background: var(--cy-color-text-primary);
  color: var(--cy-color-text-inverse);
  font-size: var(--cy-type-label);
  font-weight: 500;
}

/* 稿上「开放招募」贴右(J3-B 158:118),父级是普通块流,给它一个右对齐的行容器 */
.cto__actions-end { margin-top: 16rpx; display: flex; justify-content: flex-end; }
.cto__outline-btn {
  display: inline-block;
  padding: 0 32rpx;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: var(--cy-radius-pill);
  border: 1px solid var(--cy-color-bg-interactive);
  color: var(--cy-color-text-primary);
  font-size: var(--cy-type-label);
  font-weight: 500;
}

.cto__footnote {
  display: block;
  margin-top: 32rpx;
  font-size: var(--cy-type-caption);
  color: var(--cy-color-text-tertiary);
  line-height: 1.5;
}

/* isolated 组件内全局 .cy-pressed 进不来,本地补一份(照 scene-club-edit 的既有做法) */
.cy-pressed { opacity: .88; }

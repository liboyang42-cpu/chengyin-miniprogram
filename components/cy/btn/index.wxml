<view class="btn btn--{{_v}} {{size ? 'btn--' + size : ''}} {{loading ? 'btn--loading' : ''}}" hover-class="{{(_v === 'disabled' || loading) ? '' : 'btn--press'}}" hover-stay-time="80" aria-role="button" aria-label="{{accessibilityLabel}}" aria-disabled="{{_v === 'disabled' || loading}}" catchtap="__onTap">
  <view wx:if="{{loading}}" class="btn__spinner"></view>
  <slot></slot>
</view>

/* 纯 CSS 固定星空(非原生组件 → position:fixed 真正生效,不随页面滚动;静止=沉静)
   暗底由 CSS 提供,杜绝白;星点用 box-shadow 随机散布,无网格 */
:host { display: block; }
.sf-root {
  position: fixed; left: 0; top: 0; bottom: 0;
  width: 100vw; height: 100vh; min-height: 100vh;
  z-index: 0; pointer-events: none;
  background: var(--cy-bg-page);
  overflow: hidden;
}
/* 星云只用灰阶层次，保持暗底上的空间感而不借色相表达状态。 */
.sf-neb {
  position: absolute; left: 0; top: 0; right: 0; bottom: 0;
  background:
    radial-gradient(52% 40% at 74% 22%, rgba(196,196,196,0.08), rgba(2,2,2,0) 70%), /* ds-ok 灰阶星云渐变停止点 */
    radial-gradient(48% 40% at 26% 72%, rgba(160,160,160,0.07), rgba(2,2,2,0) 72%), /* ds-ok 灰阶星云渐变停止点 */
    radial-gradient(40% 30% at 60% 88%, rgba(112,112,112,0.04), rgba(2,2,2,0) 74%); /* ds-ok 灰阶星云渐变停止点 */
}
.sf-stars { position: absolute; left: 0; top: 0; width: 2rpx; height: 2rpx; border-radius: 50%; will-change: transform; }
/* 明显的缓慢漂移(两层不同速=纵深)+ 亮星闪烁,星辰漂浮 */
.sf-dim { animation: sfFloatA 16s ease-in-out infinite alternate; }
.sf-bright { animation: sfFloatB 13s ease-in-out infinite alternate, sfTwinkle 2.6s ease-in-out infinite; }
.sf-root--static .sf-stars { animation: none; }
@keyframes sfFloatA { from { transform: translate3d(0,0,0); } to { transform: translate3d(24rpx,-70rpx,0); } }
@keyframes sfFloatB { from { transform: translate3d(0,0,0); } to { transform: translate3d(-30rpx,-96rpx,0); } }
@keyframes sfTwinkle { 0%,100% { opacity: 0.55; } 50% { opacity: 1; } }

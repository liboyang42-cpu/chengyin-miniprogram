.pc-xbox-time {
  margin-top: var(--cy-space-1); font-size: var(--cy-type-caption); color: var(--cy-color-text-tertiary); line-height: 1.4;
}

/* 推荐列表 */
.pc-rec { display: flex; gap: var(--cy-legacy-18); padding: var(--cy-legacy-18) var(--cy-space-3); border-bottom: 1rpx solid var(--cy-color-border-subtle); /* ds-ok: 18rpx/1rpx 无同值 token */ }
.pc-rec:last-child { border-bottom: none; }

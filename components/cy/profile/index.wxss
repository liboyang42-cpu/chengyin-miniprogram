/* 骨架屏→内容淡切:isolated 组件收不到全局 components.wxss,@import 同一份定义 */
@import '../../../style/fade-in.wxss';
:host { display: block; min-height: 100vh; }
.pc-page { min-height: 100vh; position: relative; color: var(--cy-color-text-primary); }
.pc-player {
  /* 玩家中心与 Play / Roam 共用黑白灰语义；商家视角仍由 theme-merchant 控制。 */
  --cy-color-selection: var(--cy-color-text-primary);
  --cy-color-brand: var(--cy-color-text-primary);
  --cy-color-brand-strong: var(--cy-color-text-primary);
  --cy-color-brand-soft: var(--cy-color-action-secondary-bg);
  --cy-color-status-success: var(--cy-color-text-primary);
  --cy-color-status-warning: var(--cy-color-text-primary);
  --cy-color-status-danger: var(--cy-color-text-primary);
  --cy-color-status-info: var(--cy-color-text-primary);
  --cy-brand: var(--cy-color-text-primary);
  --cy-accent-strong: var(--cy-color-text-primary);
}

/* ============================================================
 * 商家视角 —— 日间 token 真源 = style/tokens.wxss 的 .theme-light/.theme-merchant,
 * 根节点已挂 theme-merchant,本页不再手抄。原先这里是 18 行字面值副本,值已与真源分叉且
 * 停在 R1 对比度修正之前(text-secondary 与 placeholder 都是 R1 前的旧值 —— placeholder 白底实测 2.56:1)。
 *
 * 下面两段不能省,原因是实测出来的(Chrome 计算值,非推断):
 *   ② 旧名别名层与 ①'' 组件层在 page{} 上就完成了 var() 替换 —— 后代元素再覆盖 --cy-color-*,
 *   它们不跟随。所以:
 *   · 本页自己的样式全部改读 --cy-color-*,天然跟随 .theme-merchant;
 *   · 但页内读别名的组件(style/components.wxss 的 cy-tabs、cy-empty/cy-error、roleBadge)
 *     只能靠在挂主题的这个元素上把别名重声明一遍才跟得上。值一律指回真源,不写字面值,
 *     真源改了这里自动跟随 —— 这正是原来那份手抄副本做不到、于是烂掉的地方。
 *   · ①'' 组件层(--cy-comp-*)页面无权声明(DS §2.1),故 cy-card / cy-btn 在本页不可用,
 *     它们在商家视角会渲成夜间样式。详见 PR 说明。
 * ============================================================ */
.pc-merchant {
  /* 去品牌化:商家工作台不出品牌紫 —— 与 style/merchant-light.wxss §②「黑 CTA」同一约定。
     selection 的日值就是深墨(ref-ink-900),与原手抄的 --cy-brand 字面值逐字相同,零漂移。 */
  --cy-color-brand: var(--cy-color-selection);

  /* 别名 shim:只列页内组件真正读到的那些 */
  --cy-bg-page:          var(--cy-color-bg-page);
  --cy-bg-card-2:        var(--cy-color-bg-surface-subtle);
  --cy-border-card:      var(--cy-color-border-subtle);
  --cy-brand:            var(--cy-color-brand);
  --cy-text-title:       var(--cy-color-text-primary);
  --cy-text-body:        var(--cy-color-text-secondary);
  --cy-text-secondary:   var(--cy-color-text-tertiary);
  --cy-text-inverse:     var(--cy-color-text-inverse);
  --cy-btn-solid-bg:     var(--cy-color-action-primary-bg);
  --cy-btn-solid-fg:     var(--cy-color-action-primary-fg);
  /* roleBadge 读它;不跟随时会拿夜间那档亮紫压浅底 = 实测 2.73:1。日真源 brand-strong
     是 R1 专为浅底调的文字级紫(5.21:1)。这里不做去品牌化:roleBadge 是身份徽章,不是 CTA/进度。 */
  --cy-accent-strong:    var(--cy-color-brand-strong);

  background: var(--cy-color-bg-page);
}

/* 顶部封面(可上传,入口在「···」→ 更换背景 / onChangeHeroBg)。
 * 2026-08-04 用户定「和 Xbox 一样:有顶部上传图片 + 渐变」——原来 blur(52rpx)+opacity .62
 * +玩家态再叠 grayscale(1),把上传的图糊成一片黑,等于有图跟没图一样(实拍即纯黑屏)。
 * 现在只留一点点柔化保证白字可读,图本身要看得出是图。 */
/* ⚠️ 高度必须 ≤ .pc-page-fade 收到实底的位置,否则遮罩管不到的那几十 rpx 会露出裸图,
   底部又冒一条硬线(2026-08-04 二轮实拍:hero 比 fade 高 20rpx,就露出一道棕黄边)。 */
.pc-hero-bg { position: fixed; top: 0; left: 0; right: 0; height: 880rpx; z-index: 0; overflow: hidden; }
.pc-hero-bg-img { width: 110%; height: 110%; margin: -5%; filter: blur(10rpx); opacity: 0.92; transform: scale(1.02); }
/* 页面透明度渐变（对标 Xbox：Tab 上方收束为实底，非图片染色）。
 * stops 是 bg-page 同色的 alpha 阶:小程序无 color-mix(),「token 色 @ alpha」无法表达,
 * 且 token 层无渐变表达 —— 故保留字面值,末端仍收到 token 实底上。
 * 2026-08-04 用户「图片和下面纯黑纯白要有过渡,现在有一条很明显的分界线」,
 * 同日追加「只有分界线那里过渡,别把整张图都变成过渡」——两条一起约束成:
 *   · 上半段 alpha 恒 0 → 封面**保持清晰**,不做任何压暗(第一版从 26% 就起压 = 蒙住整张图,改错了);
 *   · 只在接近底边的一段做柔化,且这段要够长(≈40% 高度)、stop 够密(每档落差 ≤0.18),
 *     否则又回到「落差挤在十几个 px 里」= 人眼读成硬线(初版 .34→.70 挤在 12% 就是这么来的)。 */
.pc-page-fade {
  position: fixed; top: 0; left: 0; right: 0; height: 900rpx; z-index: 0; pointer-events: none;
  background: linear-gradient(180deg, rgba(2,1,4,0) 0%, rgba(2,1,4,0) 56%, rgba(2,1,4,0.10) 66%, rgba(2,1,4,0.26) 75%, rgba(2,1,4,0.46) 82%, rgba(2,1,4,0.66) 88%, rgba(2,1,4,0.84) 93%, rgba(2,1,4,0.95) 97%, var(--cy-color-bg-page) 100%); /* ds-ok */
}
/* 商家态同一套结构,只是收到日间白底(用户:「商家版页需要一样 只不过是白色的」)。
 * 原来 display:none 把商家的封面整块砍了,那是「白色蒙版」时代的遗留。
 * ⚠️ 白页文字是深色,压在彩色封面上会糊(2026-08-04 首轮实拍:「Lv.1 城市探索者」「连续探索」
 * 几乎读不出)。曾用 opacity:.32 把封面压成水印解决,但用户「没那么清晰」——封面清晰度优先。
 * 封面图本身不压 opacity;文字不加描边、不加底板(用户 2026-08-04 明确否掉描边)。
 * 可读性靠下面这层白纱渐变解决(2026-09-24 起首屏段抬高,见下条)。 */
/* 2026-08-20:纱色从纯白改为与页底同色(#F3F4F4=243,244,244)。原来 93%~97% 处是
 * 近纯白纱、100% 跳到灰底 —— 白与 #F3F4F4 的色差在图层交界读成一条白色横带
 * (用户圈出的「像两个图层,上图下灰」)。同色收束后交界不可见。 */
/* 2026-09-24 裁决(CU-M-14/M-33/M-65/M-76):深色/杂色封面上店名、城市角色、口号、顶栏「主页」读不清。
 * 先试过只给店名那一列垫玻璃底板,走查判为「像没退出的输入框」的回归,用户定改成封面渐变:
 * 顶栏~身份行这段(0~44%)白纱抬到 .52~.60,深色字压在最暗的照片上也有 ≥4.5:1;
 * 往下照旧逐档收到页底同色,不加底板、不加描边(8-04 否掉描边的约定不变)。 */
.pc-merchant .pc-page-fade {
  background: linear-gradient(180deg, rgba(243,244,244,0.52) 0%, rgba(243,244,244,0.60) 18%, rgba(243,244,244,0.60) 44%, rgba(243,244,244,0.66) 56%, rgba(243,244,244,0.74) 66%, rgba(243,244,244,0.82) 75%, rgba(243,244,244,0.88) 82%, rgba(243,244,244,0.92) 88%, rgba(243,244,244,0.95) 93%, rgba(243,244,244,0.98) 97%, var(--cy-color-bg-page) 100%); /* ds-ok */
}
.pc-merchant .pc-nav-ico,
.pc-merchant .pc-avatar-edit-ico,
.pc-merchant .pc-tool-ico {
  filter: brightness(0);
  opacity: 0.78;
}

.pc-statusbar, .pc-nav, .pc-scroll { position: relative; z-index: 1; }
.pc-scroll { box-sizing: border-box; background: transparent; }
/* 左右内距 space-3(24rpx) → --cy-page-x(32rpx):全站页边距单一真源,本页原比其余 9 页外扩 8rpx */
.pc-body { padding: var(--cy-space-1) var(--cy-page-x) calc(var(--cy-space-5) + var(--cy-tabbar-h)); box-sizing: border-box; }

/* 顶栏 */
.pc-nav { display: flex; align-items: center; padding: 0 var(--cy-page-x); box-sizing: border-box; }
.pc-nav-side { width: var(--cy-btn-h); }
.pc-nav-center { flex: 1; text-align: center; }
.pc-nav-title {
  font-weight: 700;
  letter-spacing: 1rpx;
}   /* 尺寸/色走 .cy-h2;保留 700 字重避免变粗 */
/* 2026-08-20 用户定:去掉圆形玻璃底,只留裸图标(尺寸/热区不变) */
.pc-nav-btn {
  width: var(--cy-btn-h); height: var(--cy-btn-h);
  display: flex; align-items: center; justify-content: center;
}
.pc-nav-ico { width: var(--cy-legacy-36); height: var(--cy-legacy-36); }

/* 首屏身份区:身份头 + 三项统计。2026-08-04 用户定「删掉现在的黑色长方块背景」——
 * 对标 Xbox,头像/名称/好友关注全部直接铺在顶部封面渐变上,不套面板。
 * 横向内距归零,让它与下面各分节共用 .pc-body 的 --cy-page-x,不多缩进一截。 */
.pc-idcard {
  margin-bottom: var(--cy-space-4);
  padding: var(--cy-space-2) 0 0;
}

/* 身份头 */
.pc-gamer { display: flex;   gap: var(--cy-space-3); padding: var(--cy-space-2-5) var(--cy-space-1) var(--cy-space-3-5); align-items: flex-start; /* ds-ok: 20rpx/28rpx 无同值 spacing token */ }
.pc-avatar-wrap { position: relative; flex-shrink: 0; }
.pc-avatar-ring {
  width: 132rpx; height: 132rpx; border-radius: 50%; padding: var(--cy-legacy-4); box-sizing: border-box;
  background: linear-gradient(135deg, var(--cy-color-brand), #7048E8); /* ds-ok 头像环装饰渐变:token 层无渐变表达;终点取品牌紫深端与起点同族,非文字、不承载信息 */
}
.pc-player .pc-avatar-ring {
  background: linear-gradient(135deg, var(--cy-color-text-primary), var(--cy-color-border-strong));
}
.pc-player.pc-self .pc-avatar-ring {
  background: var(--cy-comp-profile-avatar-ring);
}
.pc-avatar { width: 100%; height: 100%; border-radius: 50%; border: 3rpx solid var(--cy-color-bg-page); background: var(--cy-color-bg-surface-subtle); box-sizing: border-box; display: block; }
/* 商家主体没 logo 时的 lettermark:沿用同一个圆和描边,只换内容。 */
.pc-avatar--initial {
  display: flex; align-items: center; justify-content: center;
  color: var(--cy-color-text-secondary);
  font-size: var(--cy-type-display); font-weight: 600; line-height: 1;
}
.pc-avatar-edit {
  position: absolute; top: 0; right: 0; width: var(--cy-legacy-36); height: var(--cy-legacy-36); border-radius: 50%;
  background: var(--cy-color-bg-surface); border: 2rpx solid var(--cy-color-border-strong);
  display: flex; align-items: center; justify-content: center;
}
.pc-avatar-edit-ico { width: var(--cy-legacy-18); height: var(--cy-legacy-18); }
.pc-avatar-dot {
  position: absolute; bottom: var(--cy-legacy-6); right: var(--cy-legacy-6); width: var(--cy-legacy-22); height: var(--cy-legacy-22); border-radius: 50%;
  background: var(--cy-color-status-success); border: 4rpx solid var(--cy-color-bg-page);
}
.pc-gamer-main { flex: 1; min-width: 0; }
/* 昵称 40rpx(废弃 token --cy-font-display)→ section-title 36:页面标题已由顶栏「我的」(.cy-h2)承担,
   昵称是身份头这个模块的标题;同页最大字是成就 tab 的 56rpx G 分,给 page-title 48 会压过它。
   font-weight 800 → 700(DS §12.5 字重封顶) */
.pc-gamer-name { font-size: var(--cy-type-section-title); font-weight: 700; line-height: 1.2; }
.pc-gamer-lv {
  margin-top: var(--cy-space-1); display: flex; flex-wrap: wrap; align-items: center; gap: var(--cy-space-1);
  /* 用户定:品牌紫只做极少数强调时刻，等级徽章不是。原来用的是品牌色变量，
     在深色卡上既跳又跟全站黑白基调冲突 ⇒ 收到可读的次级文字色。
     契约 P1-K 盯的就是这件事(原来钉在旧 .explorer-kicker 上)。
     ⚠️ 注释里刻意不写出那个变量名 —— 契约是纯文本匹配，写出来同样判红。 */
  font-size: var(--cy-type-label); font-weight: 600; color: var(--cy-color-text-secondary);
}
.pc-role-badge { display: inline-flex; }
.pc-lv-badge { width: 71rpx; height: 33rpx; vertical-align: middle; }
/* 2026-08-04 用户「上海/连续探索/好友/关注/粉丝 商家玩家的字体都看不清,颜色再加深」:
   secondary/tertiary 两档灰是给「压在实底上」调的,这几行现在压在封面照片上,明度落在
   照片中段就读不出。提到 text-primary —— 它在两个主题下各自解析(玩家近白、商家近墨),
   所以一条规则同时治两态。只提这两处压图的,页面其余层级不动。 */
.pc-gamer-meta {   margin-top: var(--cy-legacy-10); display: flex; flex-wrap: wrap; gap: var(--cy-space-2); font-size: var(--cy-type-caption); color: var(--cy-color-text-primary); /* ds-ok: 10rpx 无同值 spacing token */ }
/* 原为 📍 emoji 充当图标(DS §9 禁止),改 cy-icon gps;emoji 是模板里写死的、不来自数据,故可换 */
.pc-gamer-loc { display: inline-flex; align-items: center; gap: var(--cy-space-1); }
.pc-gamer-slogan { margin-top: var(--cy-legacy-14); font-size: var(--cy-type-label); color: var(--cy-color-text-primary); line-height: 1.45; }
.pc-edit-link { margin-top: var(--cy-space-1-5); font-size: var(--cy-type-label); color: var(--cy-color-text-secondary); }

/* 三项统计 */
/* 收进身份卡后,下外边距交给 .pc-idcard 统一给(原来那份会在卡内多出一段空白) */
.pc-stats {
  display: flex; align-items: center;
  padding: var(--cy-space-3) 0;
}
.pc-statcol { flex: 1; display: flex; flex-direction: column; align-items: center; gap: var(--cy-space-1); }
.pc-stat-n { font-size: var(--cy-type-section-title); font-weight: 700; }
.pc-stat-l { font-size: var(--cy-type-caption); color: var(--cy-color-text-primary); }
.pc-stat-div { width: 2rpx; height: 52rpx; background: var(--cy-color-border-subtle); }
.pc-metric-error { display: flex; flex-direction: column; align-items: center; padding-bottom: var(--cy-space-3); }

/* 主操作(未收编 cy-btn:组件层 --cy-comp-btn-* 不跟随本页的 class 主题,见顶部说明) */
.pc-actions { display: flex; gap: var(--cy-space-2); margin: var(--cy-space-1-5) 0 var(--cy-space-2-5); /* ds-ok: 12rpx/20rpx 无同值 spacing token */ }
/* 2026-08-04 用户定:「按钮都是 80% 的透明度且都需要是纯黑 纯白」。
 * 纯值刻意不走 token —— action-primary-bg 在夜间是「星白」(#F5F6FA 一类)、日间是墨黑(#1x1x1x),
 * 都不是纯 #fff/#000;用户要的就是那两个端点值,套 token 反而拿不到。故字面值 + ds-ok。
 * 玩家(深页)=纯白底纯黑字,商家(白页)=纯黑底纯白字,两边都压 .8 alpha 让封面透出来。 */
/* ★ !important 不是偷懒,是必需:style/components.wxss:309 那条全局「按钮矫正层」把 .pc-primary
   连同几十个旧类一起 `background: var(--cy-btn-solid-bg) !important` 钉死了。没有 !important
   的页面规则一律打不过它 —— 实测本页 .pc-primary 的 computed 值一直是 rgb(246,247,250)/
   rgb(51,54,60)(即 token 星白/墨灰),用户要的「纯白纯黑 + 80%」从来没生效过;同一批里
   .pc-more 因为不在那份类名清单里,反而是唯一听页面的。
   矫正层在 style/(禁区)且波及全站按钮,不能为本页去动它,故在页面侧用 .pc-page 提特异性做局部豁免。 */
.pc-primary, .pc-more {
  height: var(--cy-btn-h); border-radius: var(--cy-radius-lg);
  border: none;
  font-size: var(--cy-type-body); font-weight: 700;
  display: flex; align-items: center; justify-content: center;
}
/* 玩家(深页)=纯白 @80%;商家(白页)=纯黑不透明 —— 用户「商户的核销按钮就要纯黑的吧」,
   白底会把 20% 透出来合成 #333,所以商家这半边不压 alpha。 */
.pc-page .pc-primary, .pc-page .pc-more {
  background: rgba(255, 255, 255, 0.8) !important; /* ds-ok: 用户指定纯白 @80% */
  color: #000000 !important;                       /* ds-ok: 用户指定纯黑 */
}
.pc-page.pc-merchant .pc-primary, .pc-page.pc-merchant .pc-more {
  background: #000000 !important;                  /* ds-ok: 用户指定纯黑 */
  color: #FFFFFF !important;                       /* ds-ok: 用户指定纯白 */
}
.pc-page .pc-primary--follow {
  background: var(--cy-color-text-primary) !important;
  color: var(--cy-color-bg-page) !important;
}
.pc-page .pc-primary--followed {
  background: var(--cy-color-bg-surface-subtle) !important;
  color: var(--cy-color-text-secondary) !important;
}
.pc-page .pc-primary--follow,
.pc-page .pc-primary--followed {
  transition: transform var(--cy-motion-standard) var(--cy-ease-out), opacity var(--cy-motion-fast) var(--cy-ease-out);
}
.pc-primary--pending { opacity: 0.72; transform: scale(0.985); }
.pc-follow-result { display: flex; align-items: center; justify-content: center; gap: var(--cy-space-1); }
.pc-follow-check { display: flex; align-items: center; justify-content: center; }
.pc-primary--settled .pc-follow-check {
  animation: pc-follow-settled var(--cy-motion-standard) var(--cy-ease-out) both;
}
@keyframes pc-follow-settled {
  0% { opacity: 0; transform: scale(0.72); }
  68% { opacity: 1; transform: scale(1.08); }
  100% { opacity: 1; transform: scale(1); }
}
.pc-reduced-motion .pc-primary--follow,
.pc-reduced-motion .pc-primary--followed { transition: none; }
.pc-reduced-motion .pc-primary--settled .pc-follow-check { animation: none; }
.pc-primary { flex: 1; }
.pc-more { width: var(--cy-btn-h); flex: none; }
/* 玩家自己页只保留一枚横向票夹主按钮。 */
.pc-ticket { width: 100%; gap: var(--cy-space-1); }
.pc-ticket-icon { display: flex; align-items: center; justify-content: center; }
.pc-btn-press { opacity: 0.88; }

/* 探索值 */
.pc-exp-row {
  display: flex; align-items: center; gap: var(--cy-space-1-5); margin-bottom: var(--cy-space-2-5); padding: 0 var(--cy-space-1); /* ds-ok: 12rpx/20rpx 无同值 spacing token */
}
.pc-exp-badge {
  width: 44rpx; height: 44rpx; border-radius: 50%; background: var(--cy-color-bg-surface);
  border: 2rpx solid var(--cy-color-border-strong); font-size: var(--cy-type-caption); font-weight: 700;
  display: flex; align-items: center; justify-content: center; color: var(--cy-color-brand);
}
.pc-exp-label { font-size: var(--cy-type-label); color: var(--cy-color-text-tertiary); }
.pc-exp-val { font-size: var(--cy-type-card-title); font-weight: 700; margin-left: auto; }

/* 城市身份卡。

.pc-rec-sub { font-size: var(--cy-type-caption); color: var(--cy-color-text-tertiary); margin-top: var(--cy-legacy-6); }

/* 动态 Feed */
.pc-feed { margin-top: var(--cy-space-1); }
.pc-post {
  background: transparent; border: none;
  border-radius: 0; padding: var(--cy-space-3) var(--cy-space-1); margin-bottom: var(--cy-space-1);
  border-bottom: 1rpx solid var(--cy-color-border-subtle);
}
.pc-post:last-child { border-bottom: none; }
.pc-post-head { display: flex; gap: var(--cy-space-2); align-items: center; }
.pc-post-meta { flex: 1; }
.pc-post-name { display: block; font-size: var(--cy-type-label); font-weight: 700; }
.pc-post-time { display: block; font-size: var(--cy-type-caption); color: var(--cy-color-text-tertiary); margin-top: var(--cy-space-1); }
.pc-post-body { margin: var(--cy-space-2) 0 var(--cy-space-1-5); font-size: var(--cy-type-body); line-height: 1.5; color: var(--cy-color-text-secondary); /* ds-ok: 12rpx 无同值 spacing token */ }
.pc-post-pics { white-space: nowrap; width: 100%; }
.pc-post-pic { width: 220rpx; height: 220rpx; border-radius: var(--cy-radius-sm); margin-right: var(--cy-space-1-5); display: inline-block; }
.pc-post-tools { display: flex; align-items: center; gap: var(--cy-space-3); margin-top: var(--cy-space-2); }
.pc-tool { display: flex; align-items: center; gap: var(--cy-space-1); font-size: var(--cy-type-label); color: var(--cy-color-text-tertiary); background: transparent; padding: 0; margin: 0; line-height: 1; }

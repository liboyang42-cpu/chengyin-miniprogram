}
.pc-proj-sub {
  margin-top: var(--cy-space-1); font-size: var(--cy-type-caption); color: var(--cy-color-text-tertiary); line-height: 1.45;
  overflow: hidden; text-overflow: ellipsis; display: -webkit-box;
  -webkit-line-clamp: 2; -webkit-box-orient: vertical;
}
.pc-proj-thumb {
  flex-shrink: 0; width: 128rpx; height: 128rpx; border-radius: var(--cy-radius-sm);
  background: var(--cy-color-bg-surface-subtle);
}

/* 项目 Tab · Xbox 列表风(与团体-我的项目一致) */
.pc-xbox-list { display: flex; flex-direction: column; gap: var(--cy-space-3-5); margin-bottom: var(--cy-space-3); /* ds-ok: 28rpx 无同值 spacing token */ }
/* 2026-08-20 项目卡 v2(用户定):G 积分/浏览量/时间百分比对商家无决策价值,整排删掉;
   只留 封面/名称/档期/状态章。改白卡承托 —— 原先内容裸排在封面渐变图层上,
   图层交界的白横带正好穿过卡片(见 .pc-merchant .pc-page-fade 注释)。 */
.pc-xbox-proj {
  display: flex; align-items: center; gap: var(--cy-space-2-5);

/* 足迹 */
.pc-fp-filters { display: flex; gap: var(--cy-space-2); margin: var(--cy-space-1) 0 var(--cy-space-2); flex-wrap: wrap; }
.pc-fp-filter {
  font-size: var(--cy-type-label); color: var(--cy-color-text-tertiary); padding: var(--cy-legacy-10) var(--cy-legacy-22); border-radius: var(--cy-radius-pill);
  background: var(--cy-color-bg-surface); border: 2rpx solid var(--cy-color-border-subtle);
}
.pc-fp-filter-on { color: var(--cy-color-text-primary); border-color: var(--cy-color-brand); background: var(--cy-color-brand-soft); }
.pc-map-wrap { position: relative; height: 420rpx; border-radius: var(--cy-radius-md); overflow: hidden; margin-bottom: var(--cy-space-2-5); }
.pc-map { width: 100%; height: 100%; }
.pc-map-overlay {
  position: absolute; left: var(--cy-space-3); bottom: var(--cy-space-3); padding: var(--cy-space-2) var(--cy-space-2-5); border-radius: var(--cy-radius-sm); /* ds-ok: 20rpx 无同值 spacing token */
  background: rgba(2,1,4,0.72); backdrop-filter: blur(8rpx); /* ds-ok 压地图的玻璃底 = bg-page @ 72%;小程序无 color-mix(),「token 色 @ alpha」无法表达 */
}
.pc-map-city { display: block; font-size: var(--cy-type-body); font-weight: 700; }
.pc-map-hint { display: block; font-size: var(--cy-type-caption); color: var(--cy-color-text-tertiary); margin-top: var(--cy-legacy-4); }
.pc-fp-stats { display: flex; flex-wrap: wrap; gap: var(--cy-space-1-5); margin-bottom: var(--cy-space-2); /* ds-ok: 12rpx 无同值 spacing token */ }
.pc-fpcell {
  width: calc(50% - 6rpx); box-sizing: border-box; background: var(--cy-color-bg-surface);
  border: 2rpx solid var(--cy-color-border-subtle); border-radius: var(--cy-radius-md); padding: var(--cy-legacy-22) var(--cy-space-3); /* ds-ok: 22rpx/6rpx/2rpx 无同值 token */
}
.pc-fpcell-n { display: block; font-size: var(--cy-type-card-title); font-weight: 700; }
.pc-fpcell-l { display: block; font-size: var(--cy-type-caption); color: var(--cy-color-text-tertiary); margin-top: var(--cy-legacy-4); }
.pc-replay { text-align: center; font-size: var(--cy-type-label); color: var(--cy-color-brand); padding: var(--cy-space-2) 0 var(--cy-space-1); }

/* 勋章 */
.pc-medal-grid { display: flex; flex-wrap: wrap; gap: var(--cy-space-2); }
.pc-medal {
  width: calc(33.33% - 12rpx); box-sizing: border-box; text-align: center;
  background: var(--cy-color-bg-surface); border: 2rpx solid var(--cy-color-border-subtle); border-radius: var(--cy-radius-md); padding: var(--cy-space-2-5) var(--cy-space-1-5);
}
/* font-size 在这里是拿字号当 icon 尺寸使,不是字阶语义;废弃 token --cy-font-display(40)无同值目标,
   取最近的 section-title 36 —— 它撑的是 96rpx 圆盘里的兜底 emoji,4rpx 差无功能影响。此类为死码(只报不删) */
.pc-medal-disc {
  width: var(--cy-space-8); height: var(--cy-space-8); border-radius: 50%; margin: 0 auto var(--cy-space-1-5); /* ds-ok: 12rpx 无同值 spacing token */
  background: var(--cy-color-bg-surface-subtle); display: flex; align-items: center; justify-content: center; overflow: hidden;
  font-size: var(--cy-type-section-title);
}
.pc-medal-disc-ico { width: 100%; height: 100%; }
.pc-medal-name { display: block; font-size: var(--cy-type-caption); font-weight: 700; line-height: 1.3; }
.pc-medal-lv { margin-top: var(--cy-legacy-6); font-size: var(--cy-type-caption); color: var(--cy-color-brand); }
.pc-medal-more { text-align: center; font-size: var(--cy-type-label); color: var(--cy-color-text-tertiary); padding: var(--cy-space-3) 0; }

/* 资料 */
/* 门店 AI 形象卡(npc_profile scope 2 门店分身)。像素素材放大必须关插值,否则 64px 的图拉到 128rpx
   会被浏览器双线性插值糊成一团 —— 那正是「像素风」唯一会看错的地方。
   image-rendering 是可继承属性,写在 <image> 外层能传到微信内部的 <img>。 */
.pc-npc {
  display: flex; align-items: center; gap: var(--cy-space-2-5);
  padding: var(--cy-space-3) var(--cy-space-3-5); margin: var(--cy-space-2) 0;
  background: var(--cy-color-bg-surface); border: 2rpx solid var(--cy-color-border-subtle);
  border-radius: var(--cy-radius-md);
}
.pc-npc-avatar {
  /* ds-ok: 128rpx 像素画布边长,无同值 spacing token;显式定尺寸避开 image 默认 240px 高 */
  width: 128rpx; height: 128rpx; flex-shrink: 0;
  border-radius: var(--cy-radius-sm);
  background: var(--cy-color-bg-surface-subtle);
  image-rendering: pixelated;
}
.pc-npc-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: var(--cy-space-1); }
.pc-npc-name { font-size: var(--cy-type-card-title); font-weight: 700; color: var(--cy-color-text-primary); }
.pc-npc-greet { font-size: var(--cy-type-body); line-height: 1.5; color: var(--cy-color-text-secondary); }
/* 「聊聊」入口。★ 触达区不小于 44pt(88rpx):文字本身只有一行高,
   不撑到 88rpx 的话点不中,而形象卡整块又不该可点(点整块会和"看形象"混淆)。 */
.pc-npc-chat-entry {
  flex-shrink: 0; min-width: 112rpx; min-height: 88rpx;
  display: flex; align-items: center; justify-content: center;
  padding: 0 var(--cy-space-3);
  font-size: var(--cy-type-body); font-weight: 600;
  color: var(--cy-color-brand);
  border-radius: var(--cy-radius-pill);
  background: var(--cy-color-bg-surface-subtle);
}

.pc-about-head { display: flex; align-items: center; justify-content: space-between; }
.pc-about-edit {
  min-height: var(--cy-btn-h);
  padding: 0 var(--cy-space-2);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: var(--cy-space-1);
  color: var(--cy-color-status-info);
  font-size: var(--cy-type-label);
}
.pc-about { padding: var(--cy-space-3) var(--cy-space-3-5); font-size: var(--cy-type-body); line-height: 1.55; color: var(--cy-color-text-secondary); margin-bottom: var(--cy-space-1); /* ds-ok: 28rpx 无同值 spacing token */ }
.pc-tags { display: flex; flex-wrap: wrap; gap: var(--cy-space-1-5); margin-bottom: var(--cy-space-2); padding: 0 var(--cy-space-1); /* ds-ok: 12rpx 无同值 spacing token */ }
.pc-tag {
  font-size: var(--cy-type-label); padding: var(--cy-space-1) var(--cy-legacy-18); border-radius: var(--cy-radius-pill); /* ds-ok: 18rpx 无同值 spacing token */
  background: var(--cy-color-bg-surface); border: 2rpx solid var(--cy-color-border-subtle); color: var(--cy-color-text-secondary);
}
.pc-tag--muted { color: var(--cy-color-text-tertiary); }
.pc-info-list { background: var(--cy-color-bg-surface); border: 2rpx solid var(--cy-color-border-subtle); border-radius: var(--cy-radius-md); overflow: hidden; }
.pc-info-link { color: var(--cy-color-text-tertiary); }

/* 独立成组的单行 cell(加入时间 / 会员续费):cy-cell 自带 96rpx 行高与左右 32rpx padding */
.pc-solo-cell { display: block; margin-bottom: var(--cy-space-1); }

/* 底部 sheet 由 cy-sheet 提供(chrome + 遮罩 + 头)。
   2026-09-02:删掉 .pc-sheet-mask / -head / -title / -close 四条 —— 它们是上一轮收编到
   cy-sheet 之后剩下的死码,wxml/js 全仓零引用。留着的代价不是那几行样式,是「这页还有一套
   自造遮罩」的假象:下一个人照着它再写一个 z-index:90 的浮层,就绕过了 z 分档。 */

/* 商家财务卡骨架:wxml 零引用,是拆掉功能后剩下的死码(只报不删) */
.pc-vcard {
  position: relative; overflow: hidden; margin-bottom: var(--cy-space-2-5);
  background: var(--cy-color-bg-surface); border: 2rpx solid var(--cy-color-border-subtle);
  border-radius: var(--cy-radius-lg); padding: var(--cy-space-4) var(--cy-legacy-36) var(--cy-legacy-36); /* ds-ok: 36rpx/2rpx 无同值 token */
}
.pc-vcard-glow { position: absolute; width: 280rpx; height: 280rpx; border-radius: 50%; filter: blur(70rpx); opacity: 0.45; }
.pc-vcard-glow--purple { background: #7048E8; top: -120rpx; right: -40rpx; } /* ds-ok 卡背辉光装饰:token 层无辉光表达,取品牌紫深端;非文字、被 blur(70rpx) 打散 */
.pc-vcard-glow--blue { background: var(--cy-color-brand); bottom: -140rpx; left: -60rpx; }
.pc-player .pc-vcard-glow--purple { background: var(--cy-color-border-strong); }
.pc-player .pc-vcard-glow--blue { background: var(--cy-color-text-primary); }
.pc-vcard-top { position: relative; display: flex; justify-content: space-between; align-items: center; }
.pc-vcard-pill { font-size: var(--cy-type-label); color: var(--cy-color-text-tertiary); }
.pc-vcard-link { font-size: var(--cy-type-caption); color: var(--cy-color-text-tertiary); }
/* 72rpx 无同值 token;它是金额 ⇒ data-xl(DS:金额 / 里程 / 核心数字)。800 → 700 封顶 */
.pc-vcard-amount { position: relative; font-size: var(--cy-type-data-xl); font-weight: 700; margin-top: var(--cy-space-1-5); color: var(--cy-color-text-primary); }
.pc-vcard-stats { position: relative; display: flex; gap: var(--cy-space-5); margin-top: var(--cy-space-2-5); /* ds-ok: 20rpx 无同值 spacing token */ }
.pc-vcard-stat-v { display: block; font-size: var(--cy-type-body); font-weight: 700; }
.pc-vcard-stat-v--green { color: var(--cy-color-status-success); }
.pc-vcard-stat-l { display: block; font-size: var(--cy-type-caption); color: var(--cy-color-text-tertiary); margin-top: var(--cy-legacy-4); }

/* 入口行分组容器:行样式已收编进 cy-cell(DS §3.11),cell 自带左右 32rpx padding,容器不加边距
 * (与已迁移的 pages/shezhi 同一写法);未套 cy-card 的原因见本文件顶部 */
.pc-menu { padding: var(--cy-legacy-4) 0; margin-bottom: var(--cy-space-1); /* ds-ok: 4rpx 无同值 spacing token */ }

/* 入口图标网格:6 个入口(角色互斥 ⇒ 常态 5 个)压成 4 列 = 2 行,替掉原来 6 行整宽 cell。
   图标底走明度阶,不加边框(与身份卡同一分层语言)。 */
.pc-entries { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--cy-space-3) var(--cy-space-2); padding: var(--cy-space-3) var(--cy-space-2); border-radius: var(--cy-radius-lg); background: var(--cy-color-bg-elevated); margin-bottom: var(--cy-space-2); }
.pc-entry { min-width: 0; display: flex; flex-direction: column; align-items: center; gap: var(--cy-space-1); }
.pc-entry-ico { width: var(--cy-btn-h); height: var(--cy-btn-h); border-radius: var(--cy-radius-md); background: var(--cy-color-bg-surface-subtle); display: flex; align-items: center; justify-content: center; }
.pc-entry-t { font-size: var(--cy-type-caption); color: var(--cy-color-text-secondary); text-align: center; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%; }

/* 成就行 */
.pc-achv-list { padding: var(--cy-space-1) var(--cy-space-3); }
.pc-achv { display: flex; align-items: center; gap: var(--cy-legacy-18); padding: var(--cy-legacy-18) 0; border-bottom: 1rpx solid var(--cy-color-border-subtle); }
.pc-achv:last-child { border-bottom: none; }
.pc-achv-ico { width: var(--cy-btn-h); height: var(--cy-btn-h); border-radius: var(--cy-radius-md); flex-shrink: 0; background: var(--cy-color-bg-surface-subtle); }
/* medalImg 缺失时仍保留勋章占位尺寸,以通用 star 表达已获得的勋章。 */
.pc-achv-ico--fallback { display: flex; align-items: center; justify-content: center; color: var(--cy-color-brand); }
.pc-achv-main { flex: 1; min-width: 0; }
.pc-achv-name { font-size: var(--cy-type-body); font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
/* 原是 <text>✓</text> 文本符号充当图标(DS §9 禁止)⇒ cy-icon check;色 = currentColor,故这里只给 color */
.pc-achv-ok { color: var(--cy-color-brand); flex-shrink: 0; }
.pc-theme-pct { font-size: var(--cy-type-label); font-weight: 700; color: var(--cy-color-text-tertiary); flex-shrink: 0; }

/* 当前权益。未收编 cy-cell:leading 是承载「解锁/未解锁」状态的实色圆点,
   而 cy-cell 的 icon 只吃图片 src,收编会把状态色弄丢 */
.pc-benefits { padding: var(--cy-space-1) var(--cy-space-3-5); margin-bottom: var(--cy-space-1); /* ds-ok: 28rpx 无同值 spacing token */ }
.pc-benefit { display: flex; align-items: center; gap: var(--cy-space-2); padding: var(--cy-legacy-22) 0; border-bottom: 1rpx solid var(--cy-color-border-subtle); /* ds-ok: 22rpx/1rpx 无同值 token */ }
.pc-benefit:last-child { border-bottom: none; }
/* 原为 ✓/锁 文本符号 + 写死的纯白前景:白字压 success 实测夜 2.55:1(需 4.5)= 不可读。
   换 cy-icon check/lock + text-inverse(「紫/白底上的反色字」正是实色块上的前景语义):夜 7.82 / 日 5.34 */
.pc-benefit-dot {
  width: 40rpx; height: 40rpx; border-radius: 50%; background: var(--cy-color-status-success); color: var(--cy-color-text-inverse);
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
.pc-benefit--lock .pc-benefit-dot { background: var(--cy-color-bg-surface-subtle); color: var(--cy-color-text-tertiary); }
.pc-benefit-text { flex: 1; font-size: var(--cy-type-label); color: var(--cy-color-text-primary); }
.pc-benefit--lock .pc-benefit-text { color: var(--cy-color-text-tertiary); }
/* 原是 <text>›</text> ⇒ cy-icon arrow-right */
.pc-benefit-arrow { color: var(--cy-color-text-placeholder); flex-shrink: 0; }

/* 商家「关于」:品牌口号 + 门店相册 + 营业信息 / 承接能力的键值行。
   全部走语义 token,和玩家 About 用同一批变量 ⇒ theme-merchant 切白时整组跟着切,
   不会出现「卡片白了、文字还是夜间色」那种就地求值残留。 */
.pc-gamer-slogan { font-size: var(--cy-type-label); color: var(--cy-color-text-secondary); }
.pc-mgimg {
  width: 240rpx; height: 180rpx; border-radius: var(--cy-radius-sm); /* ds-ok: 240rpx/180rpx 无同值 token */
  background: var(--cy-color-bg-surface-subtle); flex-shrink: 0;
}
.pc-mrows { padding: 0; }
.pc-mrow {
  display: flex; align-items: center; justify-content: space-between; gap: var(--cy-space-2);
  min-height: 88rpx; padding: var(--cy-space-2) var(--cy-space-3-5); /* ds-ok: 88rpx/28rpx 无同值 token */
}
.pc-mrow + .pc-mrow { border-top: 2rpx solid var(--cy-color-border-subtle); }
.pc-mrow-k { font-size: var(--cy-type-label); color: var(--cy-color-text-tertiary); flex-shrink: 0; }
.pc-mrow-v { font-size: var(--cy-type-label); color: var(--cy-color-text-primary); text-align: right; }
.pc-mrow-v--link {
  color: var(--cy-color-status-info);
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: var(--cy-space-1);
}

/* 探索作品 */
.pc-works { display: flex; flex-wrap: wrap; gap: var(--cy-space-2); margin-bottom: var(--cy-space-2); padding: 0 var(--cy-space-1); }
.pc-work-pic { width: 150rpx; height: 150rpx; border-radius: var(--cy-radius-sm); background: var(--cy-color-bg-surface-subtle); }

.pc-info-row--solo {
  display: flex; justify-content: space-between; align-items: center;
  padding: var(--cy-space-3) var(--cy-space-3-5); margin-bottom: var(--cy-space-1); /* ds-ok: 28rpx 无同值 spacing token */
  background: var(--cy-color-bg-surface); border: 2rpx solid var(--cy-color-border-subtle); border-radius: var(--cy-radius-md);
}

.pc-renew {
  display: flex; align-items: center; justify-content: space-between;
  padding: 30rpx var(--cy-space-3-5); margin-top: var(--cy-space-2); /* ds-ok: 30rpx/28rpx 无同值 spacing token */
  background: var(--cy-color-bg-surface); border: 2rpx solid var(--cy-color-border-subtle); border-radius: var(--cy-radius-md);
}
.pc-renew-name { font-size: var(--cy-type-body); font-weight: 700; color: var(--cy-color-brand); }
.pc-renew-arrow { font-size: var(--cy-type-section-title); color: var(--cy-color-text-tertiary); }

/* [P0-2] ③ 选章核销面板 —— 装在 cy-sheet 的 slot 里,条数不设上限
   (wx.showActionSheet 上限 6 项,超了只能截断 = 静默丢选项) */
.chpick { padding-bottom: var(--cy-space-2); }
.chpick__hint {
  padding: 0 var(--cy-space-1) var(--cy-space-2-5); /* ds-ok: 20rpx 无同值 spacing token */
  font-size: var(--cy-type-label);
  line-height: 1.5;
  color: var(--cy-color-text-tertiary);
}
.chpick__item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx var(--cy-space-1); /* ds-ok: 30rpx 无同值 spacing token */
  border-top: 1rpx solid var(--cy-color-border-subtle);
}
.chpick__name {
  flex: 1;
  font-size: var(--cy-type-body);
  color: var(--cy-color-text-primary);
  /* 章节名可能很长,别把箭头挤出屏幕 */
  margin-right: var(--cy-space-2);
}
.chpick__chev {
  color: var(--cy-color-text-tertiary);
}

/* ==== 积分任务弹窗(pts-)====
 * 参照:FocusFlight 票券卡(虚线分隔/双列统计)+ Xbox Rewards 双列大数字头 + Pangea 行式任务。
 * 全部走 token,零硬编码;容器由 cy-sheet 提供(遮罩/圆角/标题/关闭)。 */
.pts-hero {
  display: flex;
  align-items: center;
  padding: var(--cy-space-3) 0 var(--cy-space-3-5); /* ds-ok: 28rpx 无同值 spacing token */
}
.pts-hero__col {
  flex: 1;
  text-align: center;
  min-width: 0;
}
.pts-hero__label {
  font-size: var(--cy-type-caption);
  color: var(--cy-color-text-tertiary);
  margin-bottom: var(--cy-space-1);
}
.pts-hero__num {
  font-size: var(--cy-type-display);
  font-weight: 700;
  color: var(--cy-color-text-primary);
}
.pts-hero__div {
  width: 2rpx;
  height: var(--cy-btn-h-xs); /* ds-ok: 2rpx 无同值 spacing token */
  background: var(--cy-color-border-strong);
  flex-shrink: 0;
}
.pts-loading {
  padding: var(--cy-space-5) 0;
  text-align: center;
  font-size: var(--cy-type-caption);
  color: var(--cy-color-text-tertiary);
}
.pts-list {
  display: flex;
  flex-direction: column;
  gap: var(--cy-scene-card-gap, var(--cy-space-2-5));
}
.pts-row {
  display: flex;
  align-items: center;
  padding: var(--cy-scene-card-pad-y, var(--cy-space-3-5)) var(--cy-scene-card-pad-x, var(--cy-space-4));
  border-radius: var(--cy-scene-card-radius, var(--cy-comp-sheet-history-card-radius));
  background: var(--cy-scene-card-bg, var(--cy-comp-sheet-player-history-card));
}
.pts-row__main {
  flex: 1;
  min-width: 0;
  margin-right: var(--cy-space-3);
}
.pts-row__name {
  font-size: var(--cy-type-body);
  font-weight: 600;
  color: var(--cy-color-text-primary);
}
.pts-row__desc {
  font-size: var(--cy-type-caption);
  color: var(--cy-color-text-tertiary);
  margin-top: var(--cy-legacy-4);
}
.pts-row__side {
  flex-shrink: 0;
  text-align: right;
}
.pts-row__gain {
  font-size: var(--cy-type-card-title);
  font-weight: 700;
  color: var(--cy-color-text-primary);
}
.pts-row__done {
  font-size: var(--cy-type-caption);
  color: var(--cy-color-text-tertiary);
  margin-top: var(--cy-legacy-4);
}
.pts-row__done.is-zero { opacity: .6; }

/* 我的资产:与「我的订单」「我的项目」同段级的余额卡,整卡可点进账户收益。
   取用现有 token,不新造尺寸;--empty 档给取不到余额时的「—」压低对比度,
   避免它看起来像一个确定的读数。 */
.pc-asset {
  display: flex; align-items: center; justify-content: space-between;
  padding: var(--cy-space-3-5) var(--cy-space-3);
  margin: 0 var(--cy-space-1) var(--cy-space-3);
  border-radius: var(--cy-radius-md);
  background: var(--cy-color-bg-surface-subtle);
  border: 1rpx solid var(--cy-color-border-subtle);
  box-sizing: border-box;
}
.pc-asset__main { display: flex; flex-direction: column; gap: var(--cy-space-1); min-width: 0; }
.pc-asset__label { font-size: var(--cy-type-label); color: var(--cy-color-text-tertiary); }
/* --cy-type-data-xl 的语义就是「金额 / 里程 / 核心数字」,DS 里金额只有这一档;
   不拿 card-title 之类按数值凑,那是标题语义(见 memory:token 名对≠语义对)。 */
.pc-asset__value { font-size: var(--cy-type-data-xl); font-weight: 700; color: var(--cy-color-text-primary); }
.pc-asset__value--empty { color: var(--cy-color-text-tertiary); }
.pc-asset__yen { font-size: var(--cy-type-label); font-weight: 700; margin-right: 4rpx; } /* ds-ok: 币符与数字的贴合间距 */
.pc-asset__arrow { color: var(--cy-color-text-tertiary); flex: none; }
.pc-team-entry { margin-top: var(--cy-space-3); overflow: hidden; border-radius: var(--cy-radius-md); background: var(--cy-color-bg-surface); }

/* ===== 发起合作底栏(访客看商家主页)===== */
.pc-coop-bar {
  position: fixed; left: 0; right: 0; bottom: 0;
  z-index: var(--cy-z-sticky);
  padding: var(--cy-space-2) var(--cy-space-3) calc(var(--cy-space-2) + env(safe-area-inset-bottom));
  background: var(--cy-color-bg-page);
  border-top: 1rpx solid var(--cy-color-border-subtle);
}
.pc-coop-btn {
  height: var(--cy-btn-h);
  min-width: 88rpx;
  min-height: 88rpx;
  display: flex; align-items: center; justify-content: center;
  border-radius: var(--cy-comp-btn-radius);
  background: var(--cy-color-action-primary-bg);
  color: var(--cy-color-action-primary-fg);
  font-size: var(--cy-type-body); font-weight: 600;
}

/* 招牌主推卡(4-12):横排 图 + 标题 + 箭头,与关于区其它行同一套 token,不另起卡片皮 */
.pc-featured { display: flex; align-items: center; gap: var(--cy-space-2-5); padding: var(--cy-space-2); }
.pc-featured-img {
  width: 160rpx; height: 120rpx; flex-shrink: 0;  /* ds-ok: 160rpx/120rpx 无同值 token */
  border-radius: var(--cy-radius-sm); background: var(--cy-color-bg-surface);
}
.pc-featured-img--fallback { display: flex; align-items: center; justify-content: center; color: var(--cy-color-text-tertiary); }
.pc-featured-title {
  flex: 1; min-width: 0; font-size: var(--cy-type-card-title); font-weight: 700;
  color: var(--cy-color-text-primary);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.pc-featured-arrow { flex-shrink: 0; color: var(--cy-color-text-tertiary); }

/* ===== 商家版关于:大白卡退场,文字直接落页面底(2026-08-20 用户拍板) =====
   只动商家视角;玩家暗色视角的 .pc-card 维持原样 */
.pc-merchant .pc-card { background: transparent; border: none; margin-bottom: var(--cy-space-3); }
.pc-merchant .pc-featured { padding-left: 0; padding-right: 0; }
.pc-merchant .pc-about { padding-left: 0; padding-right: 0; }
.pc-merchant .pc-mrow { padding-left: 0; padding-right: 0; }

/* isolated 组件内全局 .cy-pressed 进不来,必须本地定义一份。
   只减淡不位移:位移要配 .cy-motion-reduced 兜底,而那个类挂在组件外的祖先上,
   isolated 下同样够不着 —— 与其留个撤不掉的位移,不如按仓库既有组件按压类的做法只减淡。 */
.cy-pressed { opacity: .88; }

<wxs src="../../../utils/wxs/money.wxs" module="money" />
<!-- 商家视角挂 theme-merchant:日间 token 真源在 style/tokens.wxss(.theme-light/.theme-merchant),
     本页不再手抄一份;.pc-merchant 只留本页自有语义(去品牌化 + 隐藏 hero 底图) -->
<view class="pc-page {{isMerchantView ? 'pc-merchant theme-merchant' : 'pc-player'}} {{isSelf ? 'pc-self' : 'pc-public'}} {{reducedMotion ? 'pc-reduced-motion' : ''}}">
  <view class="pc-hero-bg">
    <image class="pc-hero-bg-img" src="{{heroImg}}" mode="aspectFill" />
  </view>
  <view class="pc-page-fade"></view>

  <view class="pc-statusbar" style="height:{{statusBarHeight}}px;"></view>

  <!-- 设置钮放左上:右上是微信原生胶囊(···|⊙)的固定占位,放右边必被压住(2026-08-04 实拍) -->
  <view class="pc-nav" style="height:{{navBarHeight}}px;">
    <view wx:if="{{isSelf}}" class="pc-nav-btn" bindtap="goSetting" aria-role="button" aria-label="打开设置" hover-class="cy-pressed" hover-stay-time="80">
      <image class="pc-nav-ico" src="/images/icon_set.png" mode="aspectFit" />
    </view>
    <view wx:else class="pc-nav-btn" bindtap="goBack" aria-role="button" aria-label="返回上一页" hover-class="cy-pressed" hover-stay-time="80">
      <cy-icon name="back" size="40" />
    </view>
    <view class="pc-nav-center">
      <text class="pc-nav-title cy-h2">主页</text>
    </view>
    <view class="pc-nav-side"></view>
  </view>

  <scroll-view class="pc-scroll" scroll-y enhanced show-scrollbar="{{false}}"
               style="height:calc(100vh - {{statusBarHeight + navBarHeight}}px);"
               bindscrolltolower="onFeedReachBottom" lower-threshold="120">
    <view class="pc-body">

      <!-- 首屏身份卡(ADA §二G):头像 + 玩家名 + 所在城市 + 三项统计合成一张卡,
           层级只靠表面明度(elevated)+ 顶缘高光,不加边框。
           ⚠️ 等级进度环没做:进度环需要「距下一级还差多少经验」,而 /api/growth/center 只给
           levelNo/expValue,没有任何等级阈值字段 —— 画环就得自己编阈值 = 造假数据,故只做卡。 -->
      <view class="pc-idcard">
      <!-- 身份头 -->
      <view class="pc-gamer">
        <!-- 被看者是商家时,身份头整组换成商家公开身份(品牌名/头像/封面/城市角色/口号)——
             否则会出现「关于已经是商家资料、首屏还挂着个人昵称和玩家角色」。 -->
        <view class="pc-avatar-wrap" bindtap="onAvatarTap" aria-role="{{isSelf ? 'button' : ''}}" aria-label="{{isSelf ? '编辑个人资料' : (subjectIsMerchant ? subjectMerchant.name : userInfo.nickname)}}" hover-class="{{isSelf ? 'cy-pressed' : 'none'}}" hover-stay-time="80">
          <view class="pc-avatar-ring">
            <!-- 商家主体没上传 logo 时落店名首字(lettermark),不借玩家默认头像那张人脸;
                 玩家档不变,仍兜底 /images/d_profile.png。 -->
            <image wx:if="{{_avatarSrc}}" class="pc-avatar" src="{{_avatarSrc}}" mode="aspectFill" />
            <view wx:else class="pc-avatar pc-avatar--initial">{{_avatarInitial}}</view>
          </view>
          <view class="pc-avatar-edit" wx:if="{{isSelf}}"><image class="pc-avatar-edit-ico" src="/images/icon_pen.svg" mode="aspectFit" /></view>
          <view class="pc-avatar-dot"></view>
        </view>
        <view class="pc-gamer-main">
          <view class="pc-gamer-name">{{subjectIsMerchant ? (subjectMerchant.name || '商家') : (userInfo.nickname || '探索者')}}</view>
          <view class="pc-gamer-lv" wx:if="{{subjectIsMerchant}}">
            <text wx:if="{{subjectMerchant.cityRole}}">{{subjectMerchant.cityRole}}</text>
          </view>
          <view class="pc-gamer-lv" wx:else>
            <!-- 未登录时 userInfo.role 为 null,直传会触发 roleBadge 属性类型告警(2026-07-30 复拍采到);
                 兜底放在调用方,不动 components/roleBadge -->
            <view class="pc-role-badge"><roleBadge role="{{userInfo.role || ''}}" /></view>
            <image class="pc-lv-badge" wx:if="{{userInfo.levelId==2}}" src="/images/group2.png" mode="widthFix" />
            <image class="pc-lv-badge" wx:if="{{userInfo.levelId==3}}" src="/images/group3.png" mode="widthFix" />
            <image class="pc-lv-badge" wx:if="{{userInfo.levelId==4}}" src="/images/group4.png" mode="widthFix" />
            <image class="pc-lv-badge" wx:if="{{userInfo.levelId==5}}" src="/images/group5.png" mode="widthFix" />
            <text>Lv.{{growthLevel}} 城市探索者</text>
          </view>
          <view class="pc-gamer-meta">
            <text class="pc-gamer-slogan" wx:if="{{subjectIsMerchant && subjectMerchant.slogan}}">{{subjectMerchant.slogan}}</text>
            <block wx:if="{{!subjectIsMerchant}}">
              <view class="pc-gamer-loc"><cy-icon name="gps" size="24" />{{cityName}}</view>
              <text class="pc-gamer-streak" wx:if="{{isSelf && profileMetricState === 'ready'}}">连续探索：{{streakDays || 0}}天</text>
            </block>
          </view>
        </view>
      </view>

      <!-- 好友 / 关注 / 粉丝 -->
      <view class="pc-stats" wx:if="{{!isSelf || profileMetricState === 'ready'}}">
        <view class="pc-statcol"><text class="pc-stat-n">{{friendNum}}</text><text class="pc-stat-l">好友</text></view>
        <view class="pc-stat-div"></view>
        <view class="pc-statcol"><text class="pc-stat-n">{{followNum}}</text><text class="pc-stat-l">关注</text></view>
        <view class="pc-stat-div"></view>
        <view class="pc-statcol"><text class="pc-stat-n">{{fansNum}}</text><text class="pc-stat-l">粉丝</text></view>
      </view>
      <cy-empty wx:elif="{{isSelf && profileMetricState === 'empty'}}" kind="empty"
        title="第一段城市探索还没开始" sub="完成第一次探索后，这里会留下你的足迹与成长" cta="去探索" bind:cta="goRoam" />
      <!-- ⚠️ cy-error 的 retry 属性**默认就是「重试」**:不传 retry 也不绑 bind:retry,
           它照样渲染出一个按钮,而那个按钮 triggerEvent('retry') 没人听 ⇒ 死按钮,
           还和自绘的「重新加载」凑成两个 CTA(2026-08-18 A32/A34/A36/A38 四张图都拍到)。
           改成同文件其它错误态的既有写法:按钮归组件,事件绑到已有的重取方法,单一 CTA。 -->
      <view wx:elif="{{isSelf && profileMetricState === 'error'}}" class="pc-metric-error">
        <cy-error title="探索数据没加载出来" sub="记录都还在，只是这次没取到"
          retry="重新加载" bind:retry="reloadProfileMetrics" />
      </view>
      <cy-skeleton wx:else type="list" count="{{1}}" />
      </view>

      <!-- 主 CTA + 更多。未收编 cy-btn:cy-btn 读 ①'' 组件层(--cy-comp-btn-*),该层在 page{} 上
           就已完成 var() 替换,后代 class 覆盖 --cy-color-* 不跟随(实测,见 PR 说明)⇒ 商家视角会拿到
           夜间 CTA(星白底)。组件层归 style/(禁区)改不了,故本页两个按钮维持自造件,只把「···」换 cy-icon。 -->
      <!-- 2026-07-31:原"开始探索"旁的"游玩"三卡分组(继续/自由漫游/漫游足迹)与主按钮功能重复,
           已删除;主按钮直接进漫游,旁边新增"票夹"入口承接原"从票夹开始"诉求。 -->
      <view class="pc-actions">
        <!-- UI-12:公开视角(他人看)主按钮 = 关注,不再区分被看者是玩家还是商家;
             本人视角保持原样(商家本人=核销)。 -->
        <view class="pc-primary {{!isSelf ? 'pc-primary--follow' : ''}} {{!isSelf && userInfo.isFollow == 1 ? 'pc-primary--followed' : ''}} {{followSubmitting ? 'pc-primary--pending' : ''}} {{followReceipt ? 'pc-primary--settled' : ''}}"
          wx:if="{{!isSelf || (isSelf && isMerchantView)}}" bindtap="onPrimaryCta" hover-class="pc-btn-press"
          aria-role="button" aria-label="{{followSubmitting ? '关注处理中' : primaryCta}}" aria-busy="{{followSubmitting}}" aria-disabled="{{followSubmitting}}">
          <text wx:if="{{followSubmitting}}">处理中…</text>
          <view wx:else class="pc-follow-result">
            <view wx:if="{{userInfo.isFollow == 1}}" class="pc-follow-check" aria-hidden="true"><cy-icon name="check" size="32" /></view>
            <text>{{primaryCta}}</text>
          </view>
        </view>
        <!-- 2026-08-04 用户定:票夹与主按钮等大同色(都是 pc-primary),不再做次级玻璃钮 -->
        <view class="pc-primary pc-ticket" wx:if="{{isSelf && !isMerchantView}}" bindtap="goSignup" hover-class="pc-btn-press" aria-role="button" aria-label="票夹">
          <view class="pc-ticket-icon"><cy-icon name="coupon" size="32" /></view>
          <text>票夹</text>
        </view>
        <view class="pc-primary pc-ticket" wx:if="{{!isSelf && !subjectIsMerchant}}" bindtap="onStartChat" hover-class="pc-btn-press" aria-role="button" aria-label="发消息">
          <cy-icon name="tab-feed" size="32" />
          <text>发消息</text>
        </view>
        <!-- UI-12:公开视角也要有「···」更多(分享主页/屏蔽);本人商家视角保持原入口。 -->
        <view class="pc-more" wx:if="{{!isSelf || isMerchantView}}" bindtap="openMoreMenu" hover-class="pc-btn-press" aria-role="button" aria-label="打开更多操作"><cy-icon name="more" size="32" /></view>
      </view>

      <!-- ⓪ 门店 AI 形象(npc_profile 里 scope 2「门店分身」,后台配):像素分身静态出场,不接对话。
           ★ 刻意放在 tab 之上而不是「关于」里:他人视角默认落在 posts(见 index.js 的 activeTab 兜底),
             挂进「关于」等于只有点过那个 tab 的人才看得见,形象就白配了。
           没配 / 未审 / 已停用时后端回的 npc 为 null,整块不渲染 —— 不留空头像框冒充「还没配好」。
           头像是必填项,故只判 npc 存在即可;greeting 可空,空了只出名字。 -->
      <block wx:if="{{subjectIsMerchant}}">
          <view class="pc-npc" wx:if="{{subjectMerchant.npc}}">
            <view class="pc-npc-avatar"><cy-npc-avatar src="{{subjectMerchant.npc.avatar}}"/></view>
            <view class="pc-npc-main">
              <text class="pc-npc-name">{{subjectMerchant.npc.name}}</text>
              <text class="pc-npc-greet" wx:if="{{subjectMerchant.npc.greeting}}">{{subjectMerchant.npc.greeting}}</text>
            </view>
            <!-- 对话入口。★ 开关关时**只去掉这个按钮**,形象照常出场 ——
                 它本来就是 PR #820 的静态展示,不该因为对话没开就整块消失。
                 判在这里而不是让人点了才 403:给一个点了必失败的入口比没有入口更坏。 -->
            <view wx:if="{{merchantNpcChatOn}}" class="pc-npc-chat-entry" bindtap="openMerchantNpcChat"
                  hover-class="cy-pressed" hover-stay-time="80" aria-role="button" aria-label="和店铺形象聊聊">聊聊</view>
          </view>
      </block>

      <!-- Tab：紧挨主按钮（对标 Xbox Rewards/Posts/Achievements/About） -->
      <!-- 2026-07-31 用户定:这排是「切换不同内容区」,用文字+下划线(fill);白胶囊(chip)只给
           「同一页面内切换内容」的筛选器。上一轮统一成 chip 是改错了,已撤回。 -->
      <cy-tabs class="pc-tabs" variant="fill" hairline="{{false}}" tabs="{{memberTabs}}" active="{{activeTab}}" bind:change="onTabChange" />

      <!-- ===== TAB · 项目 ===== -->
      <block wx:if="{{isSelf && activeTab === 'projects'}}">
        <view class="pc-sec-head">
          <text class="pc-sec-tit pc-sec-tit--flush pc-sec-tit--sm">我的订单</text>
          <view class="pc-sec-link" bindtap="goOrder" hover-class="cy-pressed" hover-stay-time="80" aria-role="button" aria-label="查看订单详情"><text>查看详情</text><cy-icon name="arrow-right" size="26" /></view>
        </view>
        <scroll-view wx:if="{{orderPreviewList.length}}" class="pc-hscroll" scroll-x enhanced show-scrollbar="{{false}}">
          <view class="pc-hscroll-inner">
            <view class="pc-proj-card" wx:for="{{orderPreviewList}}" wx:key="id" bindtap="onOrderPreviewTap" data-id="{{item.id}}" hover-class="cy-pressed" hover-stay-time="80">
              <view class="pc-proj-body">
                <view class="pc-proj-title">{{item.title}}</view>
                <view class="pc-proj-sub">{{item.sub}}</view>
              </view>
              <image wx:if="{{item.cover}}" class="pc-proj-thumb" src="{{item.cover}}" mode="aspectFill" />
            </view>
          </view>
        </scroll-view>
        <!-- 错误 ≠ 空态:加载失败时说明「订单本身还在」并给重试,不再渲染「暂无订单」 -->
        <cy-error wx:elif="{{orderErr}}" title="订单没加载出来" sub="已报名的订单都还在，只是这次没取到" retry="重试" bind:retry="reloadOrders" />
        <cy-empty wx:else title="暂无订单" sub="去探索城市活动，报名后即可在这里查看" />

        <!-- C7:唯一管理入口(原「我的模板」section 并入我的项目页的模板 tab);角标=未通过+审核中 -->
        <view class="pc-sec-head">
          <view class="pc-sec-left">
            <text class="pc-sec-tit pc-sec-tit--sm">我的项目</text>
            <view class="pc-sec-badge" wx:if="{{projectPendingCount > 0}}">{{projectPendingCount}}</view>
          </view>
          <view class="pc-sec-link" bindtap="goProject" hover-class="cy-pressed" hover-stay-time="80" aria-role="button" aria-label="管理全部项目"><text>管理全部</text><cy-icon name="arrow-right" size="26" /></view>
        </view>
        <view class="pc-xbox-list" wx:if="{{projectPreviewList.length}}">
          <view class="pc-xbox-proj" wx:for="{{projectPreviewList}}" wx:key="id" bindtap="onProjectPreviewTap" data-id="{{item.id}}" hover-class="cy-pressed" hover-stay-time="80">
            <view class="pc-xbox-cover-wrap">
              <image class="pc-xbox-cover" src="{{item.cover}}" mode="aspectFill" />
            </view>
            <view class="pc-xbox-main">
              <view class="pc-xbox-name">{{item.name}}</view>
              <view class="pc-xbox-time">{{item.timeLabel}}</view>
            </view>
            <!-- 档期未知时 statusLabelOf 回空串:不渲染空的章壳,也不编一个状态 -->
            <view wx:if="{{item.statusText}}" class="pc-xbox-status {{item.statusDone ? 'pc-xbox-status--done' : ''}}">{{item.statusText}}</view>
          </view>
        </view>
        <cy-error wx:elif="{{projectErr}}" title="项目没加载出来" sub="你发布的项目都还在，只是这次没取到" retry="重试" bind:retry="reloadProjects" />
        <cy-empty wx:elif="{{projectAllEnded}}" title="已结束的项目已收起" sub="在「管理全部」里查看全部项目" />
        <cy-empty wx:else title="还没有项目" sub="发布路线与场次，在这里统一管理" />

        <!-- 我的资产(2026-08-08 用户定):与「我的订单」「我的项目」并列的第三段。
             资金相关全部收进这里,详情走账户收益页(余额/收益明细/分润/提现/提现记录都在那)。
             余额直接读 userInfo.balance,零新增请求;整段在 isSelf 分支内,别人主页看不到。 -->
        <view class="pc-sec-head">
          <text class="pc-sec-tit pc-sec-tit--sm">我的资产</text>
          <view class="pc-sec-link" bindtap="goEarnings" hover-class="cy-pressed" hover-stay-time="80" aria-role="button" aria-label="查看资产详情"><text>查看详情</text><cy-icon name="arrow-right" size="26" /></view>
        </view>
        <!-- 空值口径复用 money.amount(空 → 「—」,0 照常渲 ¥0),不在这另起一套判断 -->
        <view class="pc-asset" bindtap="goEarnings" hover-class="pc-tap" hover-stay-time="80"
              aria-role="button" aria-label="我的资产，账户余额{{balanceText == null ? '暂未取到' : balanceText + '元'}}">
          <view class="pc-asset__main">
            <text class="pc-asset__label">账户余额</text>
            <text class="pc-asset__value {{balanceText == null ? 'pc-asset__value--empty' : ''}}">{{money.amount(balanceText)}}</text>
          </view>
          <cy-icon class="pc-asset__arrow" name="arrow-right" size="32" />
        </view>

        <!-- 商家 Owner 与员工共用的经营身份入口。放在资产之后：资产回答“钱在哪里”，
             团队回答“谁能经营”；权限与主题只认 access/me，不拿全局 role/userType 猜。 -->
        <view class="pc-team-entry" wx:if="{{isClubLeader}}">
          <cy-cell icon="/images/icon_tab_workbench.svg"
                   title="俱乐部工作台"
                   description="活动、成员与现场运营"
                   hairline="{{false}}"
                   bind:tap="goClubWorkbench" />
        </view>
        <view class="pc-team-entry" wx:if="{{merchantAccess.active}}">
          <cy-cell icon="/images/icon_qa_person.svg"
                   title="经营团队"
                   description="岗位权限、员工邀请与离职回收"
                   value="{{merchantTeamEntryValue}}"
                   hairline="{{false}}"
                   bind:tap="goMerchantTeam" />
        </view>
      </block>

      <!-- ===== TAB · 推文 ===== -->
      <block wx:if="{{activeTab === 'posts'}}">
        <view class="pc-feed">
          <cy-error wx:if="{{feedErr}}" title="动态没加载出来" sub="已发布的动态都还在，只是这次没取到" retry="重试" bind:retry="reloadFeed" />
          <cy-empty wx:elif="{{nodata}}" title="还没有推文" sub="{{isSelf ? '你还没有发布过推文' : 'TA 还没有发布推文'}}" />
          <view class="pc-post" wx:for="{{list}}" wx:key="id">
            <view class="pc-post-head">
              <cy-avatar size="sm64" src="{{item.memberAvatar || userInfo.avatar || '/images/d_profile.png'}}" name="{{item.memberNickname || userInfo.nickname}}" />
              <view class="pc-post-meta">
                <text class="pc-post-name">{{item.memberNickname || userInfo.nickname}}</text>
                <text class="pc-post-time">{{item.formattedCreateTime}}</text>
              </view>
            </view>
            <view class="pc-post-body" bindtap="jumpDetail" data-index="{{index}}" hover-class="cy-pressed" hover-stay-time="80">{{item.contents}}</view>
            <scroll-view wx:if="{{item.picList && item.picList.length}}" scroll-x class="pc-post-pics">
              <image wx:for="{{item.picList}}" wx:for-item="pic" wx:key="*this" src="{{pic}}" mode="aspectFill"
                     class="pc-post-pic" data-piclist="{{item.picList}}" data-index="{{index}}" catchtap="previewImage"  aria-role="button" aria-label="查看大图" hover-class="cy-pressed" hover-stay-time="80"/>
            </scroll-view>
            <view class="pc-post-tools">
              <view class="pc-tool" catchtap="lickClick" data-index="{{index}}" data-type="1" hover-class="cy-pressed" hover-stay-time="80">
                <image class="pc-tool-ico" src="{{item.isLiked==1 ? '/images/icon_sjt_h.png' : '/images/icon_sjt.png'}}" mode="widthFix" />{{item.likeCount || 0}}
              </view>
              <view class="pc-tool" catchtap="lickClick" aria-role="button" aria-label="点赞" data-index="{{index}}" data-type="2" hover-class="cy-pressed" hover-stay-time="80">
                <image class="pc-tool-ico" src="{{item.isLiked==2 ? '/images/icon_xjt_h.png' : '/images/icon_xjt.png'}}" mode="widthFix" />
              </view>
              <view class="pc-tool {{item.isBookmarked==1 ? 'is-on' : ''}}" catchtap="favoriteClick" data-index="{{index}}" aria-role="button" aria-label="{{item.isBookmarked==1 ? '取消收藏' : '收藏动态'}}" aria-pressed="{{item.isBookmarked==1}}" hover-class="cy-pressed" hover-stay-time="80">
                <cy-icon name="{{item.isBookmarked==1 ? 'star-filled' : 'star'}}" size="36" />
              </view>
              <button class="pc-tool pc-tool-share" open-type="share" data-id="{{item.id}}" aria-label="转发动态">
                <image class="pc-tool-ico" src="/images/icon_share.png" mode="widthFix" />
              </button>
            </view>
          </view>
        </view>
      </block>

      <!-- ===== TAB · 成就 ===== -->
      <block wx:if="{{activeTab === 'achievements'}}">
        <block wx:if="{{isSelf}}">
        <view class="pc-achievement-metrics" wx:if="{{profileMetricState === 'ready'}}">
        <view class="pc-gs-row">
          <view class="pc-gs-main" aria-label="城瘾积分 {{profilePoint}}">
            <text class="pc-gs-icon" aria-hidden="true">G</text>
            <text class="pc-gs-num">{{profilePoint}}</text>
          </view>
          <!-- 用 view 而非 text:微信 hover-class 只在 view/button/navigator/cover-view 上生效,
               text 组件没有这个属性,写了也是死的(全仓 14 处 hover-class 无一在 text 上)。 -->
          <view class="pc-gs-link" bindtap="onPointsHelp" hover-class="pc-tap-text" hover-stay-time="80"
                aria-role="button" aria-label="如何获取积分">如何获取积分</view>
        </view>

        <view class="pc-rank" bindtap="goGrowthCenter" hover-class="pc-tap" hover-stay-time="80"
              aria-role="button" aria-label="本月排名 {{rankDisplay.no}},查看成长中心详情">
          <!-- 只有城市榜。后端 /api/user/points/statistics 无 scope 入参,
               拿不到全国/好友/俱乐部榜 —— 有了再加回选择器,别先摆控件后补数据。 -->
          <text class="pc-rank-title">本月排名 · {{cityName}}</text>
          <view class="pc-rank-body">
            <view class="pc-rank-left">
              <text class="pc-rank-no">{{rankDisplay.no}}</text>
              <text class="pc-rank-delta" wx:if="{{rankDisplay.delta}}">{{rankDisplay.delta}}</text>
            </view>
            <view class="pc-rank-sep"></view>
            <view class="pc-rank-right">
              <text class="pc-rank-k">累计探索</text>
              <text class="pc-rank-v">{{exploreStat.shops || 0}}家店</text>
              <text class="pc-rank-exp">本周 +{{exploreStat.weekExp}} EXP</text>
            </view>
          </view>
          <view class="pc-compare"><text>查看详情</text><cy-icon name="arrow-right" size="28" /></view>
        </view>

        <!-- 未收编 cy-cell:本行的 aria-role/aria-label 是无障碍必需,而 cy-cell 不透传 aria
             (组件只在 open-type 的 button 上有 aria-label),全仓也无 aria 挂自定义组件的先例。
             收编会静默丢掉这两个属性 ⇒ 等 cy-cell 支持 aria 透传再收。 -->
        <view class="pc-wall" bindtap="goWall" hover-class="pc-tap" hover-stay-time="80"
              aria-role="button" aria-label="勋章墙,实时数字装置,查看全部勋章">
          <view class="pc-wall-l">
            <text class="pc-wall-t">勋章墙</text>
            <text class="pc-wall-s">实时数字装置 · 查看全部勋章</text>
          </view>
          <cy-icon class="pc-wall-arrow" name="arrow-right" size="32" />
        </view>

        <view class="pc-wall" bindtap="goAlbum" hover-class="pc-tap" hover-stay-time="80"
              aria-role="button" aria-label="集邮册,上街拍到的城市,查看全部邮票">
          <view class="pc-wall-l">
            <text class="pc-wall-t">集邮册</text>
            <text class="pc-wall-s">上街拍到的城市 · 查看全部邮票</text>
          </view>
          <cy-icon class="pc-wall-arrow" name="arrow-right" size="32" />
        </view>

        <!-- 未收编 cy-cell:与上面两行同一条理由(cy-cell 不透传 aria,收编会静默丢掉无障碍名) -->
        <view class="pc-wall" bindtap="goObjectCards" hover-class="pc-tap" hover-stay-time="80"
              aria-role="button" aria-label="藏品册,玩的时候拍下的东西,查看全部藏品卡">
          <view class="pc-wall-l">
            <text class="pc-wall-t">藏品册</text>
            <text class="pc-wall-s">玩的时候拍下的东西 · 查看全部藏品卡</text>
          </view>
          <cy-icon class="pc-wall-arrow" name="arrow-right" size="32" />
        </view>

        <view class="pc-sec-tit">城市勋章 · {{medalCount}}</view>
        <!-- 未收编 cy-card:同上,cy-card 读 --cy-comp-card-bg ⇒ 商家视角会渲成夜间深卡 -->
        <view class="pc-card pc-achv-list">
          <cy-error wx:if="{{medalErr}}" title="勋章没加载出来" sub="已点亮的勋章都还在，只是这次没取到" retry="重试" bind:retry="reloadMedals" />
          <cy-empty wx:elif="{{medals.length === 0}}" title="还没有点亮的勋章" sub="完成城市节点即可点亮" />
          <!-- medals 里只有【已点亮】的勋章,未点亮的不在列表里 —— 故此处没有进度可言,
               「已获得」由右侧 ✓ 表达。别再加进度条:它只会恒满。 -->
          <view class="pc-achv" wx:for="{{medals}}" wx:key="templateId"
                aria-label="{{item.medalName}},已获得">
            <image class="pc-achv-ico" wx:if="{{item.medalImg}}" src="{{item.medalImg}}" mode="aspectFill" aria-hidden="true" />
            <view class="pc-achv-ico pc-achv-ico--fallback" wx:else aria-hidden="true">
              <cy-icon name="star" size="40" />
            </view>
            <view class="pc-achv-main">
              <view class="pc-achv-name">{{item.medalName}}</view>
            </view>
            <!-- 收编 cy-icon:组件内部自带 aria-hidden,无障碍零损失 -->
            <cy-icon class="pc-achv-ok" name="check" size="32" />
          </view>
        </view>
        </view>
        <cy-empty wx:elif="{{profileMetricState === 'empty'}}" kind="empty" title="成长记录从第一次探索开始"
          sub="去完成一次城市探索，积分、排名与勋章会在这里出现" />
        <view wx:elif="{{profileMetricState === 'error'}}" class="pc-metric-error">
          <cy-error title="成长记录没加载出来" sub="记录都还在，只是这次没取到"
            retry="重新加载" bind:retry="reloadProfileMetrics" />
        </view>
        <cy-skeleton wx:else type="list" count="{{2}}" />
        </block>
        <view wx:else class="pc-public-achievements">
          <view class="pc-public-stat">
            <text class="pc-public-stat-n">{{(userInfo.topicNum || 0) + (userInfo.activityNum || 0)}}</text>
            <text class="pc-public-stat-l">发布内容</text>
          </view>
          <view class="pc-public-stat">
            <text class="pc-public-stat-n">{{userInfo.likeNum || 0}}</text>
            <text class="pc-public-stat-l">获赞</text>
          </view>
          <view class="pc-public-stat">
            <text class="pc-public-stat-n">{{userInfo.fansNum || 0}}</text>
            <text class="pc-public-stat-l">粉丝</text>
          </view>
        </view>
      </block>

      <!-- ===== TAB · 关于 ===== -->
      <block wx:if="{{activeTab === 'about'}}">
        <!-- ===== 关于 · 商家被看者 ===== -->
        <block wx:if="{{subjectIsMerchant}}">
          <!-- ⓪ 招牌主推(4-12/R9-33):商家在装修里置顶的活动或券,后端已核验归属与公开态;
               没选/已下架/已易主时 featured 为 null,整块不渲染,不给空壳卡。 -->
          <block wx:if="{{featured}}">
            <view class="pc-sec-tit pc-sec-tit--flush">招牌主推</view>
            <view class="pc-card pc-featured" bindtap="goFeatured"
                  aria-role="{{featured.actionable ? 'button' : ''}}"
                  aria-label="{{featured.actionable ? '查看主推 ' + featured.titleText : '招牌主推'}}"
                  hover-class="{{featured.actionable ? 'cy-pressed' : 'none'}}" hover-stay-time="80">
              <image wx:if="{{featured.imageUrl}}" class="pc-featured-img" src="{{featured.imageUrl}}" mode="aspectFill" />
              <view wx:else class="pc-featured-img pc-featured-img--fallback"><cy-icon name="star" size="40" /></view>
              <text class="pc-featured-title">{{featured.titleText}}</text>
              <cy-icon wx:if="{{featured.actionable}}" class="pc-featured-arrow" name="arrow-right" size="24" />
            </view>
          </block>

          <!-- ① 品牌故事:两者都空只给一次克制空态,不替商家编文案 -->
          <block wx:if="{{subjectMerchant.storyTitle || subjectMerchant.description}}">
            <view class="pc-sec-tit {{featured ? '' : 'pc-sec-tit--flush'}}">{{subjectMerchant.storyTitle || '品牌故事'}}</view>
            <view class="pc-card pc-about" wx:if="{{subjectMerchant.description}}">{{subjectMerchant.description}}</view>
          </block>
          <cy-empty wx:else title="还没有品牌故事" sub="商家完善资料后，这里会展示品牌介绍" />

          <!-- ② 门店相册:空则整块不渲染 -->
          <block wx:if="{{merchantGallery.length}}">
            <view class="pc-sec-tit">门店相册</view>
            <scroll-view class="pc-hscroll" scroll-x enhanced show-scrollbar="{{false}}">
              <view class="pc-hscroll-inner">
                <image wx:for="{{merchantGallery}}" wx:key="*this" class="pc-mgimg" src="{{item}}" mode="aspectFill"
                       data-src="{{item}}" bindtap="previewMerchantGallery"  aria-role="button" aria-label="查看大图" hover-class="cy-pressed" hover-stay-time="80"/>
              </view>
            </scroll-view>
          </block>

          <!-- ③ 品类 -->
          <block wx:if="{{merchantCategories.length}}">
            <view class="pc-sec-tit">品类</view>
            <view class="pc-tags">
              <text class="pc-tag" wx:for="{{merchantCategories}}" wx:key="id">{{item.categoryName}}</text>
            </view>
          </block>

          <!-- ④ 特色标签 -->
          <block wx:if="{{merchantTags.length}}">
            <view class="pc-sec-tit">特色标签</view>
            <view class="pc-tags">
              <text class="pc-tag" wx:for="{{merchantTags}}" wx:key="*this">{{item}}</text>
            </view>
          </block>

          <!-- ⑤ 营业信息:有有效经纬度时地址才可点,没有坐标就是纯文本,不给点不动的假链接 -->
          <view class="pc-sec-tit">营业信息</view>
          <view class="pc-card pc-mrows">
            <view class="pc-mrow">
              <text class="pc-mrow-k">营业状态</text>
              <text class="pc-mrow-v">{{subjectMerchant.businessStatusText}}</text>
            </view>
            <view class="pc-mrow" wx:if="{{subjectMerchant.businessTime}}">
              <text class="pc-mrow-k">营业时间</text>
              <text class="pc-mrow-v">{{subjectMerchant.businessTime}}</text>
            </view>
            <view class="pc-mrow" wx:if="{{subjectMerchant.address}}" bindtap="goMerchantLocation"
                  aria-role="{{merchantHasGeo ? 'button' : ''}}" aria-label="{{merchantHasGeo ? '在地图上查看门店地址' : ''}}" hover-class="{{merchantHasGeo ? 'cy-pressed' : 'none'}}" hover-stay-time="80">
              <text class="pc-mrow-k">门店地址</text>
              <text class="pc-mrow-v {{merchantHasGeo ? 'pc-mrow-v--link' : ''}}">{{subjectMerchant.address}}</text>
            </view>
            <view class="pc-mrow" bindtap="goMerchantReviews" aria-role="button" aria-label="查看真实评价" hover-class="cy-pressed" hover-stay-time="80">
              <text class="pc-mrow-k">真实评价</text>
              <view class="pc-mrow-v pc-mrow-v--link"><text>核销用户评价与商家回复</text><cy-icon name="arrow-right" size="24" /></view>
            </view>
          </view>

          <!-- ⑥ 承接能力:四项全空则整块不渲染,不留一个空标题配空框 -->
          <block wx:if="{{subjectMerchant.capacityText || subjectMerchant.suitActivityTypes || subjectMerchant.availableTime || subjectMerchant.demand}}">
            <view class="pc-sec-tit">承接能力</view>
            <view class="pc-card pc-mrows">
              <view class="pc-mrow" wx:if="{{subjectMerchant.capacityText}}">
                <text class="pc-mrow-k">可容纳</text>
                <text class="pc-mrow-v">{{subjectMerchant.capacityText}}</text>
              </view>
              <view class="pc-mrow" wx:if="{{subjectMerchant.suitActivityTypes}}">
                <text class="pc-mrow-k">适合路线</text>
                <text class="pc-mrow-v">{{subjectMerchant.suitActivityTypes}}</text>
              </view>
              <view class="pc-mrow" wx:if="{{subjectMerchant.availableTime}}">
                <text class="pc-mrow-k">可承接时段</text>
                <text class="pc-mrow-v">{{subjectMerchant.availableTime}}</text>
              </view>
              <view class="pc-mrow" wx:if="{{subjectMerchant.demand}}">
                <text class="pc-mrow-k">合作诉求</text>
                <text class="pc-mrow-v">{{subjectMerchant.demand}}</text>
              </view>
            </view>
          </block>
        </block>

        <!-- 探测中:不知道是谁就先别渲染任何一套 About -->
        <cy-skeleton wx:elif="{{merchantState === 'loading'}}" type="list" count="{{2}}" />

        <!-- 网络失败:绝不回退成玩家 About 或「商家未完善」——那是拿「没查到」冒充业务事实 -->
        <view wx:elif="{{merchantState === 'network-error'}}" class="pc-metric-error">
          <cy-error title="资料没加载出来" sub="这次没取到，重试一下"
            retry="重新加载" bind:retry="retryMerchantProbe" />
        </view>

        <!-- ===== 关于 · 玩家 / 俱乐部被看者(原样不动) ===== -->
        <block wx:else>
        <view class="pc-about-head">
          <view class="pc-sec-tit pc-sec-tit--flush">个人介绍</view>
          <view class="pc-about-edit" wx:if="{{isSelf}}" bindtap="goEditIntro" aria-role="button" aria-label="编辑个人介绍" hover-class="cy-pressed" hover-stay-time="80">
            <cy-icon name="edit" size="28" />
            <text>编辑</text>
          </view>
        </view>
        <view class="pc-card pc-about">{{userInfo.introduction || '还没有写个人介绍，完善资料后可展示'}}</view>

        <view class="pc-sec-tit">兴趣标签</view>
        <view class="pc-tags">
          <text class="pc-tag" wx:for="{{categoryList}}" wx:key="id">{{item.categoryName}}</text>
          <text class="pc-tag pc-tag--muted" wx:if="{{categoryList.length === 0}}">完善资料后可展示兴趣</text>
        </view>

        <view class="pc-sec-tit" wx:if="{{casePicsList.length}}">探索作品</view>
        <view class="pc-works" wx:if="{{casePicsList.length}}">
          <image wx:for="{{casePicsList}}" wx:key="*this" src="{{item}}" mode="aspectFill" class="pc-work-pic"
                 data-url="{{item}}" bindtap="previewWork"  aria-role="button" aria-label="查看大图" hover-class="cy-pressed" hover-stay-time="80"/>
        </view>

        <cy-cell wx:if="{{isSelf}}" class="pc-solo-cell" title="加入时间" value="{{joinDate}}" arrow="{{false}}" hairline="{{false}}" />

        <block wx:if="{{isSelf}}">
        <!-- 入口收纳(ADA §二G):原「探索与成长 / 更多 / 会员续费」三段共 6 行整宽 cell,
             压成一块 4 列图标网格(角色互斥 ⇒ 常态正好 2 行)。入口本身一个不增不减、
             跳转全部沿用原方法;去掉的只是每行那句说明文案 —— 标签已自明。
             ⚠️ 角标数字不做:钱包/票券余量在现有接口里没有字段,补一次请求去凑 = 新增接口调用(禁)。 -->
        <!-- 2026-08-20 用户定:商家视角不出现「探索与更多」(收益入口在我的资产,其余为玩家向);
             玩家/俱乐部保留优惠券、邀请好友与投诉建议。 -->
        <view class="pc-sec-tit" wx:if="{{!isMerchantView}}">探索与更多</view>
        <view class="pc-entries" wx:if="{{!isMerchantView}}">
          <view class="pc-entry" wx:if="{{isClubLeader}}" bindtap="goClub" hover-class="pc-tap" hover-stay-time="80"
                aria-role="button" aria-label="{{clubOwnedCount >= 1 ? '俱乐部管理台' : '创建俱乐部'}}">
            <view class="pc-entry-ico"><cy-icon name="tab-club" size="40" /></view>
            <text class="pc-entry-t">{{clubOwnedCount >= 1 ? '俱乐部' : '创建俱乐部'}}</text>
          </view>
          <view class="pc-entry" wx:if="{{!isClubLeader && role === 'player'}}" bindtap="goBecomeTalent" hover-class="pc-tap" hover-stay-time="80"
                aria-role="button" aria-label="成为主理人，创建俱乐部">
            <view class="pc-entry-ico"><cy-icon name="tab-club" size="40" /></view>
            <text class="pc-entry-t">成为主理人</text>
          </view>
          <view class="pc-entry" bindtap="goEarnings" hover-class="pc-tap" hover-stay-time="80"
                aria-role="button" aria-label="我的收益，账户余额与俱乐部分润">
            <view class="pc-entry-ico"><cy-icon name="finance" size="40" /></view>
            <text class="pc-entry-t">我的收益</text>
          </view>
          <view class="pc-entry" bindtap="goCoupon" hover-class="pc-tap" hover-stay-time="80"
                aria-role="button" aria-label="优惠券">
            <view class="pc-entry-ico"><cy-icon name="coupon" size="40" /></view>
            <text class="pc-entry-t">优惠券</text>
          </view>
          <view class="pc-entry" bindtap="goInvite" hover-class="pc-tap" hover-stay-time="80"
                aria-role="button" aria-label="邀请好友，分享城瘾给好友">
            <view class="pc-entry-ico"><cy-icon name="gift" size="40" /></view>
            <text class="pc-entry-t">邀请好友</text>
          </view>
          <view class="pc-entry" bindtap="goComplaint" hover-class="pc-tap" hover-stay-time="80"
                aria-role="button" aria-label="投诉与建议，对已参与的活动发起投诉">
            <view class="pc-entry-ico"><cy-icon name="warning" size="40" /></view>
            <text class="pc-entry-t">投诉建议</text>
          </view>
        </view>

        <view class="pc-sec-tit">当前权益</view>
        <view class="pc-benefits">
          <view class="pc-benefit {{item.unlocked ? '' : 'pc-benefit--lock'}}" wx:for="{{benefits}}" wx:key="text"
                bindtap="onBenefitTap" data-route="{{item.route}}" data-unlocked="{{item.unlocked}}" hover-class="cy-pressed" hover-stay-time="80">
            <view class="pc-benefit-dot"><cy-icon name="{{item.unlocked ? 'check' : 'lock'}}" size="24" /></view>
            <text class="pc-benefit-text">{{item.text}}</text>
            <cy-icon class="pc-benefit-arrow" wx:if="{{item.route && item.unlocked}}" name="arrow-right" size="32" />
          </view>
        </view>
        </block>
        </block>
      </block>

      <view style="height:180rpx;"></view>
    </view>
  </scroll-view>

  <!-- ★ tabBar 必须待在 .pc-page 里面:它读 --cy-color-bg-surface / -text-secondary,挂在容器外
       就取不到 theme-merchant 的日间值,商家态底栏会解析成夜间深色(2026-08-04 实拍:白页配黑底栏)。
       变量继承不受自定义组件样式隔离影响(隔离挡的是类选择器),position:fixed 也不受影响
       —— .pc-page 上没有 transform/filter,fixed 仍相对视口。 -->
  <!-- 只有 tabBar 宿主(pages/member/index)挂底栏:本人从 canonical 进 userinfo 时
       effectiveIsSelf 也为真,但那不是 tabBar 页,挂上去就是一条点不通的假底栏。 -->
  <tabBar wx:if="{{hostSelf}}" mode="{{isMerchantView ? 'merchant' : 'consumer'}}" activeKey="{{isMerchantView ? 'mine' : ''}}" dark="{{!isMerchantView}}" />

  <!-- 发起合作 CTA:访客看商家主页(coop/invite type=0,达人→商家)。同 tabBar 理由必须留在
       .pc-page 内,商家态才取得到 theme-merchant 日间 token(黑白按钮,不带金色)。
       滚动区尾部既有 180rpx 空垫,底栏不会盖住正文。
       2026-09-16 用户拍板 #13:商家当主办方时也要能邀请商家承接章节 —— 带主题上下文进来的
       商家观看者(从「去找商家」/项目页带着 topicId)同样渲染这颗 CTA;不带上下文的普通
       商家浏览仍不渲染(维持 2026-08-20 H1 对「商家看商家」的收口)。 -->
  <view wx:if="{{isMerchantView && !isSelf && (!viewerIsMerchant || topicId)}}" class="pc-coop-bar">
    <view class="pc-coop-btn" bindtap="onCoopInvite" aria-role="button" aria-label="向该商家发起合作" hover-class="cy-pressed" hover-stay-time="80">发起合作</view>
  </view>
</view>

<!-- 页内弹层统一交给 sceneStack；公开主页不挂自有场景宿主。 -->
<view class="scene-host" wx:if="{{sceneCurrent && sceneCurrent.id === 'member-more-menu'}}" catchtouchmove="blockSceneTouch">
<cy-scene-sheet show="{{true}}" variant="{{sceneCurrent.variant}}" theme="{{isMerchantView ? 'merchant' : 'player'}}" title="{{sceneCurrent.title}}" mask-closable="{{sceneCurrent.maskClosable}}" bind:requestclose="closeMoreMenu">
  <!-- UI-12:公开视角的「···」只给「分享主页 / 屏蔽」;改资料/背景/设置是本人的操作,不在公开视角出现。 -->
  <cy-cell wx:if="{{isSelf && isMerchantView}}" title="店铺资料" arrow="{{false}}" bind:tap="goShop" />
  <cy-cell title="分享主页" arrow="{{false}}" bind:tap="onShareProfile" />
  <cy-cell wx:if="{{isSelf}}" title="更换背景图 · 16:9 横图" arrow="{{false}}" bind:tap="onChangeHeroBg" />
  <cy-cell wx:if="{{isSelf}}" title="设置" arrow="{{false}}" bind:tap="onMoreSetting" />
  <!-- CU-M-43(2026-09-23 用户裁决 B):「屏蔽」暂不开放。原入口只弹一句「已屏蔽」,
       既不写关系数据也不落本地态,重进页面一切照旧 —— 是句假成功。写口接通前这里不放
       这条 cell,也不用「暂未开放」的理由行占位(不可点的行读起来仍像一个能用的功能)。 -->
</cy-scene-sheet>
</view>

<!-- [P0-2] ③ 选章核销:一商家在同一路线承接多章是常态 ⇒ 交集≥2 时由他自己选,
     选完调 scan_qr_code_chapter。不用 wx.showActionSheet —— 它的 itemList 上限 6 项,
     超了就得截断 = 静默丢选项。 -->
<view class="scene-host" wx:if="{{sceneCurrent && sceneCurrent.id === 'member-chapter-picker'}}" catchtouchmove="blockSceneTouch">
<cy-scene-sheet show="{{true}}" variant="{{sceneCurrent.variant}}" theme="{{isMerchantView ? 'merchant' : 'player'}}" title="{{sceneCurrent.title}}" mask-closable="{{sceneCurrent.maskClosable}}" bind:requestclose="onChapterSheetClose">
  <view class="chpick">
    <view class="chpick__hint">你在本路线承接了多个章节,请选择本次要核销的那一个</view>
    <view class="chpick__item" wx:for="{{chapterSheet.items}}" wx:key="id"
          data-id="{{item.id}}" bindtap="onChapterPick" hover-class="cy-pressed" hover-stay-time="80">
      <text class="chpick__name">{{item.name}}</text>
      <cy-icon class="chpick__chev" name="arrow-right" size="32" />
    </view>
  </view>
</cy-scene-sheet>
</view>

<view class="scene-host" wx:if="{{sceneCurrent && sceneCurrent.id === 'member-station-picker'}}" catchtouchmove="blockSceneTouch">
<cy-scene-sheet show="{{true}}" variant="{{sceneCurrent.variant}}" theme="{{isMerchantView ? 'merchant' : 'player'}}" title="{{sceneCurrent.title}}" mask-closable="{{sceneCurrent.maskClosable}}" bind:requestclose="onStationSheetClose">
  <view class="chpick">
    <view class="chpick__hint">你在本路线承接了多个据点,请选择本次实际核销的据点</view>
    <view class="chpick__item" wx:for="{{stationSheet.items}}" wx:key="registrationMerchantId"
          data-registration-merchant-id="{{item.registrationMerchantId}}" bindtap="onStationPick" hover-class="cy-pressed" hover-stay-time="80">
      <text class="chpick__name">{{item.name}}</text>
      <cy-icon class="chpick__chev" name="arrow-right" size="32" />
    </view>
  </view>
</cy-scene-sheet>
</view>

<!-- 积分任务:双列统计头(我的积分/本周获得)+ 票券式虚线分隔 + 任务行(名称/说明 · +分值/完成态) -->
<view class="scene-host" wx:if="{{sceneCurrent && sceneCurrent.id === 'points-tasks'}}" catchtouchmove="blockSceneTouch">
<cy-scene-sheet show="{{true}}" variant="{{sceneCurrent.variant}}" theme="{{sceneCurrent.theme}}" title="{{sceneCurrent.title}}" mask-closable="{{sceneCurrent.maskClosable}}" bind:requestclose="onPointsSheetClose">
  <view class="pts-hero">
    <view class="pts-hero__col">
      <view class="pts-hero__label">我的积分</view>
      <view class="pts-hero__num">{{userInfo.point || 0}}</view>
    </view>
    <view class="pts-hero__div"></view>
    <view class="pts-hero__col">
      <view class="pts-hero__label">本周获得</view>
      <view class="pts-hero__num">+{{pointsStat.weekPoints}}</view>
    </view>
  </view>
  <cy-skeleton wx:if="{{pointsSheet.loading}}" type="list" count="{{3}}" />
  <view wx:elif="{{pointsSheet.failed}}" class="pts-loading cy-fade-in" bindtap="loadPointsTasks" hover-class="cy-pressed" hover-stay-time="80">加载失败,点此重试</view>
  <cy-empty wx:elif="{{pointsSheet.loaded && !pointsSheet.tasks.length}}" title="暂无积分任务" sub="积分规则上线后会出现在这里" />
  <view wx:else class="pts-list">
    <view class="pts-row" wx:for="{{pointsSheet.tasks}}" wx:key="id">
      <view class="pts-row__main">
        <view class="pts-row__name">{{item.title}}</view>
        <view class="pts-row__desc" wx:if="{{item.description}}">{{item.description}}</view>
      </view>
      <view class="pts-row__side">
        <view class="pts-row__gain">+{{item.points}}</view>
        <view class="pts-row__done {{item.doneCount ? '' : 'is-zero'}}">{{item.doneCount ? '已获 ' + item.doneCount + ' 次' : '待完成'}}</view>
      </view>
    </view>
  </view>
</cy-scene-sheet>
</view>

<!-- 账户/订单/参与/收益统一挂在“我的”根场景；内容组件只读真实接口，宿主只管理栈。 -->
<view class="member-scene-host" wx:if="{{sceneCurrent && sceneCurrent.id !== 'qr-coupon' && sceneCurrent.id !== 'share-invite' && sceneCurrent.id !== 'member-more-menu' && sceneCurrent.id !== 'member-chapter-picker' && sceneCurrent.id !== 'member-station-picker' && sceneCurrent.id !== 'points-tasks'}}" catchtouchmove="blockSceneTouch">
  <cy-scene-sheet show="{{true}}" variant="{{sceneCurrent.variant}}" theme="{{sceneCurrent.theme}}" title="{{sceneCurrent.title}}" can-back="{{sceneCurrent.canBack}}" dirty="{{sceneCurrent.dirty}}" mask-closable="{{sceneCurrent.maskClosable}}" footer="{{sceneCurrent.footer}}" bind:requestclose="requestSceneClose" bind:back="backScene">
    <cy-scene-route-content id="sceneRouteContent" scene-id="{{sceneCurrent.id}}" params="{{sceneCurrent.params}}" theme="{{sceneCurrent.theme}}" bind:open="openChildScene" bind:back="backScene" bind:close="closeScene" bind:dirtychange="onSceneDirtyChange" />
    <view wx:if="{{sceneCurrent.footer}}" slot="footer" class="member-scene-footer">
      <cy-btn variant="primary" bindtap="submitSceneForm">{{sceneCurrent.id === 'member-withdraw' ? '确认提现' : sceneCurrent.id === 'settings-profile' ? '保存资料' : sceneCurrent.id === 'settings-feedback' ? '提交建议' : sceneCurrent.id === 'merchant-apply' ? '提交入驻申请' : sceneCurrent.id === 'club-apply' ? '提交申请' : sceneCurrent.id === 'merchant-citynode' ? '提交互动模板' : '保存'}}</cy-btn>
    </view>
  </cy-scene-sheet>
</view>
<view class="member-scene-host" wx:if="{{sceneCurrent && sceneCurrent.id === 'share-invite'}}" catchtouchmove="blockSceneTouch">
  <cy-scene-sheet show="{{true}}" variant="{{sceneCurrent.variant}}" theme="{{sceneCurrent.theme}}" title="{{sceneCurrent.title}}" can-back="{{sceneCurrent.canBack}}" dirty="{{sceneCurrent.dirty}}" mask-closable="{{sceneCurrent.maskClosable}}" bind:requestclose="requestSceneClose" bind:back="backScene">
    <cy-scene-share-invite theme="{{sceneCurrent.theme}}" />
  </cy-scene-sheet>
</view>
<view class="member-scene-host" wx:if="{{sceneCurrent && sceneCurrent.id === 'qr-coupon'}}" catchtouchmove="blockSceneTouch">
  <cy-scene-sheet show="{{true}}" variant="{{sceneCurrent.variant}}" theme="{{sceneCurrent.theme}}" title="{{sceneCurrent.title}}" can-back="{{sceneCurrent.canBack}}" dirty="{{sceneCurrent.dirty}}" mask-closable="{{sceneCurrent.maskClosable}}" bind:requestclose="requestSceneClose" bind:back="backScene">
    <cy-scene-qr-coupon coupon-history-id="{{sceneCurrent.params.couponHistoryId}}" name="{{sceneCurrent.params.name}}" bind:close="backScene" />
  </cy-scene-sheet>
</view>
<cy-modal wx:if="{{isSelf}}" class="{{isMerchantView ? 'theme-merchant' : 'theme-dark'}}" show="{{sceneConfirm.show}}" title="放弃未保存修改？" content="关闭后，本次修改不会保留。" confirm-text="放弃修改" cancel-text="继续编辑" danger bind:confirm="confirmSceneDiscard" bind:cancel="cancelSceneDiscard" />

<!-- 门店 NPC 对话。bizId = 商家 id;与漫游轨共用 cy-npc-chat 壳,靠 scope 选端点。 -->
<cy-npc-chat wx:if="{{subjectIsMerchant && subjectMerchant.npc}}"
  show="{{merchantNpcChatShow}}"
  scope="merchant"
  session-id="{{subjectMerchant.id}}"
  npc-name="{{subjectMerchant.npc.name}}"
  greeting="{{subjectMerchant.npc.greeting}}"
  bind:close="closeMerchantNpcChat" />

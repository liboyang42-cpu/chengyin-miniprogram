@import '../../../style/fade-in.wxss';

:host { display: block; height: 100%; }
.aid { --cy-tabs-fade-bg: var(--cy-comp-sheet-player-bg); width: 100%; min-height: 100%; box-sizing: border-box; display: flex; flex-direction: column; padding-bottom: calc(var(--cy-space-4) + env(safe-area-inset-bottom)); }
/* 独立页宿主(收益明细页)无弹层底,渐隐端改跟页底,否则右缘露一块弹层色矩形(2026-09-19 实拍) */
.aid--page { --cy-tabs-fade-bg: var(--cy-color-bg-page); }

/* .id-sheet-title 随组件内重复标题一并移除(标题由弹层头出,见 wxml 注释)。
   它原来还负责「标题到筛选 tab」那一档间距,tab 现在成了正文首个元素 ⇒ 顶距由 .id-tabs 自己补。 */
.id-tabs { margin-top: var(--cy-space-2); margin-bottom: var(--cy-space-4); }

/* 玩家记录卡与 scene-roam-history 共用半透明层级；独立页保留原 token fallback。 */
.id-list { padding: var(--cy-space-2); background: var(--cy-scene-card-bg, var(--cy-color-bg-surface-strong)); border-radius: var(--cy-scene-card-radius, var(--cy-radius-lg)); }
.id-item { display: flex; align-items: center; min-height: 152rpx; padding: 0 var(--cy-space-3); box-sizing: border-box; }
.id-item + .id-item { margin-top: var(--cy-space-1); }
.id-more { min-height: var(--cy-btn-h); display: flex; align-items: center; justify-content: center; color: var(--cy-text-title); font-size: var(--cy-font-label); font-weight: 600; }
.id-state-fill { display: flex; flex-direction: column; flex: 1; justify-content: center; }

.id-item-badge { width: var(--cy-space-7); height: var(--cy-space-7); border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-right: 32rpx; box-shadow: var(--cy-shadow-card); }
.id-item-badge__txt { font-size: var(--cy-font-body); font-weight: 700; line-height: 1; }
.id-item-badge--create,
.id-item-badge--brand { background: var(--cy-bg-elevated); }
.id-item-badge--create .id-item-badge__txt,
.id-item-badge--brand .id-item-badge__txt { color: var(--cy-text-title); }
.id-item-info { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: var(--cy-space-2); }
.id-item-title { overflow: hidden; color: var(--cy-text-title); font-size: var(--cy-font-body); font-weight: 600; white-space: nowrap; text-overflow: ellipsis; }
.id-item-meta { display: flex; align-items: center; gap: 16rpx; }
.id-item-date,
.id-item-status { color: var(--cy-text-secondary); font-size: var(--cy-font-label); font-weight: 500; }
.id-item-sep { width: var(--cy-legacy-4); height: var(--cy-legacy-4); border-radius: 50%; background: var(--cy-bg-subtle); flex-shrink: 0; }
/* 原 .id-item-status--pending 与基类同色(恒等于没生效),随「假状态」一起去掉 */
.id-item-right { display: flex; flex-direction: column; align-items: flex-end; flex-shrink: 0; margin-left: var(--cy-space-2-5); }
.id-item-amount { color: var(--cy-text-title); font-size: var(--cy-font-subtitle); font-weight: 600; white-space: nowrap; }
/* 用户裁决:入账绿、出账红。走 DS 的 status token,不自造字面色(自造会撞 ds-hardcode-gate,
   且主题一改就漂)。实测落在本卡底 rgba(255,255,255,.06) 合成于 #1C1C1E ≈ #2A2A2C 上:
   绿 #12B886 = 5.64:1 过 AA;红 #E5484D = 3.68:1,过大字号档但差 4.5 —— 暗色域红色阶里
   没有更亮的一档,要提上去得动全局 --cy-color-status-danger,那是另一个决定。
   方向不只靠色:amountText 自带 +/− 号,meta 行还写着「收入 / 支出」。 */
.id-item-amount--in { color: var(--cy-success); }
.id-item-amount--out { color: var(--cy-danger); }

/* isolated 组件内全局 .cy-pressed 进不来,必须本地定义一份。
   只减淡不位移:位移要配 .cy-motion-reduced 兜底,而那个类挂在组件外的祖先上,
   isolated 下同样够不着 —— 与其留个撤不掉的位移,不如按仓库既有组件按压类的做法只减淡。 */
.cy-pressed { opacity: .88; }

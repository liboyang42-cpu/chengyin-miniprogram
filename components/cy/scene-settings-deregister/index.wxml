<view class="deregister-scene">
  <view class="deregister-card" wx:if="{{status === 'PENDING'}}">
    <text class="deregister-title">注销申请已提交</text>
    <text class="deregister-copy">账号功能已冻结。你可以在冷静期结束前撤销申请。</text>
    <text class="deregister-time">{{executeAfter ? '预计执行时间：' + executeAfter : '执行时间待确认'}}</text>
    <cy-error wx:if="{{cancelError}}" title="撤销没有完成" sub="{{cancelError}}" retry="重试" bind:retry="cancel" />
    <cy-btn class="deregister-action" variant="secondary" loading="{{canceling}}" disabled="{{canceling}}" bindtap="cancel">撤销注销申请</cy-btn>
  </view>

  <view class="deregister-card" wx:elif="{{status === 'ELIGIBLE'}}">
    <text class="deregister-copy">注销后账号无法恢复；公开内容将匿名化，依法需要留存的交易记录将停止用于其他目的。</text>
    <text class="deregister-link" bindtap="goCancellationNotice" hover-class="cy-pressed" hover-stay-time="80">查看《账号注销须知》</text>
    <checkbox-group bindchange="toggleConfirmed"><label class="deregister-check"><checkbox value="confirmed" color="#1a1a1a"/>我已阅读并理解注销后果</label></checkbox-group>
    <view class="deregister-code-row"><input class="deregister-code-input" placeholder="短信验证码" value="{{smscode}}" bindinput="inputCode" maxlength="6" aria-label="短信验证码"/><text class="deregister-code-send {{smsSending ? 'is-disabled' : ''}}" bindtap="sendSms" aria-role="button" aria-disabled="{{smsSending}}" aria-label="{{smsSending ? '正在发送验证码' : '获取验证码'}}" hover-class="{{smsSending ? 'none' : 'cy-pressed'}}" hover-stay-time="80">{{smsSending ? '发送中…' : (smsSent ? '重新发送' : '获取验证码')}}</text></view>
    <text wx:if="{{smsSent}}" class="deregister-inline-status" aria-role="status">验证码已发送至尾号 {{phoneMasked}} 的手机号</text>
    <cy-error wx:elif="{{smsError}}" title="验证码没有发送" sub="{{smsError}}" retry="重试" bind:retry="sendSms" />
    <cy-error wx:if="{{applyError}}" title="注销申请没有提交" sub="{{applyError}}" retry="重试" bind:retry="apply" />
    <cy-btn class="deregister-action" variant="danger" loading="{{submitting}}" disabled="{{!canApply}}" bindtap="apply">确认申请注销</cy-btn>
  </view>

  <view class="deregister-card deregister-card--blocked" wx:elif="{{status === 'BLOCKED'}}">
    <text class="deregister-title deregister-title--danger">暂时无法注销</text>
    <text class="deregister-copy">请先处理以下事项：</text>
    <text class="deregister-blocker" wx:for="{{blockers}}" wx:key="*this">· {{item}}</text>
  </view>

  <cy-error wx:elif="{{status === 'ERROR'}}" fill title="注销条件核验失败" sub="{{statusError || '没能确认注销条件，请稍后重试。'}}" retry="重试" bind:retry="loadStatus" />

  <cy-empty class="deregister-loading" wx:elif="{{status === 'LOADING'}}" kind="loading" fill size="lg" title="正在核验注销条件" />
  <cy-error wx:else fill title="账号状态待确认" sub="当前状态无法识别，请重新核验。" retry="重试" bind:retry="loadStatus" />
</view>

<cy-agreement-sheet show="{{showNoticeSheet}}" type="deregister" theme="{{theme}}" bind:close="closeNoticeSheet" />

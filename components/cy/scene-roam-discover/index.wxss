/* 骨架屏→内容淡切:isolated 组件收不到全局 components.wxss,@import 同一份定义 */
@import '../../../style/fade-in.wxss';
:host { display: block; height: 100%; }
.discover-body { height: 100%; min-height: 0; display: flex; flex-direction: column; }
.discover-search { display: flex; align-items: center; gap: var(--cy-space-2); padding: var(--cy-space-2) 0; flex: none; }
.discover-search__input { flex: 1; min-width: 0; height: var(--cy-btn-h); box-sizing: border-box; padding: 0 var(--cy-space-3); border-radius: var(--cy-radius-pill); background: var(--cy-color-bg-surface-subtle); color: var(--cy-color-text-primary); font-size: var(--cy-type-body); }
.discover-search__button { min-height: var(--cy-btn-h); display: flex; align-items: center; padding: 0 var(--cy-space-3); border-radius: var(--cy-radius-pill); background: var(--cy-color-action-primary-bg); color: var(--cy-color-action-primary-fg); font-size: var(--cy-type-label); }
.discover-tags { flex: none; white-space: nowrap; padding: var(--cy-space-2) 0; }
.discover-tag { display: inline-flex; align-items: center; min-height: 88rpx; box-sizing: border-box; margin-right: var(--cy-space-2); padding: var(--cy-space-1-5) var(--cy-space-3); border: 1rpx solid var(--cy-color-border-strong); border-radius: var(--cy-radius-sm); color: var(--cy-color-text-secondary); font-size: var(--cy-type-label); }
.discover-tag--on { border-color: var(--cy-color-action-primary-bg); background: var(--cy-color-action-primary-bg); color: var(--cy-color-action-primary-fg); }
.discover-list { flex: 1; min-height: 0; padding: var(--cy-space-2) 0; box-sizing: border-box; }
.discover-item { display: block; margin-bottom: var(--cy-space-2-5); }
.discover-stale, .discover-refreshing { flex: none; display: flex; align-items: center; justify-content: space-between; gap: var(--cy-space-2); min-height: 88rpx; box-sizing: border-box; padding: var(--cy-space-2) var(--cy-space-3); border-radius: var(--cy-radius-md); background: var(--cy-color-status-warning-soft); color: var(--cy-color-text-secondary); font-size: var(--cy-type-caption); }
.discover-refreshing { justify-content: center; background: var(--cy-color-bg-surface-subtle); }
.discover-stale__action { display: flex; align-items: center; justify-content: center; min-width: 88rpx; min-height: 88rpx; color: var(--cy-color-text-primary); font-weight: 700; }

/* isolated 组件内全局 .cy-pressed 进不来,必须本地定义一份。
   只减淡不位移:位移要配 .cy-motion-reduced 兜底,而那个类挂在组件外的祖先上,
   isolated 下同样够不着 —— 与其留个撤不掉的位移,不如按仓库既有组件按压类的做法只减淡。 */
.cy-pressed { opacity: .88; }

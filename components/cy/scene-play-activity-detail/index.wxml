<view class="activity-body">
  <cy-skeleton wx:if="{{state === 'loading'}}" type="detail" />
  <cy-error class="cy-fade-in" wx:elif="{{state === 'error'}}" fill title="活动详情暂时打不开" sub="{{errorMsg}}" retry="重新读取" bind:retry="retry" />
  <cy-empty class="cy-fade-in" wx:elif="{{state === 'missing'}}" fill size="lg" title="活动链接无效" sub="没有收到活动编号，无法读取详情。" cta="返回活动列表" bind:cta="close" />
  <cy-empty class="cy-fade-in" wx:elif="{{state === 'empty'}}" fill size="lg" title="活动不存在" sub="这场活动可能已下线或暂时不可见。" cta="返回活动列表" bind:cta="close" />
  <!-- M1-3 门卡:非俱乐部成员看到的是加入引导,而不是占位标题 + 空票种的假详情 -->
  <cy-empty class="cy-fade-in" wx:elif="{{state === 'gate'}}" fill size="lg" title="{{gateMessage}}" sub="加入俱乐部后即可查看活动详情与票种" cta="{{gateClubId ? '去加入俱乐部' : '返回活动列表'}}" bind:cta="goGateClub" />

  <view class="cy-fade-in" wx:elif="{{state === 'ready'}}">
    <view class="activity-hero">
      <image wx:if="{{info.imgUrl}}" class="activity-hero__image" src="{{info.imgUrl}}" mode="aspectFill" />
      <view wx:else class="activity-hero__fallback"><cy-icon name="image" size="48" /><text>封面待确认</text></view>
      <view class="activity-hero__shade"></view>
      <view class="activity-hero__copy">
        <cy-badge type="status" variant="{{statusVariant}}" label="{{statusText}}" />
        <text class="activity-hero__title">{{titleText}}</text>
        <text class="activity-hero__date">{{dateText}}</text>
      </view>
    </view>

    <view wx:if="{{info.cancelTime}}" class="activity-cancelled">
      <text class="activity-cancelled__title">该活动已被主办方取消</text>
      <text wx:if="{{info.cancelReason}}" class="activity-cancelled__reason">原因：{{info.cancelReason}}</text>
      <text class="activity-cancelled__sub">已报名费用将原路全额退回，预计 1–3 个工作日到账。</text>
    </view>

    <view class="activity-section activity-meta">
      <!-- rebase 并集时 master 的旧三行(写死「城市探索」「位置待定」、把缺失报名数显示成 0)
           与本分支的新三行叠在了一起。保留下面这套:hasLocation 分叉 + registrationCountText
           不把「没取到」伪装成 0;master 的按压反馈已嫁接到可点的集合点行上。 -->
      <view class="activity-row"><text class="activity-row__key">主题</text><text class="activity-row__value">{{categoryText || '主题待确认'}}</text></view>
      <view wx:if="{{hasLocation}}" class="activity-row" bindtap="openLocation" hover-class="activity-row--press" hover-stay-time="80" aria-role="button" aria-label="导航到集合点"><text class="activity-row__key">集合点</text><text class="activity-row__value activity-row__link">{{info.addressName || info.address || '查看地图'}}</text></view>
      <view wx:else class="activity-row"><text class="activity-row__key">集合点</text><text class="activity-row__value">{{info.addressName || info.address || '位置待确认'}}</text></view>
      <view class="activity-row"><text class="activity-row__key">已报名</text><text class="activity-row__value">{{registrationCountText || 0}} 人</text></view>
      <view class="activity-row"><text class="activity-row__key">玩法节点</text><text class="activity-row__value">{{info.memberTemplateList.length || 0}} 个</text></view>
    </view>

    <view wx:if="{{info.description}}" class="activity-section">
      <text class="activity-section__title">关于这场活动</text>
      <text class="activity-copy">{{info.description}}</text>
    </view>

    <view wx:if="{{hostName}}" class="activity-section activity-host">
      <text class="activity-section__title">主理人</text>
      <view class="activity-host__row" bindtap="goUserInfo" hover-class="activity-row--press" hover-stay-time="80" data-id="{{info.collaboratorsList[0].memberId}}">
        <cy-avatar size="72" src="{{hostAvatar || ''}}" name="{{hostName}}" />
        <view class="activity-host__copy"><text class="activity-host__name">{{hostName}}</text><text class="activity-host__role">发起人 · 主理人</text></view>
      </view>
    </view>

    <view wx:if="{{info.registrationList.length}}" class="activity-section">
      <text class="activity-section__title">{{registrationCountText || 0}} 人已报名</text>
      <view class="activity-people">
        <view class="activity-person" wx:for="{{info.registrationList}}" wx:key="id" bindtap="goUserInfo" hover-class="activity-row--press" hover-stay-time="80" data-id="{{item.memberId}}" aria-role="button" aria-label="查看{{item.nickname || '报名用户'}}主页">
          <cy-avatar size="64" src="{{item.avatar || ''}}" name="{{item.nickname}}" />
        </view>
      </view>
    </view>

    <view wx:if="{{info.memberTemplateList.length}}" class="activity-section">
      <text class="activity-section__title">节点玩法</text>
      <view class="activity-node-list">
        <!-- rebase 并集时 master 的旧节点块(缺闭合、写死兜底封面、直接读 item.title)
             与本分支的完整块叠在一起。保留下面这套:无图走占位、_titleText 归一、箭头用图标;
             master 的按压反馈已嫁接过去。 -->
        <view class="activity-node" wx:for="{{info.memberTemplateList}}" wx:key="id" bindtap="goTemplateDetail" data-id="{{item.id}}" hover-class="activity-row--press" hover-stay-time="80">
          <image wx:if="{{item._imageUrl}}" class="activity-node__image" src="{{item._imageUrl}}" mode="aspectFill" />
          <view wx:else class="activity-node__placeholder"><cy-icon name="image" size="32" /></view>
          <view class="activity-node__copy"><text class="activity-node__name">{{item._titleText}}</text><text class="activity-node__meta">{{item._playersText}} · {{item._durationText}}</text></view>
          <cy-icon class="activity-node__arrow" name="arrow-right" size="28" />
        </view>
      </view>
    </view>

    <view class="activity-section">
      <text class="activity-section__title">票种</text>
      <view wx:if="{{tickets.length}}" class="ticket-list">
        <view wx:for="{{tickets}}" wx:key="id" class="ticket {{item._id === selectedTicketId ? 'ticket--selected' : ''}} {{!item._available || item._windowPassed ? 'ticket--disabled' : ''}}" data-id="{{item._id}}" bindtap="selectTicket" hover-class="cy-pressed" hover-stay-time="80">
          <view class="ticket__head"><text class="ticket__name">{{item._nameText}}</text><text class="ticket__price">{{item._priceText}}</text></view>
          <!-- CU-C-32:过期/已开始的场次在卡面上就说清楚(原来只在点下去的那一刻给一句 toast,
               卡面跟可卖的票一模一样)。 -->
          <text class="ticket__meta">{{item._dateText || '场次时间待定'}}{{item._inventoryText ? ' · ' + item._inventoryText : ''}}{{item._windowText ? ' · ' + item._windowText : ''}}</text>
          <view class="ticket__more" catchtap="toggleTicket" data-id="{{item._id}}" aria-role="button" aria-label="{{expandedTicketId === item._id ? '收起阵容' : '查看阵容与截止时间'}}" aria-expanded="{{expandedTicketId === item._id}}" hover-class="cy-pressed" hover-stay-time="80" hover-stop-propagation="true"><text class="ticket__more-label">{{expandedTicketId === item._id ? '收起阵容' : '查看阵容与截止时间'}}</text><cy-icon class="ticket__more-icon" name="slide-arrow" size="24" /></view>
          <view wx:if="{{expandedTicketId === item._id}}" class="ticket__detail">
            <text wx:if="{{item.description}}" class="ticket__desc">{{item.description}}</text>
            <text wx:if="{{item._deadlineText}}" class="ticket__limit">报名截止 {{item._deadlineText}}</text>
            <view wx:if="{{item.cmsRegistrationList.length}}" class="ticket__people">
              <view class="ticket__person" wx:for="{{item.cmsRegistrationList}}" wx:key="id" wx:for-item="registrant" catchtap="goUserInfo" data-id="{{registrant.memberId}}" hover-class="cy-pressed" hover-stay-time="80" hover-stop-propagation="true">
                <cy-avatar size="56" src="{{registrant.avatar || ''}}" name="{{registrant.nickname}}" />
                <text class="ticket__person-name">{{registrant.nickname}}</text>
              </view>
            </view>
            <cy-empty wx:else size="sm" title="这个票种还没有人报名" />
          </view>
        </view>
      </view>
      <!-- CU-M-107:这句原本固定写「主理人」,但活动也可以由商家主办 —— 商家看自己主办的活动
           被指向一个与自己无关的角色。本场景拿不到主办身份字段,统一说「主办方」。 -->
      <cy-empty wx:else size="sm" title="暂无可选票种" sub="主办方还没有发布可报名票种。" />
    </view>

    <view class="activity-section">
      <view class="activity-review-head">
        <view class="activity-review-score"><text class="activity-review-score__value">{{averageRatingText}}</text><text class="activity-review-score__meta">{{commentCountText || 0}} 条评价</text></view>
        <cy-btn variant="secondary" size="sm" bindtap="openComment">写评价</cy-btn>
      </view>
      <view wx:if="{{info.commentList.length}}" class="activity-comment-list">
        <view class="activity-comment" wx:for="{{info.commentList}}" wx:key="id">
          <view class="activity-comment__head"><text class="activity-comment__name">{{item.memberNickname || '城瘾玩家'}}</text><text class="activity-comment__time">{{item.createTime}}</text></view>
          <view class="activity-comment__stars"><cy-icon wx:for="{{item.rating}}" wx:key="*this" class="activity-comment__star" name="star" size="22" /></view>
          <text class="activity-comment__text">{{item.contents}}</text>
        </view>
      </view>
      <cy-empty wx:else size="sm" title="还没有评价" sub="参加后，来分享你的真实体验。" />
    </view>

    <view class="activity-points"><cy-icon class="activity-points__icon" name="star" size="30" /><text class="activity-points__text">首次真实评价的积分以平台当前规则为准</text></view>

    <view wx:if="{{cancelShow}}" class="activity-form activity-form--danger">
      <view class="activity-form__head"><text class="activity-form__title">取消活动</text><text class="activity-form__close" bindtap="closeCancel" hover-class="cy-pressed" hover-stay-time="80">关闭</text></view>
      <!-- 预检 500 既可能是业务拒绝(无权限),也可能是「系统繁忙」:给重新检查,别把一次抖动判成永久不能取消 -->
      <cy-error wx:if="{{cancelBlocked}}" title="暂不能取消这场活动" sub="{{cancelError}}" retry="重新检查" bind:retry="openCancel" />
      <block wx:else>
      <text class="activity-form__hint">将为所有未核销报名全额退款，并同步下架活动，操作不可撤销。</text>
      <textarea class="activity-form__textarea" value="{{cancelReason}}" bindinput="onCancelReasonInput" maxlength="100" placeholder="填写取消原因（会展示给已报名用户）" />
      <cy-error wx:if="{{cancelError}}" title="活动取消失败" sub="{{cancelError}}" retry="重试" bind:retry="submitCancel" />
      <cy-btn variant="danger" loading="{{cancelling}}" disabled="{{!canCancel}}" bindtap="submitCancel">确认取消并退款</cy-btn>
      </block>
    </view>

    <view wx:if="{{voteShow}}" class="activity-form">
      <view class="activity-form__head"><text class="activity-form__title">评价场次</text><text class="activity-form__close" bindtap="closeComment" hover-class="cy-pressed" hover-stay-time="80">关闭</text></view>
      <!-- CU-C-104:填表前先说明资格口径,人人可评但未参与不计首评积分 -->
      <text class="activity-form__hint">人人可评；未参与本次活动的评价不计首评积分。</text>
      <view class="activity-rating"><view aria-role="button" aria-label="选择评分" class="activity-rating__target {{index <= answer ? 'activity-rating__target--on' : ''}}" wx:for="{{starsBox}}" wx:key="index" data-index="{{index}}" bindtap="changeRating" hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="star" size="44" /></view></view>
      <textarea class="activity-form__textarea" value="{{plnr}}" bindinput="onCommentInput" maxlength="300" placeholder="写下你的真实体验" />
      <view class="activity-upload-list">
        <view class="activity-upload" wx:for="{{uploadImages}}" wx:key="*this"><image class="activity-upload__image" src="{{item}}" mode="aspectFill" bindtap="previewCommentImage" aria-role="button" aria-label="查看评论大图" data-src="{{item}}"  hover-class="cy-pressed" hover-stay-time="80"/><view class="activity-upload__delete" bindtap="deleteCommentImage" aria-role="button" aria-label="删除这张评论图" data-index="{{index}}" hover-class="cy-pressed" hover-stay-time="80"><view class="activity-upload__delete-icon"><cy-icon name="close-sm" size="20" /></view></view></view>
        <view wx:if="{{uploadImages.length < 9}}" class="activity-upload activity-upload--add" bindtap="chooseCommentImages" hover-class="cy-pressed" hover-stay-time="80"><cy-icon name="image" size="28" /><text class="activity-upload__label">添加图片</text></view>
      </view>
      <cy-error wx:if="{{commentError}}" title="评价没有发布" sub="{{commentError}}" retry="重试" bind:retry="submitComment" />
      <cy-btn variant="primary" loading="{{commentSubmitting}}" disabled="{{!canSubmitComment}}" bindtap="submitComment">发布评价</cy-btn>
    </view>

    <view class="activity-action">
      <button class="activity-share" open-type="share" bindtap="trackShare" data-share-type="activity" data-activity-id="{{activityId}}" data-activity-name="{{info.name}}" data-activity-image="{{info.imgUrl}}"><cy-icon class="activity-share__icon" name="share" size="28" /><text class="activity-share__label">分享</text></button>
      <cy-btn wx:if="{{info.cancelTime}}" class="activity-action__main" variant="primary" disabled="{{true}}">活动已取消</cy-btn>
      <cy-btn wx:elif="{{isOwner}}" class="activity-action__main" variant="danger" bindtap="openCancel">取消活动并退款</cy-btn>
      <cy-btn wx:elif="{{actionState === 'signup'}}" class="activity-action__main" variant="primary" disabled="{{!canConfirmSignup}}" bindtap="openSignup">立即报名</cy-btn>
      <cy-btn wx:elif="{{actionState === 'view' || actionState === 'play' || actionState === 'trace'}}" class="activity-action__main" variant="primary" bindtap="goPlay">{{actionText}}</cy-btn>
      <cy-btn wx:else class="activity-action__main" variant="primary" disabled="{{true}}">{{actionText}}</cy-btn>
    </view>
  </view>
</view>

:host{ display:block; }
/* 三态照 Figma 3965:17359 源码:
 *   default  蓝 #147CE1,白字
 *   release  拖过阈值:轨道转浅灰 #E3EAF9,字 #1162B1(「Alrighty」态)
 *   done     绿 #12A533,白字 + 星星/桃心爆点
 * 几何:轨 300×56 r64 → 108rpx/r123;圆钮 40 → 77rpx;内边距 8 → 15rpx。 */
.sc{ position:relative; width:100%; box-sizing:border-box; height:108rpx; border-radius:123rpx; /* ds-ok Figma 轨道几何 */
  display:flex; align-items:center; justify-content:center; padding:15rpx;
  background:#147CE1; box-shadow:inset 6rpx 12rpx 19rpx rgba(1,1,20,.15); /* ds-ok Figma 默认态配色与内阴影 */
  transition:background .18s linear; } /* ds-ok Figma 源码 */
.sc--release{ background:#E3EAF9; box-shadow:inset 6rpx 12rpx 15rpx rgba(1,1,20,.02); } /* ds-ok Figma 源码 */
.sc--done{ background:#12A533; } /* ds-ok Figma 源码 */
.sc.is-disabled{ opacity:.5; }
.sc__label{ position:relative; margin-left:92rpx; font-size:35rpx; font-weight:500; color:#FEFDFD; } /* ds-ok Figma 源码 18pt */
.sc--release .sc__label{ color:#1162B1; } /* ds-ok Figma 源码 */
.sc__knob{ position:absolute; left:15rpx; width:77rpx; height:77rpx; border-radius:999rpx; /* ds-ok Figma 圆钮几何 */
  background:#FEFDFD; display:flex; align-items:center; justify-content:center; color:#147CE1; /* ds-ok Figma 圆钮配色 */
  box-shadow:0 15rpx 29rpx rgba(1,1,20,.3); transition:transform .18s ease; } /* ds-ok Figma 源码 */
.sc--release .sc__knob{ box-shadow:0 0 10rpx rgba(1,1,20,.08); color:#1162B1; } /* ds-ok Figma 释放态 */
.sc--done .sc__knob{ color:#12A533; } /* ds-ok Figma 完成态 */
/* 爆点:从钮沿 --tx/--ty 飞出,放大→消失,只放一次 */
.scp{ position:absolute; left:50%; top:50%; width:44rpx; height:42rpx; pointer-events:none;
  background-size:contain; background-repeat:no-repeat; background-position:center;
  animation:scp-burst .7s cubic-bezier(.17,.67,.35,1) both; }
/* 减少动态效果:确认成功的爆花是纯装饰的位移+缩放,直接不播;
   确认态本身仍由 .sc--done 的配色表达,反馈不归零。 */
.sc--reduced .scp{ animation: none; opacity: 0; }
.scp--sm{ width:26rpx; height:25rpx; }

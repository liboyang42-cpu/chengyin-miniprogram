// CU-C-87:章节标题 = 序号 + 用户填的名字。名字本身已经带编号时不再叠一层序号。
//
// 病根:序号由**位置**派生(改顺序就跟着变,这是权威的那一半),而名字是可选的补充 ——
// 用户把名字写成「第1章 隔离书店站」时,旧实现拼出「第1章 第1章 隔离书店站」。
//
// ⚠️ 这是 pages/publish/fabu/index.js 的 chapterCardTitle 的第二份实现:WXS 不能
// require 普通 JS 模块(章节卡在 wxml 里逐帧渲染,只能走 WXS)。两份漂移 = 章节卡与
// 发布确认页对同一章显示不同标题。tests/unit/chapter-title-dedupe-contract.test.js
// 逐例把两份实现钉在一起,别只改一份。
//
// 判据与 pages/club/topic-story/index.js 的 chapterTitle 一致:名字打头就是「第N章」。

// 等价于 /^第.{1,3}章/(WXS 侧不依赖正则实现,避免两套引擎的差异)。
// 第 + 1~3 个字符 + 章 ⇒ 首个「章」落在下标 2..4。
var hasOrdinal = function (raw) {
  if (raw.indexOf('第') !== 0) return false;
  var i = raw.indexOf('章', 1);
  return i > 1 && i <= 4;
};

var label = function (index, name) {
  var raw = (name === null || name === undefined) ? '' : ('' + name);
  var seq = '第' + (index + 1) + '章';
  if (hasOrdinal(raw)) return raw;
  return raw ? seq + ' ' + raw : seq;
};

module.exports = { label: label };

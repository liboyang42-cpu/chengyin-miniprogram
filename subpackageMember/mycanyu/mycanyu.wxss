/* 根容器 flex column + 确定高度,是 cy-empty/cy-error 的 fill(flex:1)真正吃满"标题下方到
   屏幕底部"剩余空间的前提(2026-07-31 总控根因修复:居中=剩余空间居中,不是整屏/贴顶)。 */
.canyu-page { min-height: 100vh; display: flex; flex-direction: column; background: var(--cy-color-bg-page); color: var(--cy-color-text-primary); }
.canyu-nav-spacer { width: 100%; }
/* flex:1 让本容器吃满 canyu-page 里除 nav/title/tabs 外的剩余高度;自身也要是 flex column
   (min-height:0 允许在 flex 布局里正确收缩)才能把这份剩余空间正确让给里面 fill 的空/错态。 */
/* padding-top = tab 与下方第一张卡的间距 */
.canyubox{overflow: hidden; padding-top: var(--cy-space-4); padding-bottom: var(--cy-safe-bottom); flex: 1; min-height: 0; display: flex; flex-direction: column;}
.canyu-refreshing{ min-height: var(--cy-btn-h); display: flex; align-items: center; margin: 0 var(--cy-space-2); color: var(--cy-text-secondary); font-size: var(--cy-font-label); }
.canyubox cy-inline-error{ display: block; margin: 0 var(--cy-space-2) var(--cy-space-3); }
/* 用户备注:"下面居中下移"——加载失败态整体在 tab 下方区域垂直居中并偏下,不贴顶 */
.canyubox_li{overflow: hidden; border-radius: var(--cy-radius-lg); background: var(--cy-color-bg-surface); margin: 0 var(--cy-space-2) var(--cy-space-4) var(--cy-space-2); }
.canyubox_li_tgb{position: relative; overflow: hidden;}
.canyubox_li_left{ position: relative; overflow: hidden;}
.canyubox_li_left image{ width:432rpx; height: 336rpx; vertical-align: top;}
/* 图片右缘淡入卡面的罩层。原为近白字面值；本页使用玩家暗色主题，
   换 token 后跟随卡面真值(浅色白/暗色近黑),
   不再把「卡是白的」焊死在页面里。末端用 transparent 关键字(小程序无 color-mix())。 */
.canyubox_li_left::after{content: " "; width: 432rpx; height: 100%;  position: absolute; left: 0; top: 0;
  background: linear-gradient(268.87deg, var(--cy-color-bg-surface) 2.85%, transparent 98.89%);
}
/* 文字块自带 space-3 内边距 = 文字与其下方图片右缘之间的呼吸;box-sizing 保证加了内边距
   仍占原来的 336rpx 宽度,不把块撑出卡外。 */
.canyubox_li_right { position: absolute; right: var(--cy-legacy-36); top: var(--cy-space-4); width: 336rpx; padding: var(--cy-space-3); box-sizing: border-box;}
.canyubox_li_right_top{overflow: hidden; display: flex; flex-direction: column; align-items: flex-start; gap: var(--cy-space-1); margin-bottom: var(--cy-space-2);}
/* 标题吃满文字块整宽(288rpx ≈ 8 字/行)、最多两行;不再与状态签并排分宽 */
.canyubox_li_right_top_name{ width: 100%; font-size: var(--cy-type-section-title); font-weight: bold; line-height: var(--cy-leading-tight); word-break: break-all;}
/* 状态签按内容自然宽度,不再 102rpx 定宽裁掉「未开始」 */
.canyubox_li_right_top_zt{ max-width: 100%;}
.canyubox_li_right_top_zt text{ width: 100%; height: 40rpx; line-height: 40rpx; overflow: hidden; display: block; border-radius: var(--cy-radius-sm); text-align: center; font-size: var(--cy-type-label); font-weight:bold;}
.canyubox_li_right_time{ font-size: var(--cy-type-label); color: var(--cy-color-text-secondary); margin-bottom: var(--cy-space-1-5);}
.canyubox_li_right_time image{ width: 24rpx; height: 24rpx; vertical-align: top;margin: var(--cy-legacy-4) var(--cy-legacy-6) 0 0;}
.canyubox_li_right_txt{font-size: var(--cy-type-label); color: var(--cy-color-text-secondary);}
.canyubox_li_right_txt image{ width: 24rpx; height: 24rpx; vertical-align: top; margin: var(--cy-legacy-4) var(--cy-legacy-6) 0 0;}

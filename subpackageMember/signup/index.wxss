.signup {
  position: relative;
  height: 100vh;
  overflow: hidden;
}

/* UI-17(2026-09-18):整页一张完整票卡 —— 标题条删掉后,背景图必须铺满全屏(含状态栏/返回行),
   否则顶部仍留一段页面黑。固定层 + 主题色遮罩,票卡浮在上面。 */
.signup .ztbg {
  position: fixed;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  filter: blur(50rpx); opacity: .5;
  z-index: 0;
  pointer-events: none;
}

.signup-scrim {
  position: fixed;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  pointer-events: none;
  background: linear-gradient(0deg, rgba(0, 0, 0, .3), rgba(0, 0, 0, .6) 30%); /* ds-ok: 沿用原 .main 的遮罩渐变(压在用户照片上,不随主题翻转) */
}

.signup .main {
  position: relative;
  overflow: hidden;
  z-index: 1;
  /* UI-17 二次返修:底部安全区(Home 指示条)不算可视区,卡不在它里面居中。 */
  box-sizing: border-box;
  padding-bottom: env(safe-area-inset-bottom);
}

/* UI-17 二次返修:导航以下、底部安全区以上的区域里,把票名 + 卡 + 指示点这一列
   水平垂直居中。名称带与指示点区等高(各 140rpx,见下),所以卡的上下留白对称 ——
   卡的几何中心正好落在区域中点,不是「名字+卡+点」整体的中点。 */
.signup .wrap {
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 0;
}

/* 票名:卡外、紧贴卡顶之上。140rpx 高与 swiper 的指示点区等高 ⇒ 卡上下留白对称;
   文字压在带底,留 20rpx 与卡顶的呼吸。文字色/字号走 token,不硬编码;字号用 L1 页标题(用户嫌卡片标题字号太小)。 */
.signup .ticket-name {
  width: 520rpx;
  height: 140rpx;
  box-sizing: border-box;
  padding-bottom: var(--cy-space-2-5);
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: center;
  flex-shrink: 0;
}

.signup .ticket-name__state {
  display: block;
  width: 100%;
  margin-top: var(--cy-space-1);
  text-align: center;
  font-size: var(--cy-font-caption);
  color: var(--cy-text-secondary);
}

.signup .ticket-name__t {
  display: block;
  width: 100%;
  text-align: center;
  font-size: var(--cy-font-page-title);
  font-weight: 700;
  color: var(--cy-text-title);
}

.signup .toolbar {
  position: relative;
  margin: 44rpx var(--cy-page-x) var(--cy-legacy-18) var(--cy-page-x); /* ds-ok: 44rpx 是 r1-c04-order-ticket-contract.test.js 锁定的横向边距修复值,不改 */
}

.signup .toolbar button {
  position: absolute;
  right: var(--cy-space-3-5);
  margin: 0;
  width: auto;
  top: 50%;
  transform: translateY(-50%);
}

.signup .toolbar button image {
  width: 48rpx;
  height: 48rpx;
}

/*
.signup .slides {
  padding-top: var(--cy-space-4);
  width: 610rpx;

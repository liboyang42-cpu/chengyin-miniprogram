  border-radius: 60rpx;
  width: 576rpx;
  height: calc(100% - 100rpx) !important;
  border: 10rpx solid rgba(255, 255, 255, 0.9); box-shadow: 8rpx 8rpx 8rpx rgba(255, 255, 255, .5);
} */
/* 活动 */
.wallet{
  overflow: hidden;
}
.wallet .list {
  padding: var(--cy-space-6) var(--cy-legacy-72) var(--cy-space-7) var(--cy-legacy-72);
  box-sizing: border-box;
  height:100%;
  overflow-y:auto;
}

.wallet .list .li {
  margin-bottom: var(--cy-space-5);
}

.wallet .list .li .item {
  height: 368rpx;
  border-radius: 80rpx;
  position: relative;
  overflow: hidden;
  border: 10rpx solid rgba(255, 255, 255, 0.9);
}

.wallet .list .li .item image {
  width: 100%;
  border-radius: 80rpx; vertical-align: top;
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
}


/* 2026-07-31:优惠券票卡(.david、.david_tkb_li 系、.hong)已随"删除票夹页优惠券 tab"整体搬到
   独立的 subpackageMember/coupon(见 wt3b-visual-semantics-contract.test.js 的 P1-5 契约,已随实现迁移)。 */

/* 2026-07-31:原 position:fixed + top/left:50% 是"整屏居中"(会把内容顶到状态栏/标题下面去算中点),
   和用户明确的"标题下方到屏幕底部这段剩余空间里居中"不是一回事。改成 flex:1 让出的正常文档流子项,
   居中交给 cy-empty/cy-error 的 fill 变体做(.signup 根节点已经是 flex-col + height:100vh)。 */
.davidwu{ position: relative; z-index: 1; width: 100%; overflow: hidden; display: flex; flex-direction: column; flex: 1; }
/* cy-empty/cy-error 是 styleIsolation:isolated 组件,宿主标签默认 display:block,
   组件内部的 flex:1 要宿主自己也是 flex 容器才生效,从页面外部补一层。 */
.fill-slot{ display: flex !important; flex-direction: column !important; flex: 1 !important; min-height: 0 !important; }

/* 2026-07-31:优惠券详情弹框(.tkbg/.tkbox*)随优惠券 tab 一起删除,不再在本页触发。 */

/* UI-17:卡外的票名大字、票面 meta(名称/场次时间)与票根文字都已删——返修后票面零文字,
   票名/状态只在 aria-label 里出现(见 index.wxml 顶部说明)。 */

/* 票夹里的队伍入口(2026-09-04 判定表补的那条)。跟着当前票走,没有队伍整行不出。 */
.team-entry {
  position: absolute;
  left: var(--cy-page-x);
  right: var(--cy-page-x);
  bottom: env(safe-area-inset-bottom);
  display: flex;
  align-items: center;
  padding: var(--cy-space-4);
  border-radius: var(--cy-radius-md);
  background: var(--cy-bg-card);
}

@media (max-height: 700px) {
  .signup {
    height: auto;
    min-height: 100vh;
    overflow-y: auto;
  }

  .signup .main {
    flex: none;
    overflow: visible;
  }

  .signup .wrap {
    flex: none;
    height: 1204rpx;
  }

  .team-entry {
    position: static;
    margin: var(--cy-space-4) var(--cy-page-x) 0;
  }
}

.team-entry__main {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: baseline;
}

.team-entry__k {
  font-size: var(--cy-font-body);
  font-weight: 600;
  color: var(--cy-text-title);
}

.team-entry__v {
  margin-left: var(--cy-space-2-5);
  min-width: 0;
  font-size: var(--cy-font-caption);
  color: var(--cy-text-muted);
}

.team-entry__n {
  margin-right: var(--cy-space-2);
  font-size: var(--cy-font-caption);
  color: var(--cy-text-muted);
}

page { background: var(--cy-bg-page); color: var(--cy-text-title); }

.tixian-page { min-height: 100vh; display: flex; flex-direction: column; }
.tixian-content { flex: 1; min-height: 0; display: flex; flex-direction: column; }

.tx-history-entry { min-height: var(--cy-btn-h); margin: 0 var(--cy-page-x) var(--cy-space-2); padding: 0 var(--cy-space-4); box-sizing: border-box; display: flex; align-items: center; justify-content: space-between; border-radius: var(--cy-radius-md); background: var(--cy-color-action-secondary-bg); color: var(--cy-text-title); font-size: var(--cy-font-body); font-weight: 600; }

/* D19:Revolut 详情行用独立灰块起层,不再用横线把一整张表切开。 */
.txyr { margin: 0 var(--cy-page-x) var(--cy-space-3); min-height: calc(var(--cy-btn-h) + var(--cy-space-2)); padding: 0 var(--cy-space-4); box-sizing: border-box; background: var(--cy-color-input-bg-empty); border-radius: var(--cy-radius-md); display: flex; justify-content: space-between; align-items: center; }
.txyr_left { flex: 1; min-width: 0; display: flex; justify-content: space-between; align-items: center; gap: var(--cy-space-2); font-size: var(--cy-font-body); }
.txyr_left text { font-weight: 700; color: var(--cy-color-input-text); }
.txyr_unknown { color: var(--cy-text-secondary); }
/* 命中区 88rpx = 44pt(全局规范铁律 5 / WCAG 2.5.8),视觉字号不变。 */
.txyr_right { margin-left: var(--cy-space-2); min-height: var(--cy-btn-h); display: flex; align-items: center; padding: 0 var(--cy-space-3); border-radius: var(--cy-radius-pill); background: var(--cy-color-action-secondary-bg); font-size: var(--cy-font-body); font-weight: 600; color: var(--cy-text-title); }

.tx-stages { display: block; margin: 0 var(--cy-page-x) var(--cy-space-3); }
.txcon { margin: 0 var(--cy-page-x); }
.txcon_ly { min-height: calc(var(--cy-btn-h) + var(--cy-space-2)); padding: 0 var(--cy-space-4); box-sizing: border-box; display: flex; align-items: center; justify-content: space-between; gap: var(--cy-space-3); margin-bottom: var(--cy-space-2); border-radius: var(--cy-radius-md); background: var(--cy-color-input-bg-empty); }
.txcon_ly--filled { background: var(--cy-color-input-bg-filled); }
.txcon_ly_name { flex: none; font-size: var(--cy-font-body); color: var(--cy-text-secondary); }
.txcon_ly_inp { flex: 1; min-width: 0; display: flex; justify-content: flex-end; align-items: center; }
.txcon_ly_inp input { width: 100%; height: var(--cy-btn-h); text-align: right; font-size: var(--cy-font-body); color: var(--cy-color-input-text); }
.txcon_ly_inp--amount input { font-size: var(--cy-font-subtitle); font-weight: 700; }
.txcon_ly_inp--disabled input { font-size: var(--cy-font-body); color: var(--cy-text-secondary); }
.txcon_ly_currency { margin-right: var(--cy-space-1); font-size: var(--cy-font-subtitle); font-weight: 700; color: var(--cy-color-input-text); }
.tx-placeholder { color: var(--cy-color-input-placeholder); }
/* 2026-09-16 表单退役后的说明文字:不再是输入框,只是给「提现方式」那一行一个值 */
.tx-cs-note { font-size: var(--cy-font-body); color: var(--cy-color-text-secondary); }

.tx-bottom { margin-top: auto; padding: var(--cy-space-5) var(--cy-page-x) calc(var(--cy-space-4) + env(safe-area-inset-bottom)); }
.tx-cta { margin-top: var(--cy-space-3); }
.txtpis_tit { font-size: var(--cy-font-body); font-weight: 700; margin-bottom: var(--cy-space-1); }
.txtpis_txt { color: var(--cy-text-body); font-size: var(--cy-font-label); line-height: var(--cy-leading-normal); }

/* 单独同意勾选行:与表单卡同宽,不跟提现说明挤在一起 */
.tx-consent { margin: var(--cy-space-3) 40rpx 0; }

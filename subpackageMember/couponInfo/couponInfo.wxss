@import '../../style/merchant-light.wxss';

.fabu {
  padding-bottom: calc(var(--cy-comp-footer-h) + var(--cy-space-4));
  min-height: 100vh;
  background: var(--cy-bg-page);
  color: var(--cy-text-title);
}

.fabu.theme-topic-editor .wp {
  padding: 0 var(--cy-page-x) 0; /* aaa v2:标题下间距由 cy-page-title space-5 独家供给 */
}

.submit-error {
  margin-top: var(--cy-space-3);
}

.fabu .form .li {
  margin-bottom: var(--cy-space-2-5);
}

.fabu .form .li .item-tit {
  font-size: var(--cy-font-body);
  margin-bottom: var(--cy-space-2);
  color: var(--cy-text-body);
}

.fabu .form .li .item-tit text {
  color: var(--cy-danger);
  margin-left: var(--cy-legacy-4);
}

.fabu .form .li .item-cont {
  height: var(--cy-space-7); line-height: 80rpx; 
  background: var(--cy-color-bg-surface-subtle);
  border-radius: var(--cy-radius-sm);
  padding: 0 var(--cy-space-2-5);
  box-sizing: border-box;
}
.fabu .form .li .item-cont text{font-size: var(--cy-font-subtitle);}
.fabu .form .li .item-cont input.davidinp{font-size: var(--cy-font-body); color: var(--cy-text-title);}
.fabu .form .li .item-cont input.davidinp2{font-size: var(--cy-font-body); display:block; width: 240rpx; float: left; color: var(--cy-text-title);}
.fabu .form .li .item-cont image.davidyu{width: 24rpx; height: 24rpx; float:right; margin-top: var(--cy-legacy-26); filter: brightness(0); opacity: 0.68;}
.fabu .form .li2 .item-cont {
  height:auto;
}
.fabu .form .li .item-cont2{
  background: var(--cy-color-bg-surface-subtle);
  border-radius: var(--cy-radius-sm);
  padding:var(--cy-space-1-5) var(--cy-legacy-26) var(--cy-space-1-5) var(--cy-space-2-5);
  box-sizing: border-box;
}
.fabu .form .li .hezuo .fl image{
  width: var(--cy-legacy-72);
  height: var(--cy-legacy-72);
  border-radius:50%;
}
.fabu .form .li .hezuo .fl .name{
  font-size: var(--cy-font-label);
  color: var(--cy-text-body);
  margin-left: var(--cy-space-4);
}
.fabu .form .li .hezuo .zw{
  color: var(--cy-text-body);
  font-size: var(--cy-font-label);
}
.fabu .form .li .hezuo .add-more{
  font-size: var(--cy-font-label);
  color: var(--cy-accent);
  margin-top: var(--cy-space-4);
}
.fabu .form .li .item-cont input {
  height: 100%;
  box-sizing: border-box;
}

.fabu .form .li .item-cont textarea {
  min-height:180rpx; width: 100%; line-height: var(--cy-leading-normal);
  padding: var(--cy-legacy-10);
  box-sizing: border-box;
  color: var(--cy-text-title);
}

.fabu .form .li .item-cont .jt image {
  width: var(--cy-legacy-14);
  height: var(--cy-legacy-22) !important;
  filter: brightness(0);
  opacity: 0.68;
}

.fabu .form .li .fmt {
  width: 100%;
  height: 336rpx !important;
  border-radius: var(--cy-radius-sm);
}

.fabu .form .li .picker_group {
  height: 100%;
  font-size: var(--cy-font-label);
  color: var(--cy-text-secondary);
}

.fabu .form .li .picker_group .picker{ min-width: 0; display: flex; align-items: center;}
/* 死宽 100rpx 装不下 "2026-08-15"(10 字符 @--cy-font-label 约需 140rpx),日期被拦腰折成
   "2026-" / "08-15" 两行(E29 走查)。改 min-width 保住未选态的占位宽度,内容长了自己撑开;
   nowrap 兜住任何更长的日期格式。 */
.fabu .form .li .picker_group .picker .text-style1 {min-width: 0; white-space: normal; line-height: var(--cy-leading-normal); }
.fabu .form .li .picker_group .picker .text-style2 {min-width: 0; white-space: normal; color: var(--cy-text-title); line-height: var(--cy-leading-normal);}

.fabu .form .li .picker_group .text-style1 {
  margin: 0 3rpx; /* ds-ok: 像素级微调,不是量表间距 */
}

.fabu .form .li .picker_group image {
  flex-shrink: 0;
  width: 24rpx;
  height: 24rpx;
  margin-left: 8rpx;
  filter: brightness(0);
  opacity: 0.68;
}

.fabu .form .li .picker2 {
  height: var(--cy-space-7);
}

.fabu .form .ul .li {
  width: 100%;
}

.fabu .fabu-btn {
  position: fixed;
  width: 100%;
  left: 0;
  bottom: 0;
  font-size: var(--cy-font-subtitle);
  z-index: 2;
  /* 2026-08-11 用户裁决:底部「取消 / 发布优惠券」这条要跟页面同底,不要白色。
     原来是 --cy-bg-card(白),在灰页上凭空多出一条白带,把页面切成两截。 */
  background: var(--cy-bg-page);
}

.fabu .fabu-btn .wrap {
  padding: var(--cy-space-2-5) var(--cy-space-3-5);
}

.text-style2{font-size: var(--cy-font-caption);}


/* 模板选择 */
.pop-temp .temp-list {
  padding: var(--cy-space-4) 0;
  margin: calc(var(--cy-legacy-10) * -1);
}

.pop-temp .temp-list .li {
  width: 50%;
  margin: 0 0 var(--cy-space-4) 0;
}

.pop-temp .temp-list .li .item {
  margin: var(--cy-space-2);
  overflow: hidden;
}

.pop-temp .temp-list .li .item image {
  width: 100%;
}

/* 选中状态样式。用户定:只有填充没有描边;品牌紫只做强调不做选中态。
   原本是 2px(全仓唯一用 px 不用 rpx 的地方) + --cy-accent 紫描边。
   改成 cy-tabs chip 同款:实心反色中性(DS §2.1 主 CTA 不用品牌紫)。 */
.li.selected .item {
  position: relative;
  background: var(--cy-color-action-primary-bg);
  color: var(--cy-color-action-primary-fg);
  border-radius: 8px;
}


.selected-mark image {
  width: 100%;
  height: 100%;
}


.coupon-type-option {
  min-height: var(--cy-btn-h);
  display: flex;
  align-items: center;
  padding: 0 var(--cy-space-3);
  border-radius: var(--cy-radius-md);
  color: var(--cy-text-title);
  font-size: var(--cy-font-body);
}
.coupon-type-option--on { background: var(--cy-bg-card-2); font-weight: 600; }



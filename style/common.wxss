  color: #fff;
  padding: 0 40rpx;
  box-sizing: border-box;
  display: none;
}

.pop-model::before {
  content: "";
  background: rgba(10, 9, 13, 0.85);
  backdrop-filter: blur(32rpx);
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
  z-index: -1;
  width: 100%;
  height: 100%;
  position: absolute;
  left: 0;
  top: 0;
  /* 装饰弧与面板 .pop-model 同档:这层就是面板可见的底,两档半径会露怯 */
  border-radius: var(--cy-comp-sheet-radius) var(--cy-comp-sheet-radius) 0 0;
  box-shadow: 0px 8rpx 64rpx 0px rgba(0, 0, 0, 0.16);
}

.pop-model button {
  color: #fff;
  width: auto;
}

.pop-model .pop-top {
  padding: 40rpx 0;
  font-size: var(--cy-type-card-title);
  font-weight: bold;
  color: #fff;
}

.pop-model .pop-top button {
  width: auto;
  color: #ED0006; font-size: var(--cy-type-card-title); font-weight: bold;
}
.pop-model .pop-top .tit{ color: var(--cy-color-text-primary); font-size: var(--cy-type-card-title);font-weight: bold;}
.pop-model .pop-top button.david_aok{color: var(--cy-color-brand);}
.pop-model .pop-top button.david_aok image{width: 40rpx; height: 40rpx;}

.pop-model .pop-cont {
  height: 80vh;
  overflow-y: auto;
  padding-right: 30rpx;
  margin-right: calc(var(--cy-space-2-5) * -1);
}

.pop-model.show {
  display: block;
}

/* 主题弹窗 */
.pop-topic{
  position:fixed;
  width:100%;
  bottom:0;
  left:0;
  z-index:32;
  border-radius:var(--cy-comp-sheet-radius) var(--cy-comp-sheet-radius) 0 0;
  background:var(--cy-color-bg-surface);
  padding-bottom: env(safe-area-inset-bottom);
}
.pop-topic .pop-cont {
  padding: var(--cy-space-3-5) var(--cy-space-3-5);
  box-sizing: border-box;
}

.pop-topic .zt1 {
  border-bottom: 2rpx solid var(--cy-color-border-subtle);
  padding-bottom: 30rpx;
}

.pop-topic .zt1 .col1 {
  width: 180rpx;
  margin-right: 38rpx;
}

.pop-topic .zt1 .col1 image {
  width: 180rpx;
  height: 254rpx !important;
  border-radius: var(--cy-radius-sm);
}

.pop-topic .zt1 .col2 .tit {
  font-size: var(--cy-type-card-title);
  font-weight: bold;
  margin-bottom: var(--cy-space-2-5);
}

.pop-topic .zt1 .col2 .check text {
  background: var(--cy-color-bg-surface-subtle);
  height: 50rpx;
  display: flex;
  align-items: center;
  padding: 0 var(--cy-space-2);
  color: var(--cy-color-text-secondary);
  border-radius: var(--cy-radius-sm);
}

.pop-topic .dl {
  padding: 40rpx 0;
  border-bottom: 2rpx solid var(--cy-color-border-subtle);
}

.pop-topic .dl .dt {
  font-size: var(--cy-type-card-title);
  font-weight: bold;
  margin-bottom: var(--cy-space-2-5);
}

.pop-topic .dl .check .dd {
  padding: var(--cy-legacy-10) var(--cy-space-2-5);
  background: var(--cy-color-bg-surface-subtle);
  border-radius: var(--cy-radius-sm);
  margin: 0 var(--cy-space-2-5) var(--cy-legacy-10) 0;
}

.pop-topic .dl .check .dd.check {
  background: var(--cy-color-brand);
  color: var(--cy-color-text-inverse);
}

.pop-topic .bm-btn {
  padding-top:25rpx!important;
}

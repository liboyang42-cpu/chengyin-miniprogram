/* ============================================================
 * .theme-game —— 玩法域「游戏皮」(2026-08-27)
 *
 * 为什么要这个作用域:玩家端全站是 consumer-night(纯黑),但玩法页需要读作
 * 「进了另一个空间」——用户拍板游戏要和其余页面不一样。做法沿用 .theme-light /
 * .theme-topic-editor 的既有手法:挂 class 换域,不改基础 page{}。
 *
 * ⚠️ 本块是**叠加层,不是独立主题域**:玩法页根节点挂 class="theme-light theme-game" ——
 *    日间语义值与 ② 旧名 alias 全部来自既有 .theme-light 块那一处真源,本块只加游戏增量。
 *    这样做的原因:tokens.wxss 自己警告过「别名在 page{} 已就地求值成暗端快照,只补其中几个
 *    会半黑半白」,而 theme-light-alias-snapshot-contract 正是盯这条。与其再抄一份完整日值
 *    (多一处要同步的真源),不如复用已经过 R1 对比度验收的那一块。
 *    若日后玩法域要脱离商家日值独立演进,再把它提升成 .theme-topic-editor 那样的完整块。
 *
 * 颜色零新增:强调红/黄/绿全部指向 ⓪ 原子色层已有值 —— red-700 的白字对比度 5.0:1 是
 * 现成结论,不用重测;换成更亮的橙红(如 #EE3124)白字只有 4.12:1,达不到 R1 的 4.5:1。
 * 页面/组件只读本块的 --cy-game-*,禁止在玩法页 wxss 里写字面色值。
 * ============================================================ */
page.theme-game,
.theme-game {
  /* —— 强调色:玩法域的主操作与判定反馈 —— */
  --cy-game-accent:        var(--cy-ref-red-700);      /* 主键底(白字 5.0:1) */
  --cy-game-accent-fg:     #FFFFFF;
  --cy-game-accent-soft:   rgba(208,50,59,.10);        /* red-700 的软底,同 brand-soft 手法 */
  --cy-game-marker:        var(--cy-ref-amber-500);    /* 目标刻度标记 */
  --cy-game-win:           var(--cy-ref-green-700);    /* 判定「完美/优秀」(浅端 R1 成功色) */

  /* —— 判定结果的整屏泛色底:三档各一,均为对应原子色的软底 —— */
  --cy-game-flood-win:     rgba(11,122,87,.14);
  --cy-game-flood-ok:      rgba(245,159,0,.16);
  --cy-game-flood-miss:    rgba(208,50,59,.12);

  /* —— 玩法专用字号:DS 最大档 data-2xl(84rpx)是 tab 页 hero 数字,
        停表读数是全屏唯一主角,再大一档才压得住场;只在本域生效,不进全站字阶。 —— */
  --cy-game-type-hero:     132rpx;
  --cy-game-type-readout:  64rpx;
}

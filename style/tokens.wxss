  --cy-comp-search-filled-fg: var(--cy-color-input-filled-fg);
  --cy-comp-search-placeholder: var(--cy-color-input-placeholder);
  --cy-color-border-subtle: rgba(255,255,255,.08);
  --cy-comp-card-highlight: rgba(255,255,255,.08);
  --cy-comp-card-shadow-day: 0 0 0 0 transparent;
  --cy-comp-card-border: var(--cy-color-border-subtle);
  --cy-comp-cell-fill-bg: var(--cy-color-bg-surface-subtle);
  --cy-text-title: var(--cy-color-text-primary);
  --cy-color-border-strong: rgba(255,255,255,.16);
  --cy-color-sheet-handle: #5A5A5A;
  --cy-color-result-fail-badge: #F94D5C;
  --cy-color-state-pressed: rgba(255,255,255,.10);
  --cy-color-overlay: rgba(0,0,0,.56);
  --cy-color-action-primary-bg: #F8F8F8;
  --cy-color-action-primary-fg: #0A0A0A;
  --cy-color-action-secondary-bg: rgba(255,255,255,.08);
  --cy-color-action-danger-bg: var(--cy-ref-red-700);
  --cy-color-action-danger-fg: #FFFFFF;
  /* 与默认(玩家)作用域同步去紫,理由见上方 page{} 里那段注释 */
  --cy-color-selection: var(--cy-color-text-primary);
  --cy-color-brand: var(--cy-color-text-primary);
  --cy-color-brand-strong: var(--cy-color-text-secondary);   /* 同默认域,见上方注释 */
  --cy-color-brand-soft: rgba(248,248,248,.12);
  --cy-color-status-success: #22C55E;                    /* D3:与 page{} 同步 */
  --cy-color-status-warning: #D58300;                    /* 同上:保留 9-02 的对比度实测值 */
  --cy-color-status-danger: #E5484D;
  --cy-color-status-info: var(--cy-ref-blue-400);
  --cy-color-status-danger-soft: rgba(229,72,77,.14);
  --cy-color-status-neutral-soft: rgba(145,145,145,.16);   /* 2026-09-01:状态胶囊软底,与其余五支同构(本域 text-tertiary 的低透明版) */
  --cy-color-rare-soft: rgba(245,159,0,.14);          /* 同上;rare 与 warning 同为琥珀,按手册「同色靠图标区分」的既有做法,不换色相 */
  --cy-color-rare-fg: var(--cy-color-rare);   /* 夜间琥珀压在自己的软底上 7.6:1,直接用本色 */
  --cy-color-status-success-soft: rgba(34,197,94,.14);
  --cy-color-status-warning-soft: rgba(213,131,0,.18);   /* 跟 #D58300 同步 */
  --cy-color-status-info-soft: rgba(76,134,255,.14);
  --cy-color-skeleton-base: #16141C;
  --cy-color-skeleton-highlight: #211E29;
  --cy-color-bg-interactive:                        #4D4D4D;
  --cy-color-status-danger-on-interactive:          #FF3B4F;
  --cy-color-medal-gold:                            #FFCB3C;
  --cy-color-medal-silver:                          #D6D6D6;
  --cy-color-medal-bronze:                          #F58C41;
  --cy-color-skeleton-on-sheet:                     #303038;

  /* —— 模板页「连体 tab + 紫面」(2026-08-26 定稿,画板 16)——
     ⚠️ 紫在这里是**内容面**,不是 brand。--cy-brand 的约 70 个消费点一个都不动
     (2026-08-01 用户拍板「玩家版全去紫」仍然有效,那条管的是 selection/brand)。
     面用顶部渐变往下淡出:紫只落在 tab 连接处 / chips / banner,列表区回到近黑
     —— 封面是大地色系自绘 key art,压在高彩紫上会互相打架。 */
  --cy-color-panel-accent-top:   #5B2A9D;
  --cy-color-panel-accent-mid:   #341A55;
  --cy-color-panel-accent-deep:  #180E24;
  --cy-color-panel-accent-base:  #0B0810;
  /* 扫光:必须比它所在的面亮,否则是一圈自己看不见的动画(换面色时要一起重算) */
  --cy-color-glow-sweep:         #FFFFFF;
  --cy-color-glow-sweep-soft:    #EFEDFA;
  --cy-bg-subtle: rgba(255,255,255,0.04);
  --cy-white-4: rgba(255,255,255,0.04);
  --cy-white-64: rgba(255,255,255,0.64);
  --cy-price: #FFFFFF;
  --cy-shadow-card: none;
  /* ② 旧名 alias 快照重估:与 .theme-light/.theme-merchant 块对称(嵌套主题时不许停在浅值上) */
  --cy-bg-page:        var(--cy-color-bg-page);
  --cy-bg-card:        var(--cy-color-bg-surface);
  --cy-comp-modal-panel: #4D4D4D;   /* 暗端同 page{}:危险确认面板要浮起来 */
  --cy-bg-card-2:      var(--cy-color-bg-surface-subtle);
  --cy-bg-glass:       var(--cy-color-bg-glass);
  --cy-bg-elevated:    var(--cy-color-bg-elevated);
  --cy-bg-raised:      var(--cy-color-bg-raised);
  --cy-bg-interactive: var(--cy-color-bg-interactive);
  --cy-bg-accent-weak: var(--cy-color-brand-soft);
  --cy-text-body:        var(--cy-color-text-secondary);
  --cy-text-secondary:   var(--cy-color-text-tertiary);
  --cy-text-placeholder: var(--cy-color-text-placeholder);
  --cy-text-inverse:     var(--cy-color-text-inverse);
  --cy-border-card: var(--cy-color-border-subtle);
  --cy-border-line: var(--cy-color-border-strong);
  --cy-brand:         var(--cy-color-brand);
  --cy-brand-soft:    var(--cy-color-brand-soft);
  --cy-accent:        var(--cy-color-brand);
  --cy-accent-strong: var(--cy-color-brand-strong);
  --cy-accent-soft:   var(--cy-color-brand-soft);
  --cy-info:          var(--cy-color-status-info);
  --cy-success:       var(--cy-color-status-success);
  --cy-danger:        var(--cy-color-status-danger);
  --cy-danger-soft:   var(--cy-color-status-danger-soft);
  --cy-gold:          var(--cy-color-rare);
  --cy-white-8:  var(--cy-color-border-subtle);

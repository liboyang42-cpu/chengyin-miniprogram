page {
  font-size: 24rpx;
  background: var(--cy-bg-page);
}

/**app.wxss**/
.flex {
  display: flex
}

.flex-a {
  flex: 1;
  overflow: hidden;
}

.flex-b {
  display: flex;
  justify-content: space-between
}

.flex-c {
  display: flex;
  justify-content: center
}

.flex-e {
  display: flex;
  justify-content: flex-end
}

.flex-w {
  display: flex;
  flex-wrap: wrap;
}

.flex-ac {
  display: flex;
  align-items: center;
}

.flex-cb {
  display: flex;
  align-items: center;
  justify-content: space-between
}

.flex-cc {
  display: flex;
  align-items: center;
  justify-content: center
}

.flex-ce {
  display: flex;
  align-items: center;
  justify-content: flex-end
}

.flex-ae {
  display: flex;
  align-items: flex-end;
  justify-content: flex-start
}

.flex-cs {
  display: flex;
  align-items: center;
  justify-content: flex-start
}

.flex-col {
  display: flex;
  flex-direction: column;
}

.flex-shr {
  flex-shrink: 0;
}

.wp {
  padding: 0 var(--cy-space-3);
  box-sizing: border-box;
}

.ep1 {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ep2 {
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.trans {
  background: transparent;
}

/*fontsize*/
.f28 {
  font-size: 28rpx;
}

.fb {
  font-weight: bold;
}

/* 原生 button 复位。★只保留 `button` 这一支(特异度 0,0,1)。
 * 别再补 `wx-button:not([size=mini])`:它不多发一条声明(`button` 已经命中所有 button,
 * 含 size=mini —— 已用 automator 计算样式实测),唯一作用是把整块抬到 0,1,1,
 * 于是全站页面/组件里任何单类 `.xxx { background/padding/margin/font-weight: ... }`
 * 挂在 <button> 上都被静默吃掉(标签选择器还会穿透自定义组件的样式隔离)。
 * 全仓清单与回归门禁见 scripts/button-reset-specificity-lint.js(带 --selftest 负控)。 */
button {
  font-weight: normal;
  padding: 0;
  margin: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: none;
}

button::before {
  display: none
}

button.auto {
  width: auto;
}

.shadow {
  background: #fff;
  border-radius: 16rpx;
}

.safebot {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: content-box;
}

.radius,
.radius image {
  border-radius: 20rpx;
}

.pr28 {
  padding-right: 28rpx !important;
  box-sizing: border-box;
}

.line1 {
  width: 100%;
  border: 12rpx solid #D9D9D9;
}

textarea{ line-height: 1.5;}

@keyframes bounceDown {
  25% {
    transform: translateY(-8px);
  }

  50%,
  100% {
    transform: translateY(0);
  }

  75% {
    transform: translateY(8px);
  }
}